---
// A short scroll-driven deck for the home page: one idea per panel, with the figure
// beside the copy. The panels are real markup, so the section reads as a list without
// a script and as a deck once the scroll drives it.
interface PanelImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Panel {
  kicker: string;
  title: string;
  body: string;
  note?: string;
  // The one line the panel has to land, set as a pull quote above the body.
  point?: string;
  // The numbers the panel exists to land, set large beside the copy.
  metrics?: Array<{ value: string; unit?: string }>;
  image?: PanelImage;
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede: string;
  panels: Panel[];
  // Each panel's name in the footer, so the progress reads as a menu and jumps.
  labels?: readonly string[];
  // A line under the deck about the material itself, such as a development build.
  footnote?: string;
}

const { id, eyebrow, title, lede, panels, labels, footnote } = Astro.props;

// A metric is written as it reads ("$2", "1,648"), and the counter needs the number
// on its own. The digits are lifted out at build time; prefix and suffix stay text.
const splitMetric = (value: string) => {
  const match = value.match(/^([^0-9]*)([\d,]+)(.*)$/);
  if (!match) return { prefix: '', digits: '', target: 0, suffix: value };
  const [, prefix, digits, suffix] = match;
  return { prefix, digits, target: Number(digits.replace(/,/g, '')), suffix };
};
---

<section class:list={['pdeck', footnote && 'pdeck--noted']} id={id} data-panel-deck style={`--steps: ${panels.length}`}>
  <div class="pdeck__stage">
    <div class="wrap pdeck__grid">
      <header class="pdeck__head">
        <p class="eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
        <p class="lede">{lede}</p>
      </header>

      <ol class="pdeck__list">
        {
          panels.map((panel, index) => (
            <li
              class:list={['panel', index === 0 && 'is-active', panel.image ? 'panel--figure' : 'panel--text']}
              data-panel
            >
              <div class="panel__copy">
                <p class="panel__kicker">{panel.kicker}</p>
                {panel.metrics && (
                  <p class="panel__metrics">
                    {panel.metrics.map((metric) => {
                      const parts = splitMetric(metric.value);
                      return (
                        <span class="panel__metric">
                          {parts.digits ? (
                            <span class="panel__value">
                              {parts.prefix}
                              <span data-count={parts.target}>{parts.digits}</span>
                              {parts.suffix}
                            </span>
                          ) : (
                            <span class="panel__value">{metric.value}</span>
                          )}
                          {metric.unit && <span class="panel__unit">{metric.unit}</span>}
                        </span>
                      );
                    })}
                  </p>
                )}
                <h3>{panel.title}</h3>
                {panel.point && <p class="panel__point">{panel.point}</p>}
                <p class="panel__body">{panel.body}</p>
                {panel.note && <p class="panel__note">{panel.note}</p>}
              </div>
              {panel.image && (
                <figure class="panel__figure">
                  <img
                    src={panel.image.src}
                    alt={panel.image.alt}
                    width={panel.image.width}
                    height={panel.image.height}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}
            </li>
          ))
        }
      </ol>

      <div class="pdeck__foot">
        <p class="pdeck__count">
          <span data-panel-now>01</span>
          <span class="pdeck__of">/ {String(panels.length).padStart(2, '0')}</span>
        </p>
        {
          labels && (
            <div class="pdeck__tabs">
              {labels.map((label, index) => (
                <button
                  type="button"
                  class:list={['pdeck__tab', index === 0 && 'is-active']}
                  data-panel-tab={index}
                >
                  {label}
                </button>
              ))}
            </div>
          )
        }
        <div class="pdeck__rail"><span class="pdeck__bar" data-panel-bar></span></div>
        <p class="pdeck__cue">Scroll</p>
      </div>

      {footnote && <p class="pdeck__note">{footnote}</p>}
    </div>
  </div>
</section>

<style>
  .pdeck {
    position: relative;
  }

  .pdeck__stage {
    display: grid;
    align-items: center;
    padding-block: clamp(48px, 8vh, 96px);
  }

  .pdeck__grid {
    display: grid;
    gap: clamp(20px, 3vh, 32px);
  }

  .pdeck__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pdeck__head h2 {
    margin: 0;
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.4rem);
    font-stretch: 115%;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .pdeck__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  .panel + .panel {
    margin-top: 48px;
  }

  /* A screenshot carries the panel, so it takes the wider column. */
  .panel--figure {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  /* A panel without a figure takes the whole width instead of leaving an empty column. */
  .panel--text {
    grid-template-columns: minmax(0, 1fr);
  }

  .panel--text .panel__copy {
    max-width: 46rem;
  }

  .panel__copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .panel__kicker {
    margin: 0;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .panel__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin: 2px 0 0;
  }

  .panel__metric {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-variant-numeric: tabular-nums;
  }

  .panel__value {
    font-size: clamp(2.6rem, 1.4rem + 3vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .panel__unit {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .panel__copy h3 {
    margin: 0;
    font-size: clamp(1.4rem, 1.2rem + 1vw, 1.9rem);
    font-weight: 600;
    font-stretch: 115%;
    letter-spacing: -0.015em;
    line-height: 1.12;
  }

  .panel__point {
    margin: 2px 0 0;
    padding-left: 14px;
    border-left: 2px solid var(--accent);
    font-size: clamp(1.02rem, 0.94rem + 0.4vw, 1.22rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--fg);
    text-wrap: pretty;
  }

  .panel__body {
    margin: 0;
    max-width: 42rem;
    color: var(--fg-2);
    font-size: 16px;
    line-height: 1.6;
  }

  .panel__note {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--fg-3);
  }

  .panel__figure {
    margin: 0;
  }

  .panel__figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .pdeck__foot {
    display: flex;
    align-items: center;
    gap: 20px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--fg-3);
  }

  .pdeck:not(.is-live) .pdeck__foot {
    display: none;
  }

  .pdeck__count {
    margin: 0;
    color: var(--fg);
  }

  .pdeck__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .pdeck__tab {
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg-3);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    transition: color 200ms var(--ease);
  }

  .pdeck__tab:hover,
  .pdeck__tab:focus-visible {
    color: var(--fg);
  }

  .pdeck__tab.is-active {
    color: var(--accent);
  }

  .pdeck__of {
    margin-left: 4px;
    color: var(--fg-3);
  }

  .pdeck__rail {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--line-2);
  }

  .pdeck__bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .pdeck__cue {
    margin: 0;
  }

  .pdeck__note {
    margin: 0;
    max-width: 62ch;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--fg-3);
  }

  .pdeck.is-live {
    height: calc(100svh + var(--steps) * 82svh);
  }

  /* A deck that carries a footnote gives the note the room it needs inside the
     stage, so the line is readable without scrolling past the deck. */
  .pdeck--noted .pdeck__stage {
    padding-block: clamp(40px, 7vh, 80px) 28px;
  }

  .pdeck--noted .pdeck__grid {
    gap: clamp(14px, 2vh, 22px);
  }

  .pdeck.is-live .pdeck__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    padding-block: calc(var(--masthead-h) + 24px) 40px;
  }

  .pdeck.is-live.pdeck--noted .pdeck__stage {
    padding-block: calc(var(--masthead-h) + 12px) 20px;
  }

  /* The turn matches the cases deck: a panel enters from below, the one it replaced
     leaves upward, and the list waits below the heading until the section is close. */
  .pdeck.is-live .panel {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    transform: translateY(28px);
    pointer-events: none;
    transition:
      opacity 560ms var(--ease-deck),
      transform 820ms var(--ease-deck);
  }

  .pdeck.is-live .panel.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .pdeck.is-live .panel.is-past {
    opacity: 0;
    transform: translateY(-28px);
  }

  .pdeck.is-live .pdeck__list,
  .pdeck.is-live .pdeck__foot,
  .pdeck.is-live .pdeck__note {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 700ms var(--ease),
      transform 700ms var(--ease);
  }

  .pdeck.is-live.is-revealed .pdeck__list,
  .pdeck.is-live.is-revealed .pdeck__foot,
  .pdeck.is-live.is-revealed .pdeck__note {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    /* The deck keeps one panel in the window, so a phone gets a smaller scale of the
       same panel. A panel that still runs past the window scrolls inside the stage
       instead of being cut at the bottom edge. */
    .pdeck.is-live .pdeck__stage {
      height: 100svh;
      min-height: 0;
      align-items: start;
      overflow-y: auto;
    }

    .pdeck__stage,
    .pdeck--noted .pdeck__stage,
    .pdeck.is-live .pdeck__stage,
    .pdeck.is-live.pdeck--noted .pdeck__stage {
      padding-block: calc(var(--masthead-h) + 12px) 16px;
    }

    .pdeck__grid,
    .pdeck--noted .pdeck__grid {
      gap: 12px;
    }

    .pdeck__head {
      gap: 6px;
    }

    .pdeck__head h2 {
      font-size: 1.4rem;
    }

    .pdeck__head .lede {
      font-size: 14px;
      line-height: 1.45;
    }

    .panel__copy {
      gap: 6px;
    }

    .panel__metrics {
      gap: 4px 20px;
    }

    .panel__value {
      font-size: clamp(1.8rem, 1.4rem + 2vw, 2.4rem);
    }

    .panel__unit {
      font-size: 10px;
    }

    .panel__copy h3 {
      font-size: 1.15rem;
    }

    .panel__point {
      padding-left: 10px;
      font-size: 0.95rem;
      line-height: 1.35;
    }

    .panel__body {
      font-size: 14px;
      line-height: 1.5;
    }

    .panel__note,
    .pdeck__foot,
    .pdeck__note {
      font-size: 10px;
    }

    .pdeck__foot {
      gap: 12px;
    }

    .panel__figure img {
      max-height: 32svh;
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pdeck.is-live {
      height: auto;
    }

    .pdeck.is-live .pdeck__stage {
      position: static;
      height: auto;
    }

    .pdeck.is-live .panel {
      grid-area: auto;
      opacity: 1;
      pointer-events: auto;
      transition: none;
    }

    .pdeck.is-live .panel + .panel {
      margin-top: 48px;
    }

    .pdeck__foot {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { resetAll, rollAll } from '../scripts/count-up';

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const tooSmall = window.matchMedia('(max-height: 559px), (max-width: 359px) and (max-height: 620px)');

  document.querySelectorAll<HTMLElement>('[data-panel-deck]').forEach((deck) => {
    const panels = Array.from(deck.querySelectorAll<HTMLElement>('[data-panel]'));
    const stage = deck.querySelector<HTMLElement>('.pdeck__stage');
    const bar = deck.querySelector<HTMLElement>('[data-panel-bar]');
    const now = deck.querySelector<HTMLElement>('[data-panel-now]');
    const tabs = Array.from(deck.querySelectorAll<HTMLButtonElement>('[data-panel-tab]'));
    if (panels.length === 0) return;

    const show = (index: number) => {
      panels.forEach((panel, i) => {
        panel.classList.toggle('is-active', i === index);
        panel.classList.toggle('is-past', i < index);
      });
      tabs.forEach((tab, i) => tab.classList.toggle('is-active', i === index));
      if (now) now.textContent = String(index + 1).padStart(2, '0');
      // A phone scrolls a long panel inside the stage, so the next one opens at its head.
      if (stage) stage.scrollTop = 0;

      const panel = panels[index];
      if (panel && deck.classList.contains('is-revealed')) {
        resetAll(panel);
        rollAll(panel);
      }
    };

    // A label jumps to its panel: in the deck the target is that panel's share of the
    // section's scroll range, and in the stacked state it is the panel itself.
    const jump = (index: number) => {
      const motion = reduce.matches ? 'auto' : 'smooth';
      if (!deck.classList.contains('is-live')) {
        panels[index]?.scrollIntoView({ behavior: motion, block: 'start' });
        return;
      }
      const top = deck.getBoundingClientRect().top + window.scrollY;
      const range = deck.offsetHeight - window.innerHeight;
      window.scrollTo({ top: top + ((index + 0.5) / panels.length) * range, behavior: motion });
    };

    tabs.forEach((tab, index) => tab.addEventListener('click', () => jump(index)));

    let trigger: ScrollTrigger | null = null;
    let reveal: IntersectionObserver | null = null;

    const stack = () => {
      trigger?.kill();
      trigger = null;
      reveal?.disconnect();
      reveal = null;
      deck.classList.remove('is-live', 'is-revealed');
      panels.forEach((panel) => panel.classList.add('is-active'));
    };

    const start = () => {
      stack();
      deck.classList.add('is-live');
      reveal = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            deck.classList.add('is-revealed');
            reveal?.disconnect();
            const panel = panels.find((item) => item.classList.contains('is-active'));
            if (panel) {
              resetAll(panel);
              rollAll(panel);
            }
          }
        },
        { rootMargin: '0px 0px -40% 0px' },
      );
      reveal.observe(deck);
      show(0);
      let current = 0;

      // A panel turns only once the scroll is a fifth of a unit past the boundary,
      // and it holds that far back again, so a flick cannot run the deck past the reader.
      const HOLD = 0.22;
      const pick = (position: number) => {
        let next = current;
        while (next < panels.length - 1 && position >= next + 1 + HOLD) next += 1;
        while (next > 0 && position <= next - HOLD) next -= 1;
        return next;
      };

      trigger = ScrollTrigger.create({
        trigger: deck,
        start: 'top top',
        end: 'bottom bottom',
        onUpdate: (self) => {
          if (bar) bar.style.transform = `scaleX(${self.progress})`;
          const index = pick(self.progress * panels.length);
          if (index !== current) {
            current = index;
            show(index);
          }
        },
      });
    };

    const apply = () => {
      if (reduce.matches || tooSmall.matches) stack();
      else start();
    };

    apply();
    reduce.addEventListener('change', apply);
    tooSmall.addEventListener('change', apply);
  });
</script>
