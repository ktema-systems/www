---
import { productMenu, site } from '../config';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <nav class="footer__products" aria-label="Products">
      {productMenu.map((entry) => <a href={entry.href}>{entry.label}</a>)}
    </nav>
    <div class="footer__base">
      <p>© {year} {site.legalName}, {site.legalStatus}.</p>
      <nav class="footer__links" aria-label="Elsewhere">
        <a href={`mailto:${site.contact}`}>{site.contact}</a>
        <!-- <a href={site.github}>GitHub (Pre-Release)</a> -->
        <!--<a href={site.docs}>Documentation</a>-->
      </nav>
    </div>
  </div>
</footer>
