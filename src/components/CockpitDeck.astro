---
// The cockpit screenshots as a scroll-driven deck: one run at a time, read from
// the same stage. The panels are real markup, so a reader without JavaScript or
// on a narrow screen gets the two figures stacked.
const shots = [
  {
    src: '/delta_scr.png',
    width: 1767,
    height: 951,
    alt: 'Development screen of the Delta platform from a manufacturing robot demo run, showing a production cell with a conveyor, servo drives, maintenance robots, and two live camera views.',
    caption:
      'A development screen from the manufacturing robot demo run. The cell shows a conveyor, servo drives, maintenance robots, and two live camera views, with the operator\'s intents and claims on the left.',
  },
  {
    src: '/delta_scr.jpeg',
    width: 3362,
    height: 2158,
    alt: 'Development screen of the Delta platform from a drone and aircraft rescue demo run, with intents and claims on the left, the project\'s space in the middle, and the chain of fact, hint, intent, and claim along the bottom.',
    caption:
      'A development screen from the drone and aircraft rescue demo run. Intents and claims sit on the left, the project\'s space is in the middle with two live camera views, and the chain of fact, hint, intent, and claim runs along the bottom.',
  },
];
---

<section
  class="shots"
  data-cockpit-deck
  style={`--shots: ${shots.length}`}
  aria-label="Cockpit demo runs"
>
  <div class="shots__stage" data-shots-stage>
    <div class="shots__grid">
      <ol class="shots__list">
        {
          shots.map((shot, index) => (
            <li class:list={['shots__panel', index === 0 && 'is-active']} data-shots-panel>
              <figure class="shot">
                <div class="shot__frame">
                  <img
                    src={shot.src}
                    alt={shot.alt}
                    width={shot.width}
                    height={shot.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption>{shot.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ol>

      <div class="shots__foot">
        <p class="shots__count">
          <span data-shots-now>01</span>
          <span class="shots__of">/ {String(shots.length).padStart(2, '0')}</span>
        </p>
        <div class="shots__rail"><span class="shots__bar" data-shots-bar></span></div>
        <p class="shots__cue">Scroll</p>
      </div>
    </div>
  </div>
</section>

<style>
  .shots {
    position: relative;
  }

  .shots__stage {
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--masthead-h) + 16px) 28px;
  }

  .shots__grid {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: clamp(16px, 2.2vh, 28px);
    min-height: min(76svh, 720px);
  }

  .shots__list {
    display: grid;
    align-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shots__panel {
    display: block;
  }

  .shots__panel + .shots__panel {
    margin-top: 28px;
  }

  .shot {
    margin: 0;
  }

  .shot__frame {
    width: 100%;
    aspect-ratio: 3362 / 2158;
    max-height: calc(100svh - 180px);
    border-radius: 10px;
    overflow: hidden;
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .shot figcaption {
    padding: 14px 18px 0;
    color: var(--fg-3);
    font-size: 12.5px;
    line-height: 1.6;
  }

  .shots__foot {
    display: flex;
    align-items: center;
    gap: 20px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--fg-3);
  }

  .shots:not(.is-live) .shots__foot {
    display: none;
  }

  .shots__count {
    margin: 0;
    color: var(--fg);
  }

  .shots__of {
    margin-left: 4px;
    color: var(--fg-3);
  }

  .shots__rail {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--line-2);
  }

  .shots__bar {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .shots__cue {
    margin: 0;
    text-transform: uppercase;
  }

  .shots.is-live {
    height: calc(100svh + var(--shots) * 70svh);
  }

  .shots.is-live .shots__stage {
    position: sticky;
    top: 0;
    height: 100svh;
  }

  .shots.is-live .shots__panel {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
    transition:
      opacity 420ms var(--ease),
      transform 560ms var(--ease);
  }

  .shots.is-live .shots__panel + .shots__panel {
    margin: 0;
  }

  .shots.is-live .shots__panel.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .shots.is-live .shots__panel.is-past {
    opacity: 0;
    transform: translateY(-24px);
  }

  @media (max-width: 720px) {
    .shots__stage {
      min-height: 0;
      padding-block: 0;
    }

    .shots__grid {
      min-height: 0;
    }

    .shots__list {
      gap: 28px;
    }

    .shots__panel + .shots__panel {
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shots.is-live {
      height: auto;
    }

    .shots.is-live .shots__stage {
      position: static;
      height: auto;
    }

    .shots.is-live .shots__panel {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .shots.is-live .shots__panel + .shots__panel {
      margin-top: 28px;
    }

    .shots.is-live .shots__foot {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const region = document.querySelector<HTMLElement>('[data-cockpit-deck]');
  const panels = region
    ? Array.from(region.querySelectorAll<HTMLElement>('[data-shots-panel]'))
    : [];
  const bar = region?.querySelector<HTMLElement>('[data-shots-bar]');
  const now = region?.querySelector<HTMLElement>('[data-shots-now]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  // A stage this small cannot hold the deck, so it stays a list there: a phone in
  // landscape, a window dragged to a sliver, or the smallest phones.
  const tooSmall = window.matchMedia(
    '(max-height: 559px), (max-width: 359px) and (max-height: 620px)',
  );

  const setActive = (index: number) => {
    panels.forEach((panel, i) => {
      panel.classList.toggle('is-active', i === index);
      panel.classList.toggle('is-past', i < index);
      panel.setAttribute('aria-hidden', i === index ? 'false' : 'true');
    });

    if (now) {
      now.textContent = String(index + 1).padStart(2, '0');
    }
  };

  let trigger: ScrollTrigger | null = null;

  const stack = () => {
    trigger?.kill();
    trigger = null;
    region?.classList.remove('is-live');

    panels.forEach((panel) => {
      panel.classList.add('is-active');
      panel.classList.remove('is-past');
      panel.setAttribute('aria-hidden', 'false');
    });
  };

  const start = () => {
    if (!region) return;
    stack();
    region.classList.add('is-live');
    setActive(0);

    trigger = ScrollTrigger.create({
      trigger: region,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => {
        if (bar) {
          bar.style.transform = `scaleX(${self.progress})`;
        }

        const index = Math.min(panels.length - 1, Math.floor(self.progress * panels.length));
        if (!panels[index]?.classList.contains('is-active')) {
          setActive(index);
        }
      },
    });
  };

  const apply = () => {
    if (!region || panels.length === 0) return;
    if (reduce.matches || tooSmall.matches) stack();
    else start();
  };

  apply();
  reduce.addEventListener('change', apply);
  tooSmall.addEventListener('change', apply);
</script>
