---
import Section from './Section.astro';
import { site } from '../config';
---

<Section
  id="contact"
  label="Contact"
  title="Put the engine inside your product"
  lede="If your device has to keep its own history and answer for it on the spot, we should talk. We are choosing the first design partners now."
  band
>
  <div class="prose">
    <p>
      Ktema runs inside the product you already ship. It needs no server, no network, and no
      database, and it fits the memory a small device has. Tell us what your machine has to
      remember, and we will show you what the record looks like on it.
    </p>
  </div>

  <div class="actions">
    <a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a>
    <!--<a class="btn" href={site.docs}>Read the documentation</a>-->
  </div>
</Section>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
