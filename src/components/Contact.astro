---
import Section from './Section.astro';
import { site } from '../config';

interface Props {
  title: string;
  lede: string;
  body: string;
}

const { title, lede, body } = Astro.props;
---

<Section id="contact" label="Contact" title={title} lede={lede} band>
  <div class="prose">
    <p>{body}</p>
  </div>

  <div class="actions">
    <a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a>
  </div>
</Section>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
