---
// The engine's measurements, walked by the page's own scroll. One number at a time,
// each with the figure that makes it land, so the section reads as a deck once the
// script takes it and as four plain blocks without one.
//
// Every figure here is produced by this tree: `benches/run.sh` for the host, and
// `verify/device/check.sh` for the part. A number a reader cannot trace to a run is
// the failure this section exists to avoid.

const steps = 4;

interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
}

const {
  eyebrow = 'Proof',
  title = 'What the engine costs, on the machine and over the log.',
  lede = 'Four numbers: what it takes to fit, what it costs to grow, what a question returns, and what a database needs for the same question.',
} = Astro.props;
---

<section class="deck" id="proof" data-deck style={`--steps: ${steps}`}>
  <div class="deck__stage">
    <div class="wrap deck__grid">
      <header class="deck__head">
        <p class="eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
        <p class="lede">{lede}</p>
      </header>

      <ol class="deck__list">
        <li class="step" data-step>
          <div class="step__copy">
            <p class="step__meta"><span>01</span><span>the footprint</span></p>
            <p class="step__value">
              <span data-count="1648" data-decimals="0">1,648</span><span class="step__unit">B</span>
            </p>
            <p class="step__claim">
              The engine never holds more than 1,648 bytes of working memory on the board: a fortieth of the 64 KB arena it is
              given.
            </p>
            <p class="step__note">
              An ESP32-S3 with 8 MB of flash, the records on the flash and the read path included.
            </p>
          </div>
          <div class="step__fig">
            <div class="budget">
              <span class="budget__fill" style="--to: 0.0251"></span>
              <span class="budget__edge" style="--to: 0.0251" aria-hidden="true"></span>
            </div>
            <p class="budget__legend">
              <span>1,648 B at the peak</span>
              <span>2.5% of a 64 KB budget</span>
            </p>
            <p class="split__legend">
              The records sit on the flash. This is what the engine holds while it works, and it
              does not grow with them.
            </p>
          </div>
        </li>

        <li class="step" data-step>
          <div class="step__copy">
            <p class="step__meta"><span>02</span><span>the growth</span></p>
            <p class="step__value">
              <span data-count="1.67" data-decimals="2">1.67</span><span class="step__unit">µs</span>
            </p>
            <p class="step__claim">
              A record read from the middle of ten thousand: 1.67 µs, against 1.04 µs at a
              thousand.
            </p>
            <p class="step__note">
              Ten times the history adds two thirds of a microsecond, because a read does not walk
              the log from its start.
            </p>
          </div>
          <div class="step__fig">
            <div class="row">
              <span class="row__k">1,000 records</span>
              <span class="row__v">1.04 µs</span>
              <span class="row__track"><span class="row__fill" style="--to: 0.62"></span></span>
            </div>
            <div class="row">
              <span class="row__k">10,000 records</span>
              <span class="row__v">1.67 µs</span>
              <span class="row__track"><span class="row__fill" style="--to: 1"></span></span>
            </div>
            <p class="delta">+0.63 µs, for ten times the records.</p>
            <p class="split__legend">Bars scaled to 1.67 µs.</p>
          </div>
        </li>

        <li class="step" data-step>
          <div class="step__copy">
            <p class="step__meta"><span>03</span><span>the question</span></p>
            <p class="step__value">
              <span data-count="2.96" data-decimals="2">2.96</span><span class="step__unit">ms</span>
            </p>
            <p class="step__claim">
              A question that returns 1,001 records from ten thousand stored takes 2.96 ms.
            </p>
            <p class="step__note">
              At a thousand records the same question returns 101, in 148 µs.
            </p>
          </div>
          <div class="step__fig">
            <div class="row">
              <span class="row__k">1,000 stored · 101 returned</span>
              <span class="row__v">148 µs</span>
              <span class="row__track"><span class="row__fill" style="--to: 0.05"></span></span>
            </div>
            <div class="row">
              <span class="row__k">10,000 stored · 1,001 returned</span>
              <span class="row__v">2.96 ms</span>
              <span class="row__track"><span class="row__fill" style="--to: 1"></span></span>
            </div>
            <p class="delta">+2.81 ms, and 900 more records returned.</p>
            <p class="split__legend">Bars scaled to 2.96 ms.</p>
          </div>
        </li>

        <li class="step" data-step>
          <div class="step__copy">
            <p class="step__meta"><span>04</span><span>the alternative</span></p>
            <p class="step__value">
              <span data-count="100" data-decimals="0">100</span><span class="step__unit">KB</span>
            </p>
            <p class="step__claim">
              A minimum SQLite build needs an operating system and about 100 KB of heap for its
              B-tree.
            </p>
            <p class="step__note">
              It also rebuilds on boot: it replays its write-ahead log, while LittleFS walks its
              directory and NVS reads its page index into RAM.
            </p>
          </div>
          <div class="step__fig">
            <div class="row">
              <span class="row__k">Ktema · 1,648 B</span>
              <span class="row__v">1,648 B</span>
              <span class="row__track"><span class="row__fill" style="--to: 0.016"></span></span>
            </div>
            <div class="row">
              <span class="row__k">SQLite · 100 KB</span>
              <span class="row__v">100 KB</span>
              <span class="row__track"><span class="row__fill" style="--to: 1"></span></span>
            </div>
            <p class="split__legend">
              Bars scaled to 100 KB. The engine figure is measured on the board; the database
              figure is its published minimum.
            </p>
          </div>
        </li>
      </ol>

      <div class="deck__foot">
        <p class="deck__count">
          <span data-step-now>01</span>
          <span class="deck__of">/ {String(steps).padStart(2, '0')}</span>
        </p>
        <div class="deck__rail"><span class="deck__bar" data-step-bar></span></div>
        <p class="deck__cue">Scroll</p>
      </div>

      <p class="deck__source">
        The footprint is the ESP32-S3 run on the board. The read and the question are host figures:
        release build, median of 51 samples. The database figure is its published minimum.
      </p>
    </div>
  </div>
</section>

<style>
  .deck {
    position: relative;
  }

  .deck__stage {
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--masthead-h) + 32px) 48px;
  }

  .deck__grid {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    gap: clamp(24px, 4vh, 44px);
    min-height: min(78svh, 780px);
  }

  .deck__head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .deck__head h2 {
    margin: 0;
    font-size: clamp(1.7rem, 1.2rem + 2vw, 2.6rem);
    font-stretch: 115%;
    letter-spacing: -0.015em;
    line-height: 1.08;
  }

  .deck__head .lede {
    max-width: 44rem;
  }

  .deck__list {
    display: grid;
    align-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }

  .step + .step {
    margin-top: 56px;
  }

  .step__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .step__meta {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin: 0;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .step__meta span + span {
    color: var(--fg-3);
  }

  .step__value {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin: 0;
    font-size: clamp(3.2rem, 1.8rem + 5vw, 6rem);
    font-weight: 600;
    font-stretch: 115%;
    letter-spacing: -0.045em;
    line-height: 0.92;
    font-variant-numeric: tabular-nums;
  }

  .step__unit {
    font-family: var(--mono);
    font-size: clamp(1rem, 0.8rem + 0.9vw, 1.5rem);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--fg-3);
  }

  .step__claim {
    margin: 0;
    max-width: 32rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    color: var(--fg-2);
  }

  .step__note {
    margin: 0;
    max-width: 32rem;
    padding-left: 16px;
    border-left: 2px solid var(--line-2);
    font-size: 0.9rem;
    color: var(--fg-3);
  }

  .step__fig {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
    align-items: baseline;
  }

  .row__k {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .row__v {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-2);
    font-variant-numeric: tabular-nums;
  }

  .row__track {
    position: relative;
    grid-column: 1 / -1;
    height: 12px;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }

  .row__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--to, 1) * 100%);
    background: var(--accent);
    clip-path: inset(0 calc((1 - var(--p, 1)) * 100%) 0 0);
    transition: clip-path 700ms var(--ease);
  }

  .delta {
    margin: 0;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .split {
    display: flex;
    height: 34px;
    margin-top: 4px;
    border: 1px solid var(--line);
    clip-path: inset(0 calc((1 - var(--p, 1)) * 100%) 0 0);
    transition: clip-path 700ms var(--ease);
  }

  .split__seg {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--w) * 1%);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-accent);
  }

  .split__seg--key {
    background: var(--accent);
  }

  .split__seg--frame {
    background: var(--accent-2);
  }

  .split__seg--value {
    background: var(--panel);
    color: var(--fg-3);
  }

  .split__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    align-items: center;
    margin: 0;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--fg-3);
  }

  .legend__item {
    display: inline-flex;
    gap: 7px;
    align-items: center;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot--key {
    background: var(--accent);
  }

  .dot--frame {
    background: var(--accent-2);
  }

  .dot--value {
    background: var(--panel);
    border: 1px solid var(--line-2);
  }

  .budget {
    position: relative;
    height: clamp(72px, 10vh, 104px);
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 calc(100% / 8 - 1px),
        var(--line) calc(100% / 8 - 1px) calc(100% / 8)
      ),
      var(--bg-2);
    border: 1px solid var(--line);
  }

  .budget__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--to, 1) * 100%);
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    clip-path: inset(0 calc((1 - var(--p, 1)) * 100%) 0 0);
    transition: clip-path 700ms var(--ease);
  }

  .budget__edge {
    position: absolute;
    inset: 0 auto 0 calc(var(--to, 1) * 100%);
    width: 1px;
    background: var(--fg);
    box-shadow: 0 0 14px 2px var(--accent);
    opacity: calc(var(--p, 1) * 0.9);
    transition: opacity 700ms var(--ease);
  }

  .budget__legend {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--fg-2);
    font-variant-numeric: tabular-nums;
  }

  .deck__foot {
    display: flex;
    align-items: center;
    gap: 20px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--fg-3);
  }

  .deck:not(.is-live) .deck__foot {
    display: none;
  }

  .deck__count {
    margin: 0;
    color: var(--fg);
  }

  .deck__of {
    margin-left: 4px;
    color: var(--fg-3);
  }

  .deck__rail {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--line-2);
  }

  .deck__bar {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .deck__cue {
    margin: 0;
    text-transform: uppercase;
  }

  .deck__source {
    max-width: 62ch;
    margin: 0;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    line-height: 1.7;
    color: var(--fg-3);
  }

  /* The deck. The section gains the walk's length only once the script has taken
     it, so a reader without JavaScript keeps four plain blocks. */
  .deck.is-live {
    height: calc(100svh + var(--steps) * 70svh);
  }

  .deck.is-live .deck__stage {
    position: sticky;
    top: 0;
    height: 100svh;
  }

  .deck.is-live .step + .step {
    margin: 0;
  }

  /* The turn matches the cases deck: a step enters from below and the one it
     replaced leaves upward. */
  .deck.is-live .step {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(28px);
    pointer-events: none;
    transition:
      opacity 480ms var(--ease),
      transform 640ms var(--ease);
  }

  .deck.is-live .step.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .deck.is-live .step.is-past {
    opacity: 0;
    transform: translateY(-28px);
  }

  .deck.is-live .deck__list,
  .deck.is-live .deck__foot {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 700ms var(--ease),
      transform 700ms var(--ease);
  }

  .deck.is-live.is-revealed .deck__list,
  .deck.is-live.is-revealed .deck__foot {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 860px) {
    .step {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    /* The legend below carries the three parts; the segments are too narrow for a label. */
    .split__seg {
      font-size: 0;
    }
  }

  /* The step, its figure, and the source have to share one sticky stage, so the
     section's summary line goes first when the width is that of a tablet or a
     phone. */
  @media (max-width: 860px) and (max-height: 900px) {
    .deck__head .lede {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .deck__grid {
      gap: 14px;
    }

    .deck__source {
      font-size: 9.5px;
      line-height: 1.45;
    }
  }

  @media (max-width: 480px) {
    .deck__grid {
      gap: 8px;
    }

    .deck__head h2 {
      font-size: 1.2rem;
    }

    .step__copy {
      gap: 10px;
    }

    .step__fig {
      gap: 6px;
    }

    .step__value {
      font-size: 2.4rem;
    }

    .step__claim {
      font-size: 0.95rem;
    }

    .step__note {
      font-size: 0.78rem;
    }

    .split {
      height: 26px;
    }
  }

  /* The smallest phones keep the steps and drop the provenance line; it returns
     as soon as the stage has room for it. */
  @media (max-width: 860px) and (max-height: 660px) {
    .deck__source {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck.is-live {
      height: auto;
    }

    .deck.is-live .deck__stage {
      position: static;
      height: auto;
    }

    .deck.is-live .step {
      opacity: 1;
      pointer-events: auto;
    }

    .deck__rail,
    .deck__cue {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { resetAll, rollAll } from '../scripts/count-up';

  gsap.registerPlugin(ScrollTrigger);

  const deck = document.querySelector<HTMLElement>('[data-deck]');
  const panels = deck ? Array.from(deck.querySelectorAll<HTMLElement>('[data-step]')) : [];
  const bar = deck?.querySelector<HTMLElement>('[data-step-bar]');
  const now = deck?.querySelector<HTMLElement>('[data-step-now]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  // A stage this small cannot hold the deck, so it stays a list there: a phone in
  // landscape, a window dragged to a sliver, or the smallest phones.
  const tooSmall = window.matchMedia(
    '(max-height: 559px), (max-width: 359px) and (max-height: 620px)',
  );

  // The step arrives whole: its bars fill and its number rolls together. The roll
  // comes from the shared counter module, so every deck counts the same way.
  const play = (panel: HTMLElement | undefined) => {
    if (!panel) return;
    panel.style.setProperty('--p', '0');
    window.requestAnimationFrame(() => {
      panel.style.setProperty('--p', '1');
      resetAll(panel);
      rollAll(panel);
    });
  };

  const setActive = (index: number) => {
    panels.forEach((panel, i) => {
      panel.classList.toggle('is-active', i === index);
      panel.classList.toggle('is-past', i < index);
      panel.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      if (i !== index) panel.style.setProperty('--p', '1');
    });

    if (now) {
      now.textContent = String(index + 1).padStart(2, '0');
    }

    if (deck?.classList.contains('is-revealed')) play(panels[index]);
  };

  let trigger: ScrollTrigger | null = null;
  let reveal: IntersectionObserver | null = null;

  const stack = () => {
    trigger?.kill();
    trigger = null;
    reveal?.disconnect();
    reveal = null;
    deck?.classList.remove('is-live', 'is-revealed');

    panels.forEach((panel) => {
      panel.classList.add('is-active');
      panel.setAttribute('aria-hidden', 'false');
    });
  };

  const start = () => {
    if (!deck) return;
    stack();
    deck.classList.add('is-live');
    setActive(0);

    reveal = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          deck.classList.add('is-revealed');
          reveal?.disconnect();
          play(panels.find((panel) => panel.classList.contains('is-active')));
        }
      },
      { rootMargin: '0px 0px -40% 0px' },
    );
    reveal.observe(deck);

    let current = -1;

    trigger = ScrollTrigger.create({
      trigger: deck,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => {
        if (bar) {
          bar.style.transform = `scaleX(${self.progress})`;
        }

        const index = Math.min(panels.length - 1, Math.floor(self.progress * panels.length));
        if (index !== current) {
          current = index;
          setActive(index);
        }
      },
    });
  };

  const apply = () => {
    if (!deck || panels.length === 0) return;
    if (reduce.matches || tooSmall.matches) stack();
    else start();
  };

  apply();
  reduce.addEventListener('change', apply);
  tooSmall.addEventListener('change', apply);
</script>
