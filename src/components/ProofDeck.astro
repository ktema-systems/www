---
import Deck from './Deck.astro';

// The engine's measurements, walked by the page's own scroll. One number at a time,
// each with the figure that makes it land, so the section reads as a deck once the
// script takes it and as four plain blocks without one.
//
// Every figure here is produced by this tree: `benches/run.sh` for the host, and
// `verify/device/check.sh` for the part. A number a reader cannot trace to a run is
// the failure this section exists to avoid.

const slides = [
  {
    meta: '01',
    stamp: 'the footprint',
    metrics: [{ value: '1,648', unit: 'B' }],
    body: 'The engine never holds more than 1,648 bytes of working memory on the board: a fortieth of the 64 KB arena it is given.',
    rows: [
      {
        text: 'An ESP32-S3 with 8 MB of flash, the records on the flash and the read path included.',
        rule: true,
      },
    ],
    gauge: {
      fill: 0.0251,
      from: '1,648 B at the peak',
      to: '2.5% of a 64 KB budget',
      caption:
        'The records sit on the flash. This is what the engine holds while it works, and it does not grow with them.',
    },
  },
  {
    meta: '02',
    stamp: 'the growth',
    metrics: [{ value: '1.67', unit: 'µs' }],
    body: 'A record read from the middle of ten thousand: 1.67 µs, against 1.04 µs at a thousand.',
    rows: [
      {
        text: 'Ten times the history adds two thirds of a microsecond, because a read does not walk the log from its start.',
        rule: true,
      },
    ],
    bars: [
      { label: '1,000 records', value: '1.04 µs', fill: 0.62 },
      { label: '10,000 records', value: '1.67 µs', fill: 1 },
    ],
    delta: '+0.63 µs, for ten times the records.',
    legend: 'Bars scaled to 1.67 µs.',
  },
  {
    meta: '03',
    stamp: 'the question',
    metrics: [{ value: '2.96', unit: 'ms' }],
    body: 'A question that returns 1,001 records from ten thousand stored takes 2.96 ms.',
    rows: [{ text: 'At a thousand records the same question returns 101, in 148 µs.', rule: true }],
    bars: [
      { label: '1,000 stored · 101 returned', value: '148 µs', fill: 0.05 },
      { label: '10,000 stored · 1,001 returned', value: '2.96 ms', fill: 1 },
    ],
    delta: '+2.81 ms, and 900 more records returned.',
    legend: 'Bars scaled to 2.96 ms.',
  },
  {
    meta: '04',
    stamp: 'the alternative',
    metrics: [{ value: '100', unit: 'KB' }],
    body: 'A minimum SQLite build needs an operating system and about 100 KB of heap for its B-tree.',
    rows: [
      {
        text: 'It also rebuilds on boot: it replays its write-ahead log, while LittleFS walks its directory and NVS reads its page index into RAM.',
        rule: true,
      },
    ],
    bars: [
      { label: 'Ktema · 1,648 B', value: '1,648 B', fill: 0.016 },
      { label: 'SQLite · 100 KB', value: '100 KB', fill: 1 },
    ],
    legend:
      'Bars scaled to 100 KB. The engine figure is measured on the board; the database figure is its published minimum.',
  },
];
---

<Deck
  id="proof"
  eyebrow="Proof"
  title="What the engine costs, on the machine and over the log."
  lede="Four numbers: what it takes to fit, what it costs to grow, what a question returns, and what a database needs for the same question."
  slides={slides}
  footnote="The footprint is the ESP32-S3 run on the board. The read and the question are host figures: release build, median of 51 samples. The database figure is its published minimum."
/>
