---
import Deck from './Deck.astro';
import LoopFigure from './LoopFigure.astro';
import CampaignFigure from './CampaignFigure.astro';

// The run's own deck: the loop first, then one run through it. The deck supplies the
// stage and the walk; the two figures move with the scroll, so they are passed as
// slots and animated by the script below.
const slides = [
  {
    kicker: 'The premise',
    title: 'A run is not a command',
    body: 'A command asks for an output and waits. An autonomous system keeps running, and a person can enter at any point with a new intent, a limit, or a correction. What the machine does is the sum of those entries.',
    stacked: true,
  },
  {
    kicker: 'The run',
    title: 'The villa evacuation',
    body: 'An emergency lift on the Monaco coast. The operator calls the lift. The hospital adds a 75-second bound for the scan. Both enter while the work is moving. The run starts when the emergency is declared and ends when treatment begins.',
    note: 'One run, three entries, one 75-second bound.',
    stacked: true,
  },
];
---

<Deck
  id="loop"
  eyebrow="The loop"
  title="Intent enters a moving run"
  lede="A run is not a command. The loop comes first, then one run where intent enters while the work is moving."
  slides={slides}
  size="stage"
>
  <LoopFigure slot="figure-0" />
  <CampaignFigure slot="figure-1" />
</Deck>

<script>
  const deck = document.querySelector<HTMLElement>('#loop[data-deck]');

  const setLoop = (local: number) => {
    const ring = deck?.querySelector<HTMLElement>('[data-loop-ring]');
    const nodes = deck ? Array.from(deck.querySelectorAll<HTMLElement>('[data-loop-node]')) : [];

    if (ring) {
      ring.style.transform = `translate(-50%, -50%) rotate(${local * 180}deg)`;
    }

    nodes.forEach((node, i) => {
      const step = Math.min(1, Math.max(0, local * nodes.length - i));
      node.style.opacity = String(0.35 + 0.65 * step);
    });
  };

  const setCampaign = (local: number) => {
    const figure = deck?.querySelector<HTMLElement>('[data-campaign]');
    if (!figure) return;

    const start = Number(figure.dataset.start ?? 8);
    const end = Number(figure.dataset.end ?? 176);
    const deadline = Number(figure.dataset.deadline ?? 83);
    const runAt = start + local * (end - start);

    const span = figure.querySelector<HTMLElement>('[data-campaign-span]');
    if (span) {
      span.style.transform = `scaleX(${local})`;
    }

    const line = figure.querySelector<HTMLElement>('[data-campaign-deadline]');
    if (line) {
      line.style.opacity = String(runAt >= deadline ? 1 : 0);
    }

    const windowBar = figure.querySelector<HTMLElement>('[data-campaign-window]');
    if (windowBar) {
      const progress = Math.min(1, Math.max(0, (runAt - start) / (deadline - start)));
      windowBar.style.transform = `scaleX(${progress})`;
    }

    figure.querySelectorAll<HTMLElement>('[data-campaign-dot]').forEach((dot) => {
      const at = Number(dot.dataset.at ?? 0);
      const passed = runAt >= at;
      dot.style.opacity = passed ? '1' : '0.18';
      dot.style.transform = `scale(${passed ? 1 : 0.6})`;
    });
  };

  // Stacked, the deck has no walk, so both figures are drawn whole.
  setLoop(1);
  setCampaign(1);

  // The deck reports where the walk is; each figure spends its own slide's progress.
  deck?.addEventListener('deck:progress', (event) => {
    const { index, local } = (event as CustomEvent<{ index: number; local: number }>).detail;
    if (index === 0) setLoop(local);
    else setCampaign(local);
  });
</script>
