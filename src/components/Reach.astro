            )}
            {node.glyph === 'dot' && <circle class="reach__dot" r="2" />}
          </g>
        </g>
      ))
    }

    {
      nodes.map((node) =>
        node.label && node.labelPos ? (
          <text
            class="reach__label"
            data-label={node.id}
            data-read={joinThreshold.get(node.id) ?? 1}
            x={round(node.labelPos.x)}
            y={round(node.labelPos.y)}
            text-anchor={node.labelPos.anchor}
            style={`--fade: ${node.fade}`}
          >
            {node.label}
          </text>
          ) : null,
        )
      }
    </g>
  </svg>

  <script type="application/json" id="reach-space" set:html={JSON.stringify(payload)} />

  <figcaption class="reach__caption">
    Each machine keeps its own record at its own coordinate. Two records meet where they
    reach the same point, and one instant can hold the futures that follow it. No cloud,
    no database, no index.
  </figcaption>
</figure>

<style>
  .reach {
    /* The figure spans the page, so the caption stays centred while the scene can
       still hold the right edge before the pin. */
    width: 100%;
    max-width: none;
    margin: 0;
  }

  /* The frame is as tall as the drawing, so the paragraph sits under it with an
     ordinary gap and the whole block can be centred in the window. */
  .reach svg {
    display: block;
    width: min(1900px, calc((100svh - 300px) * 1.4433));
    max-width: 100%;
    height: auto;
    margin-left: auto;
    margin-right: 0;
    /* The frame is open: a label or a state that reaches the edge is not cut off. */
    overflow: visible;
    cursor: grab;
    /* A sideways drag turns the sphere; the page keeps the vertical scroll. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    /* The scene begins larger than the figure and settles as the pin arrives, so the
       top of the sphere stands behind the promise before the section begins. The
       shift is the one that centres the sphere once the promise has gone. */
    transform: translate(var(--reach-shift, 0px), var(--reach-rise, 0px)) scale(var(--reach-scale, 1));
    transform-origin: 100% 50%;
  }

  @media (max-width: 1259px) {
    /* Without half a window to spare, the scene is centred as a whole rather than
       cutting the states off the left edge. */
    .reach svg {
      transform: translateX(var(--reach-shift, 0px)) scale(var(--reach-scale, 1));
    }
  }

  .reach svg.is-grabbing {
    cursor: grabbing;
  }

  .reach__sphere {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.9;
    opacity: 0.15;
  }

  /* The hosts belong to the figure, not to its backdrop: they arrive with the pin. */
  .reach__hosts {
    opacity: var(--reach-hosts, 1);
  }

  .reach__shell path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.6;
  }

  /* The fork: three states of the same lattice, each the execution that follows the
     instant the read. They carry the accent because they are what the record
     becomes, and the parent's outline steps back so they are the figure. */
  .reach__branch circle,
  .reach__branch path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.7;
  }

  .reach__branch circle {
    stroke-width: 0.8;
  }

  /* Each state is a copy of the space, so the points where two reads meet have copies
     inside it. The threads mark the correspondence and the dots mark the copies. */
  .reach__thread {
    stroke: var(--fg);
    stroke-width: 0.3;
    stroke-dasharray: 2 4;
  }

  .reach__state-point {
    fill: var(--accent);
  }

  .reach__branch-name {
    font-family: var(--text);
    font-size: 8.5px;
    letter-spacing: 0.06em;
    text-anchor: middle;
    fill: var(--accent);
    /* A halo in the page colour keeps the label legible over its own wires. */
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .reach__branch-letter {
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .reach.is-forked .reach__sphere {
    opacity: 0.1;
  }

  .reach__volume {
    stroke: none;
  }

  /* One ring per host: the read is as many extents as there are entities. */
  .reach__extent {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.8;
    opacity: 0.14;
  }

  .reach__particle {
    fill: var(--fg);
    opacity: 0.42;
    transition: opacity 300ms var(--ease);
  }

  .reach__particle.is-read {
    opacity: 1;
  }

  .reach__join {
    opacity: 0;
    transition: opacity 420ms var(--ease);
  }

  .reach__join line {
    stroke: var(--fg);
    stroke-width: 0.55;
    opacity: 0.17;
  }

  .reach__join circle {
    fill: var(--fg);
  }

  .reach__join.is-joined {
    opacity: 1;
  }

  /* The marks are the host's identity, not a signal: once the host arrives they
     stay at full strength. */
  .reach__mark {
    opacity: 1;
  }

  .reach__mark-outline {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .reach__mark-inner {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  .reach__glyph,
  .reach__glyph * {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
    /* The glyphs are drawn at their own depth scale, so the stroke is held at the
       weight the sphere is drawn at. */
    vector-effect: non-scaling-stroke;
  }

  .reach__dot {
    fill: var(--fg);
    stroke: none;
  }

  .reach__label {
    font-family: var(--text);
    font-size: 7px;
    fill: var(--fg);
    opacity: calc(0.36 * var(--fade, 1) * var(--shown, 1));
    transition: opacity 300ms var(--ease);
  }

  .reach__label.is-read {
    opacity: calc(0.72 * var(--fade, 1) * var(--shown, 1));
  }

  .reach__label.is-active {
    opacity: calc(var(--fade, 1) * var(--shown, 1));
  }

  @media (max-width: 720px) {
    /* At phone scale the small names are specks; the icons and the caption carry it. */
    .reach__label {
      display: none;
    }
  }

  /* The explanation is the paragraph the figure was drawn for: it arrives as soon as
     the hosts do, and the reader has it while the read and the fork play out. */
  .reach__caption {
    max-width: 52rem;
    margin: 40px auto 0;
    padding-inline: clamp(16px, 4vw, 40px);
    font-size: clamp(15px, 0.5vw + 0.85rem, 18px);
    line-height: 1.6;
    color: var(--fg-2);
    text-align: left;
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 900ms var(--ease),
      transform 900ms var(--ease);
  }

  .reach.is-explained .reach__caption {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reach svg {
      transform: none;
    }

    .reach__particle,
    .reach__join,
    .reach__label,
    .reach__caption {
      transition: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const DEG = Math.PI / 180;

  const figure = document.querySelector<HTMLElement>('[data-reach]');
  const svg = figure?.querySelector<SVGSVGElement>('svg');
  const caption = figure?.querySelector<HTMLElement>('.reach__caption');
  const payloadEl = document.getElementById('reach-space');

  interface Vec3 extends Array<number> {
    0: number;
    1: number;
    2: number;
  }

  interface Ring {
    radius: number;
    kind: 'lon' | 'lat';
    value: number;
    offset: Vec3;
  }

  interface Group {
    opacity: number;
    rings: Ring[];
    offset?: Vec3;
  }

  interface Space {
    focal: number;
    dist: number;
    ox: number;
    oy: number;
    radius: number;
    tilt: number;
    yaw: number;
    limit: number;
    lift: number;
    shells: Group[];
    branches: Array<{
      name: string;
      angle: number;
      offset: Vec3;
      radius: number;
      rings: Ring[];
    }>;
    arcX: number;
    arcY: number;
    particles: Array<[number, number, number, number]>;
    nodes: Array<{
      id: string;
      p: Vec3;
      size: number;
      icon: boolean;
      label: string | null;
      side: string | null;
    }>;
    joins: Array<{ a: number; b: number }>;
    extents: Vec3[];
  }

  const space: Space = JSON.parse(payloadEl?.textContent ?? '{}');

  if (figure && svg && space.nodes) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    // The sphere's centre as a share of the SVG width. The scene is centred once the
    // promise has gone, so the whole sphere is visible at rest.
    const viewBox = svg.viewBox.baseVal;
    const sphereFraction = (space.ox - viewBox.x) / viewBox.width;

    // The sphere turns about its own axis, and a drag turns it faster.
    let yaw = space.yaw;
    let tilt = space.tilt;
    let progress = 0;
    // How far the space has forked, from none to three copies fully apart.
    let fork = 0;
    let dragging = false;
    let resumeAt = 0;
    let visible = true;
    let lastFrame = performance.now();
    // The scale the CSS transform currently applies, so the arc can be kept inside the
    // window without reading layout every frame.
    let visualScale = 1;

    const projectAt = (x: number, y: number, z: number, angle: number) => {
      const across = x * Math.cos(angle) - z * Math.sin(angle);
      const depthAxis = x * Math.sin(angle) + z * Math.cos(angle);
      const up = y * Math.cos(tilt) + depthAxis * Math.sin(tilt);
      const depth = space.dist + depthAxis * Math.cos(tilt) - y * Math.sin(tilt);
      const p = space.focal / depth;
      return { x: space.ox + across * p, y: space.oy - up * p, p, depth };
    };

    // One projection for the whole space. A composite state is carried by the same
    // lattice the sphere is, so it turns with the sphere instead of holding its frame.
    const project = (x: number, y: number, z: number) => projectAt(x, y, z, yaw);

    // A state stands on a shallow arc around the sphere, level with it: the offset is
    // solved in the camera frame so the three of them use the width and none of them
    // drops into the paragraph below.
    const orbitOffset = (angle: number, at: number, arcX: number): Vec3 => {
      const p = space.focal / space.dist;
      const across = (arcX * Math.cos(angle)) / p;
      const up = (space.arcY * Math.sin(angle)) / p;
      const depthAxis = up * Math.sin(tilt);
      const y = up * Math.cos(tilt);
      return [
        across * Math.cos(at) + depthAxis * Math.sin(at),
        y,
        -across * Math.sin(at) + depthAxis * Math.cos(at),
      ];
    };

    // Depth as a light level: the far side of the sphere is behind the field.
    const fadeOf = (p: number) => Math.min(1, Math.max(0.45, 0.45 + (p - 0.778) * 3.69));

    const ringPoint = (ring: Ring, angle: number): Vec3 => {
      const [ox, oy, oz] = ring.offset;
      if (ring.kind === 'lon') {
        const lon = ring.value * DEG;
        return [
          ox + ring.radius * Math.sin(angle) * Math.cos(lon),
          oy + ring.radius * Math.cos(angle),
          oz + ring.radius * Math.sin(angle) * Math.sin(lon),
        ];
      }
      const lat = ring.value * DEG;
      const r = ring.radius * Math.cos(lat);
      const h = ring.radius * Math.sin(lat);
      return [ox + r * Math.cos(angle), oy + h, oz + r * Math.sin(angle)];
    };

    const pathOf = (points: Vec3[], projection = project) => {
      let d = '';
      for (let index = 0; index < points.length; index += 1) {
        const at = projection(points[index][0], points[index][1], points[index][2]);
        d += `${index === 0 ? 'M' : 'L'}${at.x.toFixed(1)} ${at.y.toFixed(1)}`;
      }
      return `${d}Z`;
    };

    const groupEls = Array.from(svg.querySelectorAll<SVGGElement>('[data-group]')).map(
      (element, index) => {
        const group = space.shells[index] as Group | undefined;
        const rings = (group?.rings ?? []).map((ring) =>
          Array.from({ length: 49 }, (_, step) => ringPoint(ring, (step / 48) * Math.PI * 2)),
        );
        return {
          element,
          rings,
          paths: Array.from(element.querySelectorAll<SVGPathElement>('path')),
          circle: element.querySelector<SVGCircleElement>('circle'),
          offset: group?.offset ?? null,
        };
      },
    );

    // The branch rings are held around the branch's own centre, so the spread is one
    // number per frame and the lattice keeps its shape as it travels.
    const branchEls = Array.from(svg.querySelectorAll<SVGGElement>('[data-branch]')).map(
      (element) => {
        const branch = space.branches[Number(element.dataset.branch ?? 0)];
        const [ox, oy, oz] = branch.offset;
        return {
          element,
          angle: branch.angle,
          radius: branch.radius,
          rings: branch.rings.map((ring) =>
            Array.from({ length: 49 }, (_, step) => {
              const point = ringPoint(ring, (step / 48) * Math.PI * 2);
              return [point[0] - ox, point[1] - oy, point[2] - oz] as Vec3;
            }),
          ),
          paths: Array.from(element.querySelectorAll<SVGPathElement>('path')),
          circle: element.querySelector<SVGCircleElement>('circle'),
          label: element.querySelector<SVGTextElement>('text'),
          letter: element.querySelector<SVGTextElement>('.reach__branch-letter'),
        };
      },
    );

    const nodeEls = Array.from(svg.querySelectorAll<SVGGElement>('.reach__node'));
    // The fork groups are layered against this circle, so the near state covers the far one.
    const sphereEl = svg.querySelector<SVGCircleElement>('.reach__sphere');
    const particleEls = Array.from(svg.querySelectorAll<SVGCircleElement>('[data-particle]'));
    const extentEls = Array.from(svg.querySelectorAll<SVGCircleElement>('[data-extent]'));
    const threadEls = Array.from(svg.querySelectorAll<SVGLineElement>('.reach__thread'));
    const statePointEls = Array.from(
      svg.querySelectorAll<SVGCircleElement>('.reach__state-point'),
    );
    // The midpoint of each join is the point the threads leave from.
    const joinPoints: Vec3[] = space.joins.map((join) => {
      const a = space.nodes[join.a].p;
      const b = space.nodes[join.b].p;
      return [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2, (a[2] + b[2]) / 2];
    });
    const joinEls = Array.from(svg.querySelectorAll<SVGGElement>('[data-join]')).map((element) => ({
      element,
      line: element.querySelector('line') as SVGLineElement,
      dot: element.querySelector('circle') as SVGCircleElement,
      read: Number(element.dataset.read ?? 1),
    }));
    const labels = Array.from(svg.querySelectorAll<SVGTextElement>('[data-label]'));
    const marks = Array.from(svg.querySelectorAll<SVGGElement>('[data-mark]'));

    const markById = new Map(marks.map((mark) => [mark.dataset.mark ?? '', mark]));
    const labelById = new Map(labels.map((label) => [label.dataset.label ?? '', label]));
    const fades = new Map<string, number>();

    // Label widths do not change with the turn, so they are measured once.
    const widths = new Map<string, number>();
    const measure = () => {
      labels.forEach((label) => {
        widths.set(label.dataset.label ?? '', label.getComputedTextLength());
      });
    };
    measure();
    document.fonts?.ready.then(measure).catch(() => {});

    const overlaps = (
      a: { x1: number; x2: number; y1: number; y2: number },
      b: { x1: number; x2: number; y1: number; y2: number },
    ) => a.x1 < b.x2 && b.x1 < a.x2 && a.y1 < b.y2 && b.y1 < a.y2;

    const labelBox = (
      x: number,
      y: number,
      anchor: string | null,
      width: number,
    ) => {
      const x1 = anchor === 'start' ? x : anchor === 'end' ? x - width : x - width / 2;
      return { x1, x2: x1 + width, y1: y - 6.5, y2: y + 2 };
    };

    const render = () => {
      const frame = svg.viewBox.baseVal;
      // The arc shrinks on a narrow window, so all three states stay in view.
      const pxPerUnit = (svg.clientWidth / viewBox.width) * visualScale;
      const room =
        (document.documentElement.clientWidth / 2 - 16) / pxPerUnit -
        (space.branches[0]?.radius ?? 0);
      const arcX = Math.min(space.arcX, room);
      // The states ride the turn: their arc is behind the sphere by the same angle the
      // sphere has turned, so they come round it like satellites.
      const drift = (yaw - space.yaw) * 0.55;

      for (const group of groupEls) {
        group.paths.forEach((path, index) => {
          const points = group.rings[index];
          if (points) path.setAttribute('d', pathOf(points));
        });
        if (group.circle && group.offset) {
          const centre = project(group.offset[0], group.offset[1], group.offset[2]);
          group.circle.setAttribute('cx', centre.x.toFixed(1));
          group.circle.setAttribute('cy', centre.y.toFixed(1));
        }
      }

      space.particles.forEach((point, index) => {
        const element = particleEls[index];
        if (!element) return;
        const at = project(point[0], point[1], point[2]);
        element.setAttribute('cx', at.x.toFixed(1));
        element.setAttribute('cy', at.y.toFixed(1));
        element.setAttribute(
          'fill-opacity',
          Math.min(0.58, Math.max(0.14, 0.16 + (at.p - 0.76) * 2.1)).toFixed(2),
        );
      });

      // The glyphs first, so the labels know what they have to clear.
      const placed = space.nodes.map((node, index) => {
        const element = nodeEls[index];
        const [x, y, z] = node.p;
        const at = project(x, y, z);
        const outX = at.x - space.ox;
        const outY = at.y - space.oy;
        const outLength = Math.hypot(outX, outY) || 1;
        const lift = node.icon ? space.lift : 0;
        const liftedX = at.x + (outX / outLength) * lift;
        const glyphX = node.icon
          ? Math.min(frame.x + frame.width - 26, Math.max(frame.x + 26, liftedX))
          : liftedX;
        const glyphY = at.y + (outY / outLength) * lift;
        const scale = at.p * node.size;

        element?.setAttribute(
          'transform',
          `translate(${glyphX.toFixed(1)} ${glyphY.toFixed(1)}) scale(${scale.toFixed(3)})`,
        );

        const fade = Math.round(fadeOf(at.p) * 20) / 20;
        if (fades.get(node.id) !== fade) {
          fades.set(node.id, fade);
          if (element) element.style.opacity = String(fade);
          labelById.get(node.id)?.style.setProperty('--fade', String(fade));
        }

        markById
          .get(node.id)
          ?.setAttribute(
            'transform',
            `translate(${at.x.toFixed(1)} ${at.y.toFixed(1)}) scale(${(at.p * 1.2).toFixed(2)})`,
          );

        return {
          node,
          depth: at.p,
          glyphX,
          glyphY,
          glyphBox: node.icon
            ? {
                x1: glyphX - 30 * Math.abs(scale),
                x2: glyphX + 30 * Math.abs(scale),
                y1: glyphY - 38 * Math.abs(scale),
                y2: glyphY + 24 * Math.abs(scale),
              }
            : null,
        };
      });

      // Labels take the space they fit into, nearest first, and step aside when the
      // turn brings them onto another host or another name.
      const taken: Array<{ x1: number; x2: number; y1: number; y2: number }> = placed
        .map((entry) => entry.glyphBox)
        .filter((box): box is NonNullable<typeof box> => box !== null);

      // A forked state is an obstacle too, once it has separated from the sphere.
      space.branches.forEach((branch) => {
        const [ox, oy, oz] = orbitOffset(branch.angle + drift, yaw, arcX);
        const centre = project(ox * fork, oy * fork, oz * fork);
        // Before the states separate they sit at the centre, so only the part that has
        // moved out is an obstacle.
        const radius = branch.radius * centre.p * 1.04 * fork;
        taken.push({
          x1: centre.x - radius,
          x2: centre.x + radius,
          y1: centre.y - radius,
          y2: centre.y + radius,
        });
      });

      [...placed]
        .sort((a, b) => b.depth - a.depth)
        .forEach(({ node, glyphX, glyphY }) => {
          const label = labelById.get(node.id);
          if (!label) return;
          const anchor = label.getAttribute('text-anchor');
          const width = widths.get(node.id) ?? 60;
          const offset = 20;
          let x = glyphX + offset;
          let y = glyphY + 2;
          if (node.side === 'left') x = glyphX - offset;
          if (node.side === 'above') {
            x = glyphX;
            y = glyphY - 15;
          }
          if (node.side === 'below') {
            x = glyphX;
            y = glyphY + 22;
          }
          y = Math.min(frame.y + frame.height - 6, Math.max(frame.y + 16, y));
          const box = labelBox(x, y, anchor, width);
          // A name that would leave the frame is carried back inside it, so a turn
          // never cuts one off.
          let shift = 0;
          if (box.x1 < frame.x + 6) shift = frame.x + 6 - box.x1;
          if (box.x2 + shift > frame.x + frame.width - 6) {
            shift = frame.x + frame.width - 6 - box.x2;
          }
          x += shift;
          box.x1 += shift;
          box.x2 += shift;
          label.setAttribute('x', x.toFixed(1));
          label.setAttribute('y', y.toFixed(1));

          const blocked = taken.some((other) => overlaps(box, other));
          label.style.setProperty('--shown', blocked ? '0' : '1');
          if (!blocked) taken.push(box);
        });

      // A state that comes round the near side is painted over the one behind it, so a
      // crossing reads as depth and not as two lattices fused into one.
      const layered: Array<{ element: SVGGElement; depth: number }> = [];
      branchEls.forEach((branch) => {
        const [ox, oy, oz] = orbitOffset(branch.angle + drift, yaw, arcX);
        const spread = fork;
        const centre = project(ox * spread, oy * spread, oz * spread);
        layered.push({ element: branch.element, depth: centre.p });

        branch.paths.forEach((path, index) => {
          const points = branch.rings[index];
          if (!points) return;
          path.setAttribute(
            'd',
            pathOf(
              points.map(
                ([x, y, z]) => [x + ox * spread, y + oy * spread, z + oz * spread] as Vec3,
              ),
              project,
            ),
          );
        });

        branch.circle?.setAttribute('cx', centre.x.toFixed(1));
        branch.circle?.setAttribute('cy', centre.y.toFixed(1));
        branch.circle?.setAttribute('r', (branch.radius * centre.p * 1.04).toFixed(1));

        branch.label?.setAttribute('x', centre.x.toFixed(1));
        branch.label?.setAttribute('y', (centre.y - 1).toFixed(1));
        branch.letter?.setAttribute('x', centre.x.toFixed(1));
        branch.letter?.setAttribute('y', (centre.y + 11).toFixed(1));
      });

      // Each state holds its own combination of the points where two reads meet. The
      // thread runs from that point in the sphere to its copy inside the state, and the
      // dot marks the copy.
      threadEls.forEach((thread, index) => {
        const branch = branchEls[Number(thread.dataset.state ?? 0)];
        if (!branch) return;
        const point = joinPoints[Number(thread.dataset.point ?? 0)];
        if (!point) return;
        const [ox, oy, oz] = orbitOffset(branch.angle + drift, yaw, arcX);
        const k = branch.radius / space.radius;
        const start = project(point[0], point[1], point[2]);
        const at = project(
          ox * fork + point[0] * k,
          oy * fork + point[1] * k,
          oz * fork + point[2] * k,
        );
        thread.setAttribute('x1', start.x.toFixed(1));
        thread.setAttribute('y1', start.y.toFixed(1));
        thread.setAttribute('x2', at.x.toFixed(1));
        thread.setAttribute('y2', at.y.toFixed(1));
        thread.setAttribute('opacity', (fork * 0.8).toFixed(3));
        const dot = statePointEls[index];
        if (dot) {
          dot.setAttribute('cx', at.x.toFixed(1));
          dot.setAttribute('cy', at.y.toFixed(1));
          dot.setAttribute('opacity', (fork * 0.9).toFixed(3));
        }
      });

      if (sphereEl) {
        layered.sort((a, b) => a.depth - b.depth);
        const order = layered.map(({ element }) => element.dataset.branch).join(',');
        // Only touch the tree when the order actually changes, so the turn stays cheap.
        if (order !== branchOrder) {
          branchOrder = order;
          layered.forEach(({ element }) => svg.insertBefore(element, sphereEl));
        }
      }

      space.extents.forEach((port, index) => {
        const element = extentEls[index];
        if (!element) return;
        const at = project(port[0], port[1], port[2]);
        element.setAttribute('cx', at.x.toFixed(1));
        element.setAttribute('cy', at.y.toFixed(1));
        element.setAttribute('r', (progress * space.limit * at.p).toFixed(1));
      });

      space.joins.forEach((join, index) => {
        const element = joinEls[index];
        if (!element) return;
        const from = space.nodes[join.a].p;
        const to = space.nodes[join.b].p;
        const start = project(from[0], from[1], from[2]);
        const end = project(to[0], to[1], to[2]);
        element.line.setAttribute('x1', start.x.toFixed(1));
        element.line.setAttribute('y1', start.y.toFixed(1));
        element.line.setAttribute('x2', end.x.toFixed(1));
        element.line.setAttribute('y2', end.y.toFixed(1));
        const mid = project(
          (from[0] + to[0]) / 2,
          (from[1] + to[1]) / 2,
          (from[2] + to[2]) / 2,
        );
        element.dot.setAttribute('cx', mid.x.toFixed(1));
        element.dot.setAttribute('cy', mid.y.toFixed(1));
      });
    };

    let lit = 0;
    let branchOrder = '';
    const thresholds = particleEls.map((particle) => Number(particle.dataset.threshold ?? 0));

    // The read is the first share of the scroll and the fork the rest of it, so the
    // reader sees the joins close before the space divides.
    const READ_SHARE = 0.48;
    // The split completes with time to spare, so the reader can look at the three
    // executions and then read the paragraph rather than reaching them as the figure
    // leaves.
    const FORK_SHARE = 0.34;
    // At rest the sphere is a little smaller than its dome and sits below the masthead,
    // so the whole sphere is visible with air above it and the paragraph below.
    const PIN_SCALE = 0.92;
    // The pinned block is nudged down from the exact centre, so the air above the sphere
    // is a little greater than the air under the paragraph.
    const BLOCK_BIAS = 36;
    // The opening dome is offset right, but only by this much on a very wide screen.
    const INITIAL_OFFSET = 180;

    const paint = (value: number) => {
      const whole = Math.min(1, Math.max(0, value));
      progress = Math.min(1, whole / READ_SHARE);
      const split = Math.min(1, Math.max(0, (whole - READ_SHARE) / FORK_SHARE));
      fork = split * split * (3 - 2 * split);

      // The particles are sorted by the progress at which a read reaches them, so
      // only the ones that just crossed are touched.
      let cut = 0;
      while (cut < thresholds.length && thresholds[cut] <= progress) cut += 1;
      if (cut !== lit) {
        const from = Math.min(lit, cut);
        const to = Math.max(lit, cut);
        for (let index = from; index < to; index += 1) {
          particleEls[index]?.classList.toggle('is-read', index < cut);
        }
        lit = cut;
      }

      joinEls.forEach((join) => {
        join.element.classList.toggle('is-joined', progress >= join.read);
      });

      const state = (element: SVGElement) => {
        const read = Number(element.dataset.read ?? 1);
        return { passed: progress >= read, justNow: Math.abs(progress - read) < 0.04 };
      };
      labels.forEach((label) => {
        const { passed, justNow } = state(label);
        label.classList.toggle('is-read', passed);
        label.classList.toggle('is-active', justNow);
      });

      // The copies arrive with the split and the parent steps behind them.
      branchEls.forEach((branch) => {
        branch.element.setAttribute('style', `opacity: ${(fork * 0.68).toFixed(3)}`);
        // The name arrives once the state has separated, so it never reads over the
        // sphere it just left.
        branch.label?.setAttribute(
          'opacity',
          (Math.max(0, Math.min(1, (fork - 0.55) / 0.35)) * 0.95).toFixed(2),
        );
      });
      figure.classList.toggle('is-forked', fork > 0.02);
      // The paragraph arrives with the hosts, so it explains the space while the read
      // and the fork play out rather than after them.
      figure.classList.toggle('is-explained', whole >= 0.12);

      render();
    };

    // The figure starts larger than its pinned size and settles as the pin arrives, so
    // the top of the sphere stands behind the promise before the section begins.
    const documentTop = (element: HTMLElement) => {
      let top = 0;
      let current: HTMLElement | null = element;
      while (current) {
        top += current.offsetTop;
        current = current.offsetParent as HTMLElement | null;
      }
      return top;
    };
    let approachEnd = Math.max(1, documentTop(figure) - 8);
    let lastScale = 0;
    let lastShift = 0;
    const measureApproach = () => {
      approachEnd = Math.max(1, documentTop(figure) - 8);
    };
    addEventListener('resize', measureApproach, { passive: true });

    // The turn runs while the figure is on screen, and rests while a reader holds it.
    const step = (now: number) => {
      const delta = Math.min(0.05, (now - lastFrame) / 1000);
      lastFrame = now;
      const approach = Math.min(1, Math.max(0, window.scrollY / approachEnd));
      const scale = 1.4 - (1.4 - PIN_SCALE) * approach;
      visualScale = scale;
      if (Math.abs(scale - lastScale) > 0.001) {
        lastScale = scale;
        svg.style.setProperty('--reach-scale', scale.toFixed(3));
        svg.style.setProperty('--reach-hosts', approach.toFixed(3));
      }
      // The sphere moves from the right edge to the centre as it shrinks, so the frame
      // lands centred whichever width the window has.
      const viewport = document.documentElement.clientWidth;
      const baseCenter = viewport - (1 - sphereFraction) * svg.clientWidth * scale;
      const firstBase = viewport - (1 - sphereFraction) * svg.clientWidth * 1.4;
      const firstTarget = Math.min(firstBase, viewport / 2 + INITIAL_OFFSET);
      const target = firstTarget + (viewport / 2 - firstTarget) * approach;
      const shift = target - baseCenter;
      if (Math.abs(shift - lastShift) > 0.5) {
        lastShift = shift;
        svg.style.setProperty('--reach-shift', `${shift.toFixed(1)}px`);
      }

      if (visible && !dragging && !reduce.matches && now > resumeAt) {
        yaw += delta * 0.11;
        render();
      }
      requestAnimationFrame(step);
    };

    let dragX = 0;
    svg.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      dragging = true;
      dragX = event.clientX;
      resumeAt = Number.POSITIVE_INFINITY;
      svg.setPointerCapture(event.pointerId);
      svg.classList.add('is-grabbing');
    });

    svg.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      const delta = event.clientX - dragX;
      dragX = event.clientX;
      yaw += delta * 0.008;
      render();
    });

    const release = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      resumeAt = performance.now() + 1800;
      svg.classList.remove('is-grabbing');
      if (svg.hasPointerCapture(event.pointerId)) svg.releasePointerCapture(event.pointerId);
    };

    svg.addEventListener('pointerup', release);
    svg.addEventListener('pointercancel', release);

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        lastFrame = performance.now();
      },
      { rootMargin: '120px' },
    ).observe(figure);

    // The page backdrop waits until the figure has left the viewport. The hero sits
    // above the figure, and its field is fixed, so an earlier arrival would draw the
    // hexagon over the globe while the figure is still leaving.
    const settle = (done: boolean) => {
      if (done) document.documentElement.dataset.reachDone = 'true';
      else delete document.documentElement.dataset.reachDone;
    };
    new IntersectionObserver(([entry]) => {
      settle(entry.boundingClientRect.bottom <= 0);
    }).observe(figure);

    // The pinned block is the drawing and its paragraph, and its top is set so the two
    // sit centred in the window with the bias above, at every size.
    const pinStart = () => {
      const height = svg.clientHeight;
      const paragraph = caption?.offsetHeight ?? 0;
      const gap = caption
        ? Number.parseFloat(getComputedStyle(caption).marginTop) || 0
        : 0;
      const inset = ((1 - PIN_SCALE) * height) / 2;
      const margin = (document.documentElement.clientHeight - (height + gap + paragraph - inset)) / 2;
      return `top ${Math.max(8, Math.round(margin - inset + BLOCK_BIAS))}px`;
    };

    if (reduce.matches) {
      // The whole story: the read closed and the space divided.
      paint(1);
    } else {
      // Pinned for both acts: the read closes, then the space divides.
      ScrollTrigger.create({
        trigger: figure,
        start: pinStart,
        // Long enough for both acts and for the paragraph that follows them.
        end: '+=2000',
        pin: true,
        onUpdate: (self) => paint(self.progress),
        onRefresh: (self) => paint(self.progress),
      });
      requestAnimationFrame(step);
    }
  }
</script>
