---
/*
  The engine's reach: one sphere of records and the hosts that sit on it.

  There is no centre to the deployment. An entity carries the engine and reads the
  sphere from the coordinate it is attached to, so every host is drawn on the
  surface, not orbiting it. The interior is the space of coordinates that could
  exist, and the lattice is repeated as parallel shells because the same space holds
  every instance at once. Each host opens a scanner from its own port, and two hosts
  are joined where their scans meet.
*/

const DEG = Math.PI / 180;
const round = (value: number) => Math.round(value * 10) / 10;

const TILT = 42 * DEG;
const SIN_T = Math.sin(TILT);
const COS_T = Math.cos(TILT);
const YAW = 24 * DEG;
const SIN_Y = Math.sin(YAW);
const COS_Y = Math.cos(YAW);
const FOCAL = 2200;
const DIST = 2600;

const VIEW_W = 720;
const VIEW_H = 456;
const OX = VIEW_W / 2;
const OY = 224;

// x runs right, y up, z toward the reader. The camera yaws around y and then looks
// down by the tilt, so the sphere has depth on both sides of every axis.
const project = (x: number, y: number, z: number) => {
  const across = x * COS_Y - z * SIN_Y;
  const depthAxis = x * SIN_Y + z * COS_Y;
  const up = y * COS_T + depthAxis * SIN_T;
  const depth = DIST + depthAxis * COS_T - y * SIN_T;
  const p = FOCAL / depth;
  return { x: OX + across * p, y: OY - up * p, p, depth };
};

const RADIUS = 228;

const ORIGIN = project(0, 0, 0);
// A sphere projects to a circle slightly larger than its radius times the depth
// scale: the silhouette is the tangent, not the centre plane.
const SILHOUETTE = (RADIUS * FOCAL) / Math.sqrt(DIST * DIST - RADIUS * RADIUS);

const asPoints = (corners: number[][]) =>
  corners.map(([u, h]) => `${round(u)},${round(h)}`).join(' ');

const flatHex = (radius: number) => {
  const shoulder = (radius * Math.sqrt(3)) / 2;
  return [
    [0, radius],
    [shoulder, radius / 2],
    [shoulder, -radius / 2],
    [0, -radius],
    [-shoulder, -radius / 2],
    [-shoulder, radius / 2],
  ];
};

const length3 = (v: [number, number, number]) => Math.hypot(v[0], v[1], v[2]) || 1;

// A coordinate on the surface, given as longitude and latitude.
const onSphere = (lonDeg: number, latDeg: number): [number, number, number] => {
  const lon = lonDeg * DEG;
  const lat = latDeg * DEG;
  return [
    RADIUS * Math.cos(lat) * Math.cos(lon),
    RADIUS * Math.sin(lat),
    RADIUS * Math.cos(lat) * Math.sin(lon),
  ];
};

// The mark is the favicon stamped on the coordinate the host reads. It faces the
// reader, because a hexagon in the port's tangent plane collapses to a sliver
// wherever the port sits on the limb of the sphere.
const markAt = (at: { x: number; y: number; p: number }) => {
  const radius = 6 * at.p * 1.2;
  return {
    x: round(at.x),
    y: round(at.y),
    outline: asPoints(flatHex(radius)),
    inner: asPoints(
      [0, 90, 180, 270].map((step) => {
        const angle = step * DEG;
        return [radius * 0.41 * Math.cos(angle), radius * 0.41 * Math.sin(angle)];
      }),
    ),
  };
};

type Icon =
  | 'robot'
  | 'drone'
  | 'laptop'
  | 'monitor'
  | 'rack'
  | 'space'
  | 'vehicle'
  | 'meter'
  | 'camera'
  | 'gateway'
  | 'wearable'
  | 'plc';

interface Seed {
  id: string;
  lon: number;
  lat: number;
  icon?: Icon;
  glyph?: 'dot';
  halo: number;
  size: number;
  label?: string;
  side?: 'left' | 'right' | 'above' | 'below';
}

// Twelve hosts on the surface carry the examples. The peers below carry none,
// because they stand for every other field the same space can hold.
const seeds: Seed[] = [
  { id: 'space', lon: 8, lat: 30, icon: 'space', halo: 30, size: 0.5, label: 'Space system', side: 'right' },
  { id: 'meter', lon: 38, lat: -30, icon: 'meter', halo: 30, size: 0.5, label: 'Smart meter', side: 'below' },
  { id: 'camera', lon: 68, lat: 30, icon: 'camera', halo: 30, size: 0.5, label: 'Vision camera', side: 'right' },
  { id: 'plc', lon: 98, lat: -30, icon: 'plc', halo: 30, size: 0.5, label: 'Factory PLC', side: 'right' },
  { id: 'laptop', lon: 128, lat: 30, icon: 'laptop', halo: 30, size: 0.5, label: 'Laptop and mobile', side: 'left' },
  { id: 'drone', lon: 158, lat: -30, icon: 'drone', halo: 30, size: 0.5, label: 'MCU drone', side: 'left' },
  { id: 'robot', lon: 188, lat: 30, icon: 'robot', halo: 30, size: 0.5, label: 'ROS robot', side: 'left' },
  { id: 'medical', lon: 218, lat: -30, icon: 'monitor', halo: 30, size: 0.5, label: 'Medical device', side: 'left' },
  { id: 'wearable', lon: 248, lat: 30, icon: 'wearable', halo: 30, size: 0.5, label: 'Wearable', side: 'right' },
  { id: 'vehicle', lon: 278, lat: -30, icon: 'vehicle', halo: 30, size: 0.5, label: 'Vehicle ECU', side: 'right' },
  { id: 'rack', lon: 308, lat: 30, icon: 'rack', halo: 30, size: 0.5, label: 'Data center', side: 'right' },
  { id: 'gateway', lon: 338, lat: -30, icon: 'gateway', halo: 30, size: 0.5, label: 'Edge gateway', side: 'right' },

  // A mesh of near peers and a group read through one of its members: the same
  // space sustains both topologies at once.
  { id: 'p1', lon: 20, lat: -6, glyph: 'dot', halo: 3, size: 1.6 },
  { id: 'p2', lon: 44, lat: 8, glyph: 'dot', halo: 3, size: 1.4 },
  { id: 'p3', lon: 60, lat: -14, glyph: 'dot', halo: 3, size: 1.5 },
  { id: 'p4', lon: 200, lat: -8, glyph: 'dot', halo: 3, size: 1.6 },
  { id: 'p5', lon: 224, lat: 6, glyph: 'dot', halo: 3, size: 1.4 },
  { id: 'p6', lon: 236, lat: -16, glyph: 'dot', halo: 3, size: 1.4 },
  { id: 'p7', lon: 320, lat: 10, glyph: 'dot', halo: 3, size: 1.3 },
];

const labelOffset = 34;

const nodes = seeds.map((seed) => {
  const position = onSphere(seed.lon, seed.lat);
  const at = project(...position);
  // The glyph is pushed off the surface along the silhouette, so the host sits on
  // its coordinate instead of covering it.
  const outX = at.x - ORIGIN.x;
  const outY = at.y - ORIGIN.y;
  const outLength = Math.hypot(outX, outY) || 1;
  const lift = seed.glyph ? 0 : 21;
  const glyphAt = { x: at.x + (outX / outLength) * lift, y: at.y + (outY / outLength) * lift };
  const far = at.depth > DIST;
  return {
    ...seed,
    position,
    at,
    far,
    fade: far ? 0.62 : 1,
    mark: markAt(at),
    labelPos: seed.label
      ? seed.side === 'left'
        ? { x: glyphAt.x - labelOffset, y: glyphAt.y + 4, anchor: 'end' }
        : seed.side === 'above'
          ? { x: glyphAt.x, y: glyphAt.y - 26, anchor: 'middle' }
          : seed.side === 'below'
            ? { x: glyphAt.x, y: glyphAt.y + 38, anchor: 'middle' }
            : { x: glyphAt.x + labelOffset, y: glyphAt.y + 4, anchor: 'start' }
      : null,
    transform: `translate(${round(glyphAt.x)} ${round(glyphAt.y)}) scale(${round(at.p * seed.size * 1000) / 1000})`,
  };
});

const direct = nodes.filter((node) => node.icon);
const peers = nodes.filter((node) => node.glyph === 'dot');
const ports = direct.map((node) => node.position);

// Every pair of ports within a coincidence radius meets when the two scans have
// grown to half their distance apart. The join is drawn at that coordinate pair.
const COINCIDENCE = RADIUS * 1.2;
const pairs: Array<[number, number]> = [];
for (let a = 0; a < direct.length; a += 1) {
  for (let b = a + 1; b < direct.length; b += 1) {
    const from = direct[a].position;
    const to = direct[b].position;
    if (length3([to[0] - from[0], to[1] - from[1], to[2] - from[2]]) <= COINCIDENCE) {
      pairs.push([a, b]);
    }
  }
}

const segments = pairs.map(([a, b]) => {
  const from = direct[a].position;
  const to = direct[b].position;
  return {
    from,
    to,
    a: direct[a].id,
    b: direct[b].id,
    distance: length3([to[0] - from[0], to[1] - from[1], to[2] - from[2]]),
  };
});

// The interior: coordinates that could exist, denser toward the surface and each
// with the depth it sits at. The seed is fixed, so the field is the same on every
// build.
const seeded = (seed: number) => {
  let state = seed;
  return () => {
    state = (state * 1664525 + 1013904223) % 4294967296;
    return state / 4294967296;
  };
};

const random = seeded(31);

const field = Array.from({ length: 320 }, () => {
  const theta = random() * Math.PI * 2;
  const phi = Math.acos(2 * random() - 1);
  const radius = Math.pow(random(), 0.5) * RADIUS;
  const point: [number, number, number] = [
    radius * Math.sin(phi) * Math.cos(theta),
    radius * Math.cos(phi),
    radius * Math.sin(phi) * Math.sin(theta),
  ];
  const at = project(...point);
  // A point belongs to the scan that reaches it first.
  const nearest = Math.min(
    ...ports.map((port) =>
      Math.hypot(point[0] - port[0], point[1] - port[1], point[2] - port[2]),
    ),
  );
  return {
    at,
    nearest,
    r: round(0.4 + Math.pow(random(), 2.2) * 2),
    depth: round(Math.min(0.58, Math.max(0.14, 0.16 + (at.p - 0.76) * 2.1))),
  };
}).sort((a, b) => a.nearest - b.nearest);

// The scan has to reach the farthest coordinate any host reads, or the field would
// stay dark where no ring ever arrives.
const reachLimit =
  Math.max(
    ...segments.map((segment) => segment.distance / 2),
    ...field.map((point) => point.nearest),
  ) * 1.02;

const joins = segments.map(({ from, to, a, b, distance }) => {
  const start = project(...from);
  const end = project(...to);
  const mid = project((from[0] + to[0]) / 2, (from[1] + to[1]) / 2, (from[2] + to[2]) / 2);
  return {
    a,
    b,
    x1: round(start.x),
    y1: round(start.y),
    x2: round(end.x),
    y2: round(end.y),
    midX: round(mid.x),
    midY: round(mid.y),
    threshold: round((distance / 2 / reachLimit) * 1000) / 1000,
  };
});

const particles = field.map((particle) => ({
  cx: round(particle.at.x),
  cy: round(particle.at.y),
  r: particle.r,
  depth: particle.depth,
  threshold: round(Math.min(1, particle.nearest / reachLimit) * 1000) / 1000,
}));

// The first join a host takes part in is the moment its own coordinate becomes a
// shared one, so that is when its name is read.
const joinThreshold = new Map<string, number>();
for (const join of joins) {
  for (const id of [join.a, join.b]) {
    const current = joinThreshold.get(id);
    if (current === undefined || join.threshold < current) {
      joinThreshold.set(id, join.threshold);
    }
  }
}

const screenOf = (id: string) => nodes.find((node) => node.id === id)?.at ?? null;
const links: Array<{ x1: number; y1: number; x2: number; y2: number }> = [];
const link = (
  from: { x: number; y: number } | null,
  to: { x: number; y: number } | null,
) => {
  if (!from || !to) return;
  links.push({ x1: round(from.x), y1: round(from.y), x2: round(to.x), y2: round(to.y) });
};
link(screenOf('p1'), screenOf('p2'));
link(screenOf('p2'), screenOf('p3'));
link(screenOf('p3'), screenOf('p1'));
link(screenOf('p4'), screenOf('p5'));
link(screenOf('p4'), screenOf('p6'));

const space = {
  focal: FOCAL,
  sin: SIN_T,
  cos: COS_T,
  sinY: SIN_Y,
  cosY: COS_Y,
  dist: DIST,
  ox: OX,
  oy: OY,
  limit: round(reachLimit),
};

const sphere = ORIGIN;
const silhouette = round(SILHOUETTE);

// The lattice is repeated at three radii: the same space held in parallel, so the
// sphere reads as a volume rather than a shell.
const ring = (
  count: number,
  offset: [number, number, number],
  at: (angle: number) => [number, number, number],
) =>
  Array.from({ length: count + 1 }, (_, index) => {
    const point = at((index / count) * Math.PI * 2);
    return project(point[0] + offset[0], point[1] + offset[1], point[2] + offset[2]);
  });

const pathOf = (points: Array<{ x: number; y: number }>) =>
  `${points.map((point, index) => `${index === 0 ? 'M' : 'L'}${round(point.x)} ${round(point.y)}`).join(' ')} Z`;

const latticeAt = (radius: number, phase: number, offset: [number, number, number] = [0, 0, 0]) => {
  const meridians = [0, 60, 120].map((degrees) => {
    const lon = (degrees + phase) * DEG;
    return pathOf(
      ring(64, offset, (angle) => [
        radius * Math.sin(angle) * Math.cos(lon),
        radius * Math.cos(angle),
        radius * Math.sin(angle) * Math.sin(lon),
      ]),
    );
  });
  const parallels = [-60, -30, 0, 30, 60].map((degrees) => {
    const lat = degrees * DEG;
    const r = radius * Math.cos(lat);
    const h = radius * Math.sin(lat);
    return pathOf(ring(64, offset, (angle) => [r * Math.cos(angle), h, r * Math.sin(angle)]));
  });
  return [...meridians, ...parallels];
};

// Two shells of the same lattice for the volume, and three copies of the sphere
// displaced along a time axis: the record is replayable, so one instant is held in
// several time dimensions at once and the copies trail behind it.
const shells = [
  { opacity: 0.085, paths: latticeAt(RADIUS, 0) },
  { opacity: 0.05, paths: latticeAt(RADIUS * 0.88, 22) },
];

// A copy carries the outline and three rings, enough to read as the same sphere
// without doubling the weight of the lattice.
const echoOf = (offset: [number, number, number]) => {
  const equator = pathOf(
    ring(64, offset, (angle) => [RADIUS * Math.cos(angle), 0, RADIUS * Math.sin(angle)]),
  );
  const meridians = [0, 90].map((degrees) => {
    const lon = degrees * DEG;
    return pathOf(
      ring(64, offset, (angle) => [
        RADIUS * Math.sin(angle) * Math.cos(lon),
        RADIUS * Math.cos(angle),
        RADIUS * Math.sin(angle) * Math.sin(lon),
      ]),
    );
  });
  return [equator, ...meridians];
};

const TIME_STEP: [number, number, number] = [22, -22, 0];
const echoes = [1, 2, 3].map((step) => {
  const offset: [number, number, number] = [
    TIME_STEP[0] * step,
    TIME_STEP[1] * step,
    TIME_STEP[2] * step,
  ];
  const centre = project(offset[0], offset[1], offset[2]);
  return {
    opacity: 0.055 - step * 0.013,
    x: round(centre.x),
    y: round(centre.y),
    paths: echoOf(offset),
  };
});
---

<figure class="reach" data-reach data-space={JSON.stringify(space)}>
  <svg viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} role="img" aria-labelledby="reach-title">
    <title id="reach-title"
      >Hosts attached to one sphere of records: the copies behind the sphere are the
      same instant held in parallel, every host reads the sphere from its own
      coordinate, and two hosts are joined where their scans meet</title
    >

    <defs>
      <clipPath id="reach-sphere">
        <circle cx={round(sphere.x)} cy={round(sphere.y)} r={silhouette} />
      </clipPath>
      <!-- A light held above the sphere, so the interior reads as a volume. -->
      <radialGradient id="reach-light" cx="38%" cy="28%" r="76%">
        <stop offset="0%" stop-color="var(--fg)" stop-opacity="0.06" />
        <stop offset="55%" stop-color="var(--fg)" stop-opacity="0.02" />
        <stop offset="100%" stop-color="var(--fg)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <circle
      class="reach__sphere"
      cx={round(sphere.x)}
      cy={round(sphere.y)}
      r={silhouette}
    />

    {
      echoes.map((echo) => (
        <g class="reach__echo" style={`opacity: ${echo.opacity}`}>
          <circle cx={echo.x} cy={echo.y} r={silhouette} />
          {echo.paths.map((path) => (
            <path d={path} />
          ))}
        </g>
      ))
    }

    {
      shells.map((shell) => (
        <g class="reach__shell" style={`opacity: ${shell.opacity}`}>
          {shell.paths.map((path) => (
            <path d={path} />
          ))}
        </g>
      ))
    }

    <circle
      class="reach__volume"
      cx={round(sphere.x)}
      cy={round(sphere.y)}
      r={silhouette}
      fill="url(#reach-light)"
    />

    <g clip-path="url(#reach-sphere)">
      <g class="reach__scanners">
        {
          direct.map((node) => (
            <circle
              class="reach__scanner"
              data-scanner
              data-at={node.position.join(',')}
              cx={round(node.at.x)}
              cy={round(node.at.y)}
              r="0"
            />
          ))
        }
      </g>

      <g class="reach__field">
        {
          particles.map((particle) => (
            <circle
              class="reach__particle"
              data-particle
              data-threshold={particle.threshold}
              cx={particle.cx}
              cy={particle.cy}
              r={particle.r}
              fill-opacity={particle.depth}
            />
          ))
        }
      </g>

      {
        joins.map((join) => (
          <g class="reach__join" data-join data-read={join.threshold}>
            <line x1={join.x1} y1={join.y1} x2={join.x2} y2={join.y2} />
            <circle cx={join.midX} cy={join.midY} r="1.7" />
          </g>
        ))
      }

      {links.map((link) => <line class="reach__link" x1={link.x1} y1={link.y1} x2={link.x2} y2={link.y2} />)}
    </g>

    {
      nodes.map((node) =>
        node.mark ? (
          <g
            class="reach__mark"
            data-mark={node.id}
            data-read={joinThreshold.get(node.id) ?? 1}
            transform={`translate(${node.mark.x} ${node.mark.y})`}
            style={`--fade: ${node.fade}`}
          >
            <polygon class="reach__mark-outline" points={node.mark.outline} />
            <polygon class="reach__mark-inner" points={node.mark.inner} />
          </g>
        ) : null,
      )
    }

    {
      nodes.map((node) => (
        <g class="reach__node" transform={node.transform} style={`opacity: ${node.fade}`}>
          <circle class="reach__halo" r={node.halo} />
          <g class="reach__glyph">
            {node.icon === 'robot' && (
              <>
                <line x1="0" y1="-38" x2="0" y2="-30" />
                <rect x="-13" y="-30" width="26" height="15" rx="3" />
                <circle cx="-5" cy="-23" r="1.8" />
                <circle cx="5" cy="-23" r="1.8" />
                <rect x="-21" y="-11" width="42" height="24" rx="3" />
                <line x1="-21" y1="1" x2="21" y2="1" />
                <circle cx="-13" cy="19" r="5" />
                <circle cx="13" cy="19" r="5" />
              </>
            )}
            {node.icon === 'drone' && (
              <>
                <rect x="-7" y="-5" width="14" height="10" rx="2" />
                <line x1="-7" y1="0" x2="-25" y2="-14" />
                <line x1="7" y1="0" x2="25" y2="-14" />
                <line x1="-30" y1="-15" x2="-12" y2="-15" />
                <line x1="12" y1="-15" x2="30" y2="-15" />
                <line x1="-5" y1="5" x2="-11" y2="18" />
                <line x1="5" y1="5" x2="11" y2="18" />
              </>
            )}
            {node.icon === 'laptop' && (
              <>
                <rect x="-22" y="-24" width="44" height="28" rx="2" />
                <line x1="-14" y1="-16" x2="14" y2="-16" />
                <path d="M-28 4 H28 L34 14 H-34 Z" />
              </>
            )}
            {node.icon === 'monitor' && (
              <>
                <rect x="-24" y="-20" width="48" height="34" rx="3" />
                <path d="M-18 0 H-9 L-4 -9 L3 9 L8 -3 H18" />
                <line x1="0" y1="14" x2="0" y2="22" />
                <line x1="-9" y1="22" x2="9" y2="22" />
              </>
            )}
            {node.icon === 'rack' && (
              <>
                <rect x="-17" y="-28" width="34" height="56" rx="2" />
                <line x1="-17" y1="-14" x2="17" y2="-14" />
                <line x1="-17" y1="0" x2="17" y2="0" />
                <line x1="-17" y1="14" x2="17" y2="14" />
                <circle cx="-11" cy="-21" r="1.5" />
                <circle cx="-11" cy="-7" r="1.5" />
                <circle cx="-11" cy="7" r="1.5" />
              </>
            )}
            {node.icon === 'space' && (
              <>
                <rect x="-8" y="-6" width="16" height="20" rx="2" />
                <rect x="-30" y="-2" width="18" height="12" />
                <rect x="12" y="-2" width="18" height="12" />
                <line x1="-12" y1="4" x2="-8" y2="4" />
                <line x1="8" y1="4" x2="12" y2="4" />
                <line x1="0" y1="-6" x2="0" y2="-18" />
                <circle cx="0" cy="-21" r="2.4" />
              </>
            )}
            {node.icon === 'vehicle' && (
              <>
                <path d="M-28 8 H-20 L-14 -9 H14 L20 8 H28" />
                <line x1="-28" y1="8" x2="28" y2="8" />
                <circle cx="-15" cy="11" r="5" />
                <circle cx="15" cy="11" r="5" />
              </>
            )}
            {node.icon === 'meter' && (
              <>
                <rect x="-18" y="-22" width="36" height="44" rx="4" />
                <line x1="-11" y1="-13" x2="11" y2="-13" />
                <path d="M-10 8 A 10 10 0 0 1 10 8" />
                <line x1="0" y1="8" x2="7" y2="-2" />
              </>
            )}
            {node.icon === 'camera' && (
              <>
                <rect x="-26" y="-12" width="34" height="24" rx="3" />
                <path d="M8 -5 L24 -12 V12 L8 5 Z" />
                <circle cx="-9" cy="0" r="7" />
              </>
            )}
            {node.icon === 'gateway' && (
              <>
                <rect x="-24" y="2" width="48" height="14" rx="3" />
                <line x1="-14" y1="2" x2="-19" y2="-16" />
                <line x1="14" y1="2" x2="19" y2="-16" />
                <circle cx="-19" cy="-19" r="2" />
                <circle cx="19" cy="-19" r="2" />
              </>
            )}
            {node.icon === 'wearable' && (
              <>
                <rect x="-10" y="-13" width="20" height="26" rx="6" />
                <path d="M-7 -13 V-22 H7 V-13" />
                <path d="M-7 13 V22 H7 V13" />
                <line x1="10" y1="-6" x2="14" y2="-6" />
              </>
            )}
            {node.icon === 'plc' && (
              <>
                <rect x="-20" y="-16" width="40" height="32" rx="2" />
                <line x1="-20" y1="-5" x2="20" y2="-5" />
                <line x1="-20" y1="7" x2="20" y2="7" />
                <line x1="-13" y1="-16" x2="-13" y2="-10" />
                <line x1="13" y1="-16" x2="13" y2="-10" />
                <circle cx="-12" cy="1" r="1.8" />
                <circle cx="0" cy="1" r="1.8" />
              </>
            )}
            {node.glyph === 'dot' && <circle class="reach__dot" r="2" />}
          </g>
        </g>
      ))
    }

    {
      nodes.map((node) =>
        node.label && node.labelPos ? (
          <text
            class="reach__label"
            data-label={node.id}
            data-read={joinThreshold.get(node.id) ?? 1}
            x={round(node.labelPos.x)}
            y={round(node.labelPos.y)}
            text-anchor={node.labelPos.anchor}
            style={`--fade: ${node.fade}`}
          >
            {node.label}
          </text>
        ) : null,
      )
    }
  </svg>

  <figcaption class="reach__caption">
    One engine and one record format, on twelve hosts attached to the same space: a drone
    with no operating system, a medical device, a data center, a space system. A record is a
    coordinate in that space, not a row in a centre. The copies behind the sphere are one
    instant held in parallel, because the record replays. Every host scans from the coordinate
    it holds, and two hosts are joined where their scans meet.
  </figcaption>
</figure>

<style>
  .reach {
    max-width: 1000px;
    margin: 0 auto;
  }

  .reach svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .reach__sphere {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.9;
    opacity: 0.15;
  }

  .reach__shell path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.6;
  }

  /* The copies of one instant, held behind it. */
  .reach__echo circle,
  .reach__echo path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.6;
  }

  .reach__echo circle {
    stroke-width: 0.9;
  }

  .reach__volume {
    stroke: none;
  }

  /* One ring per host: the scan is as many scanners as there are entities. */
  .reach__scanner {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.8;
    opacity: 0.14;
  }

  .reach__particle {
    fill: var(--fg);
    opacity: 0.42;
    transition: opacity 300ms var(--ease);
  }

  .reach__particle.is-read {
    opacity: 1;
  }

  .reach__join {
    opacity: 0;
    transition: opacity 420ms var(--ease);
  }

  .reach__join line {
    stroke: var(--fg);
    stroke-width: 0.55;
    opacity: 0.17;
  }

  .reach__join circle {
    fill: var(--fg);
  }

  .reach__join.is-joined {
    opacity: 1;
  }

  .reach__link {
    stroke: var(--fg);
    stroke-width: 0.7;
    stroke-dasharray: 2.4 3.4;
    opacity: 0.28;
  }

  .reach__mark {
    opacity: calc(0.3 * var(--fade, 1));
    transition: opacity 300ms var(--ease);
  }

  .reach__mark.is-read {
    opacity: calc(0.68 * var(--fade, 1));
  }

  .reach__mark.is-active {
    opacity: var(--fade, 1);
  }

  .reach__mark-outline {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .reach__mark-inner {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  .reach__halo {
    fill: var(--bg);
  }

  .reach__glyph,
  .reach__glyph * {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
    /* The glyphs are drawn at their own depth scale, so the stroke is held at the
       weight the sphere is drawn at. */
    vector-effect: non-scaling-stroke;
  }

  .reach__dot {
    fill: var(--fg);
    stroke: none;
  }

  .reach__label {
    font-family: var(--text);
    font-size: 11.5px;
    fill: var(--fg);
    opacity: calc(0.36 * var(--fade, 1));
    transition: opacity 300ms var(--ease);
  }

  .reach__label.is-read {
    opacity: calc(0.72 * var(--fade, 1));
  }

  .reach__label.is-active {
    opacity: var(--fade, 1);
  }

  .reach__caption {
    max-width: 56rem;
    margin: 20px auto 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--fg-3);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .reach__particle,
    .reach__join,
    .reach__mark,
    .reach__label {
      transition: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const figure = document.querySelector<HTMLElement>('[data-reach]');
  const scanners = figure
    ? Array.from(figure.querySelectorAll<SVGCircleElement>('[data-scanner]'))
    : [];
  const particles = figure
    ? Array.from(figure.querySelectorAll<SVGCircleElement>('[data-particle]'))
    : [];
  const joins = figure ? Array.from(figure.querySelectorAll<SVGGElement>('[data-join]')) : [];
  const labels = figure ? Array.from(figure.querySelectorAll<SVGTextElement>('[data-label]')) : [];
  const marks = figure ? Array.from(figure.querySelectorAll<SVGGElement>('[data-mark]')) : [];
  const space = JSON.parse(figure?.dataset.space ?? '{}') as {
    focal: number;
    sin: number;
    cos: number;
    sinY: number;
    cosY: number;
    dist: number;
    ox: number;
    oy: number;
    limit: number;
  };

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const thresholds = particles.map((particle) => Number(particle.dataset.threshold ?? 0));
  const scannerAt = scanners.map((scanner) =>
    (scanner.dataset.at ?? '0,0,0').split(',').map(Number),
  );
  let lit = 0;

  const project = (x: number, y: number, z: number) => {
    const across = x * space.cosY - z * space.sinY;
    const depthAxis = x * space.sinY + z * space.cosY;
    const up = y * space.cos + depthAxis * space.sin;
    const depth = space.dist + depthAxis * space.cos - y * space.sin;
    const p = space.focal / depth;
    return { x: space.ox + across * p, y: space.oy - up * p, p };
  };

  const paint = (progress: number) => {
    if (!figure) return;

    const at = Math.min(1, Math.max(0, progress));
    const radius = at * space.limit;

    // Every host scans from its own coordinate, so every host carries a ring.
    scanners.forEach((scanner, index) => {
      const [x, y, z] = scannerAt[index];
      const centre = project(x, y, z);
      scanner.setAttribute('cx', centre.x.toFixed(1));
      scanner.setAttribute('cy', centre.y.toFixed(1));
      scanner.setAttribute('r', (radius * centre.p).toFixed(1));
    });

    // The particles are sorted by the progress at which a scan reaches them, so
    // only the ones that just crossed are touched.
    let cut = 0;
    while (cut < thresholds.length && thresholds[cut] <= at) cut += 1;
    if (cut !== lit) {
      const from = Math.min(lit, cut);
      const to = Math.max(lit, cut);
      for (let index = from; index < to; index += 1) {
        particles[index]?.classList.toggle('is-read', index < cut);
      }
      lit = cut;
    }

    joins.forEach((join) => {
      join.classList.toggle('is-joined', at >= Number(join.dataset.read ?? 1));
    });

    const state = (element: SVGElement) => {
      const read = Number(element.dataset.read ?? 1);
      return { passed: at >= read, justNow: Math.abs(at - read) < 0.04 };
    };
    labels.forEach((label) => {
      const { passed, justNow } = state(label);
      label.classList.toggle('is-read', passed);
      label.classList.toggle('is-active', justNow);
    });
    marks.forEach((mark) => {
      const { passed, justNow } = state(mark);
      mark.classList.toggle('is-read', passed);
      mark.classList.toggle('is-active', justNow);
    });
  };

  if (figure) {
    if (reduce.matches) {
      paint(0.72);
    } else {
      // Pinned for the scan, so the joins finish before the section leaves.
      ScrollTrigger.create({
        trigger: figure,
        start: 'top 12%',
        end: '+=760',
        pin: true,
        onUpdate: (self) => paint(self.progress),
        onRefresh: (self) => paint(self.progress),
      });
    }
  }
</script>
