            )}
            {node.icon === 'monitor' && (
              <>
                <rect x="-24" y="-20" width="48" height="34" rx="3" />
                <path d="M-18 0 H-9 L-4 -9 L3 9 L8 -3 H18" />
                <line x1="0" y1="14" x2="0" y2="22" />
