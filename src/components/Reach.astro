---
/*
  The engine's reach: one sphere of coordinates and the hosts that sit on it.

  There is no centre to the deployment. An entity carries the engine and reads the
  space from the coordinate it is attached to, so every host is drawn on the
  surface, not orbiting it. The interior is the coordinates that could exist, and the
  lattice is repeated as parallel shells because the same space holds every instance
  at once. Each host opens its read from its own coordinate, and two hosts are joined
  where their reads reach the same point.

  The sphere turns, and the reader can turn it. Every position is kept in three
  dimensions and projected per frame, so the turn is a rotation of the space and not
  a spin of a drawing.
*/

const DEG = Math.PI / 180;
const round = (value: number) => Math.round(value * 10) / 10;
const tidy = (value: number) => Math.round(value * 100) / 100;

const TILT = 42 * DEG;
const YAW = 24 * DEG;
const FOCAL = 2200;
const DIST = 2600;

// The frame is cut to the drawing: the sphere, its names, and the three states that
// stand outside it. A wider box only adds margin, and margin is space the figure does
// not use.
const VIEW_X = 38;
const VIEW_Y = 40;
const VIEW_W = 676;
const VIEW_H = 460;
const OX = 390;
const OY = 270;

const RADIUS = 228;
const LIFT = 21;

const SIN_T = Math.sin(TILT);
const COS_T = Math.cos(TILT);
const SIN_Y = Math.sin(YAW);
const COS_Y = Math.cos(YAW);

// x runs right, y up, z toward the reader. The camera yaws around y and then looks
// down by the tilt, so the sphere has depth on both sides of every axis.
const project = (x: number, y: number, z: number) => {
  const across = x * COS_Y - z * SIN_Y;
  const depthAxis = x * SIN_Y + z * COS_Y;
  const up = y * COS_T + depthAxis * SIN_T;
  const depth = DIST + depthAxis * COS_T - y * SIN_T;
  const p = FOCAL / depth;
  return { x: OX + across * p, y: OY - up * p, p, depth };
};

const ORIGIN = project(0, 0, 0);
// A sphere projects to a circle slightly larger than its radius times the depth
// scale: the silhouette is the tangent, not the centre plane.
const SILHOUETTE = (RADIUS * FOCAL) / Math.sqrt(DIST * DIST - RADIUS * RADIUS);

const asPoints = (corners: number[][]) =>
  corners.map(([u, h]) => `${round(u)},${round(h)}`).join(' ');

const flatHex = (radius: number) => {
  const shoulder = (radius * Math.sqrt(3)) / 2;
  return [
    [0, radius],
    [shoulder, radius / 2],
    [shoulder, -radius / 2],
    [0, -radius],
    [-shoulder, -radius / 2],
    [-shoulder, radius / 2],
  ];
};

const length3 = (v: [number, number, number]) => Math.hypot(v[0], v[1], v[2]) || 1;

type Vec3 = [number, number, number];

// A coordinate on the surface, given as longitude and latitude.
const onSphere = (lonDeg: number, latDeg: number): Vec3 => {
  const lon = lonDeg * DEG;
  const lat = latDeg * DEG;
  return [
    RADIUS * Math.cos(lat) * Math.cos(lon),
    RADIUS * Math.sin(lat),
    RADIUS * Math.cos(lat) * Math.sin(lon),
  ];
};

// The mark is the favicon stamped on the coordinate the host reads. It is drawn at
// the pen width of the rest of the figure, so it is scaled by the same depth.
const MARK_RADIUS = 6;
const MARK_SHAPE = {
  outline: asPoints(flatHex(MARK_RADIUS)),
  inner: asPoints(
    [0, 90, 180, 270].map((step) => {
      const angle = step * DEG;
      return [MARK_RADIUS * 0.41 * Math.cos(angle), MARK_RADIUS * 0.41 * Math.sin(angle)];
    }),
  ),
};

type Icon =
  | 'robot'
  | 'drone'
  | 'laptop'
  | 'monitor'
  | 'rack'
  | 'space'
  | 'vehicle'
  | 'meter'
  | 'camera'
  | 'gateway'
  | 'wearable'
  | 'plc';

interface Seed {
  id: string;
  lon: number;
  lat: number;
  icon?: Icon;
  glyph?: 'dot';
  size: number;
  label?: string;
  side?: 'left' | 'right' | 'above' | 'below';
}

// Twelve hosts on the surface carry the examples. The peers below carry none,
// because they stand for every other field the same space can hold.
const seeds: Seed[] = [
  { id: 'space', lon: 8, lat: 30, icon: 'space', size: 0.5, label: 'Space system', side: 'right' },
  { id: 'meter', lon: 38, lat: -30, icon: 'meter', size: 0.5, label: 'Smart meter', side: 'below' },
  { id: 'camera', lon: 68, lat: 30, icon: 'camera', size: 0.5, label: 'Vision camera', side: 'right' },
  { id: 'plc', lon: 98, lat: -30, icon: 'plc', size: 0.5, label: 'Factory PLC', side: 'right' },
  { id: 'laptop', lon: 128, lat: 30, icon: 'laptop', size: 0.5, label: 'Laptop and mobile', side: 'left' },
  { id: 'drone', lon: 158, lat: -30, icon: 'drone', size: 0.5, label: 'MCU drone', side: 'left' },
  { id: 'robot', lon: 188, lat: 30, icon: 'robot', size: 0.5, label: 'ROS robot', side: 'left' },
  { id: 'medical', lon: 218, lat: -30, icon: 'monitor', size: 0.5, label: 'Medical device', side: 'left' },
  { id: 'wearable', lon: 248, lat: 30, icon: 'wearable', size: 0.5, label: 'Wearable', side: 'below' },
  { id: 'vehicle', lon: 278, lat: -30, icon: 'vehicle', size: 0.5, label: 'Vehicle ECU', side: 'right' },
  { id: 'rack', lon: 308, lat: 30, icon: 'rack', size: 0.5, label: 'Data center', side: 'right' },
  { id: 'gateway', lon: 338, lat: -30, icon: 'gateway', size: 0.5, label: 'Edge gateway', side: 'right' },

  // A mesh of near peers and a group read through one of its members: the same
  // space sustains both topologies at once.
  { id: 'p1', lon: 20, lat: -6, glyph: 'dot', size: 1.6 },
  { id: 'p2', lon: 44, lat: 8, glyph: 'dot', size: 1.4 },
  { id: 'p3', lon: 60, lat: -14, glyph: 'dot', size: 1.5 },
  { id: 'p4', lon: 200, lat: -8, glyph: 'dot', size: 1.6 },
  { id: 'p5', lon: 224, lat: 6, glyph: 'dot', size: 1.4 },
  { id: 'p6', lon: 236, lat: -16, glyph: 'dot', size: 1.4 },
  { id: 'p7', lon: 320, lat: 10, glyph: 'dot', size: 1.3 },
];

const labelOffset = 34;

const nodes = seeds.map((seed) => {
  const position = onSphere(seed.lon, seed.lat);
  const at = project(...position);
  // The glyph is pushed off the surface along the silhouette, so the host sits on
  // its coordinate instead of covering it.
  const outX = at.x - ORIGIN.x;
  const outY = at.y - ORIGIN.y;
  const outLength = Math.hypot(outX, outY) || 1;
  const lift = seed.glyph ? 0 : LIFT;
  const glyphAt = { x: at.x + (outX / outLength) * lift, y: at.y + (outY / outLength) * lift };
  const far = at.depth > DIST;
  return {
    ...seed,
    position,
    at,
    glyphAt,
    far,
    fade: far ? 0.62 : 1,
    transform: `translate(${round(glyphAt.x)} ${round(glyphAt.y)}) scale(${round(at.p * seed.size * 1000) / 1000})`,
    markTransform: `translate(${round(at.x)} ${round(at.y)}) scale(${tidy(at.p * 1.2)})`,
    labelPos: seed.label
      ? seed.side === 'left'
        ? { x: glyphAt.x - labelOffset, y: glyphAt.y + 4, anchor: 'end' }
        : seed.side === 'above'
          ? { x: glyphAt.x, y: glyphAt.y - 26, anchor: 'middle' }
          : seed.side === 'below'
            ? { x: glyphAt.x, y: glyphAt.y + 38, anchor: 'middle' }
            : { x: glyphAt.x + labelOffset, y: glyphAt.y + 4, anchor: 'start' }
      : null,
  };
});

const direct = nodes.filter((node) => node.icon);
const ports = direct.map((node) => node.position);

// Every pair of ports within a coincidence radius meets when the two reads have
// grown to half their distance apart. The join is drawn at that coordinate pair.
const COINCIDENCE = RADIUS * 1.2;
const pairs: Array<[number, number]> = [];
for (let a = 0; a < direct.length; a += 1) {
  for (let b = a + 1; b < direct.length; b += 1) {
    const from = direct[a].position;
    const to = direct[b].position;
    if (length3([to[0] - from[0], to[1] - from[1], to[2] - from[2]]) <= COINCIDENCE) {
      pairs.push([a, b]);
    }
  }
}

const indexOf = (id: string) => nodes.findIndex((node) => node.id === id);

const segments = pairs.map(([a, b]) => {
  const from = direct[a];
  const to = direct[b];
  return {
    from,
    to,
    a: indexOf(from.id),
    b: indexOf(to.id),
    distance: length3([
      to.position[0] - from.position[0],
      to.position[1] - from.position[1],
      to.position[2] - from.position[2],
    ]),
  };
});

// The interior: coordinates that could exist, denser toward the surface and each
// with the depth it sits at. The seed is fixed, so the field is the same on every
// build.
const seeded = (seed: number) => {
  let state = seed;
  return () => {
    state = (state * 1664525 + 1013904223) % 4294967296;
    return state / 4294967296;
  };
};

const random = seeded(31);

const field = Array.from({ length: 320 }, () => {
  const theta = random() * Math.PI * 2;
  const phi = Math.acos(2 * random() - 1);
  const radius = Math.pow(random(), 0.5) * RADIUS;
  const point: Vec3 = [
    radius * Math.sin(phi) * Math.cos(theta),
    radius * Math.cos(phi),
    radius * Math.sin(phi) * Math.sin(theta),
  ];
  const at = project(...point);
  // A point belongs to the read that reaches it first.
  const nearest = Math.min(
    ...ports.map((port) =>
      Math.hypot(point[0] - port[0], point[1] - port[1], point[2] - port[2]),
    ),
  );
  return {
    point,
    at,
    nearest,
    r: round(0.4 + Math.pow(random(), 2.2) * 2),
  };
}).sort((a, b) => a.nearest - b.nearest);

// The read has to reach the farthest coordinate any host holds, or the field would
// stay dark where no ring ever arrives.
const reachLimit =
  Math.max(
    ...segments.map((segment) => segment.distance / 2),
    ...field.map((point) => point.nearest),
  ) * 1.02;

const joins = segments.map(({ from, to, a, b, distance }) => {
  const mid = project(
    (from.position[0] + to.position[0]) / 2,
    (from.position[1] + to.position[1]) / 2,
    (from.position[2] + to.position[2]) / 2,
  );
  return {
    a,
    b,
    midX: round(mid.x),
    midY: round(mid.y),
    threshold: round((distance / 2 / reachLimit) * 1000) / 1000,
  };
});

const particles = field.map((particle) => ({
  cx: round(particle.at.x),
  cy: round(particle.at.y),
  r: particle.r,
  depth: round(Math.min(0.58, Math.max(0.14, 0.16 + (particle.at.p - 0.76) * 2.1))),
  threshold: round(Math.min(1, particle.nearest / reachLimit) * 1000) / 1000,
}));

// The first join a host takes part in is the moment its own coordinate becomes a
// shared one, so that is when its name is read.
const joinThreshold = new Map<string, number>();
for (const join of joins) {
  for (const id of [nodes[join.a].id, nodes[join.b].id]) {
    const current = joinThreshold.get(id);
    if (current === undefined || join.threshold < current) {
      joinThreshold.set(id, join.threshold);
    }
  }
}

const screenOf = (id: string) =>
  nodes.find((node) => node.id === id)?.at ?? { x: 0, y: 0 };
const links: Array<{ x1: number; y1: number; x2: number; y2: number }> = [];
const link = (
  from: { x: number; y: number } | null,
  to: { x: number; y: number } | null,
) => {
  if (!from || !to) return;
  links.push({ x1: round(from.x), y1: round(from.y), x2: round(to.x), y2: round(to.y) });
};
link(screenOf('p1'), screenOf('p2'));
link(screenOf('p2'), screenOf('p3'));
link(screenOf('p3'), screenOf('p1'));
link(screenOf('p4'), screenOf('p5'));
link(screenOf('p4'), screenOf('p6'));

const sphere = ORIGIN;
const silhouette = round(SILHOUETTE);

// The lattice is described by its rings, so the page and the client derive the same
// curves from the same numbers.
type Ring = { radius: number; kind: 'lon' | 'lat'; value: number; offset: Vec3 };

const MERIDIANS = [0, 60, 120];
const PARALLELS = [-60, -30, 0, 30, 60];

const latticeRings = (
  radius: number,
  phase: number,
  offset: Vec3,
  meridians: number[],
  parallels: number[],
): Ring[] => [
  ...meridians.map((degrees) => ({ radius, kind: 'lon' as const, value: degrees + phase, offset })),
  ...parallels.map((degrees) => ({ radius, kind: 'lat' as const, value: degrees, offset })),
];

const ringPoint = (ring: Ring, angle: number): Vec3 => {
  const [ox, oy, oz] = ring.offset;
  if (ring.kind === 'lon') {
    const lon = ring.value * DEG;
    return [
      ox + ring.radius * Math.sin(angle) * Math.cos(lon),
      oy + ring.radius * Math.cos(angle),
      oz + ring.radius * Math.sin(angle) * Math.sin(lon),
    ];
  }
  const lat = ring.value * DEG;
  const r = ring.radius * Math.cos(lat);
  const h = ring.radius * Math.sin(lat);
  return [ox + r * Math.cos(angle), oy + h, oz + r * Math.sin(angle)];
};

const pathOf = (ring: Ring) => {
  const parts: string[] = [];
  for (let index = 0; index <= 48; index += 1) {
    const at = project(...ringPoint(ring, (index / 48) * Math.PI * 2));
    parts.push(`${index === 0 ? 'M' : 'L'}${round(at.x)} ${round(at.y)}`);
  }
  return `${parts.join(' ')} Z`;
};

// Two shells of the same lattice for the volume. The space forks after the read: a
// deterministic record does not commit to one future, so the fabric carries the
// branches that follow the instant it read, and the figure draws them as three copies
// of the same lattice, each displaced along a direction of its own.
const BRANCH_RADIUS = RADIUS * 0.25;
const BRANCH_SPREAD = RADIUS * 1.6;
const BRANCH_DIRS: Vec3[] = [
  [-0.94, 0.34, 0],
  [0.94, 0.34, 0],
  // Down and to the side: straight down projects too close to the centre to clear the
  // parent, and the third state has to stand outside it like the other two.
  [0.5, -0.866, 0],
];
// The last state is left open: the instant after the read has not been classified yet, so
// the space carries more futures than it draws.
const BRANCH_NAMES = ['a', 'b', 'c...'];

const branches = BRANCH_DIRS.map((dir, index) => {
  const offset: Vec3 = [
    dir[0] * BRANCH_SPREAD,
    dir[1] * BRANCH_SPREAD,
    dir[2] * BRANCH_SPREAD,
  ];
  const centre = project(...offset);
  const rim = project(dir[0] * RADIUS, dir[1] * RADIUS, dir[2] * RADIUS);
  return {
    name: BRANCH_NAMES[index] as string,
    dir,
    offset,
    x: round(centre.x),
    y: round(centre.y),
    labelTop: round(centre.y - 1),
    labelLetter: round(centre.y + 11),
    rimX: round(rim.x),
    rimY: round(rim.y),
    radius: round(BRANCH_RADIUS),
    rings: latticeRings(BRANCH_RADIUS, 0, offset, [0, 60, 120], [-30, 0, 30]),
  };
});

const shells = [
  { opacity: 0.085, rings: latticeRings(RADIUS, 0, [0, 0, 0], MERIDIANS, PARALLELS) },
  { opacity: 0.05, rings: latticeRings(RADIUS * 0.88, 22, [0, 0, 0], MERIDIANS, PARALLELS) },
];

// Everything the client needs to keep the space in three dimensions.
const payload = {
  focal: FOCAL,
  dist: DIST,
  ox: OX,
  oy: OY,
  radius: round(RADIUS),
  tilt: round(TILT * 1000) / 1000,
  yaw: round(YAW * 1000) / 1000,
  limit: round(reachLimit),
  lift: LIFT,
  branches: branches.map((branch) => ({
    name: branch.name,
    dir: branch.dir,
    offset: branch.offset,
    radius: branch.radius,
    rings: branch.rings,
  })),
  shells: shells.map((shell) => ({ opacity: shell.opacity, rings: shell.rings })),
  particles: field.map((particle, index) => [
    round(particle.point[0]),
    round(particle.point[1]),
    round(particle.point[2]),
    particles[index].r,
  ]),
  nodes: nodes.map((node) => ({
    id: node.id,
    p: [round(node.position[0]), round(node.position[1]), round(node.position[2])],
    size: node.size,
    icon: Boolean(node.icon),
    label: node.label ?? null,
    side: node.side ?? null,
  })),
  joins: joins.map((join) => ({ a: join.a, b: join.b })),
  extents: direct.map((node) => [
    round(node.position[0]),
    round(node.position[1]),
    round(node.position[2]),
  ]),
};
---

<figure class="reach" data-reach>
  <svg viewBox={`${VIEW_X} ${VIEW_Y} ${VIEW_W} ${VIEW_H}`} role="img" aria-labelledby="reach-title">
    <title id="reach-title"
      >Hosts attached to one sphere of coordinates: each host carries the engine at its
      own coordinate, two hosts are joined where their reads reach the same point, and
      when an instant closes it forks into the composite states a, b, and c, the last of
      them still open</title
    >

    <defs>
      <clipPath id="reach-sphere">
        <circle cx={round(sphere.x)} cy={round(sphere.y)} r={silhouette} />
      </clipPath>
      <!-- A light held above the sphere, so the interior reads as a volume. -->
      <radialGradient id="reach-light" cx="38%" cy="28%" r="76%">
        <stop offset="0%" stop-color="var(--fg)" stop-opacity="0.06" />
        <stop offset="55%" stop-color="var(--fg)" stop-opacity="0.02" />
        <stop offset="100%" stop-color="var(--fg)" stop-opacity="0" />
      </radialGradient>
    </defs>

    {
      branches.map((branch, index) => (
        <g class="reach__branch" data-branch={index} style="opacity: 0">
          <line
            class="reach__fork"
            data-fork={index}
            x1={branch.rimX}
            y1={branch.rimY}
            x2={branch.x}
            y2={branch.y}
          />
          <circle cx={branch.x} cy={branch.y} r={branch.radius} />
          {branch.rings.map((ring) => (
            <path d={pathOf(ring)} />
          ))}
          <text class="reach__branch-name" x={branch.x} y={branch.labelTop} opacity="0">
            <tspan>State Fabric</tspan>
            <tspan class="reach__branch-letter" x={branch.x} y={branch.labelLetter}>
              {branch.name.toUpperCase()}
            </tspan>
          </text>
        </g>
      ))
    }

    <circle
      class="reach__sphere"
      cx={round(sphere.x)}
      cy={round(sphere.y)}
      r={silhouette}
    />

    {
      shells.map((shell, index) => (
        <g class="reach__shell" data-group={index} style={`opacity: ${shell.opacity}`}>
          {shell.rings.map((ring) => (
            <path d={pathOf(ring)} />
          ))}
        </g>
      ))
    }

    <circle
      class="reach__volume"
      cx={round(sphere.x)}
      cy={round(sphere.y)}
      r={silhouette}
      fill="url(#reach-light)"
    />

    <g clip-path="url(#reach-sphere)">
      <g class="reach__extents">
        {
          direct.map((node) => (
            <circle
              class="reach__extent"
              data-extent
              cx={round(node.at.x)}
              cy={round(node.at.y)}
              r="0"
            />
          ))
        }
      </g>

      <g class="reach__field">
        {
          particles.map((particle) => (
            <circle
              class="reach__particle"
              data-particle
              data-threshold={particle.threshold}
              cx={particle.cx}
              cy={particle.cy}
              r={particle.r}
              fill-opacity={particle.depth}
            />
          ))
        }
      </g>

      {
        joins.map((join) => (
          <g class="reach__join" data-join data-read={join.threshold}>
            <line
              x1={round(nodes[join.a].at.x)}
              y1={round(nodes[join.a].at.y)}
              x2={round(nodes[join.b].at.x)}
              y2={round(nodes[join.b].at.y)}
            />
            <circle cx={join.midX} cy={join.midY} r="1.7" />
          </g>
        ))
      }

      {links.map((link) => <line class="reach__link" x1={link.x1} y1={link.y1} x2={link.x2} y2={link.y2} />)}
    </g>

    {
      nodes.map((node) =>
        node.icon ? (
          <g
            class="reach__mark"
            data-mark={node.id}
            data-read={joinThreshold.get(node.id) ?? 1}
            transform={node.markTransform}
            style={`--fade: ${node.fade}`}
          >
            <polygon class="reach__mark-outline" points={MARK_SHAPE.outline} />
            <polygon class="reach__mark-inner" points={MARK_SHAPE.inner} />
          </g>
        ) : null,
      )
    }

    {
      nodes.map((node) => (
        <g class="reach__node" transform={node.transform} style={`opacity: ${node.fade}`}>
          <g class="reach__glyph">
            {node.icon === 'robot' && (
              <>
                <line x1="0" y1="-38" x2="0" y2="-30" />
                <rect x="-13" y="-30" width="26" height="15" rx="3" />
                <circle cx="-5" cy="-23" r="1.8" />
                <circle cx="5" cy="-23" r="1.8" />
                <rect x="-21" y="-11" width="42" height="24" rx="3" />
                <line x1="-21" y1="1" x2="21" y2="1" />
                <circle cx="-13" cy="19" r="5" />
                <circle cx="13" cy="19" r="5" />
              </>
            )}
            {node.icon === 'drone' && (
              <>
                <rect x="-7" y="-5" width="14" height="10" rx="2" />
                <line x1="-7" y1="0" x2="-25" y2="-14" />
                <line x1="7" y1="0" x2="25" y2="-14" />
                <line x1="-30" y1="-15" x2="-12" y2="-15" />
                <line x1="12" y1="-15" x2="30" y2="-15" />
                <line x1="-5" y1="5" x2="-11" y2="18" />
                <line x1="5" y1="5" x2="11" y2="18" />
              </>
            )}
            {node.icon === 'laptop' && (
              <>
                <rect x="-22" y="-24" width="44" height="28" rx="2" />
                <line x1="-14" y1="-16" x2="14" y2="-16" />
                <path d="M-28 4 H28 L34 14 H-34 Z" />
              </>
            )}
            {node.icon === 'monitor' && (
              <>
                <rect x="-24" y="-20" width="48" height="34" rx="3" />
                <path d="M-18 0 H-9 L-4 -9 L3 9 L8 -3 H18" />
                <line x1="0" y1="14" x2="0" y2="22" />
                <line x1="-9" y1="22" x2="9" y2="22" />
              </>
            )}
            {node.icon === 'rack' && (
              <>
                <rect x="-17" y="-28" width="34" height="56" rx="2" />
                <line x1="-17" y1="-14" x2="17" y2="-14" />
                <line x1="-17" y1="0" x2="17" y2="0" />
                <line x1="-17" y1="14" x2="17" y2="14" />
                <circle cx="-11" cy="-21" r="1.5" />
                <circle cx="-11" cy="-7" r="1.5" />
                <circle cx="-11" cy="7" r="1.5" />
              </>
            )}
            {node.icon === 'space' && (
              <>
                <rect x="-8" y="-6" width="16" height="20" rx="2" />
                <rect x="-30" y="-2" width="18" height="12" />
                <rect x="12" y="-2" width="18" height="12" />
                <line x1="-12" y1="4" x2="-8" y2="4" />
                <line x1="8" y1="4" x2="12" y2="4" />
                <line x1="0" y1="-6" x2="0" y2="-18" />
                <circle cx="0" cy="-21" r="2.4" />
              </>
            )}
            {node.icon === 'vehicle' && (
              <>
                <path d="M-28 8 H-20 L-14 -9 H14 L20 8 H28" />
                <line x1="-28" y1="8" x2="28" y2="8" />
                <circle cx="-15" cy="11" r="5" />
                <circle cx="15" cy="11" r="5" />
              </>
            )}
            {node.icon === 'meter' && (
              <>
                <rect x="-18" y="-22" width="36" height="44" rx="4" />
                <line x1="-11" y1="-13" x2="11" y2="-13" />
                <path d="M-10 8 A 10 10 0 0 1 10 8" />
                <line x1="0" y1="8" x2="7" y2="-2" />
              </>
            )}
            {node.icon === 'camera' && (
              <>
                <rect x="-26" y="-12" width="34" height="24" rx="3" />
                <path d="M8 -5 L24 -12 V12 L8 5 Z" />
                <circle cx="-9" cy="0" r="7" />
              </>
            )}
            {node.icon === 'gateway' && (
              <>
                <rect x="-24" y="2" width="48" height="14" rx="3" />
                <line x1="-14" y1="2" x2="-19" y2="-16" />
                <line x1="14" y1="2" x2="19" y2="-16" />
                <circle cx="-19" cy="-19" r="2" />
                <circle cx="19" cy="-19" r="2" />
              </>
            )}
            {node.icon === 'wearable' && (
              <>
                <rect x="-10" y="-13" width="20" height="26" rx="6" />
                <path d="M-7 -13 V-22 H7 V-13" />
                <path d="M-7 13 V22 H7 V13" />
                <line x1="10" y1="-6" x2="14" y2="-6" />
              </>
            )}
            {node.icon === 'plc' && (
              <>
                <rect x="-20" y="-16" width="40" height="32" rx="2" />
                <line x1="-20" y1="-5" x2="20" y2="-5" />
                <line x1="-20" y1="7" x2="20" y2="7" />
                <line x1="-13" y1="-16" x2="-13" y2="-10" />
                <line x1="13" y1="-16" x2="13" y2="-10" />
                <circle cx="-12" cy="1" r="1.8" />
                <circle cx="0" cy="1" r="1.8" />
              </>
            )}
            {node.glyph === 'dot' && <circle class="reach__dot" r="2" />}
          </g>
        </g>
      ))
    }

    {
      nodes.map((node) =>
        node.label && node.labelPos ? (
          <text
            class="reach__label"
            data-label={node.id}
            data-read={joinThreshold.get(node.id) ?? 1}
            x={round(node.labelPos.x)}
            y={round(node.labelPos.y)}
            text-anchor={node.labelPos.anchor}
            style={`--fade: ${node.fade}`}
          >
            {node.label}
          </text>
        ) : null,
      )
    }
  </svg>

  <script type="application/json" id="reach-space" set:html={JSON.stringify(payload)} />

  <figcaption class="reach__caption">
    One engine and one record format, carried by every host at its own coordinate: no host at
    the centre, no database behind it. The sphere is the coordinate space, and a record is a
    point found by address, not a row found by index. A host reads the space from the
    coordinate it holds, and two hosts are joined where their reads reach the same point. The
    twelve hosts are examples, one per kind of machine, and the space holds every other. When
    an instant closes, the deterministic record carries the composite states a, b, c at
    once; c stays open until the instant after the read is classified.
  </figcaption>
</figure>

<style>
  .reach {
    /* As wide as the viewport allows: the drawing keeps 676 by 460, so this leaves
       room for the pin offset and the caption under it. */
    max-width: min(1160px, calc((100svh - 110px) * 1.47));
    margin: 0 auto;
  }

  .reach svg {
    display: block;
    width: 100%;
    height: auto;
    /* The frame is open: a label or a state that reaches the edge is not cut off. */
    overflow: visible;
    cursor: grab;
    /* A sideways drag turns the sphere; the page keeps the vertical scroll. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .reach svg.is-grabbing {
    cursor: grabbing;
  }

  .reach__sphere {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.9;
    opacity: 0.15;
  }

  .reach__shell path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.6;
  }

  /* The fork: three states of the same lattice, each the execution that follows the
     instant the read. They carry the accent because they are what the record
     becomes, and the parent's outline steps back so they are the figure. */
  .reach__branch circle,
  .reach__branch path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.7;
  }

  .reach__branch circle {
    stroke-width: 0.8;
  }

  .reach__fork {
    stroke: var(--accent);
    stroke-width: 0.55;
    stroke-dasharray: 2 4;
  }

  .reach__branch-name {
    font-family: var(--text);
    font-size: 8.5px;
    letter-spacing: 0.06em;
    text-anchor: middle;
    fill: var(--accent);
    /* A halo in the page colour keeps the label legible over its own wires. */
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .reach__branch-letter {
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .reach.is-forked .reach__sphere {
    opacity: 0.1;
  }

  .reach__volume {
    stroke: none;
  }

  /* One ring per host: the read is as many extents as there are entities. */
  .reach__extent {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.8;
    opacity: 0.14;
  }

  .reach__particle {
    fill: var(--fg);
    opacity: 0.42;
    transition: opacity 300ms var(--ease);
  }

  .reach__particle.is-read {
    opacity: 1;
  }

  .reach__join {
    opacity: 0;
    transition: opacity 420ms var(--ease);
  }

  .reach__join line {
    stroke: var(--fg);
    stroke-width: 0.55;
    opacity: 0.17;
  }

  .reach__join circle {
    fill: var(--fg);
  }

  .reach__join.is-joined {
    opacity: 1;
  }

  .reach__link {
    stroke: var(--fg);
    stroke-width: 0.7;
    stroke-dasharray: 2.4 3.4;
    opacity: 0.28;
  }

  .reach__mark {
    opacity: calc(0.3 * var(--fade, 1));
    transition: opacity 300ms var(--ease);
  }

  .reach__mark.is-read {
    opacity: calc(0.68 * var(--fade, 1));
  }

  .reach__mark.is-active {
    opacity: var(--fade, 1);
  }

  .reach__mark-outline {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .reach__mark-inner {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  .reach__glyph,
  .reach__glyph * {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
    /* The glyphs are drawn at their own depth scale, so the stroke is held at the
       weight the sphere is drawn at. */
    vector-effect: non-scaling-stroke;
  }

  .reach__dot {
    fill: var(--fg);
    stroke: none;
  }

  .reach__label {
    font-family: var(--text);
    font-size: 11.5px;
    fill: var(--fg);
    opacity: calc(0.36 * var(--fade, 1) * var(--shown, 1));
    transition: opacity 300ms var(--ease);
  }

  .reach__label.is-read {
    opacity: calc(0.72 * var(--fade, 1) * var(--shown, 1));
  }

  .reach__label.is-active {
    opacity: calc(var(--fade, 1) * var(--shown, 1));
  }

  .reach__caption {
    max-width: 56rem;
    margin: 20px auto 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--fg-3);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .reach__particle,
    .reach__join,
    .reach__mark,
    .reach__label {
      transition: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const DEG = Math.PI / 180;

  const figure = document.querySelector<HTMLElement>('[data-reach]');
  const svg = figure?.querySelector<SVGSVGElement>('svg');
  const payloadEl = document.getElementById('reach-space');

  interface Vec3 extends Array<number> {
    0: number;
    1: number;
    2: number;
  }

  interface Ring {
    radius: number;
    kind: 'lon' | 'lat';
    value: number;
    offset: Vec3;
  }

  interface Group {
    opacity: number;
    rings: Ring[];
    offset?: Vec3;
  }

  interface Space {
    focal: number;
    dist: number;
    ox: number;
    oy: number;
    radius: number;
    tilt: number;
    yaw: number;
    limit: number;
    lift: number;
    shells: Group[];
    branches: Array<{
      name: string;
      dir: Vec3;
      offset: Vec3;
      radius: number;
      rings: Ring[];
    }>;
    particles: Array<[number, number, number, number]>;
    nodes: Array<{
      id: string;
      p: Vec3;
      size: number;
      icon: boolean;
      label: string | null;
      side: string | null;
    }>;
    joins: Array<{ a: number; b: number }>;
    extents: Vec3[];
  }

  const space: Space = JSON.parse(payloadEl?.textContent ?? '{}');

  if (figure && svg && space.nodes) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    // The sphere turns about its own axis, and a drag turns it faster.
    let yaw = space.yaw;
    let tilt = space.tilt;
    let progress = 0;
    // How far the space has forked, from none to three copies fully apart.
    let fork = 0;
    let dragging = false;
    let resumeAt = 0;
    let visible = true;
    let lastFrame = performance.now();

    const projectAt = (x: number, y: number, z: number, angle: number) => {
      const across = x * Math.cos(angle) - z * Math.sin(angle);
      const depthAxis = x * Math.sin(angle) + z * Math.cos(angle);
      const up = y * Math.cos(tilt) + depthAxis * Math.sin(tilt);
      const depth = space.dist + depthAxis * Math.cos(tilt) - y * Math.sin(tilt);
      const p = space.focal / depth;
      return { x: space.ox + across * p, y: space.oy - up * p, p, depth };
    };

    // One projection for the whole space. A composite state is carried by the same
    // lattice the sphere is, so it turns with the sphere instead of holding its frame.
    const project = (x: number, y: number, z: number) => projectAt(x, y, z, yaw);
    // The fork keeps the frame it was drawn in while the sphere turns. Its anchor is a
    // silhouette point, and a silhouette does not move under a turn, so the states stay
    // where the record left them instead of swinging out of the frame.
    const projectFork = (x: number, y: number, z: number) => projectAt(x, y, z, space.yaw);

    // Depth as a light level: the far side of the sphere is behind the field.
    const fadeOf = (p: number) => Math.min(1, Math.max(0.45, 0.45 + (p - 0.778) * 3.69));

    const ringPoint = (ring: Ring, angle: number): Vec3 => {
      const [ox, oy, oz] = ring.offset;
      if (ring.kind === 'lon') {
        const lon = ring.value * DEG;
        return [
          ox + ring.radius * Math.sin(angle) * Math.cos(lon),
          oy + ring.radius * Math.cos(angle),
          oz + ring.radius * Math.sin(angle) * Math.sin(lon),
        ];
      }
      const lat = ring.value * DEG;
      const r = ring.radius * Math.cos(lat);
      const h = ring.radius * Math.sin(lat);
      return [ox + r * Math.cos(angle), oy + h, oz + r * Math.sin(angle)];
    };

    const pathOf = (points: Vec3[], projection = project) => {
      let d = '';
      for (let index = 0; index < points.length; index += 1) {
        const at = projection(points[index][0], points[index][1], points[index][2]);
        d += `${index === 0 ? 'M' : 'L'}${at.x.toFixed(1)} ${at.y.toFixed(1)}`;
      }
      return `${d}Z`;
    };

    const groupEls = Array.from(svg.querySelectorAll<SVGGElement>('[data-group]')).map(
      (element, index) => {
        const group = space.shells[index] as Group | undefined;
        const rings = (group?.rings ?? []).map((ring) =>
          Array.from({ length: 49 }, (_, step) => ringPoint(ring, (step / 48) * Math.PI * 2)),
        );
        return {
          element,
          rings,
          paths: Array.from(element.querySelectorAll<SVGPathElement>('path')),
          circle: element.querySelector<SVGCircleElement>('circle'),
          offset: group?.offset ?? null,
        };
      },
    );

    // The branch rings are held around the branch's own centre, so the spread is one
    // number per frame and the lattice keeps its shape as it travels.
    const branchEls = Array.from(svg.querySelectorAll<SVGGElement>('[data-branch]')).map(
      (element) => {
        const branch = space.branches[Number(element.dataset.branch ?? 0)];
        const [ox, oy, oz] = branch.offset;
        const length = Math.hypot(ox, oy, oz) || 1;
        return {
          element,
          offset: branch.offset,
          radius: branch.radius,
          dir: [ox / length, oy / length, oz / length] as Vec3,
          rings: branch.rings.map((ring) =>
            Array.from({ length: 49 }, (_, step) => {
              const point = ringPoint(ring, (step / 48) * Math.PI * 2);
              return [point[0] - ox, point[1] - oy, point[2] - oz] as Vec3;
            }),
          ),
          paths: Array.from(element.querySelectorAll<SVGPathElement>('path')),
          circle: element.querySelector<SVGCircleElement>('circle'),
          line: element.querySelector<SVGLineElement>('line'),
          label: element.querySelector<SVGTextElement>('text'),
          letter: element.querySelector<SVGTextElement>('.reach__branch-letter'),
        };
      },
    );

    const nodeEls = Array.from(svg.querySelectorAll<SVGGElement>('.reach__node'));
    // The fork groups are layered against this circle, so the near state covers the far one.
    const sphereEl = svg.querySelector<SVGCircleElement>('.reach__sphere');
    const particleEls = Array.from(svg.querySelectorAll<SVGCircleElement>('[data-particle]'));
    const extentEls = Array.from(svg.querySelectorAll<SVGCircleElement>('[data-extent]'));
    const joinEls = Array.from(svg.querySelectorAll<SVGGElement>('[data-join]')).map((element) => ({
      element,
      line: element.querySelector('line') as SVGLineElement,
      dot: element.querySelector('circle') as SVGCircleElement,
      read: Number(element.dataset.read ?? 1),
    }));
    const labels = Array.from(svg.querySelectorAll<SVGTextElement>('[data-label]'));
    const marks = Array.from(svg.querySelectorAll<SVGGElement>('[data-mark]'));

    const markById = new Map(marks.map((mark) => [mark.dataset.mark ?? '', mark]));
    const labelById = new Map(labels.map((label) => [label.dataset.label ?? '', label]));
    const fades = new Map<string, number>();

    // Label widths do not change with the turn, so they are measured once.
    const widths = new Map<string, number>();
    const measure = () => {
      labels.forEach((label) => {
        widths.set(label.dataset.label ?? '', label.getComputedTextLength());
      });
    };
    measure();
    document.fonts?.ready.then(measure).catch(() => {});

    const overlaps = (
      a: { x1: number; x2: number; y1: number; y2: number },
      b: { x1: number; x2: number; y1: number; y2: number },
    ) => a.x1 < b.x2 && b.x1 < a.x2 && a.y1 < b.y2 && b.y1 < a.y2;

    const labelBox = (
      x: number,
      y: number,
      anchor: string | null,
      width: number,
    ) => {
      const x1 = anchor === 'start' ? x : anchor === 'end' ? x - width : x - width / 2;
      return { x1, x2: x1 + width, y1: y - 11, y2: y + 3 };
    };

    const render = () => {
      for (const group of groupEls) {
        group.paths.forEach((path, index) => {
          const points = group.rings[index];
          if (points) path.setAttribute('d', pathOf(points));
        });
        if (group.circle && group.offset) {
          const centre = project(group.offset[0], group.offset[1], group.offset[2]);
          group.circle.setAttribute('cx', centre.x.toFixed(1));
          group.circle.setAttribute('cy', centre.y.toFixed(1));
        }
      }

      space.particles.forEach((point, index) => {
        const element = particleEls[index];
        if (!element) return;
        const at = project(point[0], point[1], point[2]);
        element.setAttribute('cx', at.x.toFixed(1));
        element.setAttribute('cy', at.y.toFixed(1));
        element.setAttribute(
          'fill-opacity',
          Math.min(0.58, Math.max(0.14, 0.16 + (at.p - 0.76) * 2.1)).toFixed(2),
        );
      });

      // The glyphs first, so the labels know what they have to clear.
      const placed = space.nodes.map((node, index) => {
        const element = nodeEls[index];
        const [x, y, z] = node.p;
        const at = project(x, y, z);
        const outX = at.x - space.ox;
        const outY = at.y - space.oy;
        const outLength = Math.hypot(outX, outY) || 1;
        const lift = node.icon ? space.lift : 0;
        const glyphX = at.x + (outX / outLength) * lift;
        const glyphY = at.y + (outY / outLength) * lift;
        const scale = at.p * node.size;

        element?.setAttribute(
          'transform',
          `translate(${glyphX.toFixed(1)} ${glyphY.toFixed(1)}) scale(${scale.toFixed(3)})`,
        );

        const fade = Math.round(fadeOf(at.p) * 20) / 20;
        if (fades.get(node.id) !== fade) {
          fades.set(node.id, fade);
          if (element) element.style.opacity = String(fade);
          markById.get(node.id)?.style.setProperty('--fade', String(fade));
          labelById.get(node.id)?.style.setProperty('--fade', String(fade));
        }

        markById
          .get(node.id)
          ?.setAttribute(
            'transform',
            `translate(${at.x.toFixed(1)} ${at.y.toFixed(1)}) scale(${(at.p * 1.2).toFixed(2)})`,
          );

        return {
          node,
          depth: at.p,
          glyphX,
          glyphY,
          glyphBox: node.icon
            ? {
                x1: glyphX - 30 * Math.abs(scale),
                x2: glyphX + 30 * Math.abs(scale),
                y1: glyphY - 38 * Math.abs(scale),
                y2: glyphY + 24 * Math.abs(scale),
              }
            : null,
        };
      });

      // Labels take the space they fit into, nearest first, and step aside when the
      // turn brings them onto another host or another name.
      const taken: Array<{ x1: number; x2: number; y1: number; y2: number }> = placed
        .map((entry) => entry.glyphBox)
        .filter((box): box is NonNullable<typeof box> => box !== null);

      // A forked state is an obstacle too, once it has separated from the sphere.
      space.branches.forEach((branch) => {
        const [ox, oy, oz] = branch.offset;
        const centre = projectFork(ox * fork, oy * fork, oz * fork);
        // Before the states separate they sit at the centre, so only the part that has
        // moved out is an obstacle.
        const radius = branch.radius * centre.p * 1.04 * fork;
        taken.push({
          x1: centre.x - radius,
          x2: centre.x + radius,
          y1: centre.y - radius,
          y2: centre.y + radius,
        });
      });

      [...placed]
        .sort((a, b) => b.depth - a.depth)
        .forEach(({ node, glyphX, glyphY }) => {
          const label = labelById.get(node.id);
          if (!label) return;
          const anchor = label.getAttribute('text-anchor');
          const width = widths.get(node.id) ?? 60;
          const offset = 34;
          let x = glyphX + offset;
          let y = glyphY + 4;
          if (node.side === 'left') x = glyphX - offset;
          if (node.side === 'above') {
            x = glyphX;
            y = glyphY - 26;
          }
          if (node.side === 'below') {
            x = glyphX;
            y = glyphY + 38;
          }
          const frame = svg.viewBox.baseVal;
          y = Math.min(frame.y + frame.height - 6, Math.max(frame.y + 16, y));
          const box = labelBox(x, y, anchor, width);
          // A name that would leave the frame is carried back inside it, so a turn
          // never cuts one off.
          let shift = 0;
          if (box.x1 < frame.x + 6) shift = frame.x + 6 - box.x1;
          if (box.x2 + shift > frame.x + frame.width - 6) {
            shift = frame.x + frame.width - 6 - box.x2;
          }
          x += shift;
          box.x1 += shift;
          box.x2 += shift;
          label.setAttribute('x', x.toFixed(1));
          label.setAttribute('y', y.toFixed(1));

          const blocked = taken.some((other) => overlaps(box, other));
          label.style.setProperty('--shown', blocked ? '0' : '1');
          if (!blocked) taken.push(box);
        });

      // A state that comes round the near side is painted over the one behind it, so a
      // crossing reads as depth and not as two lattices fused into one.
      const layered: Array<{ element: SVGGElement; depth: number }> = [];
      branchEls.forEach((branch) => {
        const [ox, oy, oz] = branch.offset;
        const spread = fork;
        const centre = projectFork(ox * spread, oy * spread, oz * spread);
        layered.push({ element: branch.element, depth: centre.p });

        branch.paths.forEach((path, index) => {
          const points = branch.rings[index];
          if (!points) return;
          path.setAttribute(
            'd',
            pathOf(
              points.map(
                ([x, y, z]) => [x + ox * spread, y + oy * spread, z + oz * spread] as Vec3,
              ),
              projectFork,
            ),
          );
        });

        branch.circle?.setAttribute('cx', centre.x.toFixed(1));
        branch.circle?.setAttribute('cy', centre.y.toFixed(1));
        branch.circle?.setAttribute('r', (branch.radius * centre.p * 1.04).toFixed(1));

        if (branch.line) {
          const rim = projectFork(
            branch.dir[0] * space.radius,
            branch.dir[1] * space.radius,
            branch.dir[2] * space.radius,
          );
          branch.line.setAttribute('x1', rim.x.toFixed(1));
          branch.line.setAttribute('y1', rim.y.toFixed(1));
          branch.line.setAttribute('x2', centre.x.toFixed(1));
          branch.line.setAttribute('y2', centre.y.toFixed(1));
        }

        branch.label?.setAttribute('x', centre.x.toFixed(1));
        branch.label?.setAttribute('y', (centre.y - 1).toFixed(1));
        branch.letter?.setAttribute('x', centre.x.toFixed(1));
        branch.letter?.setAttribute('y', (centre.y + 11).toFixed(1));
      });

      if (sphereEl) {
        layered.sort((a, b) => a.depth - b.depth);
        const order = layered.map(({ element }) => element.dataset.branch).join(',');
        // Only touch the tree when the order actually changes, so the turn stays cheap.
        if (order !== branchOrder) {
          branchOrder = order;
          layered.forEach(({ element }) => svg.insertBefore(element, sphereEl));
        }
      }

      space.extents.forEach((port, index) => {
        const element = extentEls[index];
        if (!element) return;
        const at = project(port[0], port[1], port[2]);
        element.setAttribute('cx', at.x.toFixed(1));
        element.setAttribute('cy', at.y.toFixed(1));
        element.setAttribute('r', (progress * space.limit * at.p).toFixed(1));
      });

      space.joins.forEach((join, index) => {
        const element = joinEls[index];
        if (!element) return;
        const from = space.nodes[join.a].p;
        const to = space.nodes[join.b].p;
        const start = project(from[0], from[1], from[2]);
        const end = project(to[0], to[1], to[2]);
        element.line.setAttribute('x1', start.x.toFixed(1));
        element.line.setAttribute('y1', start.y.toFixed(1));
        element.line.setAttribute('x2', end.x.toFixed(1));
        element.line.setAttribute('y2', end.y.toFixed(1));
        const mid = project(
          (from[0] + to[0]) / 2,
          (from[1] + to[1]) / 2,
          (from[2] + to[2]) / 2,
        );
        element.dot.setAttribute('cx', mid.x.toFixed(1));
        element.dot.setAttribute('cy', mid.y.toFixed(1));
      });
    };

    let lit = 0;
    let branchOrder = '';
    const thresholds = particleEls.map((particle) => Number(particle.dataset.threshold ?? 0));

    // The read is the first share of the scroll and the fork the rest of it, so the
    // reader sees the joins close before the space divides.
    const READ_SHARE = 0.52;
    // The split is complete before the pin lets go, so the reader can look at the three
    // executions rather than reaching them as the figure leaves.
    const FORK_SHARE = 0.36;

    const paint = (value: number) => {
      const whole = Math.min(1, Math.max(0, value));
      progress = Math.min(1, whole / READ_SHARE);
      const split = Math.min(1, Math.max(0, (whole - READ_SHARE) / FORK_SHARE));
      fork = split * split * (3 - 2 * split);

      // The particles are sorted by the progress at which a read reaches them, so
      // only the ones that just crossed are touched.
      let cut = 0;
      while (cut < thresholds.length && thresholds[cut] <= progress) cut += 1;
      if (cut !== lit) {
        const from = Math.min(lit, cut);
        const to = Math.max(lit, cut);
        for (let index = from; index < to; index += 1) {
          particleEls[index]?.classList.toggle('is-read', index < cut);
        }
        lit = cut;
      }

      joinEls.forEach((join) => {
        join.element.classList.toggle('is-joined', progress >= join.read);
      });

      const state = (element: SVGElement) => {
        const read = Number(element.dataset.read ?? 1);
        return { passed: progress >= read, justNow: Math.abs(progress - read) < 0.04 };
      };
      labels.forEach((label) => {
        const { passed, justNow } = state(label);
        label.classList.toggle('is-read', passed);
        label.classList.toggle('is-active', justNow);
      });
      marks.forEach((mark) => {
        const { passed, justNow } = state(mark);
        mark.classList.toggle('is-read', passed);
        mark.classList.toggle('is-active', justNow);
      });

      // The copies arrive with the split and the parent steps behind them.
      branchEls.forEach((branch) => {
        branch.element.setAttribute('style', `opacity: ${(fork * 0.68).toFixed(3)}`);
        branch.line?.setAttribute('opacity', (fork * 0.6).toFixed(3));
        // The name arrives once the state has separated, so it never reads over the
        // sphere it just left.
        branch.label?.setAttribute(
          'opacity',
          (Math.max(0, Math.min(1, (fork - 0.55) / 0.35)) * 0.95).toFixed(2),
        );
      });
      figure.classList.toggle('is-forked', fork > 0.02);

      render();
    };

    // The turn runs while the figure is on screen, and rests while a reader holds it.
    const step = (now: number) => {
      const delta = Math.min(0.05, (now - lastFrame) / 1000);
      lastFrame = now;
      if (visible && !dragging && !reduce.matches && now > resumeAt) {
        yaw += delta * 0.11;
        render();
      }
      requestAnimationFrame(step);
    };

    let dragX = 0;
    svg.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      dragging = true;
      dragX = event.clientX;
      resumeAt = Number.POSITIVE_INFINITY;
      svg.setPointerCapture(event.pointerId);
      svg.classList.add('is-grabbing');
    });

    svg.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      const delta = event.clientX - dragX;
      dragX = event.clientX;
      yaw += delta * 0.008;
      render();
    });

    const release = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      resumeAt = performance.now() + 1800;
      svg.classList.remove('is-grabbing');
      if (svg.hasPointerCapture(event.pointerId)) svg.releasePointerCapture(event.pointerId);
    };

    svg.addEventListener('pointerup', release);
    svg.addEventListener('pointercancel', release);

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        lastFrame = performance.now();
      },
      { rootMargin: '120px' },
    ).observe(figure);

    if (reduce.matches) {
      // The whole story: the read closed and the space divided.
      paint(1);
      // No pin here, so the figure leaving the viewport is the end of the sequence.
      new IntersectionObserver(([entry], observer) => {
        if (entry.isIntersecting) return;
        document.documentElement.dataset.reachDone = 'true';
        observer.disconnect();
      }).observe(figure);
    } else {
      // Pinned for both acts: the read closes, then the space divides.
      // The backdrop behind the rest of the page waits for the read to finish: the
      // figure owns the scroll until the pin lets go, so the field may not arrive
      // while it is still dividing.
      const settle = (done: boolean) => {
        if (done) document.documentElement.dataset.reachDone = 'true';
        else delete document.documentElement.dataset.reachDone;
      };

      ScrollTrigger.create({
        trigger: figure,
        start: 'top 8px',
        // Long enough for both acts: the read closing, and the space then dividing.
        end: '+=1500',
        pin: true,
        onUpdate: (self) => paint(self.progress),
        onRefresh: (self) => {
          paint(self.progress);
          settle(self.progress >= 1);
        },
        onLeave: () => settle(true),
        onEnterBack: () => settle(false),
      });
      requestAnimationFrame(step);
    }
  }
</script>
