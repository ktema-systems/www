---
import Section from './Section.astro';

const layers = [
  {
    name: 'Storage',
    detail: 'A machine answers for its own past, on the machine, with no server in the path.',
  },
  {
    name: 'Execution',
    detail: 'It moves five kinds of work: agents, signals, machines, people, and outside systems.',
  },
  {
    name: 'Governance',
    detail: 'It governs the other two: which model answers, at what cost, and on which terms.',
  },
];
---

<Section
  id="company"
  label="Company"
  title="Ktema Systems"
  lede="A company building software infrastructure that lets a machine keep its own record and answer from it, from a chip with no operating system to a data center."
>
  <div class="prose">
    <p>
      Three layers share one record: Ktema keeps it, Kletos moves the work, and Krisis governs what the other two do. The storage engine is the first of the three.
    </p>
  </div>

  <div class="cards cards--3">
    {
      layers.map((layer) => (
        <div class="card">
          <span class="card__value">{layer.name}</span>
          <p>{layer.detail}</p>
        </div>
      ))
    }
  </div>

  <p class="note">Ktema Systems is pre-incorporation.</p>
</Section>
