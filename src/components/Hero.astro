---
import HeroField from './HeroField.astro';

// The hero is shared by the pages: an optional backdrop, the field, the copy, and a
// figure the caller hands in. A page states its own line and its own title image,
// because the company's hero and the engine's hero say different things over the
// same ground.
interface Props {
  eyebrow?: string;
  title: string;
  // A short line under the display line. The company's page carries its scope here.
  subline?: string;
  lede: string;
  body?: string;
  // A page that carries its own backdrop turns the field off, so the two do not
  // draw over each other.
  field?: boolean;
  // When the field arrives: from the first paint, or once the hero has been scrolled
  // past. The company's page carries the figure right under the first screen, so its
  // backdrop comes in after the promise rather than behind it.
  fieldReveal?: 'now' | 'scroll';
  // A page that composes the copy against a scene sets the body back in depth.
  depth?: boolean;
}

const {
  eyebrow,
  title,
  subline,
  lede,
  body,
  field = true,
  fieldReveal = 'now',
  depth = false,
} = Astro.props;
---

<section class="hero" id="top">
  {
    Astro.slots.has('backdrop') && (
      <div class="hero__backdrop">
        <slot name="backdrop" />
      </div>
    )
  }
  {field && <HeroField reveal={fieldReveal} />}
  <div class="wrap">
    <div class="hero__head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {subline && <p class="hero__subline">{subline}</p>}
      <p class="hero__lede">{lede}</p>
      {body && <p class:list={['hero__body', depth && 'hero__body--deep']}>{body}</p>}
    </div>
  </div>
  {
    Astro.slots.has('figure') && (
      <div class="wrap hero__figure">
        <slot name="figure" />
      </div>
    )
  }
</section>

<style>
  .hero {
    /* The copy is a layer above the scene the next band draws behind it. */
    position: relative;
    z-index: 2;
    overflow: visible;
    isolation: isolate;
    /* The bar floats over the page, so the field starts at the top of the window
       and this padding holds the copy clear of it. The air under the lockup is the
       page's, not the bar's: it grows with the window and stops before the copy
       drifts away from the top of the screen. It is measured to sit just under the
       large mark at the top, so the mark, not an empty band, holds that space. */
    padding-top: calc(var(--masthead-h) + var(--brand-lift-top) + clamp(110px, 4.4vh, 56px));
    padding-bottom: clamp(36px, 5vh, 36px);
  }

  /* The field is the only layer below; everything in a .wrap sits above it. */
  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  .hero__head {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.4vh, 30px);
  }

  /* The tagline is three sentences, so it is set as a line rather than a label. */
  .hero .eyebrow {
    font-size: 13px;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: none;
  }

  /* The copy under the display line is held to this measure; the display line
     itself may use the full width of the page. */
  .hero__lede,
  .hero__body,
  .hero__actions {
    max-width: 40rem;
  }

  .hero h1 {
    font-size: var(--headline-size);
    letter-spacing: -0.022em;
    line-height: 1.06;
    max-width: 18em;
    margin: 0;
    /* The display line is a line rather than a paragraph, so it may run past the
       measure the copy under it is held to. It stays on one line while the page can
       carry it, and wraps to balanced lines when the page is narrower. */
    text-wrap: balance;
  }

  .hero__subline {
    margin: 0;
    /* Set in the display cut the headline uses, one step down, so the two lines read
       as one statement rather than a heading and a label. */
    font-family: var(--text);
    font-stretch: 115%;
    font-weight: 600;
    font-size: clamp(1.3rem, 1rem + 1.05vw, 2rem);
    letter-spacing: -0.006em;
    line-height: 1.15;
    color: var(--accent);
  }

  .hero__lede {
    color: var(--fg-2);
    text-wrap: pretty;
    margin: 0;
    font-size: clamp(1.05rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.55;
  }

  .hero__body {
    color: var(--fg-2);
    margin: 0;
  }

  /* The copy sits on a plane set back from the reader, so the scene behind it has
     depth rather than sitting on the same sheet. The shadow is the only thing between
     the text and the scene: a panel would flatten the depth it is there to make. */
  .hero__body--deep {
    position: relative;
    transform: perspective(900px) rotateX(4deg) translateZ(-44px);
    transform-origin: 40% 100%;
    opacity: 1;
    text-shadow:
      0 1px 18px color-mix(in srgb, var(--bg) 88%, transparent),
      0 0 42px color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .hero__actions {
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
    display: flex;
  }

  .hero__figure {
    padding-top: clamp(40px, 6vh, 72px);
    padding-bottom: clamp(24px, 4vh, 56px);
  }

  /* A phone has no room for the air the desktop hero keeps under the lockup. */
  @media (max-width: 720px) {
    .hero {
      padding-top: calc(var(--masthead-h) + var(--brand-lift-top) + 16px);
    }
  }
</style>
