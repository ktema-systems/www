---
import AddressFigure from './AddressFigure.astro';
import HeroField from './HeroField.astro';
import { site } from '../config';
---

<section class="hero" id="top">
  <HeroField />
  <div class="wrap">
    <div class="hero__head">      
      <h1>{site.tagline}</h1>
      <p class="hero__lede">
          On-device storage engine for the record that autonomous machinery and physical agents act on, without an operating system or a database.
      </p>
      <p class="hero__body">
        A software agent, a robot, a drive, or a medical monitor keeps its own history and
        answers from it: which readings moved together before the failure, what happened in the
        last seconds. No server, no network, no cloud round trip. The same engine runs from a
        microcontroller to a data center, and out to space systems.
      </p>
      
    </div>
  </div>
  <div class="wrap hero__figure">
    <AddressFigure />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* The masthead floats over the page, so the field behind it starts at the top of
       the window and this padding is what holds the copy clear of the bar. It is set
       so the air under the lockup matches the air above it at the top of the page:
       twice the lockup's lift, plus the bar's own height, less the headline's leading
       above its cap. */
    padding-top: calc(
      var(--masthead-h) + var(--brand-lift-top) * 2 - var(--headline-size) * -0.156
    );
  }

  /* The field is the only layer below; everything in a .wrap sits above it. */
  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  .hero__head {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* The copy under the display line is held to this measure; the display line
     itself may use the full width of the page. */
  .hero__lede,
  .hero__body,
  .hero__actions {
    max-width: 44rem;
  }

  /* The lockup is the masthead mark at hero scale. The mark is the same asset,
     masked so it takes currentColor rather than the black it carries as an img. */
  .hero__lockup {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 28px);
  }

  .hero__mark {
    flex: none;
    display: block;
    width: clamp(84px, 13.5vw, 152px);
    aspect-ratio: 1;
    background: var(--fg);
    -webkit-mask: url(/logo.svg) 50% / contain no-repeat;
    mask: url(/logo.svg) 50% / contain no-repeat;
  }

  .hero__word {
    font-family: var(--text);
    font-weight: 600;
    font-stretch: 115%;
    font-size: clamp(48px, 7.5vw, 84px);
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--fg);
  }

  .hero h1 {
    font-size: var(--headline-size);
    letter-spacing: -0.008em;
    margin: 0;
    /* The tagline is a display line rather than a paragraph, so it may run past
       the 44rem measure the copy under it is held to. It stays on one line while
       the page can carry it, and wraps to balanced lines when the page is
       narrower. */
    text-wrap: balance;
  }

  .hero__lede {
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.35rem);
    line-height: 1.5;
    color: var(--fg-2);
    text-wrap: pretty;
    margin: 0;
  }

  .hero__body {
    color: var(--fg-2);
    margin: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
  }

  .hero__figure {
    padding-top: 64px;
    padding-bottom: 76px;
  }
</style>
