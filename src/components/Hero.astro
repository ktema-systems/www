---
import AddressFigure from './AddressFigure.astro';
import HeroField from './HeroField.astro';
import { site } from '../config';

const metrics = [
  {
    value: '2,163 B',
    label: 'live peak heap for a write and a read round trip on a RISC-V target with no operating system',
  },
  { value: '244 B', label: 'largest single allocation in that round trip' },
  { value: '64 KB', label: 'SRAM budget the build enforces' },
  {
    value: '0.93 ms',
    label: 'three-axis query over a one-day window at 100,000 records',
  },
];
---

<section class="hero" id="top">
  <HeroField />
  <div class="wrap">
    <div class="hero__head">      
      <h1>{site.tagline}</h1>
      <p class="hero__lede">
        On-device storage engine for multi-dimensional queries,<br/>without a database or an operating system.
      </p>
      <p class="hero__body">
        Ktema puts spatiotemporal answers on a device that cannot run a database. A motor drive, a robot joint, a medical monitor, or an ECU can answer its own multi-axis questions, such as which readings moved together before the failure and what happened in the last seconds, without a server, a network, or a cloud round trip. The same engine scales from a microcontroller to the richest data center, and out to space systems.
      </p>
      
    </div>
    <ul class="metrics">
      {
        metrics.map((metric) => (
          <li class="metric">
            <span class="metric__value">{metric.value}</span>
            <span class="metric__label">{metric.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="metrics__note">
      Published benchmark: release build, median of ten samples from the Criterion harness, in a
      virtual test environment. Query figures are for the read path.
    </p>
  </div>
  <div class="wrap hero__figure">
    <AddressFigure />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* The masthead floats over the page, so the field behind it starts at the top of
       the window and this padding is what holds the copy clear of the bar. It is set
       so the air under the lockup matches the air above it at the top of the page:
       twice the lockup's lift, plus the bar's own height, less the headline's leading
       above its cap. */
    padding-top: calc(
      var(--masthead-h) + var(--brand-lift-top) * 2 - var(--headline-size) * -0.156
    );
  }

  /* The field is the only layer below; everything in a .wrap sits above it. */
  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  .hero__head {
    max-width: 44rem;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* The lockup is the masthead mark at hero scale. The mark is the same asset,
     masked so it takes currentColor rather than the black it carries as an img. */
  .hero__lockup {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 28px);
  }

  .hero__mark {
    flex: none;
    display: block;
    width: clamp(84px, 13.5vw, 152px);
    aspect-ratio: 1;
    background: var(--fg);
    -webkit-mask: url(/logo.svg) 50% / contain no-repeat;
    mask: url(/logo.svg) 50% / contain no-repeat;
  }

  .hero__word {
    font-family: var(--text);
    font-weight: 600;
    font-stretch: 115%;
    font-size: clamp(48px, 7.5vw, 84px);
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--fg);
  }

  .hero h1 {
    font-size: var(--headline-size);
    letter-spacing: -0.008em;
    margin: 0;
  }

  /* The tagline is a display line rather than a paragraph, so it is allowed to run
     past the measure the copy under it is held to. The line measures 11.9em, which
     fits one line down to 640px; under that it is wider than the page and wraps
     like any other heading. */
  @media (min-width: 640px) {
    .hero h1 {
      width: max-content;
    }
  }

  .hero__lede {
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.35rem);
    line-height: 1.5;
    color: var(--fg-2);
    text-wrap: pretty;
    margin: 0;
  }

  .hero__body {
    color: var(--fg-2);
    margin: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
  }

  .hero .metrics {
    margin-top: 52px;
  }

  .hero__figure {
    padding-top: 64px;
    padding-bottom: 76px;
  }

  .metrics__note {
    margin-top: 18px;
    font-size: 13px;
    color: var(--fg-3);
  }
</style>
