---
import Section from './Section.astro';

const layers = [
  {
    title: 'The software the buyer replaces',
    value: 'US$ 11.71B',
    body: 'The embedded database system market in 2025, projected to reach US$ 23.55B by 2034 at a CAGR of 8.08%.',
  },
  {
    title: 'The driver that grows it',
    value: '47.2% CAGR',
    body: 'The Physical AI market grows from US$ 0.89B in 2025 to US$ 15.28B by 2032, with Asia Pacific leading the demand and the manufacturing.',
  },
  {
    title: 'The wedge we sell into',
    value: '~10,000 teams',
    body: 'Firmware teams in industrial equipment, instruments, and modules, where the memory budget is the purchase requirement.',
  },
];

const scenarios = [
  {
    label: 'Base case',
    arr: '$1M ARR',
    body: '20 design wins within two years of the first paid deployment, at $50k average annual licence and support.',
    share: '0.2% of the wedge',
  },
  {
    label: 'Upside, the Series A path',
    arr: '$3M ARR',
    body: '30 design wins within three years of the first paid deployment, at $100k average.',
    share: '0.3% of the wedge',
  },
];
---

<Section
  id="market"
  label="Market"
  title="Three layers: what the buyer replaces, what grows it, and the wedge"
>
  <div class="cards cards--3">
    {
      layers.map((layer) => (
        <div class="card">
          <span class="card__value">{layer.value}</span>
          <h3>{layer.title}</h3>
          <p>{layer.body}</p>
        </div>
      ))
    }
  </div>

  <div class="prose">
    <p>
      The wedge count is derived from published figures on industrial automation equipment makers
      (9,300), IoT device manufacturers (14,000), and embedded system companies, narrowed to
      those that ship a microcontroller product with a multi-axis history requirement.
    </p>
  </div>

  <div class="cards cards--2">
    {
      scenarios.map((scenario) => (
        <div class="card">
          <h3>{scenario.label}</h3>
          <span class="card__value">{scenario.arr}</span>
          <p>{scenario.body}</p>
          <p class="card__share">{scenario.share}</p>
        </div>
      ))
    }
  </div>

  <p class="note">
    The projections above are estimates from those terms, not a booked pipeline. The size of the
    wedge and the win rate from evaluations are expected to be calibrated by the first design
    partner.
  </p>
</Section>

<style>
  .card__share {
    margin-top: auto;
    padding-top: 10px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-3);
  }
</style>
