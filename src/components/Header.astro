---
import { companyCta, companyNav, site, type NavItem } from '../config';

// Each page hands its own strip in, because an anchor points at a section the page
// it sits on carries. The default is the company home's, so a page that passes
// nothing still gets a working masthead.
interface Props {
  items?: readonly NavItem[];
  cta?: NavItem;
  // The product page being read. It marks that entry in the products panel and in
  // the phone's sheet, so the panel says where the reader is.
  current?: string;
  // A product page opens with the panel unfolded, because the other products are
  // what a reader arriving on one of them is most likely to want next.
  openProducts?: boolean;
}

const {
  items = companyNav,
  cta = companyCta,
  current,
  openProducts = false,
} = Astro.props;
const menu = items.find((item) => item.items)?.items;
---

<header class="masthead" data-open-products={openProducts ? 'true' : undefined}>
  <div class="wrap masthead__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{site.name}</span>
      <span class="brand__short">{site.short}</span>
    </a>
    <nav class="masthead__nav" aria-label="Sections">
      {
        items.map((item) =>
          item.items ? (
            <div class="masthead__item">
              <a
                href={item.href}
                data-products-trigger
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="products-menu"
              >
                {item.label}
                <span class="masthead__caret" aria-hidden="true" />
              </a>
            </div>
          ) : (
            <a href={item.href}>{item.label}</a>
          )
        )
      }
    </nav>
    <a class="btn btn--accent" href={cta.href}>{cta.label}</a>
    <button
      class="masthead__toggle"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Menu"
    >
      <span class="masthead__toggle-bar" aria-hidden="true"></span>
      <span class="masthead__toggle-bar" aria-hidden="true"></span>
    </button>
  </div>
  {
    menu && (
      <div class="product-menu" id="products-menu" data-products-menu>
        <div class="product-menu__fold">
          <div class="wrap product-menu__inner">
            {menu.map((entry) => (
              <a href={entry.href} aria-current={entry.href === current ? 'page' : undefined}>
                <span class="product-menu__name">{entry.label}</span>
                {entry.note && <span class="product-menu__note">{entry.note}</span>}
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }
  <div class="site-menu" id="site-menu" data-site-menu>
    <div class="site-menu__fold">
      <nav class="wrap site-menu__inner" aria-label="Sections">
        <ul class="site-menu__list">
          {
            items.map((item) => (
              <li class="site-menu__item">
                <a href={item.href}>{item.label}</a>
                {item.items && (
                  <ul class="site-menu__sub">
                    {item.items.map((entry) => (
                      <li>
                        <a
                          href={entry.href}
                          aria-current={entry.href === current ? 'page' : undefined}
                        >
                          <span>{entry.label}</span>
                          {entry.note && <span class="site-menu__note">{entry.note}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  // The masthead's brand is at its largest at the top of the page and settles as
  // the page moves. Only the scroll offset is written here, and the stylesheet
  // turns it into the progress value the brand and the bar's own chrome are drawn
  // from, so the distance the settle takes sits with the styles it drives. The
  // offset is written once per frame at most, so a fast wheel cannot outrun it.
  const root = document.documentElement;
  let queued = false;

  function write() {
    queued = false;
    const offset = window.scrollY;
    root.style.setProperty('--masthead-scroll', String(offset));
    root.classList.toggle('is-at-top', offset <= 0);
  }

  function schedule() {
    if (queued) {
      return;
    }
    queued = true;
    window.requestAnimationFrame(write);
  }

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  write();

  // The Products panel opens on contact and closes on a short delay, so the pointer
  // can cross from the label to the panel without the panel closing under it.
  const masthead = document.querySelector<HTMLElement>('.masthead');
  const trigger = masthead?.querySelector<HTMLElement>('[data-products-trigger]');
  const menu = masthead?.querySelector<HTMLElement>('[data-products-menu]');

  if (masthead && trigger && menu) {
    let timer: number | undefined;
    let packTimer: number | undefined;

    // The stylesheet draws the pack from the is-open class; the settling class
    // exists only for the length of that change, so scrolling never trails.
    const setOpen = (open: boolean) => {
      if (masthead.classList.contains('is-open') === open) {
        return;
      }

      masthead.classList.add('is-settling');
      masthead.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));

      window.clearTimeout(packTimer);
      packTimer = window.setTimeout(() => masthead.classList.remove('is-settling'), 480);
    };

    const open = () => {
      window.clearTimeout(timer);
      setOpen(true);
    };

    const close = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => setOpen(false), 260);
    };

    const cancelClose = () => window.clearTimeout(timer);
    const closeNow = () => {
      cancelClose();
      setOpen(false);
    };

    // A product page arrives with the panel unfolded, and that is a greeting rather
    // than a fixture: the first scroll retracts it, so the sheet never sits over the
    // page a reader came to read. The strip is not drawn on a phone, so the greeting
    // is only offered at the widths that show it.
    if (masthead.dataset.openProducts === 'true' && window.innerWidth > 720) {
      setOpen(true);

      const closeOnScroll = () => {
        if (window.scrollY > 24) {
          closeNow();
          window.removeEventListener('scroll', closeOnScroll);
        }
      };

      window.addEventListener('scroll', closeOnScroll, { passive: true });
    }

    trigger.addEventListener('pointerenter', open);
    trigger.addEventListener('focus', open);
    menu.addEventListener('pointerenter', open);
    menu.addEventListener('focusin', open);

    // The panel belongs to the masthead, so it closes only when the pointer
    // leaves the whole bar and panel, not when it crosses to an adjacent link.
    masthead.addEventListener('pointerenter', cancelClose);
    masthead.addEventListener('pointerleave', close);
    masthead.addEventListener('focusout', (event) => {
      if (!masthead.contains(event.relatedTarget as Node | null)) {
        close();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeNow();
        trigger.blur();
      }
    });
  }

  // The strip is hidden below 900px, so the same links are offered in a sheet under
  // the bar. It opens in the page's flow like the products panel and closes on a
  // link, on Escape, and when the window grows back past the strip's breakpoint.
  const menuToggle = masthead?.querySelector<HTMLElement>('[data-menu-toggle]');
  const siteMenu = masthead?.querySelector<HTMLElement>('[data-site-menu]');

  if (masthead && menuToggle && siteMenu) {
    const setSiteMenu = (open: boolean) => {
      masthead.classList.toggle('is-menu', open);
      menuToggle.setAttribute('aria-expanded', String(open));
    };

    menuToggle.addEventListener('click', () => {
      setSiteMenu(!masthead.classList.contains('is-menu'));
    });

    // Any link in the bar closes the sheet, including the call to action, because
    // a touch has no pointerleave to dismiss it after the page scrolls.
    masthead.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        setSiteMenu(false);
      }
    });

    // A touch has no pointerleave, so the sheet closes on a press outside the
    // masthead, which is the same "leave the whole area" rule the products panel
    // follows with a pointer.
    document.addEventListener('pointerdown', (event) => {
      if (!masthead.classList.contains('is-menu')) {
        return;
      }

      if (!masthead.contains(event.target as Node)) {
        setSiteMenu(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setSiteMenu(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) {
        setSiteMenu(false);
      }
    });
  }
</script>
