---
import { companyCta, companyNav, site, type NavItem, type NavLink } from '../config';

// Each page hands its own strip in, because an anchor points at a section the page
// it sits on carries. The default is the company home's, so a page that passes
// nothing still gets a working masthead.
interface Props {
  items?: readonly NavItem[];
  cta?: NavItem;
  // The products panel's entries. A product page carries the panel without a bar
  // entry that opens it: the page arrives with the panel already unfolded, so the
  // panel is the menu and a second way to open it would say the same thing twice.
  products?: readonly NavLink[];
  // The product page being read, marked in the panel and in the phone's sheet.
  current?: string;
  // A product page opens with the panel unfolded.
  openProducts?: boolean;
}

const {
  items = companyNav,
  cta = companyCta,
  products,
  current,
  openProducts = false,
} = Astro.props;

const productLinks = products ?? items.find((item) => item.items)?.items ?? [];
// The sheet lists the products as its own group, so the bar's Products entry, which
// exists only to open the panel, is not repeated there.
const sheetItems = items.filter((item) => !item.items);
---

<header
  class:list={['masthead', openProducts && 'is-open']}
  data-open-products={openProducts ? 'true' : undefined}
>
  <div class="wrap masthead__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{site.name}</span>
      <span class="brand__short">{site.short}</span>
    </a>
    <nav class="masthead__nav" aria-label="Sections">
      {
        items.map((item) =>
          item.items ? (
            <div class="masthead__item">
              <a
                href={item.href}
                data-products-trigger
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="products-menu"
              >
                {item.label}
                <span class="masthead__caret" aria-hidden="true" />
              </a>
            </div>
          ) : (
            <a href={item.href}>{item.label}</a>
          )
        )
      }
    </nav>
    <span class="masthead__cta">
      <a class="btn btn--accent" href={cta.href}>{cta.label}</a>
    </span>
    <button
      class="masthead__toggle"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Menu"
    >
      <span class="masthead__toggle-bar" aria-hidden="true"></span>
      <span class="masthead__toggle-bar" aria-hidden="true"></span>
    </button>
  </div>
  {
    productLinks.length > 0 && (
      <div class="product-menu" id="products-menu" data-products-menu>
        <div class="product-menu__fold">
          <div class="wrap product-menu__inner">
            {productLinks.map((entry) => (
              <a href={entry.href} aria-current={entry.href === current ? 'page' : undefined}>
                <span class="product-menu__name">{entry.label}</span>
                {entry.note && <span class="product-menu__note">{entry.note}</span>}
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }
  <div class="site-menu" id="site-menu" data-site-menu>
    <div class="site-menu__fold">
      <nav class="wrap site-menu__inner" aria-label="Sections">
        <ul class="site-menu__list">
          {
            productLinks.length > 0 && (
              <li class="site-menu__item">
                <a href="/#products">Products</a>
                <ul class="site-menu__sub">
                  {productLinks.map((entry) => (
                    <li>
                      <a
                        href={entry.href}
                        aria-current={entry.href === current ? 'page' : undefined}
                      >
                        <span>{entry.label}</span>
                        {entry.note && <span class="site-menu__note">{entry.note}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            )
          }
          {
            sheetItems.map((item) => (
              <li class="site-menu__item">
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  // The masthead's brand is at its largest at the top of the page and settles as
  // the page moves. Only the scroll offset is written here, and the stylesheet
  // turns it into the progress value the brand and the bar's own chrome are drawn
  // from, so the distance the settle takes sits with the styles it drives. The
  // offset is written once per frame at most, so a fast wheel cannot outrun it.
  const root = document.documentElement;
  // A page whose first figure owns the scroll keeps the full lockup and the open bar
  // until its backdrop arrives. The field and the bar change on the same attribute.
  const reach = document.querySelector('[data-reach]');
  if (reach) root.dataset.hasReach = 'true';
  let queued = false;

  function write() {
    queued = false;
    const offset = reach && root.dataset.reachDone !== 'true' ? 0 : window.scrollY;
    root.style.setProperty('--masthead-scroll', String(offset));
    root.classList.toggle('is-at-top', offset <= 0);
  }

  function schedule() {
    if (queued) {
      return;
    }
    queued = true;
    window.requestAnimationFrame(write);
  }

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  if (reach) {
    new MutationObserver(schedule).observe(root, {
      attributes: true,
      attributeFilter: ['data-reach-done'],
    });
  }
  write();

  // The Products panel opens on contact and closes on a short delay, so the pointer
  // can cross from the label to the panel without the panel closing under it. A page
  // that has no trigger still has the panel, because it arrives open.
  const masthead = document.querySelector<HTMLElement>('.masthead');
  const trigger = masthead?.querySelector<HTMLElement>('[data-products-trigger]');
  const menu = masthead?.querySelector<HTMLElement>('[data-products-menu]');

  if (masthead && menu) {
    let timer: number | undefined;
    let packTimer: number | undefined;

    // The stylesheet draws the pack from the is-open class; the settling class
    // exists only for the length of that change, so scrolling never trails.
    const setOpen = (open: boolean) => {
      if (masthead.classList.contains('is-open') === open) {
        return;
      }

      masthead.classList.add('is-settling');
      masthead.classList.toggle('is-open', open);
      trigger?.setAttribute('aria-expanded', String(open));

      window.clearTimeout(packTimer);
      packTimer = window.setTimeout(() => masthead.classList.remove('is-settling'), 320);
    };

    const open = () => {
      window.clearTimeout(timer);
      setOpen(true);
    };

    const close = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => setOpen(false), 260);
    };

    const cancelClose = () => window.clearTimeout(timer);
    const closeNow = () => {
      cancelClose();
      setOpen(false);
    };

    if (trigger) {
      trigger.addEventListener('pointerenter', open);
      trigger.addEventListener('focus', open);
      menu.addEventListener('pointerenter', open);
      menu.addEventListener('focusin', open);

      // The panel belongs to the masthead, so it closes only when the pointer
      // leaves the whole bar and panel, not when it crosses to an adjacent link.
      masthead.addEventListener('pointerenter', cancelClose);
      masthead.addEventListener('pointerleave', close);
      masthead.addEventListener('focusout', (event) => {
        if (!masthead.contains(event.relatedTarget as Node | null)) {
          close();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeNow();
          trigger.blur();
        }
      });
    }

    // The rail's light comes to rest over the product being read, so the panel says
    // where the reader is instead of drifting past it. The box is the column the panel
    // gives that product, so its centre is the middle of the place the entry occupies.
    const currentEntry = menu.querySelector<HTMLElement>('a[aria-current="page"]');

    const settleThread = () => {
      if (!currentEntry) {
        return;
      }

      const panelBox = menu.getBoundingClientRect();
      if (panelBox.width === 0) {
        return;
      }

      const entryBox = currentEntry.getBoundingClientRect();
      // The entry is a column and its name is a block across it, so both the entry and
      // the block centre right of the word. The name's text node is the word.
      const nameElement = currentEntry.querySelector<HTMLElement>('.product-menu__name');
      const range = document.createRange();
      range.selectNodeContents(nameElement ?? currentEntry);
      const labelBox = range.getBoundingClientRect();
      const box = labelBox.width > 0 ? labelBox : entryBox;
      const center = ((box.left + box.width / 2 - panelBox.left) / panelBox.width) * 100;
      // The band is 22% of the rail, and background-position is a share of the space
      // left beside it, so the offset that centres the band is (center - 11) / 0.78.
      menu.style.setProperty('--focus', `${((center - 11) / 0.78).toFixed(2)}%`);
      menu.classList.add('has-focus');
    };

    settleThread();
    window.addEventListener('resize', settleThread);

    // A product page arrives with the panel unfolded, and that is a greeting rather
    // than a fixture: the page's own top is the one place the panel belongs, so it
    // retracts as the page moves and comes back when the reader returns to the top.
    // The strip is not drawn on a phone, so the greeting is only offered at the
    // widths that show it.
    if (masthead.dataset.openProducts === 'true' && window.innerWidth > 720) {
      const syncThread = () => {
        const atTop = window.scrollY <= 24;
        setOpen(atTop);
      };

      syncThread();
      window.addEventListener('scroll', syncThread, { passive: true });
    }
  }

  // The strip is hidden below 900px, so the same links are offered in a sheet under
  // the bar. It opens in the page's flow like the products panel and closes on a
  // link, on Escape, and when the window grows back past the strip's breakpoint.
  const menuToggle = masthead?.querySelector<HTMLElement>('[data-menu-toggle]');
  const siteMenu = masthead?.querySelector<HTMLElement>('[data-site-menu]');

  if (masthead && menuToggle && siteMenu) {
    const setSiteMenu = (open: boolean) => {
      masthead.classList.toggle('is-menu', open);
      menuToggle.setAttribute('aria-expanded', String(open));
    };

    menuToggle.addEventListener('click', () => {
      setSiteMenu(!masthead.classList.contains('is-menu'));
    });

    // Any link in the bar closes the sheet, including the call to action, because
    // a touch has no pointerleave to dismiss it after the page scrolls.
    masthead.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        setSiteMenu(false);
      }
    });

    // A touch has no pointerleave, so the sheet closes on a press outside the
    // masthead, which is the same "leave the whole area" rule the products panel
    // follows with a pointer.
    document.addEventListener('pointerdown', (event) => {
      if (!masthead.classList.contains('is-menu')) {
        return;
      }

      if (!masthead.contains(event.target as Node)) {
        setSiteMenu(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setSiteMenu(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) {
        setSiteMenu(false);
      }
    });
  }

  // The page's first call to action sits in the hero, so the bar's copy closes to
  // nothing until the hero's has passed under the bar rather than offering the same
  // button twice. The button is never squeezed by the closing box, so its width is
  // the length the row closes; reading it costs one layout before the first paint.
  const heroCta = document.querySelector<HTMLElement>('[data-hero-cta]');
  const barCta = masthead?.querySelector<HTMLElement>('.masthead__cta');
  const barCtaButton = barCta?.querySelector<HTMLElement>('.btn');

  if (masthead && heroCta && barCta && barCtaButton) {
    const width = Math.ceil(barCtaButton.getBoundingClientRect().width);
    if (width > 0) {
      masthead.style.setProperty('--cta-w', `${width + 8}px`);
    }

    const barHeight = Math.ceil(masthead.getBoundingClientRect().height);
    new IntersectionObserver(
      ([entry]) => masthead.classList.toggle('is-cta-past', !entry.isIntersecting),
      { rootMargin: `-${barHeight}px 0px 0px 0px` },
    ).observe(heroCta);
  }

  // The strip marks the section the page is showing, so the menu says where the
  // reader is rather than only where they could go. A link whose target is missing
  // is left alone: a page may carry the company strip without its sections.
  const sectionLinks = Array.from(
    masthead?.querySelectorAll<HTMLAnchorElement>('.masthead__nav a[href^="#"]') ?? [],
  ).filter((link) => link.hash && document.querySelector(link.hash));

  if (masthead && sectionLinks.length > 0) {
    let ticking = false;

    const mark = () => {
      ticking = false;
      const line = window.scrollY + masthead.offsetHeight + 24;
      let active: HTMLAnchorElement = sectionLinks[0];

      for (const link of sectionLinks) {
        const target = document.querySelector<HTMLElement>(link.hash);
        if (!target) continue;
        if (target.getBoundingClientRect().top + window.scrollY <= line) {
          active = link;
        }
      }

      for (const link of sectionLinks) {
        if (link === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(mark);
    };

    mark();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', mark);
  }
</script>
