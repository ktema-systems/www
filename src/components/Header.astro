---
import { companyCta, companyNav, site, type NavItem } from '../config';

// Each page hands its own strip in, because an anchor points at a section the page
// it sits on carries. The default is the company home's, so a page that passes
// nothing still gets a working masthead.
interface Props {
  items?: readonly NavItem[];
  cta?: NavItem;
}

const { items = companyNav, cta = companyCta } = Astro.props;
const menu = items.find((item) => item.items)?.items;
---

<header class="masthead">
  <div class="wrap masthead__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{site.name}</span>
      <span class="brand__short">{site.short}</span>
    </a>
    <nav class="masthead__nav" aria-label="Sections">
      {
        items.map((item) =>
          item.items ? (
            <div class="masthead__item">
              <a
                href={item.href}
                data-products-trigger
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="products-menu"
              >
                {item.label}
                <span class="masthead__caret" aria-hidden="true" />
              </a>
            </div>
          ) : (
            <a href={item.href}>{item.label}</a>
          )
        )
      }
    </nav>
    <a class="btn btn--accent" href={cta.href}>{cta.label}</a>
  </div>
  {
    menu && (
      <div class="product-menu" id="products-menu" data-products-menu>
        <div class="product-menu__fold">
          <div class="wrap product-menu__inner">
            {menu.map((entry) => (
              <a href={entry.href}>
                <span class="product-menu__name">{entry.label}</span>
                {entry.note && <span class="product-menu__note">{entry.note}</span>}
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }
</header>

<script>
  // The masthead's brand is at its largest at the top of the page and settles as
  // the page moves. Only the scroll offset is written here, and the stylesheet
  // turns it into the progress value the brand and the bar's own chrome are drawn
  // from, so the distance the settle takes sits with the styles it drives. The
  // offset is written once per frame at most, so a fast wheel cannot outrun it.
  const root = document.documentElement;
  let queued = false;

  function write() {
    queued = false;
    const offset = window.scrollY;
    root.style.setProperty('--masthead-scroll', String(offset));
    root.classList.toggle('is-at-top', offset <= 0);
  }

  function schedule() {
    if (queued) {
      return;
    }
    queued = true;
    window.requestAnimationFrame(write);
  }

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  write();

  // The Products panel opens on contact and closes on a short delay, so the pointer
  // can cross from the label to the panel without the panel closing under it.
  const masthead = document.querySelector<HTMLElement>('.masthead');
  const trigger = masthead?.querySelector<HTMLElement>('[data-products-trigger]');
  const menu = masthead?.querySelector<HTMLElement>('[data-products-menu]');

  if (masthead && trigger && menu) {
    let timer: number | undefined;
    let packTimer: number | undefined;

    // The stylesheet draws the pack from the is-open class; the settling class
    // exists only for the length of that change, so scrolling never trails.
    const setOpen = (open: boolean) => {
      if (masthead.classList.contains('is-open') === open) {
        return;
      }

      masthead.classList.add('is-settling');
      masthead.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));

      window.clearTimeout(packTimer);
      packTimer = window.setTimeout(() => masthead.classList.remove('is-settling'), 480);
    };

    const open = () => {
      window.clearTimeout(timer);
      setOpen(true);
    };

    const close = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => setOpen(false), 140);
    };

    trigger.addEventListener('pointerenter', open);
    trigger.addEventListener('pointerleave', close);
    trigger.addEventListener('focus', open);
    trigger.addEventListener('blur', close);
    menu.addEventListener('pointerenter', open);
    menu.addEventListener('pointerleave', close);
    menu.addEventListener('focusin', open);
    menu.addEventListener('focusout', close);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        close();
        trigger.blur();
      }
    });
  }
</script>
