---
/*
  The hero's coordinate field: the mark's own construction, the hexagon, the inner
  diamond and the connector lines, traced at two scales in the accent. The large
  construction sits just left of the centre so it turns behind the copy, and the
  outer hexagon runs past the edges of the band, so the field stays large on a wide
  screen. The opacity is kept low enough that body text stays far above its contrast
  floor.

  Pure SVG and CSS, and one script for the entrance a caller defers: a field that waits
  for the first scroll cannot say that in a stylesheet. The global reduced-motion rule
  already collapses the rotation.
*/

// The entrance is the caller's: a page whose first screen is the promise shows the
// backdrop only once the reader has left it, and every other page keeps it from the
// first paint.
interface Props {
  reveal?: 'now' | 'scroll';
}

const { reveal = 'now' } = Astro.props;
---

<div class="field" data-field={reveal === 'scroll' ? 'deferred' : undefined} aria-hidden="true">
  <svg viewBox="0 0 1200 760" preserveAspectRatio="xMidYMid slice" stroke-width="1.2">
    <defs>
      <g id="ktema-field">
        <polygon points="85,-147.22 170,0 85,147.22 -85,147.22 -170,0 -85,-147.22" />
        <polygon points="35,-60.62 60.62,35 -35,60.62 -60.62,-35" />
        <line x1="85" y1="-147.22" x2="35" y2="-60.62" />
        <line x1="-85" y1="147.22" x2="-35" y2="60.62" />
        <line x1="-85" y1="-147.22" x2="-60.62" y2="-35" />
        <line x1="170" y1="0" x2="60.62" y2="35" />
        <line x1="-170" y1="0" x2="-60.62" y2="-35" />
        <line x1="85" y1="147.22" x2="60.62" y2="35" />
        <line x1="-85" y1="-147.22" x2="35" y2="-60.62" />
        <line x1="170" y1="0" x2="35" y2="-60.62" />
        <line x1="-170" y1="0" x2="-35" y2="60.62" />
        <line x1="85" y1="147.22" x2="-35" y2="60.62" />
        <line x1="85" y1="-147.22" x2="-60.62" y2="-35" />
        <line x1="85" y1="-147.22" x2="60.62" y2="35" />
        <line x1="-85" y1="147.22" x2="-60.62" y2="-35" />
        <line x1="-85" y1="147.22" x2="60.62" y2="35" />
      </g>
      <linearGradient
        id="field-beam"
        gradientUnits="userSpaceOnUse"
        x1="-170"
        y1="-150"
        x2="170"
        y2="150"
      >
        <stop class="field__beam-stop" offset="0" stop-opacity="0.02" />
        <stop class="field__beam-stop" offset="0.25" stop-opacity="0.3" />
        <stop class="field__beam-stop" offset="0.5" stop-opacity="1" />
        <stop class="field__beam-stop" offset="0.75" stop-opacity="0.3" />
        <stop class="field__beam-stop" offset="1" stop-opacity="0.02" />
      </linearGradient>
    </defs>

    <g class="field__layer field__layer--frame">
      <polygon points="885,-113.63 1170,380 885,873.63 315,873.63 30,380 315,-113.63" />
    </g>

    <g class="field__layer field__layer--near">
      <use href="#ktema-field" transform="translate(560 380) scale(2.1)" />
    </g>

    <g class="field__layer field__layer--beams">
      <g class="field__beams" transform="translate(560 380) scale(2.1)">
        <path
          class="field__beam field__beam--edge"
          d="M85 -147.22 L170 0 L85 147.22 L-85 147.22 L-170 0 L-85 -147.22 Z"
        />
        <path class="field__beam field__beam--right" d="M85 -147.22 L35 -60.62 L60.62 35 L85 147.22" />
        <path class="field__beam field__beam--left" d="M-85 147.22 L-35 60.62 L-60.62 -35 L-170 0" />
      </g>
    </g>
  </svg>
</div>

<style>
  /* The field takes the hero's height where the hero is short and a viewport band
     where it is tall. The field is scaled to fill that band, so the drawing stays
     large. The entrance is a plain fade. */
  /* The field is a page backdrop: fixed to the viewport, so it has no finite
     bottom edge inside the content. Do not restore a height cap or the hero's
     overflow clip; the field must never be cut at a section boundary. */
  .field {
    position: fixed;
    inset: 0 0 auto 0;
    height: 100vh;
    height: 100svh;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    animation: field-fade 700ms var(--ease) both;
  }

  @keyframes field-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .field[data-field='deferred'] {
    /* The first screen is the copy alone; the field arrives once it has been left. */
    animation: none;
    opacity: 0;
    transition: opacity 1200ms var(--ease);
  }

  .field[data-field='deferred'].is-shown {
    opacity: 1;
  }

  .field svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--accent);
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .field__layer {
    transform-box: view-box;
  }

  /* Opacity is set by the copy's contrast floor: a hexagon vertex stacks three
     strokes, and this leaves body text near 4.6:1. */
  .field__layer--frame {
    opacity: 0.045;
  }

  .field__layer--near {
    transform-origin: 560px 380px;
    opacity: 0.05;
    animation: field-spin 120s linear infinite;
  }

  /* Signals run along the mark's boundary and its inner arms, so the field reads
     as entities in conversation rather than a static drawing. The beams sit
     outside the dimmed layers so their own opacity is the one that shows, and they
     stay faint enough to sit under the copy and the figures. */
  .field__layer--beams {
    transform-origin: 560px 380px;
    opacity: 0.18;
    animation: field-spin 120s linear infinite;
  }

  .field__beam-stop {
    stop-color: var(--accent);
  }

  .field__beams {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .field__beam {
    stroke: url(#field-beam);
    stroke-width: 0.6;
    filter: drop-shadow(0 0 1px color-mix(in srgb, var(--accent) 28%, transparent));
  }

  .field__beam--edge {
    stroke-dasharray: 140 880;
    animation: field-beam-edge 26s linear infinite;
  }

  .field__beam--right {
    stroke-dasharray: 70 244;
    animation: field-beam-arm 15s linear infinite;
    animation-delay: -2s;
  }

  .field__beam--left {
    stroke-dasharray: 70 244;
    animation: field-beam-arm 18s linear infinite;
    animation-delay: -5s;
  }

  @keyframes field-beam-edge {
    to {
      stroke-dashoffset: -1020;
    }
  }

  @keyframes field-beam-arm {
    to {
      stroke-dashoffset: -314;
    }
  }

  @keyframes field-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (max-width: 720px) {
    .field__beam {
      filter: none;
    }

    .field__layer--beams {
      opacity: 0.15;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field {
      animation: none;
      opacity: 1;
    }

    .field[data-field='deferred'] {
      transition: none;
    }

    .field__layer--beams {
      display: none;
    }
  }
</style>

<script>
  // The reader's first scroll is the one that leaves the hero. When it has, the field
  // fades in behind the rest of the page; a page restored already scrolled is past it.
  const field = document.querySelector<HTMLElement>('.field[data-field="deferred"]');
  const hero = document.querySelector<HTMLElement>('.hero');

  if (field && hero) {
    const show = () => {
      field.classList.add('is-shown');
    };
    if (hero.getBoundingClientRect().bottom <= 0) {
      show();
    } else {
      const watch = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) return;
        show();
        watch.disconnect();
      });
      watch.observe(hero);
    }
  }
</script>
