---
/*
  The hero's coordinate field: the mark's own construction, the hexagon, the inner
  diamond and the connector lines, repeated at three scales and traced in the accent.
  It covers the top of the hero and sits slightly right of centre, so the mark reads
  beside the copy rather than behind it. The opacity is kept low enough that body text
  stays far above its contrast floor.

  Pure SVG and CSS. No client JavaScript, and the global reduced-motion rule already
  collapses the rotation.
*/
---

<div class="field" aria-hidden="true">
  <div class="field__fade">
    <svg viewBox="0 0 1200 760" preserveAspectRatio="xMidYMid slice" stroke-width="1.2">
    <defs>
      <g id="ktema-field">
        <polygon points="85,-147.22 170,0 85,147.22 -85,147.22 -170,0 -85,-147.22" />
        <polygon points="35,-60.62 60.62,35 -35,60.62 -60.62,-35" />
        <line x1="85" y1="-147.22" x2="35" y2="-60.62" />
        <line x1="-85" y1="147.22" x2="-35" y2="60.62" />
        <line x1="-85" y1="-147.22" x2="-60.62" y2="-35" />
        <line x1="170" y1="0" x2="60.62" y2="35" />
        <line x1="-170" y1="0" x2="-60.62" y2="-35" />
        <line x1="85" y1="147.22" x2="60.62" y2="35" />
        <line x1="-85" y1="-147.22" x2="35" y2="-60.62" />
        <line x1="170" y1="0" x2="35" y2="-60.62" />
        <line x1="-170" y1="0" x2="-35" y2="60.62" />
        <line x1="85" y1="147.22" x2="-35" y2="60.62" />
        <line x1="85" y1="-147.22" x2="-60.62" y2="-35" />
        <line x1="85" y1="-147.22" x2="60.62" y2="35" />
        <line x1="-85" y1="147.22" x2="-60.62" y2="-35" />
        <line x1="-85" y1="147.22" x2="60.62" y2="35" />
      </g>
    </defs>

      <g class="field__layer field__layer--frame">
        <polygon points="885,-113.63 1170,380 885,873.63 315,873.63 30,380 315,-113.63" />
      </g>

      <g class="field__layer field__layer--near">
        <use href="#ktema-field" transform="translate(870 380) scale(1.3)" />
      </g>

    </svg>
  </div>
</div>

<style>
  /* The height stays under the hero's own height, so the mask finishes fading
     before the hero's overflow clip can cut a stroke mid-air. On a short hero the
     field takes the hero's height; on a tall one it stops at the viewport band. */
  .field {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(100%, 84vh, 900px);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .field__fade {
    width: 100%;
    height: 100%;
    transform: translateX(2%);
    /* The field runs to the top and sides and melts into the page at the bottom. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 86%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 86%,
      transparent 100%
    );
  }

  .field svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--accent);
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .field__layer {
    transform-box: view-box;
  }

  /* Opacity is set by the copy's contrast floor: a hexagon vertex stacks three
     strokes, and this leaves body text near 4.6:1. */
  .field__layer--frame {
    opacity: 0.08;
  }

  .field__layer--near {
    transform-origin: 870px 380px;
    opacity: 0.15;
    animation: field-spin 120s linear infinite;
  }

  @keyframes field-spin {
    to {
      transform: rotate(1turn);
    }
  }
</style>
