---
/*
  The hero's coordinate field: the mark's own construction, the hexagon, the inner
  diamond and the connector lines, traced at two scales in the accent. Both hexagons
  are closed, and the drawing is fitted inside its band, so no stroke is cut and no
  fade is needed. It sits just left of the centre of the band, so the construction
  turns behind the copy. The opacity is kept low enough that body text stays far
  above its contrast floor.

  Pure SVG and CSS. No client JavaScript, and the global reduced-motion rule already
  collapses the rotation.
*/
---

<div class="field" aria-hidden="true">
  <svg viewBox="0 0 880 760" preserveAspectRatio="xMidYMid meet" stroke-width="1.2">
    <defs>
      <g id="ktema-field">
        <polygon points="85,-147.22 170,0 85,147.22 -85,147.22 -170,0 -85,-147.22" />
        <polygon points="35,-60.62 60.62,35 -35,60.62 -60.62,-35" />
        <line x1="85" y1="-147.22" x2="35" y2="-60.62" />
        <line x1="-85" y1="147.22" x2="-35" y2="60.62" />
        <line x1="-85" y1="-147.22" x2="-60.62" y2="-35" />
        <line x1="170" y1="0" x2="60.62" y2="35" />
        <line x1="-170" y1="0" x2="-60.62" y2="-35" />
        <line x1="85" y1="147.22" x2="60.62" y2="35" />
        <line x1="-85" y1="-147.22" x2="35" y2="-60.62" />
        <line x1="170" y1="0" x2="35" y2="-60.62" />
        <line x1="-170" y1="0" x2="-35" y2="60.62" />
        <line x1="85" y1="147.22" x2="-35" y2="60.62" />
        <line x1="85" y1="-147.22" x2="-60.62" y2="-35" />
        <line x1="85" y1="-147.22" x2="60.62" y2="35" />
        <line x1="-85" y1="147.22" x2="-60.62" y2="-35" />
        <line x1="-85" y1="147.22" x2="60.62" y2="35" />
      </g>
    </defs>

    <g class="field__layer field__layer--frame">
      <polygon points="860,380 650,16.5 230,16.5 20,380 230,743.5 650,743.5" />
    </g>

    <g class="field__layer field__layer--near">
      <use href="#ktema-field" transform="translate(440 380) scale(2.05)" />
    </g>
  </svg>
</div>

<style>
  /* The band is the whole of a short hero and a viewport slice of a tall one. The
     drawing is fitted inside it, so its own silhouette is the edge, and the band's
     end is invisible. */
  .field {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(100%, 84vh, 900px);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .field svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--accent);
    stroke-linejoin: round;
    stroke-linecap: round;
    transform: translateX(-2.5%);
  }

  .field__layer {
    transform-box: view-box;
  }

  /* Opacity is set by the copy's contrast floor: a hexagon vertex stacks three
     strokes, and this leaves body text near 4.6:1. */
  .field__layer--frame {
    opacity: 0.07;
  }

  .field__layer--near {
    transform-origin: 440px 380px;
    opacity: 0.12;
    animation: field-spin 120s linear infinite;
  }

  @keyframes field-spin {
    to {
      transform: rotate(1turn);
    }
  }
</style>
