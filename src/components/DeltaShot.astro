---
// The seat rather than the cockpit: a single record opened on the left, the run
// still live behind it. Cropped to the app so it does not repeat a deck frame.
const shot = {
  src: '/delta_seat.jpg',
  width: 1842,
  height: 1144,
  alt: 'A Delta run on Rescue Wing: Island Fire with one record opened on the left. The panel reads ground-station-2/link: kind, written at, origin, payload, and an address derived from the payload, the origin and the creator, while the intents, the cell and the island stay behind it.',
};
---

<figure class="dshot">
  <div class="dshot__frame">
    <img
      src={shot.src}
      alt={shot.alt}
      width={shot.width}
      height={shot.height}
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption>
    One fact, opened where the run is acted on: what it is, where it came from, and the
    address derived from it, read from a development build on a virtual scenario.
    {' '}
    <span class="dshot__note">Delta is planned to be open source.</span>
  </figcaption>
</figure>

<style>
  /* A screenshot of a build in progress is evidence rather than a hero, so it keeps a
     reading width and leaves the section's measure to the text. */
  .dshot {
    max-width: 640px;
    margin: 0 0 28px;
  }

  .dshot__frame {
    width: 100%;
    aspect-ratio: 1842 / 1144;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-2);
  }

  .dshot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dshot figcaption {
    padding-top: 12px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--fg-3);
  }

  .dshot__note {
    color: var(--fg-2);
  }
</style>
