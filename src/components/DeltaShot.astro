---
// The cockpit at work, kept small: it is a development build on demo material, so
// the figure is evidence of the shape rather than a product shot.
const shot = {
  src: '/delta_devscr.jpg',
  width: 1842,
  height: 1047,
  alt: 'The Delta cockpit on a demo campaign: an intent list on the left, the fleet and its map in the middle, the projects on the right, and the record along the bottom.',
};
---

<figure class="dshot">
  <div class="dshot__frame">
    <img
      src={shot.src}
      alt={shot.alt}
      width={shot.width}
      height={shot.height}
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption>
    A development build of Delta, running a demo campaign on a virtual scenario.
    <span class="dshot__note">Delta is planned to be open source.</span>
  </figcaption>
</figure>

<style>
  /* A screenshot of a build in progress is evidence rather than a hero, so it keeps a
     reading width and leaves the section's measure to the text. */
  .dshot {
    max-width: 640px;
    margin-bottom: 0;
  }

  .dshot__frame {
    width: 100%;
    aspect-ratio: 1842 / 1047;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-2);
  }

  .dshot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dshot figcaption {
    padding-top: 12px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--fg-3);
  }

  .dshot__note {
    color: var(--fg-2);
  }
</style>
