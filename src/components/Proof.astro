---
import Section from './Section.astro';

const INDEX_BYTES = 362121;
const ENGINE_BYTES = 2163;
const SRAM_BUDGET = 65536;

const share = (value: number) => `${((value / INDEX_BYTES) * 100).toFixed(2)}%`;

const bars = [
  { label: 'with the index', bytes: INDEX_BYTES, value: '~354 KB', fill: 'bar__fill--index' },
  { label: 'the 64 KB budget', bytes: SRAM_BUDGET, value: '65,536 B', fill: 'bar__fill--budget' },
  {
    label: 'without the index',
    bytes: ENGINE_BYTES,
    value: '2,163 B',
    fill: 'bar__fill--engine',
    engine: true,
  },
];
---

<Section
  id="proof"
  label="Proof"
  title="Runs on a bare RISC-V target"
  lede="A firmware image of about 121 KB boots in emulation with no operating system, writes a record, reads it back, and answers a three-axis query."
>
  <div class="bars">
    {
      bars.map((bar) => (
        <div class:list={['bar', bar.engine && 'bar--engine']}>
          <span class="bar__label">{bar.label}</span>
          <span class="bar__track">
            <span class:list={['bar__fill', bar.fill]} style={`width:${share(bar.bytes)}`} />
          </span>
          <span class="bar__value">{bar.value}</span>
        </div>
      ))
    }
  </div>

  <p class="note">
    Static SRAM use is about 32 KB inside the budget, and the optional index answers the same query
    in about 26 µs. Both builds run in continuous integration on every change.
  </p>
</Section>

<style>
  .bar--engine .bar__label {
    color: var(--accent);
  }
</style>
