---
// The deck: one idea per slide, walked by the page's own scroll, and a plain list
// without the script. Every deck on the site is this component, so the stage, the
// turn, the type scale, and the phone layout are changed in one place.
//
// The content model covers what the sections ask for: a kicker, a stamped meta
// line, a metric row, a titled line, a pull quote, body copy, labelled rows, a
// measured bar block, a budget gauge, a note, and a photograph. A figure the model
// does not describe is passed as a slot named `figure-N`, indexed by slide.
import { resetAll, rollAll } from '../scripts/count-up';

interface Metric {
  value: string;
  unit?: string;
}

interface Row {
  label?: string;
  text: string;
  // A rule down the left, for the block that has to read as evidence.
  rule?: boolean;
}

interface Bar {
  label: string;
  value: string;
  // The bar's share of its track, from 0 to 1.
  fill: number;
}

interface Gauge {
  fill: number;
  from: string;
  to: string;
  caption?: string;
}

interface SlideImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Slide {
  kicker?: string;
  // The two parts of a stamped line, such as a step number and its name.
  meta?: string;
  stamp?: string;
  title?: string;
  metrics?: Metric[];
  point?: string;
  body?: string;
  rows?: Row[];
  bars?: Bar[];
  delta?: string;
  legend?: string;
  gauge?: Gauge;
  note?: string;
  image?: SlideImage;
  // A figure that reads as a strip below the copy keeps the full width.
  stacked?: boolean;
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede: string;
  slides: Slide[];
  // Each slide's name in the footer, so the progress reads as a menu and jumps.
  labels?: readonly string[];
  // A line under the deck about the material itself, such as a development build.
  footnote?: string;
  // A deck whose figure is the content itself may take the room the frame has
  // instead of the shared box, because a diagram does not compress to a cap.
  size?: 'box' | 'stage';
}

const { id, eyebrow, title, lede, slides, labels, footnote, size = 'box' } = Astro.props;

// A figure the model cannot express arrives as a slot, so a page can pass its own
// component without the deck learning what the figure says. Rendered here because
// a slot name cannot be built inside the markup.
const figures = await Promise.all(
  slides.map((_, index) =>
    Astro.slots.has(`figure-${index}`) ? Astro.slots.render(`figure-${index}`) : '',
  ),
);

const hasFigure = (slide: Slide, index: number) =>
  Boolean(slide.image || slide.gauge || slide.bars || figures[index]);

// A metric is written as it reads ("$2", "1,648"), and the counter needs the number
// on its own. The digits are lifted out at build time; prefix and suffix stay text.
const splitMetric = (value: string) => {
  const match = value.match(/^([^0-9]*)([\d,]+)(.*)$/);
  if (!match) return { prefix: '', digits: '', target: 0, suffix: value };
  const [, prefix, digits, suffix] = match;
  return { prefix, digits, target: Number(digits.replace(/,/g, '')), suffix };
};
---

<section
  class:list={['deck', footnote && 'deck--noted', size === 'stage' && 'deck--stage-size']}
  id={id}
  data-deck
  style={`--steps: ${slides.length}`}
>
  <div class="deck__stage">
    <div class="wrap deck__grid">
      <header class="deck__head">
        <p class="eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
        <p class="lede">{lede}</p>
      </header>

      <ol class="deck__list">
        {
          slides.map((slide, index) => (
            <li
              class:list={[
                'slide',
                !hasFigure(slide, index) && 'slide--text',
                hasFigure(slide, index) && slide.stacked && 'slide--stacked',
              ]}
              data-slide
            >
              <div class="slide__copy">
                {slide.meta && (
                  <p class="slide__meta">
                    <span>{slide.meta}</span>
                    {slide.stamp && <span class="slide__stamp">{slide.stamp}</span>}
                  </p>
                )}
                {slide.kicker && <p class="slide__kicker">{slide.kicker}</p>}
                {slide.metrics && (
                  <p class="slide__metrics">
                    {slide.metrics.map((metric) => {
                      const parts = splitMetric(metric.value);
                      return (
                        <span class="slide__metric">
                          {parts.digits ? (
                            <span class="slide__value">
                              {parts.prefix}
                              <span data-count={parts.target}>{parts.digits}</span>
                              {parts.suffix}
                            </span>
                          ) : (
                            <span class="slide__value">{metric.value}</span>
                          )}
                          {metric.unit && <span class="slide__unit">{metric.unit}</span>}
                        </span>
                      );
                    })}
                  </p>
                )}
                {slide.title && <h3>{slide.title}</h3>}
                {slide.point && <p class="slide__point">{slide.point}</p>}
                {slide.body && <p class="slide__body">{slide.body}</p>}
                {slide.rows?.map((row) => (
                  <p class:list={['slide__row', row.rule && 'slide__row--rule']}>
                    {row.label && <span class="slide__key">{row.label}</span>}
                    {row.text}
                  </p>
                ))}
                {slide.note && <p class="slide__note">{slide.note}</p>}
              </div>
              {hasFigure(slide, index) && (
                <figure class="slide__figure">
                  {slide.image && (
                    <img
                      src={slide.image.src}
                      alt={slide.image.alt}
                      width={slide.image.width}
                      height={slide.image.height}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  {slide.gauge && (
                    <div class="gauge">
                      <span class="gauge__track">
                        <span class="gauge__fill" style={`--to: ${slide.gauge.fill}`} />
                        <span class="gauge__edge" style={`--to: ${slide.gauge.fill}`} aria-hidden="true" />
                      </span>
                      <p class="gauge__legend">
                        <span>{slide.gauge.from}</span>
                        <span>{slide.gauge.to}</span>
                      </p>
                      {slide.gauge.caption && <p class="gauge__caption">{slide.gauge.caption}</p>}
                    </div>
                  )}
                  {slide.bars && (
                    <div class="bars">
                      {slide.bars.map((bar) => (
                        <p class="bar">
                          <span class="bar__k">{bar.label}</span>
                          <span class="bar__v">{bar.value}</span>
                          <span class="bar__track">
                            <span class="bar__fill" style={`--to: ${bar.fill}`} />
                          </span>
                        </p>
                      ))}
                      {slide.delta && <p class="bars__delta">{slide.delta}</p>}
                      {slide.legend && <p class="bars__legend">{slide.legend}</p>}
                    </div>
                  )}
                  {figures[index] && <Fragment set:html={figures[index]} />}
                </figure>
              )}
            </li>
          ))
        }
      </ol>

      <div class="deck__foot">
        <p class="deck__count">
          <span data-slide-now>01</span>
          <span class="deck__of">/ {String(slides.length).padStart(2, '0')}</span>
        </p>
        {
          labels && (
            <div class="deck__tabs">
              {labels.map((label, index) => (
                <button
                  type="button"
                  class:list={['deck__tab', index === 0 && 'is-active']}
                  data-slide-tab={index}
                >
                  {label}
                </button>
              ))}
            </div>
          )
        }
        <div class="deck__rail"><span class="deck__bar" data-slide-bar /></div>
        <p class="deck__cue">Scroll</p>
      </div>

      {footnote && <p class="deck__note">{footnote}</p>}
    </div>
  </div>
</section>

<style>
  /* One type scale for every deck. A slide's number, its title, its prose, and its
     small print all read from these, so no deck can drift from another. */
  .deck {
    --deck-title: clamp(1.62rem, 1.16rem + 1.55vw, 2.3rem);
    --deck-slide-title: clamp(1.34rem, 1.14rem + 0.85vw, 1.76rem);
    --deck-value: clamp(2.5rem, 1.5rem + 2.9vw, 3.8rem);
    --deck-unit: 12px;
    --deck-prose: clamp(0.98rem, 0.94rem + 0.22vw, 1.1rem);
    --deck-prose-line: 1.6;
    --deck-lede: 19px;
    --deck-meta: 10.5px;
    --deck-figure: 12px;
    --deck-foot: 11.5px;
    --deck-gap: clamp(22px, 3.4vh, 38px);
    /* The room above the box, counted from the bar's lower edge, and the room below
       it. Both have a floor, so a short window keeps air over the heading. */
    --deck-roof: max(64px, 7vh);
    --deck-foot-gap: max(24px, 3vh);
    /* The box never grows past these, and it is centred in the window. */
    --deck-h: min(84svh, 690px);
    --deck-unit-scroll: 82svh;
    position: relative;
  }

  .deck__stage {
    display: grid;
    align-items: center;
    justify-items: center;
    min-height: 100svh;
    padding-block: calc(var(--masthead-h) + var(--deck-roof)) var(--deck-foot-gap);
  }

  .deck__grid {
    display: grid;
    inline-size: 100%;
    gap: var(--deck-gap);
  }

  .deck__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* A figure passed as a slot fills its column, whichever component it is. Its own
     auto margins would otherwise shrink it to the widest thing inside it. */
  .slide__figure :global(figure) {
    width: 100%;
    margin-inline: 0;
  }

  .deck__head h2 {
    margin: 0;
    font-size: var(--deck-title);
    font-stretch: 115%;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .deck__head .lede {
    max-width: 44rem;
    font-size: var(--deck-lede);
  }

  .deck__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .slide {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }

  .slide + .slide {
    margin-top: 48px;
  }

  /* A slide without a figure takes the whole width instead of leaving a column empty. */
  .slide--text,
  .slide--stacked {
    grid-template-columns: minmax(0, 1fr);
  }

  .slide--text .slide__copy {
    max-width: 46rem;
  }

  .slide--stacked .slide__copy {
    max-width: 52rem;
  }

  .slide__copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .slide__kicker,
  .slide__meta {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--deck-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .slide__meta {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }

  .slide__stamp {
    color: var(--fg-3);
  }

  .slide__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin: 2px 0 0;
  }

  .slide__metric {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-variant-numeric: tabular-nums;
  }

  .slide__value {
    font-size: var(--deck-value);
    font-weight: 600;
    font-stretch: 115%;
    letter-spacing: -0.035em;
    line-height: 0.94;
  }

  .slide__unit {
    font-family: var(--mono);
    font-size: var(--deck-unit);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .slide__copy h3 {
    margin: 0;
    font-size: var(--deck-slide-title);
    font-weight: 600;
    font-stretch: 115%;
    letter-spacing: -0.015em;
    line-height: 1.14;
  }

  .slide__point {
    margin: 2px 0 0;
    padding-left: 14px;
    border-left: 2px solid var(--accent);
    font-size: var(--deck-prose);
    font-weight: 600;
    line-height: 1.4;
    color: var(--fg);
    text-wrap: pretty;
  }

  .slide__body {
    margin: 0;
    max-width: 42rem;
    color: var(--fg-2);
    font-size: var(--deck-prose);
    line-height: var(--deck-prose-line);
    text-wrap: pretty;
  }

  .slide__row {
    margin: 0;
    max-width: 44rem;
    color: var(--fg-2);
    font-size: var(--deck-prose);
    line-height: var(--deck-prose-line);
    text-wrap: pretty;
  }

  .slide__row--rule {
    margin-top: 6px;
    padding-left: 16px;
    border-left: 2px solid var(--line-2);
    color: var(--fg-3);
  }

  .slide__key {
    display: block;
    margin-bottom: 4px;
    font-family: var(--mono);
    font-size: var(--deck-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .slide__note {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--deck-foot);
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--fg-3);
  }

  .slide__figure {
    margin: 0;
    display: grid;
    align-items: center;
  }

  .slide__figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  /* A measured row: a label, its figure, and the share it takes of the track. */
  .bars {
    display: grid;
    gap: 10px;
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
    align-items: baseline;
    margin: 0;
  }

  .bar__k {
    font-family: var(--mono);
    font-size: var(--deck-meta);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .bar__v {
    font-family: var(--mono);
    font-size: var(--deck-figure);
    font-variant-numeric: tabular-nums;
    color: var(--fg-2);
  }

  .bar__track {
    position: relative;
    grid-column: 1 / -1;
    height: 12px;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }

  .bar__fill,
  .gauge__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--to, 1) * 100%);
    background: var(--accent);
    clip-path: inset(0 calc((1 - var(--p, 1)) * 100%) 0 0);
    transition: clip-path 700ms var(--ease);
  }

  .bars__delta {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--deck-foot);
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .bars__legend,
  .gauge__caption {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--deck-meta);
    letter-spacing: 0.06em;
    line-height: 1.5;
    color: var(--fg-3);
  }

  /* One figure against the budget it is given, marked where it ends. */
  .gauge {
    display: grid;
    gap: 12px;
  }

  .gauge__track {
    position: relative;
    height: clamp(72px, 10vh, 104px);
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 calc(100% / 8 - 1px),
        var(--line) calc(100% / 8 - 1px) calc(100% / 8)
      ),
      var(--bg-2);
    border: 1px solid var(--line);
  }

  .gauge__fill {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
  }

  .gauge__edge {
    position: absolute;
    inset: 0 auto 0 calc(var(--to, 1) * 100%);
    width: 1px;
    background: var(--fg);
    box-shadow: 0 0 14px 2px var(--accent);
    opacity: calc(var(--p, 1) * 0.9);
    transition: opacity 700ms var(--ease);
  }

  .gauge__legend {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    font-family: var(--mono);
    font-size: var(--deck-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--fg-2);
  }

  .deck__foot {
    display: flex;
    align-items: center;
    gap: 20px;
    font-family: var(--mono);
    font-size: var(--deck-foot);
    letter-spacing: 0.1em;
    color: var(--fg-3);
  }

  .deck:not(.is-live) .deck__foot {
    display: none;
  }

  .deck__count {
    margin: 0;
    white-space: nowrap;
    color: var(--fg);
  }

  .deck__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .deck__tab {
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg-3);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    transition: color 200ms var(--ease);
  }

  .deck__tab:hover,
  .deck__tab:focus-visible {
    color: var(--fg);
  }

  .deck__tab.is-active {
    color: var(--accent);
  }

  .deck__of {
    margin-left: 4px;
    color: var(--fg-3);
  }

  .deck__rail {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--line-2);
  }

  .deck__bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .deck__cue {
    margin: 0;
    text-transform: uppercase;
  }

  .deck__note {
    margin: 0;
    max-width: 62ch;
    font-family: var(--mono);
    font-size: var(--deck-foot);
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: var(--fg-3);
  }

  .deck.is-live {
    height: calc(100svh + var(--steps) * var(--deck-unit-scroll));
  }

  /* The box is the same for every deck, so the heading and the foot sit at the same
     height from section to section; it is capped and centred in the window, and the
     last row is reserved for the disclosure line so a deck without one keeps the
     same foot. */
  .deck.is-live .deck__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    align-items: safe center;
    /* A deck taller than its cap scrolls here instead of running under the foot. */
    overflow-y: auto;
  }

  /* The box hugs its tallest slide, so a deck is only as large as it needs to be,
     and no larger than the cap; it is centred in the window by the stage. A fixed
     height would leave the head and the foot pinned to the frame with a hole between
     them, and the tallest slide holds the height steady while the slides turn. */
  .deck.is-live .deck__grid {
    block-size: auto;
    max-block-size: min(
      var(--deck-h),
      calc(100svh - var(--masthead-h) - var(--deck-roof) - var(--deck-foot-gap))
    );
    grid-template-rows: auto auto auto;
  }

  /* The disclosure line gets its own row, so two decks with one keep the same foot.
     A deck without one lets the foot close the box. */
  .deck--noted.is-live .deck__grid {
    grid-template-rows: auto auto auto minmax(2.5em, auto);
  }

  /* A stacked figure is as tall as it is, so that deck's box is sized by its content
     and takes the room the frame has. The stage scrolls if even that is not enough,
     rather than letting a slide run over the heading. The copy and the figure are one
     column here, so their gap, the frame's gaps, and the roof tighten together.
     Only the desktop frame is affected; a phone already fills and scrolls. */
  @media (min-width: 861px) {
    .deck--stage-size {
      --deck-gap: clamp(12px, 1.8vh, 22px);
      --deck-roof: max(48px, 6vh);
    }

    .deck--stage-size .deck__head {
      gap: 8px;
    }

    .deck--stage-size .slide--stacked {
      gap: 16px;
    }

    .deck--stage-size .slide--stacked .slide__copy {
      gap: 8px;
    }
  }

  /* The summary line is the head's largest block, and the first slide states the same
     thing; a window this short gives its room to the figure. */
  @media (min-width: 861px) and (max-height: 820px) {
    .deck--stage-size .deck__head .lede {
      display: none;
    }
  }

  .deck.is-live .deck__list {
    align-content: center;
  }

  /* The turn: a slide enters from below, the one it replaced leaves upward, and the
     list waits below the heading until the section is close. */
  .deck.is-live .slide {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    transform: translateY(28px);
    pointer-events: none;
    transition:
      opacity 560ms var(--ease-deck),
      transform 820ms var(--ease-deck);
  }

  .deck.is-live .slide.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .deck.is-live .slide.is-past {
    opacity: 0;
    transform: translateY(-28px);
  }

  .deck.is-live .deck__list,
  .deck.is-live .deck__foot,
  .deck.is-live .deck__note {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 700ms var(--ease),
      transform 700ms var(--ease);
  }

  .deck.is-live.is-revealed .deck__list,
  .deck.is-live.is-revealed .deck__foot,
  .deck.is-live.is-revealed .deck__note {
    opacity: 1;
    transform: none;
  }

  /* On a phone the box fills the window, because there is no room for air over it,
     and a slide that still runs past the edge scrolls inside the stage. The values
     above tighten here, never at the call site. */
  @media (max-width: 860px) {
    .deck {
      --deck-title: 1.4rem;
      --deck-slide-title: 1.15rem;
      --deck-value: clamp(1.8rem, 1.4rem + 2vw, 2.4rem);
      --deck-unit: 10px;
      --deck-prose: 14px;
      --deck-prose-line: 1.5;
      --deck-lede: 14px;
      --deck-figure: 11px;
      --deck-foot: 10px;
      --deck-gap: 12px;
    }

    .slide {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .deck.is-live .deck__stage {
      height: 100svh;
      min-height: 0;
      align-items: stretch;
      overflow-y: auto;
    }

    .deck.is-live .deck__grid {
      block-size: 100%;
      max-block-size: none;
      grid-template-rows: auto 1fr auto;
    }

    .deck.is-live .deck__list {
      align-content: stretch;
    }

    .deck__stage,
    .deck.is-live .deck__stage {
      padding-block: calc(var(--masthead-h) + 12px) 16px;
    }

    .deck__head {
      gap: 6px;
    }

    .slide__copy {
      gap: 6px;
    }

    .slide__metrics {
      gap: 4px 20px;
    }

    .slide__point {
      padding-left: 10px;
    }

    .deck__foot {
      gap: 12px;
    }

    .deck__tabs {
      gap: 4px 12px;
    }

    /* The cue is a hint for a pointer; a phone reaches the deck by scrolling anyway. */
    .deck__cue {
      display: none;
    }

    .slide__figure img {
      max-height: 32svh;
      object-fit: cover;
    }

    .gauge__track {
      height: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck.is-live {
      height: auto;
    }

    .deck.is-live .deck__stage {
      position: static;
      height: auto;
    }

    .deck.is-live .deck__grid {
      block-size: auto;
    }

    .deck.is-live .slide {
      grid-area: auto;
      opacity: 1;
      pointer-events: auto;
      transition: none;
    }

    .deck.is-live .slide + .slide {
      margin-top: 48px;
    }

    .deck__foot {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { resetAll, rollAll } from '../scripts/count-up';

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const tooSmall = window.matchMedia('(max-height: 559px), (max-width: 359px) and (max-height: 620px)');
  const touch = ScrollTrigger.isTouch === 1;

  document.querySelectorAll<HTMLElement>('[data-deck]').forEach((deck) => {
    const slides = Array.from(deck.querySelectorAll<HTMLElement>('[data-slide]'));
    const stage = deck.querySelector<HTMLElement>('.deck__stage');
    const bar = deck.querySelector<HTMLElement>('[data-slide-bar]');
    const now = deck.querySelector<HTMLElement>('[data-slide-now]');
    const tabs = Array.from(deck.querySelectorAll<HTMLButtonElement>('[data-slide-tab]'));
    if (slides.length === 0) return;

    // The slide arrives whole: its bars fill and its numbers roll together.
    const play = (slide: HTMLElement) => {
      slide.style.setProperty('--p', '0');
      window.requestAnimationFrame(() => {
        slide.style.setProperty('--p', '1');
        resetAll(slide);
        rollAll(slide);
      });
    };

    const show = (index: number) => {
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
        slide.classList.toggle('is-past', i < index);
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });
      tabs.forEach((tab, i) => tab.classList.toggle('is-active', i === index));
      if (now) now.textContent = String(index + 1).padStart(2, '0');
      // A phone scrolls a long slide inside the stage, so the next one opens at its head.
      if (stage) stage.scrollTop = 0;

      const slide = slides[index];
      if (slide && deck.classList.contains('is-revealed')) play(slide);
    };

    // A label jumps to its slide: in the deck the target is that slide's share of the
    // section's scroll range, and in the stacked state it is the slide itself.
    const jump = (index: number) => {
      const motion = reduce.matches ? 'auto' : 'smooth';
      if (!deck.classList.contains('is-live')) {
        slides[index]?.scrollIntoView({ behavior: motion, block: 'start' });
        return;
      }
      const top = deck.getBoundingClientRect().top + window.scrollY;
      const range = deck.offsetHeight - window.innerHeight;
      window.scrollTo({ top: top + ((index + 0.5) / slides.length) * range, behavior: motion });
    };

    tabs.forEach((tab, index) => tab.addEventListener('click', () => jump(index)));

    let trigger: ScrollTrigger | null = null;
    let reveal: IntersectionObserver | null = null;
    let settled = 0;

    const stack = () => {
      trigger?.kill();
      trigger = null;
      window.clearTimeout(settled);
      reveal?.disconnect();
      reveal = null;
      deck.classList.remove('is-live', 'is-revealed');
      slides.forEach((slide) => slide.classList.add('is-active'));
    };

    const start = () => {
      stack();
      deck.classList.add('is-live');
      reveal = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            deck.classList.add('is-revealed');
            reveal?.disconnect();
            const slide = slides.find((item) => item.classList.contains('is-active'));
            if (slide) play(slide);
          }
        },
        { rootMargin: '0px 0px -40% 0px' },
      );
      reveal.observe(deck);
      show(0);

      let current = 0;
      let last = 0;

      // A slide turns only once the scroll is a fifth of a unit past the boundary, and
      // it holds that far back again, so a flick cannot run the deck past the reader.
      const HOLD = 0.22;
      const pick = (position: number) => {
        let next = current;
        while (next < slides.length - 1 && position >= next + 1 + HOLD) next += 1;
        while (next > 0 && position <= next - HOLD) next -= 1;
        return next;
      };

      // A touch scroll keeps accelerating after the finger lifts, so on touch the index
      // is applied once the scroll settles; a wheel already moves in steps.
      const turn = (index: number) => {
        if (index === current) return;
        current = index;
        show(index);
      };

      trigger = ScrollTrigger.create({
        trigger: deck,
        start: 'top top',
        end: 'bottom bottom',
        onUpdate: (self) => {
          last = self.progress;
          if (bar) bar.style.transform = `scaleX(${self.progress})`;
          const index = pick(last * slides.length);
          // A figure that moves with the scroll reads this instead of owning a trigger.
          deck.dispatchEvent(
            new CustomEvent('deck:progress', {
              detail: { index, local: Math.min(1, Math.max(0, last * slides.length - index)) },
            }),
          );
          if (!touch) {
            turn(index);
            return;
          }
          if (index === current) return;
          window.clearTimeout(settled);
          settled = window.setTimeout(() => turn(pick(last * slides.length)), 140);
        },
      });
    };

    const apply = () => {
      if (reduce.matches || tooSmall.matches) stack();
      else start();
    };

    apply();
    reduce.addEventListener('change', apply);
    tooSmall.addEventListener('change', apply);
  });
</script>
