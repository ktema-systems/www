---
interface Props {
  id: string;
  label: string;
  title: string;
  lede?: string;
  band?: boolean;
}

const { id, label, title, lede, band = false } = Astro.props;
---

<section class:list={['section', band && 'band']} id={id}>
  <div class="wrap section__grid">
    <p class="section__label">{label}</p>
    <div class="section__body">
      <div class="section__head">
        <h2>{title}</h2>
        {lede && <p class="lede">{lede}</p>}
      </div>
      <slot />
    </div>
  </div>
</section>
