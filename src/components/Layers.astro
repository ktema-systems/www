---
import Section from './Section.astro';
import { creed, delta, product } from '../config';

// The three roles as the pitch states them, each able to run alone; the stage
// tells a reader what ships today and what is being written.
const layers = [
  {
    name: 'Ktema',
    meta: 'record and evidence, working build',
    line: 'Facts, intents, and hints, held as one record on the machine.',
    href: product.href,
    link: 'The engine',
  },
  {
    name: 'Kletos',
    meta: 'execution, running today',
    line: 'What was asked is bound to what was done, and the result is written back with what limited it.',
  },
  {
    name: 'Krisis',
    meta: 'constraints and judgment, in development',
    line: 'The limits and the decision: which model answers, at what cost, and on which terms.',
  },
];
---

<Section
  id="products"
  label="Products"
  title="One record, three roles"
  lede="Every act is kept as one record that ties three things together: what was asked, what was done, and what limited it. Ktema holds the record, Kletos performs the work, and Krisis sets the limits and judges the result. Any one runs alone; together they account for the whole act."
>
  <p class="layers__claim">
    Storage on a card keeps bytes. This record is a space: a question that spans time,
    origin, and outcome is answered on the device, with no database and no index to
    maintain.
  </p>

  <div class="cards cards--layers">
    <div class="card card--wide" id="product-delta">
      <span class="card__value">Delta</span>
      <p class="card__meta">the cockpit and campaigns</p>
      <p>What is running, who claimed it, what bounded it, and what it left behind.</p>
      <p>
        A campaign turns one run into a package: the situation, the briefing, the objectives,
        and the record. The package can be replayed and compared.
      </p>
      <p><a href={delta.href}>The cockpit</a></p>
    </div>
    {
      layers.map((layer) => {
        const motto = creed.find((entry) => entry.product === layer.name)?.line;

        return (
          <div class="card" id={`product-${layer.name.toLowerCase()}`}>
            <span class="card__value">{layer.name}</span>
            {motto && <p class="card__motto">{motto}</p>}
            <p class="card__meta">{layer.meta}</p>
            <p>{layer.line}</p>
            {layer.href && (
              <p>
                <a href={layer.href}>{layer.link}</a>
              </p>
            )}
          </div>
        );
      })
    }
  </div>
</Section>

<style>
  .cards--layers {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .layers__claim {
    max-width: 52rem;
    padding: 2px 0 2px 18px;
    border-left: 2px solid var(--accent);
    color: var(--fg);
    font-size: 17px;
    line-height: 1.6;
  }

  .card--wide {
    grid-column: 1 / -1;
  }

  .card__meta {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--fg-3);
  }

  .card__motto {
    color: var(--accent);
    font-size: 15px;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .cards--layers {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
