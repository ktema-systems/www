---
import Section from './Section.astro';
import { creed, delta } from '../config';

// The three pillars are the technical core and stand on their own. The platform and
// the transport layer sit under them in the stack, so they are drawn as two wider
// cells beneath the three.
const pillars = [
  {
    name: 'Ktema',
    meta: 'the time-machine data vault',
    line: 'The record that knows where it is, so the log grows and the engine\'s memory does not.',
    href: '/ktema',
    link: 'Ktema',
  },
  {
    name: 'Kletos',
    meta: 'the autopilot',
    line: 'Turns a stated intent into physical execution, and writes the result back to the same record.',
    href: '/kletos',
    link: 'Kletos',
  },
  {
    name: 'Krisis',
    meta: 'the authority',
    line: 'Sets what each action may do, chooses which model answers and at what cost, and keeps the work inside the rules a deployment declared. A machine can be given more autonomy when its authority is explicit.',
    href: '/krisis',
    link: 'Krisis',
  },
];

const surface = [
  {
    name: 'Delta',
    meta: 'the cockpit',
    line: 'The cockpit where operators see and command robots, drones, codebases, and the people who run them in one unified space. On the Ktema stack, it reads the same record the machine wrote.',
    href: delta.href,
    link: 'Delta',
  },
  {
    name: 'Telos',
    meta: 'the transport layer',
    line: 'Teleports live execution states between agents, people, and spaces, so an operator can stand inside a machine\'s spatiotemporal coordinate space and replay what it saw.',
    href: '/telos',
    link: 'Telos',
  },
  {
    name: 'Kleis',
    meta: 'the seal',
    line: 'The cryptographic authorization engine: the seal that makes a copy of the files worthless, and the proof that the holder was in control.',
    href: '/kleis',
    link: 'Kleis',
  },
];
---

<Section
  id="products"
  label="Products"
  title="All stacks for autonomous entities"
  lede="Six parts, one record. Three carry the machine: Ktema keeps the record, Kletos acts on it, and Krisis authorizes what it may do. Three are how a person reaches it: Delta is the cockpit, Telos is the transport, and Kleis is the seal that proves who was in control."
>
  <p class="layers__claim">
    A record in Ktema knows where it is, so a question about time, source, or outcome is answered
    from the address and nothing has to be built as the log grows. The same record that explains a
    move computes the next state, so a machine can act, be bounded, and be explained from one place.
  </p>

  <div class="cards cards--layers">
    {
      pillars.map((layer) => {
        const motto = creed.find((entry) => entry.product === layer.name)?.line;

        return (
          <div class="card" id={`product-${layer.name.toLowerCase()}`}>
            <span class="card__value">{layer.name}</span>
            {motto && <p class="card__motto">{motto}</p>}
            <p class="card__meta">{layer.meta}</p>
            <p>{layer.line}</p>
            {layer.href && (
              <p>
                <a href={layer.href}>{layer.link}</a>
              </p>
            )}
          </div>
        );
      })
    }
    {
      surface.map((layer) => (
        <div class="card card--surface" id={`product-${layer.name.toLowerCase()}`}>
          <span class="card__value">{layer.name}</span>
          <p class="card__meta">{layer.meta}</p>
          <p>{layer.line}</p>
          {layer.href && (
            <p>
              <a href={layer.href}>{layer.link}</a>
            </p>
          )}
        </div>
      ))
    }
  </div>
</Section>

<style>
  /* Six columns give three cards per row, so the three carriers and the three
     surfaces each fill one row without a stray cell. */
  .cards--layers {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .cards--layers > .card {
    position: relative;
    grid-column: span 2;
  }

  /* The three carriers are the core, so they carry a faint accent wash and a
     hairline at the top edge. The three surfaces stay neutral, and the grid
     lines read as the only strong division between them. */
  .cards--layers > .card:not(.card--surface) {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--accent) 17%, transparent),
        color-mix(in srgb, var(--accent) 4%, transparent) 62%,
        transparent
      ),
      var(--bg);
  }

  .cards--layers > .card:not(.card--surface):hover {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--accent) 22%, transparent),
        color-mix(in srgb, var(--accent) 7%, transparent) 62%,
        transparent
      ),
      var(--bg-2);
  }

  .cards--layers > .card:not(.card--surface)::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--accent),
      color-mix(in srgb, var(--accent) 35%, transparent) 55%,
      transparent
    );
  }

  .layers__claim {
    max-width: 52rem;
    padding: 2px 0 2px 18px;
    border-left: 2px solid var(--accent);
    color: var(--fg);
    line-height: 1.6;
  }

  .card__meta {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--fg-3);
  }

  .card__motto {
    color: var(--accent);
    font-size: 15px;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .cards--layers {
      grid-template-columns: minmax(0, 1fr);
    }

    .cards--layers > .card {
      grid-column: auto;
    }
  }
</style>
