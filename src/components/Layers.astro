---
import Section from './Section.astro';
import { creed, delta } from '../config';

// The three pillars are the technical core and stand on their own. The platform and
// the transport layer sit under them in the stack, so they are drawn as two wider
// cells beneath the three.
const pillars = [
  {
    name: 'Ktema',
    meta: 'the black box',
    line: 'A deterministic record the machine keeps on itself, with no operating system and no database, that answers multi-dimensional questions.',
    href: '#contact',
    link: 'Contact',
  },
  {
    name: 'Kletos',
    meta: 'the autopilot',
    line: 'Turns a stated intent into physical execution, and writes the result back to the same record.',
  },
  {
    name: 'Krisis',
    meta: 'the kill switch',
    line: 'Sets authority and limits, decides which model answers and at what cost, and can stop the work.',
  },
];

const surface = [
  {
    name: 'Delta',
    meta: 'the cockpit',
    line: 'The platform a person commands the stack from, for agents, signals, machines, people, and outside systems. On the Ktema stack, the cockpit reads the same record the machine wrote.',
    href: delta.href,
    link: 'Delta',
  },
  {
    name: 'Telos',
    meta: 'the transport layer',
    line: 'Moves work between agents, people, and spaces by coordinate, and carries the operator into the machine.',
  },
];
---

<Section
  id="products"
  label="Products"
  title="One accountable stack for autonomous machines"
  lede="Five parts, one record. Ktema is the black box that keeps it. Kletos is the autopilot that acts on it. Krisis is the kill switch that bounds it. Delta is the cockpit where a person commands the whole stack. Telos is the transport layer that moves the work."
>
  <p class="layers__claim">
    Storage keeps bytes. This record answers questions across time, source, and outcome, on the
    device, with no database and no index to maintain. Every part answers to it, so a machine can
    act, be bounded, and be explained from one place.
  </p>

  <div class="cards cards--layers">
    {
      pillars.map((layer) => {
        const motto = creed.find((entry) => entry.product === layer.name)?.line;

        return (
          <div class="card" id={`product-${layer.name.toLowerCase()}`}>
            <span class="card__value">{layer.name}</span>
            {motto && <p class="card__motto">{motto}</p>}
            <p class="card__meta">{layer.meta}</p>
            <p>{layer.line}</p>
            {layer.href && (
              <p>
                <a href={layer.href}>{layer.link}</a>
              </p>
            )}
          </div>
        );
      })
    }
    {
      surface.map((layer) => (
        <div class="card card--surface" id={`product-${layer.name.toLowerCase()}`}>
          <span class="card__value">{layer.name}</span>
          <p class="card__meta">{layer.meta}</p>
          <p>{layer.line}</p>
          {layer.href && (
            <p>
              <a href={layer.href}>{layer.link}</a>
            </p>
          )}
        </div>
      ))
    }
  </div>
</Section>

<style>
  /* Six columns let the three pillars take two each and the two layers under them
     take three each, so both rows span the full width without a stray cell. */
  .cards--layers {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .cards--layers > .card {
    grid-column: span 2;
  }

  .cards--layers > .card--surface {
    grid-column: span 3;
  }

  .layers__claim {
    max-width: 52rem;
    padding: 2px 0 2px 18px;
    border-left: 2px solid var(--accent);
    color: var(--fg);
    font-size: 17px;
    line-height: 1.6;
  }

  .card__meta {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--fg-3);
  }

  .card__motto {
    color: var(--accent);
    font-size: 15px;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .cards--layers {
      grid-template-columns: minmax(0, 1fr);
    }

    .cards--layers > .card,
    .cards--layers > .card--surface {
      grid-column: auto;
    }
  }
</style>
