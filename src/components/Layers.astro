---
import Section from './Section.astro';

// The stack as the reader meets it first: the six names, what each one does in a
// phrase, and the page where it is explained. The depth stays on the product pages,
// so this band is an index rather than a second telling of the same six parts.
interface Props {
  id?: string;
  eyebrow?: string;
}

const { id = 'products', eyebrow = 'Stack' } = Astro.props;

const parts = [
  {
    name: 'Ktema',
    role: 'Record',
    href: '/ktema',
    body: 'The engine that answers a question from its own record, with no index to maintain.',
  },
  {
    name: 'Kletos',
    role: 'Execution',
    href: '/kletos',
    body: 'An ask becomes verified work, and the work becomes a fact on the record.',
  },
  {
    name: 'Krisis',
    role: 'Judgment',
    href: '/krisis',
    body: 'The rules the work runs inside: which model, at what cost, on whose authority.',
  },
  {
    name: 'Delta',
    role: 'Operation',
    href: '/delta',
    body: 'The cockpit where a run is seen, and the intent changed from where it is read.',
  },
  {
    name: 'Telos',
    role: 'Transport',
    href: '/telos',
    body: 'Live state moved between agents, people, and spaces by address.',
  },
  {
    name: 'Kleis',
    role: 'Authorization',
    href: '/kleis',
    body: 'The key a holder presents, and the proof that the holder was in control.',
  },
];
---

<Section
  id={id}
  label={eyebrow}
  title="Six parts, one record format."
  lede="Each part stands on its own, and together they carry one record from the ask to the proven act."
>
  <ul class="stack">
    {
      parts.map((part) => (
        <li>
          <a class="stack__part" href={part.href}>
            <span class="stack__role">{part.role}</span>
            <span class="stack__name">{part.name}</span>
            <span class="stack__body">{part.body}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /* Six parts on one screen: the grid is the index, and a part is one click from the
     page that explains it. */
  .stack {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }

  .stack li {
    display: flex;
  }

  .stack__part {
    display: grid;
    gap: 6px;
    width: 100%;
    padding: 22px 22px 24px;
    background: var(--bg);
    text-decoration: none;
    transition: background 220ms var(--ease);
  }

  .stack__part:hover,
  .stack__part:focus-visible {
    background: var(--bg-2);
  }

  .stack__role {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .stack__name {
    font-size: 1.25rem;
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .stack__body {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--fg-2);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .stack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .stack {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
