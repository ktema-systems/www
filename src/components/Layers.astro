---
import PanelDeck from './PanelDeck.astro';

// The stack as a deck: one part per panel, and only what that part is worth to the
// system. The six names sit in the footer, so the progress is also the menu into the
// stack, and a reader who wants Ktema alone can go straight to it.
const parts = [
  {
    label: 'Ktema',
    kicker: 'Ktema · the record',
    title: 'The record knows where it is',
    body: 'The machine keeps its own history and answers from the address, so the log grows and the memory the engine needs does not.',
  },
  {
    label: 'Kletos',
    kicker: 'Kletos · the execution',
    title: 'An intent becomes work, and the work becomes a fact',
    body: 'The chain from what was asked to what was done stays in one record, so a run can be read back the way it happened.',
  },
  {
    label: 'Krisis',
    kicker: 'Krisis · the authority',
    title: 'The rules the work runs inside',
    body: 'What each action may do, which model answers, and at what cost, declared where the work runs.',
  },
  {
    label: 'Delta',
    kicker: 'Delta · the cockpit',
    title: 'The cockpit where a run is seen and changed',
    body: 'Robots, drones, agents, and the people who run them, read and commanded from inside the run.',
  },
  {
    label: 'Telos',
    kicker: 'Telos · the transport',
    title: 'A step to another place is an address',
    body: 'Live execution states move between agents, people, and spaces without walking a tree or scanning a path.',
  },
  {
    label: 'Kleis',
    kicker: 'Kleis · the seal',
    title: 'It decides who enters',
    body: 'The key a holder presents, the seal that makes a copy worthless, and the proof that the holder was in control.',
  },
];

const panels = parts.map(({ kicker, title, body }) => ({ kicker, title, body }));
const labels = parts.map((part) => part.label);
---

<PanelDeck
  id="products"
  eyebrow="Stack"
  title="Six parts. Take the ones your system needs."
  lede="Each part stands on its own and meets the others on the same record. A device team can ship Ktema alone; an operating team can start with Delta and add the engine when the record has to be proved on the machine."
  panels={panels}
  labels={labels}
/>
