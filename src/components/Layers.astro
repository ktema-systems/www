---
import PanelDeck from './PanelDeck.astro';

interface Props {
  id?: string;
  eyebrow?: string;
}

const { id = 'products', eyebrow = 'Stack' } = Astro.props;

// The stack as a deck: one part per panel, and only what that part is worth to the
// system. The six names sit in the footer, so the progress is also the menu into the
// stack, and a reader who wants Ktema alone can go straight to it.
const parts = [
  {
    label: 'Ktema',
    kicker: 'Ktema · the record',
    title: 'The query engine that needs no index',
    body: 'It answers across several axes from the record itself, beside Postgres, SQLite, or the database you already run, with no index to maintain.',
  },
  {
    label: 'Kletos',
    kicker: 'Kletos · the execution',
    title: 'An intent becomes work, and the work becomes a fact',
    body: 'The operating system for a full-stack agent workflow: the chain from what was asked to what was done stays in one record.',
  },
  {
    label: 'Krisis',
    kicker: 'Krisis · the authority',
    title: 'The rules the work runs inside',
    body: 'Smart contracts and governance: who moved this agent, with what authority, and on which terms.',
  },
  {
    label: 'Delta',
    kicker: 'Delta · the cockpit',
    title: 'The cockpit where a run is seen and changed',
    body: 'Software agents, robots, drones, and the people who run them, orchestrated from inside the run.',
  },
  {
    label: 'Telos',
    kicker: 'Telos · the transport',
    title: 'A step to another place is an address',
    body: 'Work in progress moves between agents, people, and spaces, so an operator can stand inside the run.',
  },
  {
    label: 'Kleis',
    kicker: 'Kleis · the seal',
    title: 'It decides who enters',
    body: 'The key a holder presents, the seal that makes a copy worthless, and the proof that the holder was in control.',
  },
];

const panels = parts.map(({ kicker, title, body }) => ({ kicker, title, body }));
const labels = parts.map((part) => part.label);
---

<PanelDeck
  id={id}
  eyebrow={eyebrow}
  title="Deterministic Record. Accountable Execution. Portable Control."
  lede="Ktema Systems is the whole stack, and each part stands on its own. The engine keeps the record, and it runs in software or on a small device. A software team can add Ktema to a service; an operating team can start with Delta across agents and machines; a device team can ship the same engine."
  panels={panels}
  labels={labels}
/>
