---
import Section from './Section.astro';
import { creed, delta } from '../config';

// The four layers, each able to run alone. The business frame is a role in the
// machine rather than a technical tier, so a buyer can say what each one does.
const layers = [
  {
    name: 'Ktema',
    meta: 'the black box',
    line: 'Keeps the record on the machine, with no operating system and no database.',
    href: '#contact',
    link: 'Contact',
  },
  {
    name: 'Kletos',
    meta: 'the autopilot',
    line: 'Turns a stated intent into physical execution, and writes the result back to the same record.',
  },
  {
    name: 'Krisis',
    meta: 'the kill switch',
    line: 'Sets the authority and the limits, and can stop the work.',
  },
  {
    name: 'Telos',
    meta: 'the transport layer',
    line: 'Moves work between agents, people, and spaces, and carries the operator into the machine.',
  },
];
---

<Section
  id="products"
  label="Products"
  title="One accountable stack for autonomous machines"
  lede="Five parts, one record. Ktema is the black box that keeps it. Kletos is the autopilot that acts on it. Krisis is the kill switch that bounds it. Telos is the transport layer that moves the work. Delta is the cockpit where a person commands the whole stack."
>
  <p class="layers__claim">
    Every part answers to the same record, so a machine can act, be bounded, and be explained from
    one place.
  </p>

  <div class="cards cards--layers">
    <div class="card card--wide" id="product-delta">
      <span class="card__value">Delta</span>
      <p class="card__meta">the cockpit</p>
      <p>Every kind of autonomous workforce in one space: agents, signals, machines, people, and outside systems.</p>
      <p>The platform a person commands the stack from. On the Ktema stack, the cockpit reads the same record the machine wrote.</p>
      <p><a href={delta.href}>Delta</a></p>
    </div>
    {
      layers.map((layer) => {
        const motto = creed.find((entry) => entry.product === layer.name)?.line;

        return (
          <div class="card" id={`product-${layer.name.toLowerCase()}`}>
            <span class="card__value">{layer.name}</span>
            {motto && <p class="card__motto">{motto}</p>}
            <p class="card__meta">{layer.meta}</p>
            <p>{layer.line}</p>
            {layer.href && (
              <p>
                <a href={layer.href}>{layer.link}</a>
              </p>
            )}
          </div>
        );
      })
    }
  </div>
</Section>

<style>
  .cards--layers {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .layers__claim {
    max-width: 52rem;
    padding: 2px 0 2px 18px;
    border-left: 2px solid var(--accent);
    color: var(--fg);
    font-size: 17px;
    line-height: 1.6;
  }

  .card--wide {
    grid-column: 1 / -1;
  }

  .card__meta {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--fg-3);
  }

  .card__motto {
    color: var(--accent);
    font-size: 15px;
    line-height: 1.35;
  }

  @media (max-width: 1100px) {
    .cards--layers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .cards--layers {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
