---
import Section from './Section.astro';

const LEFT = 190;
const RIGHT = 750;
const PLOT = RIGHT - LEFT;
const FLOOR = 128;
const CEILING = 2e10;

const logFloor = Math.log10(FLOOR);
const logCeiling = Math.log10(CEILING);

const xOf = (bytes: number) =>
  Math.round((LEFT + ((Math.log10(bytes) - logFloor) / (logCeiling - logFloor)) * PLOT) * 10) / 10;

const ROW_Y: Record<number, number> = { 4: 70, 3: 160, 2: 250 };

const systems = [
  { name: 'FlashDB', bytes: 256, row: 2, highlight: false },
  { name: 'Ktema', bytes: 4309, row: 4, highlight: true },
  { name: 'SQLite, minimum', bytes: 102400, row: 3, highlight: false },
  { name: 'MoteDB', bytes: 35 * 1024 ** 2, row: 3, highlight: false },
  { name: 'remdb', bytes: 128 * 1024 ** 2, row: 2, highlight: false },
  { name: 'shodh-redb', bytes: 8 * 1024 ** 3, row: 3, highlight: false },
].map((system) => ({ ...system, x: xOf(system.bytes), y: ROW_Y[system.row] }));

const rowLabels = [
  { row: 4, lines: ['multi-axis', 'no index'] },
  { row: 3, lines: ['multi-axis', 'indexed'] },
  { row: 2, lines: ['single-axis', 'key or time series'] },
];

const units: [number, string][] = [
  [1024, '1 KB'],
  [1024 ** 2, '1 MB'],
  [1024 ** 3, '1 GB'],
  [1024 ** 3 * 10, '10 GB'],
];

const ticks = units.map(([bytes, label]) => ({ x: xOf(bytes), label }));

const mcuRight = xOf(65536);

const rows = [
  {
    system: 'FlashDB',
    model: 'key and time series',
    index: 'key index',
    os: 'none',
    memory: 'RAM near zero, 5 to 7 KB of flash',
  },
  {
    system: 'shodh-redb',
    model: 'embedded database, multi-modal',
    index: 'B-tree',
    os: 'none',
    memory: '8 GB in the published example',
  },
  {
    system: 'remdb',
    model: 'key-value',
    index: 'hash and secondary trees',
    os: 'none',
    memory: '128 MB in the published example',
  },
  {
    system: 'spatio',
    model: 'spatial',
    index: 'R-tree and geohash',
    os: 'Linux',
    memory: 'low, with a runtime',
  },
  {
    system: 'SQLite, minimum',
    model: 'multi-axis through an index',
    index: 'B-tree',
    os: 'needs one',
    memory: 'about 100 KB of heap',
  },
  {
    system: 'MoteDB',
    model: 'vector and multi-model',
    index: 'DiskANN and others',
    os: 'Linux',
    memory: 'up to 35 MB, P99 ≤ 50 ms',
  },
  {
    system: 'Fjall',
    model: 'key-value',
    index: 'LSM tree',
    os: 'Linux',
    memory: 'not published',
  },
  {
    system: 'Qdrant Edge',
    model: 'vector, in-process',
    index: 'HNSW',
    os: 'none',
    memory: 'minimal footprint, not published',
  },
  {
    system: 'Ktema',
    model: 'multi-axis over a coordinate space',
    index: 'none',
    os: 'none',
    memory: '4.2 KB heap, 141 KB flash',
    feature: true,
  },
];
---

<Section
  id="competition"
  label="Competition"
  title="Every multi-axis system here carries an index, except one"
>
  <svg class="chart" viewBox="0 0 780 366" role="img" aria-labelledby="chart-title">
    <title id="chart-title"
      >Query model against the memory each solution uses, from published figures</title
    >

    <rect class="chart__band" x={LEFT} y="40" width={mcuRight - LEFT} height="250"></rect>
    <text class="chart__band-label" x={(LEFT + mcuRight) / 2} y="56">MCU class</text>

    {
      Object.values(ROW_Y).map((y) => (
        <line class="chart__grid" x1={LEFT} y1={y} x2={RIGHT} y2={y} />
      ))
    }
    <line class="chart__axis" x1={LEFT} y1="40" x2={LEFT} y2="290" />
    <line class="chart__axis" x1={LEFT} y1="290" x2={RIGHT} y2="290" />

    {
      rowLabels.map((row) => (
        <>
          <text class="chart__row" x={LEFT - 14} y={ROW_Y[row.row] - 3} text-anchor="end">
            {row.lines[0]}
          </text>
          <text class="chart__row" x={LEFT - 14} y={ROW_Y[row.row] + 11} text-anchor="end">
            {row.lines[1]}
          </text>
        </>
      ))
    }

    {
      systems.map((system) => (
        <>
          <circle
            class:list={['chart__point', system.highlight && 'chart__point--feature']}
            cx={system.x}
            cy={system.y}
            r={system.highlight ? 7 : 5}
          />
          <text
            class:list={['chart__label', system.highlight && 'chart__label--feature']}
            x={system.x}
            y={system.y - 14}
            text-anchor="middle"
          >
            {system.name}
          </text>
        </>
      ))
    }

    {
      ticks.map((tick) => (
        <>
          <line class="chart__tick" x1={tick.x} y1="290" x2={tick.x} y2="296" />
          <text class="chart__tick-label" x={tick.x} y="312" text-anchor="middle">
            {tick.label}
          </text>
        </>
      ))
    }

    <text class="chart__axis-title" x={(LEFT + RIGHT) / 2} y="340" text-anchor="middle"
      >memory the solution uses, published figures</text
    >
    <text class="chart__foot" x={RIGHT} y="362" text-anchor="end"
      >not plotted: spatio, Fjall, Qdrant Edge (no published memory figure)</text
    >
  </svg>

  <div class="prose">
    <p>
      FlashDB runs in less memory than any system here and answers key and time-series questions
      only. shodh-redb is <code>no_std</code> and multi-modal, but its published example runs at
      8 GB of RAM. remdb, Fjall, and a minimal SQLite build answer through an index, and MoteDB
      and spatio index on Linux and work in tens of megabytes. Every multi-axis system in the
      table except Ktema carries an index, and the ones with published figures need an operating
      system or more memory than a microcontroller carries. Ktema answers the same three-axis
      query from a 4.2 KB heap with no index and no operating system.
    </p>
  </div>

  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          <th>System</th>
          <th>Query model</th>
          <th>Index</th>
          <th>Operating system</th>
          <th>Memory</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class:list={[row.feature && 'feature']}>
              <td class="lead">{row.system}</td>
              <td>{row.model}</td>
              <td>{row.index}</td>
              <td>{row.os}</td>
              <td>{row.memory}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="note">
    Figures for the other systems are from their published documentation. FlashDB publishes its
    RAM as near zero and is drawn at the axis floor. The remdb and shodh-redb figures are their
    published examples.
  </p>
</Section>

<style>
  .chart {
    display: block;
    width: 100%;
    height: auto;
  }

  .chart__band {
    fill: var(--paper-3);
  }

  .chart__band-label {
    font-size: 10px;
    fill: var(--ink-3);
    text-anchor: middle;
  }

  .chart__grid {
    stroke: var(--rule);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .chart__axis {
    stroke: var(--rule-2);
    stroke-width: 1;
  }

  .chart__tick {
    stroke: var(--rule-2);
    stroke-width: 1;
  }

  .chart__point {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
  }

  .chart__point--feature {
    fill: var(--ink);
  }

  .chart__label {
    font-size: 10px;
    fill: var(--ink-2);
  }

  .chart__label--feature {
    font-weight: 600;
    fill: var(--ink);
  }

  .chart__row,
  .chart__tick-label {
    font-size: 10.5px;
    fill: var(--ink-3);
  }

  .chart__axis-title,
  .chart__foot {
    font-size: 11px;
    fill: var(--ink-3);
  }

  .chart__foot {
    font-size: 10px;
  }
</style>
