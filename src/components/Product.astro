---
import Section from './Section.astro';
import { site } from '../config';

const spec = [
  {
    term: 'Shipped as',
    detail:
      'A component your team adds to the build it already ships. There is nothing to port and no platform to stand up.',
  },
  {
    term: 'Self-contained',
    detail:
      'One component carries the record, how it is stored, and how it answers multi-dimensional questions.',
  },
  {
    term: 'Answers',
    detail:
      'Multi-dimensional questions about what happened and why, on the device, from the record it keeps.',
  },
  {
    term: 'Travels',
    detail:
      'A record written on one machine reads on another, with no conversion step and no export.',
  },
  {
    term: 'Reaches',
    detail:
      'The same build runs on a bare chip and on a machine in a data center, so one product line keeps one record format.',
  },
];
---

<Section
  id="product"
  label="Product"
  title="Runs inside the product you already ship"
  lede="Your team adds Ktema to the build it already has, and the product can answer multi-dimensional questions from its own record."
>
  <dl class="spec">
    {
      spec.map((row) => (
        <>
          <dt>{row.term}</dt>
          <dd>{row.detail}</dd>
        </>
      ))
    }
  </dl>

  <div>
    <h3>Rem, the reference product</h3>
    <div class="prose">
      <p>
        Rem is a reference product: an offline memory for spatial AI that keeps its data on the
        machine and answers multi-dimensional questions from it. It uses Ktema from a desktop app, a
        command line, and an AI assistant, and it shows the engine working outside the chip.
      </p>
    </div>
  </div>
</Section>

<style>
  .link-row {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 14px;
  }
</style>
