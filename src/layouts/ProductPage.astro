---
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import ProductFigure from '../components/ProductFigure.astro';
import Section from '../components/Section.astro';
import Contact from '../components/Contact.astro';
import { companyCta, productMenu } from '../config';

// The shell every product page but Delta and Ktema uses: a hero, the blocks the
// product states about itself, and one way in. The shell is shared so the six pages
// cannot drift in type, spacing, or the shape of a block.
interface Row {
  k: string;
  v: string;
}

interface Block {
  id: string;
  label: string;
  title: string;
  lede?: string;
  rows?: Row[];
  prose?: string[];
  note?: string;
}

interface Props {
  name: string;
  href: string;
  title: string;
  subline: string;
  body?: string;
  description: string;
  lede: string;
  blocks: Block[];
  contact: { title: string; lede: string; body: string };
  note?: string;
  // The one drawing that shows what the product does, drawn under the hero copy.
  figure?: 'kletos' | 'kleis' | 'krisis' | 'telos';
}

const {
  name,
  href,
  title,
  subline,
  body,
  description,
  lede,
  blocks,
  contact,
  note = '',
  figure,
} = Astro.props;

// The strip lists every section the page carries, in the order the page reads, so a
// reader can jump to the part they came for instead of scrolling the whole page.
const nav = [
  ...blocks.map((block) => ({ label: block.label, href: `#${block.id}` })),
  { label: 'Contact', href: '#contact' },
];
---

<Base
  title={`${name}: ${title}`}
  description={description}
  nav={nav}
  cta={companyCta}
  products={productMenu}
  current={href}
  openProducts
>
  <Hero title={title} subline={subline} lede={lede} body={body}>
    {figure && <ProductFigure slot="figure" kind={figure} />}
    <a class="btn btn--accent" href="#contact" slot="actions">Talk to us</a>
    {note && <p class="hero-note" slot="actions">{note}</p>}
  </Hero>

  {
    blocks.map((block) => (
      <Section id={block.id} label={block.label} title={block.title} lede={block.lede}>
        {block.prose?.map((paragraph) => (
          <div class="prose">
            <p>{paragraph}</p>
          </div>
        ))}
        {block.rows && (
          <dl class="spec">
            {block.rows.map((row) => (
              <>
                <dt>{row.k}</dt>
                <dd>{row.v}</dd>
              </>
            ))}
          </dl>
        )}
        {block.note && <p class="note">{block.note}</p>}
      </Section>
    ))
  }

  <Contact title={contact.title} lede={contact.lede} body={contact.body} />
</Base>
