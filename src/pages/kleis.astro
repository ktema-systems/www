---
import ProductPage from '../layouts/ProductPage.astro';

const blocks = [
  {
    id: 'gate',
    label: 'The gate',
    title: 'It decides who enters',
    lede: 'Two different questions, and Kleis answers the first.',
    rows: [
      { k: 'Who enters', v: 'Kleis, from the key the holder presents.' },
      { k: 'What may be done', v: 'Krisis, from the rules the deployment declared.' },
    ],
  },
  {
    id: 'boundary',
    label: 'The boundary',
    title: 'The format is public. The proof is not.',
    prose: [
      'A second implementation can recompute an address from the public format. The proof is the part a copy cannot inherit: the key a holder presents, the seal that makes the files worthless without it, and the proof that the holder was in control. A deployment that needs that proof carries Kleis.',
    ],
  },
  {
    id: 'line',
    label: 'Licensing',
    title: 'A separate product line',
    prose: ['A deployment that does not carry Kleis stays on the free tier.'],
  },
  {
    id: 'open',
    label: 'Not settled',
    title: 'The two-key mode',
    prose: [
      'A two-key mode for acts that cannot be undone is a candidate. Its specification is still open.',
    ],
  },
];
---

<ProductPage
  name="Kleis"
  href="/kleis"
  title="The seal on the record."
  subline="A copy is worth nothing without the holder."
  description="Kleis is the physical gate into the record: the key a holder presents, the seal that makes a copy worth nothing, and the proof that the holder was there."
  lede="The key a holder presents, the seal that makes a copy of the files worth nothing, and the proof that the holder was there."
  body="It decides who enters, not what the holder may do."
  blocks={blocks}
  contact={{
    title: 'Decide who enters',
    lede: 'If a copy of the files has to be worth nothing without the holder, we should talk. We work with design partners now.',
    body: 'The specification is moving. Bring the acts that cannot be undone, and we will tell you what the seal has to prove.',
  }}
/>
