---
import ProductPage from '../layouts/ProductPage.astro';

// The seal's page. The buyer's questions: who gets in, what the gate does, what the key
// opens, which acts need two of them, what runs today, and what the paid half adds. The
// page names no part of the build.
const blocks = [
  {
    id: 'gate',
    label: 'The gate',
    title: 'It decides who enters',
    lede: 'Two different questions, and Kleis answers the first.',
    rows: [
      { k: 'Who enters', v: 'Kleis, from the key the holder presents.' },
      { k: 'What may be done', v: 'The rules the deployment declared.' },
    ],
    note: 'It sits in front of the record the deployment already keeps. It opens that record, and it sets no rule of its own.',
  },
  {
    id: 'does',
    label: 'What it does',
    title: 'The ignition, the gatekeeper, the proof',
    rows: [
      {
        k: 'The ignition',
        v: 'A holder presents a key and the machine wakes. The workspace opens with the workforce behind it.',
      },
      {
        k: 'The gatekeeper',
        v: "The record is sealed to the carrier. A copy of the files opens nothing, and the seal turns in the holder's hand alone.",
      },
      {
        k: 'The proof',
        v: 'A carrier cannot be copied like a file. Presenting it proves the holder without handing the secret over, and the record of the presentation is what an auditor, an insurer, or a court reads later.',
      },
    ],
    note: 'The format is public. The proof is the part a copy cannot inherit.',
  },
  {
    id: 'rooms',
    label: 'The key',
    title: 'One key, many rooms',
    rows: [
      {
        k: 'A room',
        v: 'The places, the entities, and the record of one deployment. A room says nothing about where the data is kept.',
      },
      {
        k: 'A key',
        v: 'A key opens its rooms and holds the identity that admits a holder.',
      },
      {
        k: 'Several rooms',
        v: 'One key can open more than one, and a room is opened by one key.',
      },
    ],
    note: 'An ordinary store joins a room without being converted.',
  },
  {
    id: 'double',
    label: 'Two keys',
    title: 'For the acts that cannot be undone',
    rows: [
      { k: 'The act', v: 'An agent proposes an act whose consequence cannot be undone.' },
      { k: 'The class', v: 'The deployment places that class of act under two holders, and holds it.' },
      { k: 'The first key', v: 'A holder presents a key. The gate stays closed.' },
      { k: 'The second key', v: 'A second holder presents a key inside the declared window.' },
      { k: 'The record', v: 'Both presentations sit beside the act in one record.' },
    ],
    note: 'Two different holders, one window, one record. A second presentation by the same holder is not a second key.',
  },
  {
    id: 'today',
    label: 'Today',
    title: 'What runs, and what is not built',
    rows: [
      {
        k: 'Without a key',
        v: 'A run keeps its record, and the record opens to anyone who holds the files.',
      },
      { k: 'With a key', v: 'A copy of the files opens nothing. Not built.' },
      { k: 'The interface', v: 'Runs today, and draws a run from its own record.' },
      { k: 'Two holders', v: 'Defined. It waits on the key.' },
    ],
    note: 'The free shape is what a person can run today. The sealed room is not built.',
  },
  {
    id: 'tiers',
    label: 'The tiers',
    title: 'What the free tier holds, and what the key adds',
    rows: [
      {
        k: 'Basic',
        v: 'The interface, the record, and the agent workforce, one space at a time, on one machine.',
      },
      {
        k: 'Pro',
        v: 'A key. A sealed room, several rooms on one key, extended stores, handover.',
      },
      {
        k: 'Enterprise',
        v: 'Keys and the middleware at the edge. Many machines under one key, audit reports, two holders before an act that cannot be undone.',
      },
    ],
    note: 'Basic is the shape that runs today, with no seal and no key in front of it. The paid half is sold twice: to a machine maker as middleware on the bill of materials, and to an operator as a key that opens their own record.',
  },
];
---

<ProductPage
  name="Kleis"
  href="/kleis"
  title="The seal on the record."
  subline="A copy is worth nothing without the holder."
  description="Kleis is the physical gate into the record: the key a holder presents, the seal that makes a copy worth nothing, and the proof that the holder was there."
  lede="A holder presents a key, the room opens, and the presentation is written as a proof."
  body="It decides who enters. What may be done is the deployment's terms."
  blocks={blocks}
  figure="kleis"
  note="The design-partner program is open. The free tier runs today; the sealed room is not built."
  contact={{
    title: 'Decide who enters',
    lede: 'If a copy of the files has to be worth nothing without the holder, we should talk.',
    body: 'The specification is moving. Bring the acts that cannot be undone, and we will tell you what the seal has to prove.',
  }}
/>
