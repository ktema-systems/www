---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AddressFigure from '../components/AddressFigure.astro';
import Product from '../components/Product.astro';
import ProofDeck from '../components/ProofDeck.astro';
import Contact from '../components/Contact.astro';
import { product, productCta, productNav } from '../config';

// The engine's page: what it is, what it measures, and how it ships. The market
// case and the comparison against other stores stay in the pitch.
---

<Base
  title={`${product.name}: deterministic storage engine`}
  description={product.description}
  nav={productNav}
  cta={productCta}
  current={product.href}
  openProducts
>
  <Hero
    eyebrow="Ktema"
    title="The questions your machine can answer on its own."
    lede="Ktema is a deterministic storage engine for multi-dimensional questions. It answers them on hardware that cannot run a database, with no operating system and no index."
    body="A software agent, a robot, a drive, or a medical monitor asks which readings moved together before the failure, or what happened in the last seconds. Ktema answers from the device's own history, with no server, no network, and no cloud round trip. The same engine is built to run from a microcontroller with no operating system to a data center, and on a space system where nothing can be serviced."
  >
    <AddressFigure slot="figure" />
  </Hero>
  <ProofDeck />
  <Product />
  <Contact
    title="Put the engine inside your product"
    lede="If your device has to answer multi-dimensional questions on the spot, we should talk. We are choosing the first design partners now."
    body="Ktema runs inside the product you already ship. It needs no server, no network, and no database, and it fits the memory a small device has. Tell us what your machine has to answer, and we will show you what that query looks like on the device."
  />
</Base>
