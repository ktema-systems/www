---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AddressFigure from '../components/AddressFigure.astro';
import Product from '../components/Product.astro';
import ProofDeck from '../components/ProofDeck.astro';
import DeviceRun from '../components/DeviceRun.astro';
import Section from '../components/Section.astro';
import Contact from '../components/Contact.astro';
import { companyCta, product, productMenu, type NavItem } from '../config';

// The engine's page: what it is, what it measures, and how it ships. The market
// case and the comparison against other stores stay in the pitch.
const productNav: readonly NavItem[] = [
  { label: 'Why', href: '#why' },
  { label: 'Engine', href: '#engine' },
  { label: 'Proof', href: '#proof' },
  { label: 'Device', href: '#device-run' },
  { label: 'Product', href: '#product' },
  { label: 'Contact', href: '#contact' },
];
---

<Base
  title={`${product.name}: deterministic storage engine`}
  description={product.description}
  nav={productNav}
  cta={companyCta}
  products={productMenu}
  current={product.href}
  openProducts
>
  <Hero
    title="The record answers on its own."
    subline="One engine from a data center to a two-dollar drone."
    lede="Ktema is a multi-dimensional query engine for products and services that have to answer for what they did. It answers across several axes in a service, beside the database you already run, or on hardware that cannot run one, with no operating system under the engine, no storage work at boot, and no index to maintain."
    body="A software agent, a robot, a drive, or a medical monitor asks which readings moved together before the failure, or what happened in the last seconds. Ktema answers from the record it keeps, with or without a server, a network, or a cloud round trip."
  >
    <a class="btn btn--accent" href="#contact" slot="actions">Talk to us</a>
    <p class="hero-note" slot="actions">
      The design-partner program is open. Public previews and the private beta are on the way.
    </p>
    <AddressFigure slot="figure" />
  </Hero>

  <Section
    id="why"
    label="Why"
    title="The system has to answer for what it did."
    lede="Three failures end a deployment. The record answers all three from the machine that made it."
    wide
  >
    <div class="cards cards--3">
      <div class="card">
        <span class="card__value">The incident</span>
        <p>
          Why it acted, what it saw, and what limited it, read from the machine's own record rather
          than from a log someone has to reconstruct.
        </p>
      </div>
      <div class="card">
        <span class="card__value">The link drop</span>
        <p>
          The record is made on the machine, so the question is answered there, with or without a
          server, a network, or a cloud in the path.
        </p>
      </div>
      <div class="card">
        <span class="card__value">The audit</span>
        <p>
          For medical, automotive, industrial, and energy products, the record is the evidence a
          regulator asks for. The CRA reporting duty already applies, and the AI Act asks for
          logging over the life of a high-risk system.
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="engine"
    label="Engine"
    title="A record written under its own address."
    lede="Ktema stores the record where the question will look for it. A reader computes the address from the fields instead of walking an index."
  >
    <dl class="spec">
      <dt>The address</dt>
      <dd>
        A record's fields are its coordinates. The engine computes the address from the record, so a
        writer and a reader arrive at the same place without a lookup.
      </dd>
      <dt>The record</dt>
      <dd>
        Three kinds of entry: a fact, an intent, and a hint. Each is written once, under its own
        coordinate.
      </dd>
      <dt>The question</dt>
      <dd>
        A question is a region on the same axes, such as one origin over a time window. The answer is
        the set of records whose coordinates fall inside it. No index, and no scan from the start of
        the log.
      </dd>
      <dt>The medium</dt>
      <dd>
        The engine asks the medium for a region, a write, and an erase. On a part that is a region of
        flash; in a service it is the storage the process already has. The record is append-only; a
        segment is the unit of recovery, and the memory the engine holds is bounded by one segment,
        not by the record count.
      </dd>
      <dt>The edge</dt>
      <dd>
        A Rust library with a C ABI, including read and query, at the application edge. It links into
        the build you already ship, or the service you already run: no operating system, no file
        system, and no database under the engine.
      </dd>
      <dt>The limit</dt>
      <dd>
        A question that needs a join across separate systems, or a record that may leave the process
        or the device, is a database's job. The engine is for the question answered where the record
        was made.
      </dd>
    </dl>
  </Section>

  <ProofDeck />
  <DeviceRun />
  <Product />
  <Contact
    title="Put the engine inside your product"
    lede="If your device has to answer multi-dimensional questions on the spot, we should talk."
    body="Ktema links into the product you already ship. It leaves the server, the network, and the database you already run where they are, and it fits the memory a small device carries. Tell us what your machine has to answer, and we will show you what that query looks like on the device."
  />
</Base>
