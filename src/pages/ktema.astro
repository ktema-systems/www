---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AddressFigure from '../components/AddressFigure.astro';
import Metrics from '../components/Metrics.astro';
import Product from '../components/Product.astro';
import Proof from '../components/Proof.astro';
import WhyNow from '../components/WhyNow.astro';
import Competition from '../components/Competition.astro';
import Company from '../components/Company.astro';
import Contact from '../components/Contact.astro';
import { product, productCta, productNav, site } from '../config';

// The engine's page: what it is, what it measures, and where it stands against the
// other stores. It is the layer the company page sells first, written out.
---

<Base
  title={`${product.name}: on-device storage engine`}
  description={product.description}
  nav={productNav}
  cta={productCta}
>
  <Hero
    title={site.tagline}
    lede="On-device storage engine for the record that autonomous machinery and physical agents act on, without an operating system or a database."
    body="A software agent, a robot, a drive, or a medical monitor keeps its own history and answers from it: which readings moved together before the failure, what happened in the last seconds. No server, no network, no cloud round trip. The same engine runs from a microcontroller to a data center, and out to space systems."
  >
    <AddressFigure slot="figure" />
  </Hero>
  <Metrics />
  <Product />
  <Proof />
  <WhyNow />
  <Competition />
  <Company />
  <Contact />
</Base>
