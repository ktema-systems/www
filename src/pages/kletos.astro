---
import ProductPage from '../layouts/ProductPage.astro';

// The execution page. The order is the layer's own: the unit, the three ways a call
// arrives, the two ends a person holds, the reach, the build's own numbers, and the
// pieces that hold it. Every figure here is one this tree's notes record.
const blocks = [
  {
    id: 'unit',
    label: 'The unit',
    title: 'One call, from the stated work to the fact',
    lede: 'Every container of work holds a queue, and the queue carries a local name in every domain: a backlog, an ECO list, a work order list, a worklist, a manifest. The call is the unit that moves it.',
    rows: [
      { k: 'Stated', v: 'A person writes the work. The intent carries what was asked, who asked, and what constrains it.' },
      { k: 'Claimed', v: 'An agent, a machine, or a person takes it, and the claim is written.' },
      { k: 'Performed', v: 'The party that claimed it performs it.' },
      {
        k: 'Deposited',
        v: 'The result is written as a fact, with the evidence that the work was done.',
      },
    ],
    note: 'One request, one machine, one action. A planner, a model, and an outside agent all send the same thing, and the layer answers them the same way.',
  },
  {
    id: 'entries',
    label: 'Three ways in',
    title: 'A sentence, a model, an outside agent',
    rows: [
      {
        k: 'The line',
        v: 'The console turns a sentence into work and sends it to the machines.',
      },
      {
        k: 'The model',
        v: 'A model proposes the same work, and the layer accepts it the same way.',
      },
      {
        k: 'The outside agent',
        v: 'An outside agent reaches every machine as a tool, and reads each one as a resource.',
      },
    ],
    note: 'A model is optional. The layer runs without one.',
  },
  {
    id: 'ends',
    label: 'The two ends',
    title: 'A person states the work, and a person accepts it',
    prose: [
      'A person opens a project, writes a line, and watches the turn. That line is the first end.',
      'The second is the acceptance, written as a note in the thread: the decision sits where the person and the agent both read it, and it runs no turn.',
      'Approval is a deployment setting: every action, actions on request, or none. A call that waits for an answer waits for the person who can give it.',
    ],
    note: 'The machine holds the middle. The boundary sits outside the loop, where the first goal is stated and where the result is judged.',
  },
  {
    id: 'reach',
    label: 'The reach',
    title: 'Five executor types, one contract',
    rows: [
      {
        k: 'Agent',
        v: 'Software work, from a service to a desktop. It is the first type, and the one that runs today.',
      },
      { k: 'Signal', v: 'Measurement and industrial signalling.' },
      { k: 'Hardware', v: 'Robotics and automation.' },
      { k: 'Human-machine', v: 'Work where a person is inside the loop.' },
      { k: 'Bridge', v: 'An outside system, read and written through the same calls.' },
    ],
    note: 'A deployment is supervised, with a hub that binds the work, or peer to peer, where the board allocates by claims. One contract holds both, and the conformance suite reports whether a deployment conforms.',
  },
  {
    id: 'today',
    label: 'Today',
    title: 'What runs, measured on one host',
    rows: [
      {
        k: 'A turn',
        v: 'End to end on one host under one operator, including a request from a phone.',
      },
      { k: 'A call', v: 'A device acts within eighty milliseconds of the dispatch.' },
      {
        k: 'A move',
        v: 'The record holds the path, so a replay draws where the machine went.',
      },
      { k: 'One host', v: 'Three nodes bound to seven projects.' },
      {
        k: 'A node',
        v: 'About 19 MB resident. One file to deploy, with nothing else to install or operate.',
      },
      { k: 'The check', v: 'The contract check passes with no model in the path.' },
    ],
    note: 'The derivation that ties a fact back to its intent is the next build. No delivery rate and no cost per delivery are measured beyond one operator.',
  },
];
---

<ProductPage
  name="Kletos"
  href="/kletos"
  title="Intent delivers."
  subline="The chain from ask to delivery stays one record."
  description="Kletos is the execution layer: work is stated as an intent, claimed and performed by a node, and deposited as a fact with the evidence that ties it to the ask."
  lede="The execution layer. Work is stated as an intent, claimed by a node, performed on the machine that claimed it, and deposited as a fact. The ask, the claim, and the result stay one chain."
  body="A project used to be the work a team owed.
The project performs that work now, and the team keeps the two ends: stating the work and accepting the outcome."
  blocks={blocks}
  note="The design-partner program is open. The layer runs on one operator's host today."
  contact={{
    title: 'Put a run through the layer',
    lede: 'If work moves through agents, machines, and people at once, we should talk.',
    body: 'Bring one queue and the people who work it, and we will show the same work as one chain on the record.',
  }}
/>
