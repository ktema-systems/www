import ProductPage from '../layouts/ProductPage.astro';

const blocks = [
  {
    id: 'unit',
    label: 'The unit',
    title: 'Stated, claimed, performed, deposited',
    rows: [
      { k: 'Stated', v: 'The work is stated, and the intent that proposes it is written with it.' },
      { k: 'Claimed', v: 'An agent, a machine, or a person takes it, and the claim is written.' },
