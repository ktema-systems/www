---
import ProductPage from '../layouts/ProductPage.astro';

// The execution page. The product as it is sold: one call, the ways work arrives, the two
// ends a person holds, what the layer drives, and the scale it carries. The page names no
// part of the build.
const blocks = [
  {
    id: 'call',
    label: 'One call',
    title: 'The ask, the work, and the result stay one record',
    lede: 'Every team owes work, and every container of it has a local name: a backlog, an ECO list, a work order list, a manifest. The call is how that work moves.',
    rows: [
      { k: 'Stated', v: 'A person writes the work: what is asked, who asks, and what limits it.' },
      { k: 'Claimed', v: 'An agent, a machine, or a person takes it, and the claim is written.' },
      { k: 'Performed', v: 'The work runs on the machine that took it.' },
      { k: 'Deposited', v: 'The result is written with the evidence that the work was done.' },
    ],
    note: 'A planner, a model, and an outside system ask the same way, and one record answers each of them.',
  },
  {
    id: 'arrives',
    label: 'How work arrives',
    title: 'A sentence, a model, an outside system',
    rows: [
      { k: 'A person', v: 'A sentence on the console becomes the work.' },
      { k: 'A model', v: 'A model proposes the same work, and it is taken the same way.' },
      { k: 'An outside system', v: 'A system the layer does not own calls the same way, and reads each machine as a resource.' },
    ],
    note: 'A model is optional. The layer runs without one.',
  },
  {
    id: 'ends',
    label: 'The two ends',
    title: 'A person states the work, and a person accepts it',
    prose: [
      'The first end is the ask: a person opens a project, writes a line, and watches it move.',
      'The second end is the acceptance, written where the person and the agent both read it. It runs no work of its own.',
      'Approval is a deployment setting: every action, actions on request, or none. A call that waits for an answer waits for the person who can give it.',
    ],
    note: 'The machine holds the middle. The two ends stay with people.',
  },
  {
    id: 'drives',
    label: 'What it drives',
    title: 'Software, signals, hardware, people, outside systems',
    rows: [
      { k: 'Software', v: 'Work inside a service or on a desktop.' },
      { k: 'Signals', v: 'Measurement and industrial signalling.' },
      { k: 'Hardware', v: 'Robots and automation.' },
      { k: 'People', v: 'Work where a person is part of the loop.' },
      { k: 'Outside systems', v: 'A system the layer does not own, read and written the same way as the rest.' },
    ],
    note: 'One contract covers all five, so a deployment does not change shape when another kind of machine or agent joins it.',
  },
  {
    id: 'scale',
    label: 'The scale',
    title: 'One host carries the fleet',
    lede: 'A node is small enough that a host carries many, and the fleet still answers as one record.',
    rows: [
      { k: 'A node', v: 'About 19 MB resident, with the editor, the terminals, and git inside that figure.' },
      { k: 'A host', v: 'Three nodes and seven projects under one operator.' },
      { k: 'A device', v: 'Acts within eighty milliseconds of being asked.' },
      { k: 'A turn', v: 'End to end on one host, including a request from a phone.' },
      { k: 'A run, moved', v: 'A workspace is sealed on one machine and built again on another, under the same record.' },
    ],
    note: 'The run starts at the phone that asked, continues on the host that performed it, and is read back as one chain.',
  },
];
---

<ProductPage
  name="Kletos"
  href="/kletos"
  title="Intent delivers."
  subline="The chain from ask to delivery stays one record."
  description="Kletos is the execution layer: work is stated, claimed, performed, and deposited on one record, so a result is read with the ask that produced it."
  lede="The work a team owes gets done, and the team keeps the two ends: stating the work and accepting the outcome."
  body="A project used to be the work a team owed. The project performs that work now."
  blocks={blocks}
  figure="kletos"
  note="One contract for a person, a model, a machine, and an outside system."
  contact={{
    title: 'Put a run through the layer',
    lede: 'If work moves through agents, machines, and people at once, we should talk.',
    body: 'Bring one queue and the people who work it, and we will show the same work as one chain on the record.',
  }}
/>
