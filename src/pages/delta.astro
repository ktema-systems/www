---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DeltaDeck from '../components/DeltaDeck.astro';
import DeltaShot from '../components/DeltaShot.astro';
import Section from '../components/Section.astro';
import { delta, deltaCta, deltaNav, productMenu, site } from '../config';

// Delta's page: the platform, the seat it gives the operator, the run, and the
// campaigns. The hero states the platform, the seat section is the highlight, and
// the hand-off carries the reader to the engine the seat is built on.
---

<Base
  title={`${delta.name}: ${delta.title}`}
  description={delta.description}
  nav={deltaNav}
  cta={deltaCta}
  products={productMenu}
  current={delta.href}
  openProducts
>
  <Hero
    eyebrow="Delta"
    title={delta.tagline}
    lede="Delta is the Single Space Agentic AI Operation Platform: a cockpit where operators see and command robots, drones, codebases, agents, and the people who run them in one unified space. It can run over any backend; on the Ktema stack, every interaction and campaign is recorded and replayable."
    body="What the machine does is the sum of the intents that enter the loop."
  />

  <Section
    id="seat"
    label="The seat inside it"
    title="A dashboard looks at the machine. Delta puts you inside it."
    lede="A dashboard reports from outside the machine or the agent. Delta is that entity's own coordinate space, with its record and the constraints that bound it, read and acted on from the inside. The operator, the machine, and the auditor read one object."
    wide
  >
    <div class="cards cards--3 seat">
      <div class="card">
        <span class="card__value">To the past</span>
        <p>The entity's point of view at the moment before an incident, replayed from the record.</p>
      </div>
      <div class="card">
        <span class="card__value">To the edge</span>
        <p>The entity's own space with the link down.</p>
      </div>
      <div class="card">
        <span class="card__value">Across borders</span>
        <p>The record a regulator asks for, produced from the machine.</p>
      </div>
    </div>
  </Section>

  <DeltaDeck />

  <Section
    id="campaigns"
    label="Campaigns"
    title="A run becomes a campaign"
    lede="A campaign is one run inside a project: a situation, a briefing, the objectives, the constraints, and the record of what happened."
  >
    <dl class="spec">
      <dt>What a campaign holds</dt>
      <dd>The situation, the briefing, the objectives, the constraints, and the record of the run.</dd>
      <dt>What the platform does</dt>
      <dd>Plays the run, reads the objectives at the cursor, and compares two runs on the same record.</dd>
      <dt>What a finished run becomes</dt>
      <dd>A package that can be replayed and handed to another team.</dd>
    </dl>

    <DeltaShot />
  </Section>

  <Section
    id="contact"
    label="Contact"
    title="Bring a run to the platform."
    lede="If you run a system where intent changes while the work is moving, we are choosing the first design partners. Write to us."
    band
  >
    <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
  </Section>
</Base>

<style>
  .seat {
    margin-top: clamp(28px, 4vh, 44px);
  }
</style>
