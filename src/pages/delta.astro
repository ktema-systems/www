---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DeltaDeck from '../components/DeltaDeck.astro';
import Section from '../components/Section.astro';
import { delta, deltaCta, deltaNav, site } from '../config';

// Delta's page: the platform, the run, and the campaigns. The hero states the
// platform, and the sections below explain the run in words.
---

<Base
  title={`${delta.name}: ${delta.title}`}
  description={delta.description}
  nav={deltaNav}
  cta={deltaCta}
>
  <Hero
    eyebrow="Delta"
    title={delta.tagline}
    lede="Delta is the Single Space Agentic AI Operation Platform: a standalone mission control for robots, drones, codebases, agents, and the people who command them. It can run over any backend; on the Ktema stack, every interaction and campaign is recorded and replayable, and the platform becomes the accountable mission control."
    body="What the machine does is the sum of the intents that enter the loop."
  />

  <DeltaDeck />

  <Section
    id="campaigns"
    label="Campaigns"
    title="A run becomes a campaign"
    lede="A campaign is one run inside a project: a situation, a briefing, objectives, and the record of what happened. Delta plays it, reads it, and compares it."
  >
    <dl class="spec">
      <dt>What a campaign holds</dt>
      <dd>The situation, the briefing, the objectives, the constraints, and the record of the run.</dd>
      <dt>What the platform does</dt>
      <dd>Plays the run, reads the objectives at the cursor, and compares two runs on the same record.</dd>
      <dt>What a finished run becomes</dt>
      <dd>A package that can be replayed and handed to another team.</dd>
    </dl>

    <p class="note">
      The first campaign is the villa evacuation, described above: five objectives, one 75-second
      window, and 1,164 records.
    </p>
  </Section>

  <Section
    id="contact"
    label="Contact"
    title="Bring a run to the platform."
    lede="If you run a system where intent changes while the work is moving, we are choosing the first design partners. Write to us."
    band
  >
    <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
  </Section>
</Base>
