---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CampaignFigure from '../components/CampaignFigure.astro';
import Section from '../components/Section.astro';
import { delta, deltaCta, deltaNav, site } from '../config';

// Delta's page: the cockpit, the campaign, and the package.
---

<Base
  title={`${delta.name}: ${delta.title}`}
  description={delta.description}
  nav={deltaNav}
  cta={deltaCta}
>
  <Hero
    eyebrow="Delta"
    title={delta.tagline}
    lede="Delta runs a campaign, reads the record, and packages the result. A campaign is one run inside a project: a situation, a briefing, objectives, and the constraints that bound them. The package is the run, and it can be replayed and compared."
    body="Delta reads the record the project already holds, so the cockpit shows the state the run actually had."
  >
    <CampaignFigure slot="figure" />
  </Hero>

  <Section
    id="cockpit"
    label="Cockpit"
    title="One reading of the run"
    lede="Delta shows the work as the record has it: the project, the claim, the bound, and the result."
  >
    <div class="cards cards--3">
      <div class="card">
        <span class="card__value">What is running</span>
        <p>The project and the campaign, with the state the record gives them.</p>
      </div>
      <div class="card">
        <span class="card__value">Who claimed it</span>
        <p>The claim, the operator, and the authority that took the work.</p>
      </div>
      <div class="card">
        <span class="card__value">What bounded it</span>
        <p>The hints and the terms that limited the run.</p>
      </div>
    </div>

    <p class="note">
      Scrub the run backwards and an objective returns to open. The cockpit cannot show a state
      the record does not support.
    </p>
  </Section>

  <Section
    id="campaigns"
    label="Campaigns"
    title="A campaign is one run, start to finish"
    lede="Set the start, the end, and the objectives that matter. Delta reads the run and shows what was met, what is still open, and what was missed."
  >
    <dl class="spec">
      <dt>Start and end</dt>
      <dd>The run begins and ends on what the record says, not on a clock the operator sets.</dd>
      <dt>An objective</dt>
      <dd>A goal the record can prove: a reading, a decision, a count, or a time.</dd>
      <dt>A deadline</dt>
      <dd>Give an objective a window. A result after the window does not count.</dd>
      <dt>An optional objective</dt>
      <dd>A missed optional goal does not fail the run.</dd>
    </dl>

    <p class="note">
      The cockpit reads the campaign from the same record it is already walking, so the state
      follows the cursor.
    </p>
  </Section>

  <Section
    id="package"
    label="Package"
    title="The run stays with you"
    lede="A finished campaign keeps the full run: what was asked, what was done, what limited it, and how it ended. You can replay it, compare two runs, and hand the record to someone else."
  >
    <div class="cards cards--3">
      <div class="card">
        <span class="card__value">Replay</span>
        <p>Open the run at any point and see the state the record had then.</p>
      </div>
      <div class="card">
        <span class="card__value">Compare</span>
        <p>Read two runs side by side at the same objective and the same point.</p>
      </div>
      <div class="card">
        <span class="card__value">Hand over</span>
        <p>The record is self-contained, so it reads the same on another machine.</p>
      </div>
    </div>
  </Section>

  <Section
    id="example"
    label="Example"
    title="The villa evacuation, an example campaign"
    lede="An emergency lift on the Monaco coast shows the campaign from start to finish. It starts when the emergency is declared and ends when treatment starts."
  >
    <ul class="metrics">
      <li class="metric">
        <span class="metric__value">1,164</span>
        <span class="metric__label">records in the run</span>
      </li>
      <li class="metric">
        <span class="metric__value">5</span>
        <span class="metric__label">objectives, one with a deadline</span>
      </li>
      <li class="metric">
        <span class="metric__value">75 s</span>
        <span class="metric__label">the scan has to reach the hospital</span>
      </li>
      <li class="metric">
        <span class="metric__value">3</span>
        <span class="metric__label">checks in the scenario</span>
      </li>
    </ul>

    <p class="note">
      The scan is written at 80 seconds, three seconds inside its window. The campaign line shows
      five of five met, and the record behind each one.
    </p>
  </Section>

  <Section
    id="contact"
    label="Contact"
    title="Bring a campaign to the cockpit."
    lede="We are choosing the first design partners. If you run a situation that has to be replayed and understood, write to us."
    band
  >
    <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
  </Section>
</Base>
