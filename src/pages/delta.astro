---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Deck from '../components/Deck.astro';
import DeltaDeck from '../components/DeltaDeck.astro';
import DeltaShot from '../components/DeltaShot.astro';
import Section from '../components/Section.astro';
import { delta, demoCta, productMenu, site, type NavItem } from '../config';

// Delta's page: the platform, the cases it runs, the seat it gives the operator,
// and the loop. The island run comes first because it shows the whole platform at
// once, and the hand-off carries the reader to the loop underneath.

const deltaNav: readonly NavItem[] = [
  { label: 'Operations', href: '#operations' },
  { label: 'The seat', href: '#seat' },
  { label: 'The loop', href: '#loop' },
  { label: 'Campaigns', href: '#campaigns' },
  { label: 'Contact', href: '#contact' },
];
---

<Base
  title={`${delta.name}: ${delta.title}`}
  description={delta.description}
  nav={deltaNav}
  cta={demoCta}
  products={productMenu}
  current={delta.href}
  openProducts
>
  <Hero
    title={delta.category}
    subline={delta.tagline}
    lede="A cockpit where operators see and command robots, drones, codebases, agents, and the people who run them in one unified space. It can run over any backend; on the Ktema stack, every interaction and campaign is recorded and replayable."
    body="What the machine does is the sum of the intents that enter the loop."
  />

  <Deck
    id="operations"
    eyebrow="Operations"
    title="Three runs, one space."
    lede="Delta is the cockpit of a campaign: the machines, the people, and the record of a run, read together. Each case is read from the seat inside the run."
    slides={[
      {
        kicker: 'The run',
        title: 'A fire on an island, answered by the fleet already there',
        body: 'Delta puts every machine, person, and record of the run in one space. Survey and thermal drones map the perimeter, a relay holds the link over the strait, and crawlers and boats take the shore, each intent claimed by a different machine under the same wind and keep-out bounds. The operator changes the intent from the same record, and the fleet answers the new one without stopping.',
        note: 'The reference campaign: one situation, one record, and a fleet that answers together.',
        image: {
          src: '/delta_devscr.jpg',
          alt: 'Rescue Wing: Island Fire. The intents and records on the left, the cell view of survey, thermal, photo and relay drones with crawlers, boats and rovers in the middle, the island and its shoreline on the right, and the timeline below.',
          width: 1842,
          height: 1047,
        },
      },
      {
        kicker: 'The cell',
        title: 'A factory cell runs on one intent',
        body: 'Servos, conveyors, cameras, maintenance robots, and the people who run them, read in one cell. An intent is written once, and every agent under the cell answers from it. The operator sees the whole cell and the record of each agent in the same view.',
        image: {
          src: '/delta_scr_factory.jpeg',
          alt: 'The cockpit on a factory cell: the intents and records on the left, the feed and the cell view in the middle with servos, conveyors and maintenance robots, and the timeline along the bottom.',
          width: 1766,
          height: 920,
        },
      },
      {
        kicker: 'The span',
        metrics: [{ value: '35,786', unit: 'km' }],
        title: 'Land, air, and orbit in one view',
        body: 'A rescue run reaches from a geostationary satellite at 35,786 km to a drone over the site, with the helicopters, the escorts, and the hospital on the same map. Each element is read where it is, and the operator follows one record from orbit to the shoreline.',
        image: {
          src: '/delta_scr_satelite.jpeg',
          alt: 'A rescue campaign on the map and in the cell view: satellites at 550, 1,200 and 35,786 km, rescue and medevac aircraft, escorts, the hospital, and the operators on one space.',
          width: 1265,
          height: 686,
        },
      },
    ]}
    labels={['Run', 'Cell', 'Span']}
    footnote="The campaign data in these views is simulated. Delta is planned to be open source."
  />

  <Section
    id="seat"
    label="The seat inside it"
    title="The run, read from the inside."
    lede="Delta is the entity's own coordinate space: its record and the constraints that bound it, read and acted on from the same place the intent is changed. The operator, the machines, and the auditor read one object."
    wide
  >
    <div class="cards cards--3">
      <div class="card">
        <span class="card__value">To the past</span>
        <p>The entity's point of view at the moment before an incident, replayed from the record.</p>
      </div>
      <div class="card">
        <span class="card__value">To the edge</span>
        <p>The entity's own space with the link down.</p>
      </div>
      <div class="card">
        <span class="card__value">Across borders</span>
        <p>The record a regulator asks for, produced from the machine.</p>
      </div>
    </div>
  </Section>

  <DeltaDeck />

  <Section
    id="campaigns"
    label="Campaigns"
    title="A run becomes a campaign"
    lede="A campaign is one run inside a project: a situation, a briefing, the objectives, the constraints, and the record of what happened. The island run above is the reference campaign."
  >
    <dl class="spec">
      <dt>What a campaign holds</dt>
      <dd>The situation, the briefing, the objectives, the constraints, and the record of the run.</dd>
      <dt>What the platform does</dt>
      <dd>Plays the run, reads the objectives at the cursor, and compares two runs on the same record.</dd>
      <dt>What a finished run becomes</dt>
      <dd>A package that can be replayed and handed to another team.</dd>
    </dl>
  </Section>

  <Section
    id="contact"
    label="Contact"
    title="Bring a run to the platform."
    lede="If you run a system where intent changes while the work is moving, we should talk. Write to us."
    band
  >
    <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
  </Section>
</Base>
