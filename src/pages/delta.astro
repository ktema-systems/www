---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DeltaDeck from '../components/DeltaDeck.astro';
import CockpitDeck from '../components/CockpitDeck.astro';
import Section from '../components/Section.astro';
import { delta, deltaCta, deltaNav, site } from '../config';

// Delta's page: the Single Space Operation Platform where every kind of
// autonomous workforce is commanded in one space, with the cockpit as the surface
// a person enters intent from.
---

<Base
  title={`${delta.name}: ${delta.title}`}
  description={delta.description}
  nav={deltaNav}
  cta={deltaCta}
>
  <Hero
    eyebrow="Delta"
    title={delta.tagline}
    lede="Delta is the Single Space Operation Platform: a standalone mission control for robots, drones, codebases, agents, and the people who command them. It can run over any backend; on the Ktema stack, every interaction and campaign is recorded and replayable, and the platform becomes the accountable mission control."
    body="What the machine does is the sum of the intents that enter the loop."
  />

  <DeltaDeck />

  <Section
    id="cockpit"
    label="Cockpit"
    title="What the operator sees and changes"
    lede="The cockpit shows the run as it is, and gives the operator a way into it."
    wide
  >
    <dl class="spec">
      <dt>What the operator can change</dt>
      <dd>A new intent, a new limit, or a stop, entered while the work is moving.</dd>
      <dt>What is running</dt>
      <dd>The work in flight, where it stands, and what it is waiting on.</dd>
      <dt>Who is acting</dt>
      <dd>The agent or machine on the work, the claim it holds, and who authorized it.</dd>
      <dt>What bounded it</dt>
      <dd>The limits in force and the intent that set them.</dd>
    </dl>

    <CockpitDeck />

    <p class="note">
      Scrub back through the run and the state follows. The operator can enter the next intent from
      any point in it.
    </p>
  </Section>

  <Section
    id="campaigns"
    label="Campaigns"
    title="A run becomes a campaign"
    lede="A campaign is one run inside a project: a situation, a briefing, objectives, and the record of what happened. Delta plays it, reads it, and compares it."
  >
    <dl class="spec">
      <dt>What a campaign holds</dt>
      <dd>The situation, the briefing, the objectives, the constraints, and the record of the run.</dd>
      <dt>What the platform does</dt>
      <dd>Plays the run, reads the objectives at the cursor, and compares two runs on the same record.</dd>
      <dt>What a finished run becomes</dt>
      <dd>A package that can be replayed and handed to another team.</dd>
    </dl>

    <p class="note">
      The first campaign is the villa evacuation, shown above: five objectives, one 75-second window,
      and 1,164 records.
    </p>
  </Section>

  <Section
    id="contact"
    label="Contact"
    title="Bring a run to the platform."
    lede="If you run a system where intent changes while the work is moving, we are choosing the first design partners. Write to us."
    band
  >
    <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
  </Section>
</Base>
