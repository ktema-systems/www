---
import ProductPage from '../layouts/ProductPage.astro';

// The governance page. Three things the layer carries: the bound the record has narrowed,
// the contract that declares the terms, and the judgement that applies them where the work
// runs. The page names no part of the build.
const blocks = [
  {
    id: 'bound',
    label: 'The bound',
    title: 'It bounds the range the record has narrowed',
    lede: 'A record says what happened. Run it forward and it also says how little can happen next.',
    rows: [
      {
        k: 'The range',
        v: 'What the machine can still reach, narrowed by the trail the record already holds. The longer the trail, the smaller the range.',
      },
      {
        k: 'The terms',
        v: 'The bound a deployment declares: what an action may do, on what authority, at what cost.',
      },
      {
        k: 'The hold',
        v: 'Work that leaves the terms does not run.',
      },
      {
        k: 'The answer',
        v: 'When someone asks afterwards, the rule and the record answer together.',
      },
    ],
    note: 'The narrowing is deterministic: the same record leaves the same range. Krisis is where the bound on that range is declared.',
  },
  {
    id: 'terms',
    label: 'The contract',
    title: 'One contract answers which model, at what cost, by whose authority',
    lede: 'The terms are written with the deployment, and read against the record it keeps.',
    rows: [
      { k: 'The action', v: 'What each action may do, and what it may not.' },
      { k: 'The model', v: 'Which model answers a request.' },
      { k: 'The cost', v: 'What that answer costs.' },
      { k: 'The authority', v: 'Who may move an agent, and with what authority.' },
      { k: 'The record', v: 'What the machine did, read beside what it was allowed to do.' },
    ],
    note: 'One contract answers all five, so the same request is read the same way twice. A bound is worth what the record can prove about it, so the two are bought together.',
  },
  {
    id: 'judgement',
    label: 'The judgement',
    title: 'The decision is made where the work runs',
    lede: 'A decision that waits for a round trip is a report. The layer answers on the machine.',
    rows: [
      { k: 'The read', v: 'A request is classed, and its class decides what may happen to it.' },
      {
        k: 'The machine',
        v: 'The classifier is small enough to run on a 32-bit part with no operating system, beside the work it governs.',
      },
      {
        k: 'The check',
        v: 'The same arithmetic is written four ways: compiled, hand-written for the part, in hardware, and as the plain reference the other three are held to.',
      },
      { k: 'The number', v: '0.915 quantised accuracy on a 64-32-10 network.' },
    ],
    note: 'A decision small enough to sit on the machine, and an arithmetic that can be checked against a reference written from it.',
  },
  {
    id: 'twokeys',
    label: 'Two holders',
    title: 'The acts that cannot be undone',
    rows: [
      { k: 'The class', v: 'Which acts need two holders. Declared with the deployment.' },
      { k: 'The window', v: 'How long a second holder may still agree.' },
      { k: 'The hold', v: 'The act waits while the class holds it.' },
      { k: 'The release', v: 'It starts when a second holder agrees inside the window.' },
      { k: 'The record', v: 'Both agreements sit beside the act on one record.' },
    ],
    note: 'Two different holders, one window, one record. A second agreement by the same holder is not a second key.',
  },
  {
    id: 'buyer',
    label: 'The buyer',
    title: 'The operator who has to answer for it',
    rows: [
      {
        k: 'A regulated operator',
        v: 'A deployment that must account for which model answered, at what cost, and on whose authority.',
      },
      {
        k: 'An enterprise operator',
        v: 'A fleet where an agent can move a machine, and the terms of that move have to be readable later.',
      },
      {
        k: 'What it is bought with',
        v: 'A bound is only as good as the trail behind it, so the layer is bought with the record.',
      },
    ],
    note: 'What the buyer wants is an answer that survives an audit, which is why the price lands on the layer that holds the record.',
  },
];
---

<ProductPage
  name="Krisis"
  href="/krisis"
  title="Judgment governs."
  subline="Every action carries its terms."
  description="Krisis is the judgment layer: it declares what each action may do, which model answers and at what cost, writes the terms as a contract, and decides on the machine where the work runs."
  lede="The terms a deployment declares, held against the record of what the machine did."
  body="It bounds what can happen next, writes the bound as a contract, and reaches the decision on the machine."
  blocks={blocks}
  figure="krisis"
  note="The bound is written with the deployment, and read against the record."
  contact={{
    title: 'Declare what the work may do',
    lede: 'If a deployment has to bound what a model may do and answer for it later, we should talk.',
    body: 'Bring the rules a deployment already declares, and we will show you where they meet the record.',
  }}
/>
