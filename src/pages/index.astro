---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CaseDeck from '../components/CaseDeck.astro';
import Layers from '../components/Layers.astro';
import Reach from '../components/Reach.astro';
import Section from '../components/Section.astro';
import { companyCta, companyNav, creedLine, site } from '../config';

// The company's landing page: the promise, the situations the product is built for,
// the products, the partners, the footprint, and one way in. The detail lives on the
// engine's page and in the pitch.
---

<Base
  title={`${site.name}: ${site.tagline}`}
  description={site.description}
  nav={companyNav}
  cta={companyCta}
>
  <Hero
    eyebrow={creedLine}
    title="Replayable Agentic Computing"
    lede="An insulin pump holds a dose. A drone turns back. A robot stops a line. Later, someone asks why. The machine has to show what it was asked, what it did, and what limited it. On a device with no room for a database, that account is usually lost. When a model is the one deciding, the reasoning is usually a log no one can check."
    body="We close that gap. A spatiotemporal record on the machine, a portable mission control for the operator to rewind and prove. No cloud. No database. One quiet truth, from field sensors to space systems, from homes to defense programs."
  />

  <section class="reach-band" aria-label="Where the engine runs">
    <div class="wrap">
      <Reach />
    </div>
  </section>

  <CaseDeck />

  <Layers />

  <Section
    id="partners"
    label="Partners"
    title="Built for physical AI autonomous systems"
    lede="We work with the teams that build them and stand behind them after they ship."
  >
    <div class="biz">
      <div>
        <p class="biz__k">Who builds with it</p>
        <p>Defense programs, medical device makers, vehicle programs, and energy operators. They build the machine and carry the liability for what it does in the real world.</p>
      </div>
      <div>
        <p class="biz__k">Why now</p>
        <p>
          The EU AI Act and the Cyber Resilience Act require automatic logging over the life of a
          high-risk system. A product that cannot produce that record cannot enter the market that
          asks for it.
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="contact"
    label="Contact"
    title="Building a system that has to answer for itself?"
    lede="Write to us. We are choosing the first design partners now."
    band
  >
    <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
  </Section>
</Base>

<style>
  .reach-band {
    padding-block: 4px clamp(40px, 6vh, 80px);
  }

  .biz {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .biz > div {
    background: var(--bg);
    padding: 22px 24px;
  }

  .biz p {
    margin: 0;
  }

  .biz p + p {
    margin-top: 8px;
    color: var(--fg-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .biz__k {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  @media (max-width: 820px) {
    .biz {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
