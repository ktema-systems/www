---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CaseDeck from '../components/CaseDeck.astro';
import ProofDeck from '../components/ProofDeck.astro';
import DeltaDeck from '../components/DeltaDeck.astro';
import ProductHighlight from '../components/ProductHighlight.astro';
import ProductLink from '../components/ProductLink.astro';
import Layers from '../components/Layers.astro';
import Reach from '../components/Reach.astro';
import Section from '../components/Section.astro';
import PanelDeck from '../components/PanelDeck.astro';
import { companyCta, companyNav, creedLine, site } from '../config';

// The company's landing page: the promise, the situations the product is built for,
// the six parts as one stack, one turn for each part, and the people it is built for.
// The stack comes before the turns so a reader meets the map before the detail.
---

<Base
  title={`${site.name}: ${site.tagline}`}
  description={site.description}
  nav={companyNav}
  cta={companyCta}
>
  <Hero
    eyebrow={creedLine}
    title="Replayable Agentic Computing"
    lede="An insulin pump holds a dose. A drone turns back. A robot stops a line. Later, someone asks why, and the machine answers: what it was asked, what it did, and what limited it. That account sits on the device itself, at the moment it happened. The same record computes what happens next."
    body="We make that answer the default: a spatiotemporal record engine on the machine, and a portable mission control where the operator rewinds and proves. It needs no operating system, no database, and no cloud, so the record stays where it was made. The same record computes the next state, so the account and the control are one system."
    fieldReveal="scroll"
    depth
  >
    <a class="btn btn--accent" href={companyCta.href} slot="actions" data-hero-cta>
      {companyCta.label} 
    </a>

    <p class="hero-cta-note" slot="actions">
      Public demos and private beta are on the way.
    </p>
  </Hero>

  <section class="reach-band" aria-label="Where the engine runs">
    <div class="wrap">
      <Reach />
    </div>
  </section>

  <CaseDeck />

  <Layers />

  <PanelDeck
    id="device"
    eyebrow="Device"
    title="The record runs on the machine that made it."
    lede="A board of a few dozen grams, a chip that costs a couple of dollars, and no database under the engine. The records live in a partition of the flash the part already has."
    panels={[
      {
        kicker: 'The part',
        metric: { value: '$2', unit: 'MCU' },
        title: 'A chip that costs a couple of dollars, with nothing under the engine',
        body: 'Megabytes of flash and half a megabyte of RAM. No operating system, no database, and no file system between the engine and the flash.',
        image: {
          src: '/esp32s3-board.jpg',
          alt: 'A small flight-controller board with an ESP32-S3 module, its battery, and a USB bridge.',
          width: 1440,
          height: 739,
        },
      },
      {
        kicker: 'The footprint',
        metric: { value: '1,648', unit: 'B' },
        title: 'The engine holds under two kilobytes while it runs',
        body: 'That is the peak working memory measured on the part, with the records on the flash and the read path included.',
        note: 'The first start prepares the storage; later starts hold the same figure.',
      },
      {
        kicker: 'The surface',
        metric: { value: '3', unit: 'calls' },
        title: 'A region of flash, a write, and an erase',
        body: 'The log, the index on the medium, and the recovery above them belong to the engine, so a firmware team adds three calls to the partition it already drives.',
      },
    ]}
  />

  <PanelDeck
    id="delta"
    eyebrow="Operations"
    title="One space for the fleet."
    lede="The cockpit: robots, drones, agents, and the people who run them, read and commanded in one space over the record the machine keeps."
    panels={[
      {
        kicker: 'The cockpit',
        title: 'One space for every kind of machine',
        body: 'A flight controller, a robot on a line, and a software agent are read in the same place, and the operator acts from there rather than from three dashboards.',
        image: {
          src: '/delta_devscr.jpg',
          alt: 'The cockpit on a demo campaign: an intent list on the left, the fleet and its map in the middle, and the record along the bottom.',
          width: 1842,
          height: 1047,
        },
      },
      {
        kicker: 'The seat',
        title: 'The operator stands inside the run',
        body: `A dashboard reports from outside the machine. The cockpit is the entity's own coordinate space, with its record and the constraints that bound it, read and acted on from the inside.`,
      },
      {
        kicker: 'The campaign',
        title: 'A run another team can replay',
        body: 'A campaign holds the situation, the briefing, the objectives, the constraints, and the record. A finished run becomes a package that can be handed on and compared against another.',
      },
    ]}
  />

  <Section
    id="partners"
    label="The fit"
    title="Where the engine is the right answer"
    lede="Three conditions hold: the question combines several axes; it has to be answered where the record was made; and the memory is the one the part carries. Where they do, a database does not fit in that memory and a cloud is beyond the link."
  >
    <div class="biz">
      <div>
        <p class="biz__k">The systems</p>
        <p>Defense programs, medical device makers, vehicle programs, and energy operators. The machine serves for ten to thirty years, and the organization that shipped it answers for what it did.</p>
      </div>
      <div>
        <p class="biz__k">The condition</p>
        <p>A multi-axis question answered on the device with the link down, inside the memory the part has. No server in the path and no index to build.</p>
      </div>
      <div>
        <p class="biz__k">Where it does not apply</p>
        <p>If the record may leave the device, or the system already runs a database, that database is the simpler answer and the right one.</p>
      </div>
      <div>
        <p class="biz__k">Why now</p>
        <p>The EU AI Act requires logging over the life of a high-risk system, and the Cyber Resilience Act keeps a manufacturer answerable after it ships. A machine that carries its own record starts inside both.</p>
      </div>
    </div>
  </Section>

  <Section
    id="contact"
    label="Contact"
    title="Building a system that has to answer for itself?"
    lede="Write to us. We work with design partners now."
    band
  >
    <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
  </Section>
</Base>

<style>
  /* The note is a footnote to the call: who can ask for a demo now, and when the
     rest can. */
  .hero-cta-note {
    flex-basis: 100%;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-3);
    text-wrap: pretty;
  }

  .reach-band {
    /* The globe starts behind the end of the promise: the copy is read against it,
       and the two are one scene rather than two stacked blocks. */
    margin-top: clamp(-200px, -17vh, -110px);
    position: relative;
    z-index: 1;
    padding-block: 4px clamp(40px, 6vh, 80px);
    /* The scene opens wider than the window and settles into it. The part that hangs
       past the edge is never on screen, and clipping it sideways keeps a phone from
       scrolling the whole page to reach it. The vertical bleed is the point, so only
       the horizontal axis is clipped. */
    overflow-x: clip;
  }

  /* The sphere is the scene, so it may use the window rather than the reading column,
     and it holds the right edge while the copy holds the left. */
  .reach-band .wrap {
    max-width: none;
    padding-inline: 0;
  }

  /* A phone has no column to give the globe, so the figure sits below the promise. */
  @media (max-width: 720px) {
    .reach-band {
      margin-top: -120px;
    }
  }

  /* The deck has no gap under it, and the link that closes the turn needs one. */
  .hl-close {
    padding-block: clamp(20px, 3vh, 32px) clamp(40px, 6vh, 80px);
  }

  .biz {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .biz > div {
    background: var(--bg);
    padding: 22px 24px;
  }

  .biz p {
    margin: 0;
  }

  .biz p + p {
    margin-top: 8px;
    color: var(--fg-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .biz__k {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  @media (max-width: 820px) {
    .biz {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
