---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CaseDeck from '../components/CaseDeck.astro';
import Layers from '../components/Layers.astro';
import Reach from '../components/Reach.astro';
import Section from '../components/Section.astro';
import PanelDeck from '../components/PanelDeck.astro';
import { companyCta, productMenu, site, type NavItem } from '../config';

// The homepage owns its sections and its strip. The order, labels, and anchors below
// drive both the page and the header, so they cannot drift.

const homeSections = [
  { key: 'stack', label: 'Stack', id: 'products' },
  { key: 'operations', label: 'Operations', id: 'delta' },
  { key: 'engine', label: 'Engine', id: 'engine' },
  { key: 'cases', label: 'Cases', id: 'cases' },
  { key: 'fit', label: 'Fit', id: 'partners' },
  { key: 'contact', label: 'Contact', id: 'contact' },
] as const;

const companyNav: readonly NavItem[] = homeSections.map(({ key, label, id }) => ({
  label,
  href: `#${id}`,
  ...(key === 'stack' ? { items: productMenu } : {}),
}));

const operationsPanels = [
  {
    kicker: 'The run',
    title: 'A fire on an island, answered by the fleet already there',
    body: 'Survey and thermal drones map the perimeter, a relay holds the link over the strait, and crawlers and boats take the shore. Each intent is claimed by a different machine under the same wind and keep-out bounds, and the operator changes it while the run moves.',
    note: 'Every campaign has this shape: a situation, a briefing, the objectives, the constraints, and the record.',
    image: {
      src: '/delta_devscr.jpg',
      alt: 'Rescue Wing: Island Fire. The intents and records on the left, the cell view of survey, thermal, photo and relay drones with crawlers, boats and rovers in the middle, the island and its shoreline on the right, and the timeline below.',
      width: 1842,
      height: 1047,
    },
  },
  {
    kicker: 'The cell',
    title: 'A workforce runs on one intent',
    body: 'Servos, conveyors, cameras, maintenance robots, software agents, and the people who run them, read in the same cell view. An intent is written once, and every agent under the cell answers from it.',
    image: {
      src: '/delta_scr_factory.jpeg',
      alt: 'The cockpit on a factory cell: the intents and records on the left, the feed and the cell view in the middle with servos, conveyors and maintenance robots, and the timeline along the bottom.',
      width: 1766,
      height: 920,
    },
  },
  {
    kicker: 'The span',
    metrics: [{ value: '35,786', unit: 'km' }],
    title: 'Land, air, and orbit in one view',
    body: 'A rescue run reaches from a geostationary satellite at 35,786 km to a drone over the site, with the helicopters, the escorts, and the hospital on the same map. Each element is read where it is, and the run keeps one record across all of them.',
    image: {
      src: '/delta_scr_satelite.jpeg',
      alt: 'A rescue campaign on the map and in the cell view: satellites at 550, 1,200 and 35,786 km, rescue and medevac aircraft, escorts, the hospital, and the operators on one space.',
      width: 1265,
      height: 686,
    },
  },
  {
    kicker: 'The seat',
    title: 'The operator stands inside the run',
    body: `On the island, the operator stands in the run: the drones, their record, and the wind and keep-out bounds around them, with the intent changed from the same place the record is read.`,
  },
  {
    kicker: 'The chain',
    title: 'The ask and the act stay one chain',
    body: 'A request is stated, claimed, performed, and written as a result, with the link back to the request. The chain holds across agents, people, machines, and outside systems, so a run can be read back the way it happened.',
  },
  {
    kicker: 'The terms',
    title: 'The rules are written before the work starts',
    body: 'A smart contract or a governance rule sets which model answers, at what cost, and on whose authority, and the record is checked against it, so an audit reads a rule and a run.',
  },
  {
    kicker: 'The campaign',
    title: 'A run another team can replay',
    body: 'A finished run becomes a package that can be handed on and compared against another. The next campaign starts from it.',
  },
];

const enginePanels = [
  {
    kicker: 'The engine',
    title: 'One engine, every process',
    body: 'The engine runs in the software that needs it: a service, an operating system, an agent, a gateway, or a device. It attaches to the stack already there.',
  },
  {
    kicker: 'Alongside the database',
    title: 'Keep the database. Send it fewer questions',
    body: 'A multi-axis question normally costs an index per axis—written, rebuilt, and kept. The engine answers from the record itself, so you keep your Postgres, SQLite, or existing database for transactions, and send only the multi-axis queries to the engine. No second index to maintain.',
  },
  {
    kicker: 'The part',
    metrics: [
      { value: '$2', unit: 'MCU' },
      { value: '45', unit: 'g' },
    ],
    title: 'A two-dollar chip on a 45-gram airframe',
    body: 'A two-dollar module on a 45-gram board without its battery, with 8 MB of flash and half a megabyte of RAM. The engine writes to the flash directly.',
    image: {
      src: '/esp32s3-board.jpg',
      alt: 'A small flight-controller board with an ESP32-S3 module, its battery, and a USB bridge.',
      width: 1440,
      height: 739,
    },
  },
  {
    kicker: 'The footprint',
    metrics: [{ value: '1,648', unit: 'B' }],
    title: 'The same engine holds under two kilobytes on the part',
    body: 'That is the peak working memory measured on the part, with the records on the flash and the read path included. A boot does no storage work to find them.',
    note: 'The first start prepares the storage; later starts hold the same figure.',
  },
  {
    kicker: 'The range',
    title: 'One format across the range',
    body: 'The working memory stays flat as the log grows. On the RISC-V reference part, which carries 256 KB of flash and 64 KB of SRAM, the engine and its storage take 32,812 B of static SRAM and 123,782 B of flash.',
  },
];

const fitPanels = [
  {
    kicker: 'The condition',
    title: 'Answered where the record is made, inside the memory it has',
    point: 'The question is multi-axis, and the answer has to come from the record the system keeps.',
    body: 'A record made where the work runs answers from its own history.',
  },
  {
    kicker: 'Everyday',
    title: 'The same shape on things people already run',
    point: 'A service that keeps a season of runs. A bike computer that keeps a season of rides.',
    body: 'Which deploy cost the latency, or what changed since Monday, answered in the process itself. No account and no round trip.',
  },
  {
    kicker: 'Critical systems',
    title: 'Where the answer has to survive the audit',
    point: 'Ten to thirty years in service, and the organization that shipped it answers for what it did.',
    body: 'Defense programs, medical device makers, vehicle programs, and energy operators. The machine outlives the deployment, and the record has to outlive the machine.',
    note: 'For medical and automotive programs, the EU AI Act requires logging over the life of a high-risk system. For industrial and energy programs, the CRA reporting duty has applied since 11 September 2026, with main obligations from 11 December 2027. A defense program answers to its own regime.'
  },
  {
    kicker: 'The boundary',
    title: 'The line sits above the engine',
    point: 'If the system has to answer from its own record, the engine is the answer.',
    body: 'What happens above that line is yours: your database, your cloud, and your services. You connect it and feed it as you already do, and the format does not change with that choice.',
  },
];

const assertNever = (value: never): never => {
  throw new Error(`Unhandled home section: ${JSON.stringify(value)}`);
};

---

<Base
  title={`${site.name}: ${site.tagline}`}
  description={site.description}
  nav={companyNav}
  cta={companyCta}
>
    <Hero
        eyebrow=""
        title="Replayable Agentic Computing"
        subline="Every agent acts. Answer stays on it."
        lede="An agent books a shipment. A drone turns back. An insulin pump holds a dose. A robot stops a line. Later, someone asks why, and the system answers from the record it keeps by default: what was asked, what it did, and what limited it."
        body="We answer multi-axis questions without an index to maintain. We turn intent into verified work, enforce the rules that bound it, and put the operator inside the machine's own space to rewind and prove the decision. One open format, for any deployment target, on the stack you already use."
        fieldReveal="scroll"
        depth
      >
    <a class="btn btn--accent" href={companyCta.href} slot="actions" data-hero-cta>
      {companyCta.label} 
    </a>

    <p class="hero-cta-note" slot="actions">
      Public previews and the private beta are on the way.
    </p>
  </Hero>

  <section class="reach-band" aria-label="Where the engine runs">
    <div class="wrap">
      <Reach
        caption={{
          lead: 'One space and protocol, from chip to orbit.',
          body: 'Each agent, service, or machine keeps its own record. Records meet at the same point without talking. One record explains a move and the state it reached. Connect through your existing infrastructure — or let our mission control do it.',
        }}
      />
    </div>
  </section>

  {homeSections.map((section) => {
    switch (section.key) {
      case 'stack':
        return <Layers id={section.id} eyebrow={section.label} />;
      case 'operations':
        return (
          <PanelDeck
            id={section.id}
            eyebrow={section.label}
            title="One space for the work."
            lede="Delta is the cockpit, Kletos is the operating system for the agent workflow, and Krisis is the terms the work stays inside. The first case is a fire on an island, because it shows the whole platform at once."
            panels={operationsPanels}
            labels={['Run', 'Cell', 'Span', 'Seat', 'Chain', 'Terms', 'Campaign']}
            footnote="Pre-release development builds on simulated campaign data."
          />
        );
      case 'engine':
        return (
          <PanelDeck
            id={section.id}
            eyebrow={section.label}
            title="One engine, from a server to a two-dollar drone."
            lede="The same format runs on a server, in an operating system, beside a database, and on a two-dollar drone. The drone is the floor, not the product."
            panels={enginePanels}
            labels={['Engine', 'Alongside', 'Part', 'Footprint', 'Range']}
            footnote="The board is the smallest end of the range; the same engine runs in software."
          />
        );
      case 'cases':
        return <CaseDeck id={section.id} eyebrow={section.label} />;
      case 'fit':
        return (
          <PanelDeck
            id={section.id}
            eyebrow={section.label}
            title="Where the record answers from itself."
            lede="Three conditions hold: the question combines several axes, it has to be answered where the record was made, and the memory is the one the system has."
            panels={fitPanels}
            labels={['Condition', 'Everyday', 'Critical', 'Boundary']}
          />
        );
      case 'contact':
        return (
          <Section
            id={section.id}
            label={section.label}
            title="Building a system that has to answer for itself?"
            lede="Write to us. The design-partner program is open now."
            band
          >
            <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
          </Section>
        );
      default:
        return assertNever(section);
    }
  })}
</Base>

<style>
  /* The note is a footnote to the call: who can ask for a preview now, and when the
     rest can. */
  .hero-cta-note {
    flex-basis: 100%;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-3);
    text-wrap: pretty;
  }

  .reach-band {
    /* The globe starts behind the end of the promise: the copy is read against it,
       and the two are one scene rather than two stacked blocks. */
    margin-top: clamp(-200px, -17vh, -110px);
    position: relative;
    z-index: 1;
    padding-block: 4px clamp(40px, 6vh, 80px);
    /* The scene opens wider than the window and settles into it. The part that hangs
       past the edge is never on screen, and clipping it sideways keeps a phone from
       scrolling the whole page to reach it. The vertical bleed is the point, so only
       the horizontal axis is clipped. */
    overflow-x: clip;
  }

  /* The sphere is the scene, so it may use the window rather than the reading column,
     and it holds the right edge while the copy holds the left. */
  .reach-band .wrap {
    max-width: none;
    padding-inline: 0;
  }

  /* A phone has no column to give the globe, so the figure sits below the promise. */
  @media (max-width: 720px) {
    .reach-band {
      margin-top: -120px;
    }
  }

  /* The deck has no gap under it, and the link that closes the turn needs one. */
  .hl-close {
    padding-block: clamp(20px, 3vh, 32px) clamp(40px, 6vh, 80px);
  }

</style>
