---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CaseDeck from '../components/CaseDeck.astro';
import Layers from '../components/Layers.astro';
import Reach from '../components/Reach.astro';
import Section from '../components/Section.astro';
import PanelDeck from '../components/PanelDeck.astro';
import { companyCta, companyNav, creedLine, site } from '../config';

// The company's landing page: the promise, the situations the product is built for,
// the six parts as one stack, one turn for each part, and the people it is built for.
// The stack comes before the turns so a reader meets the map before the detail.
---

<Base
  title={`${site.name}: ${site.tagline}`}
  description={site.description}
  nav={companyNav}
  cta={companyCta}
>
  <Hero
    eyebrow={creedLine}
    title="Replayable Agentic Computing"
    lede="An insulin pump holds a dose. A drone turns back. A robot stops a line. Later, someone asks why, and the machine answers: what it was asked, what it did, and what limited it. That account sits on the device itself, at the moment it happened. The same record computes the next state, so the account and the control are one system."
    body="We make that answer the default: a spatiotemporal record engine on the machine, and a portable mission control where the operator rewinds and proves. It needs no operating system, no database, and no cloud, so the record stays where it was made."
    fieldReveal="scroll"
    depth
  >
    <a class="btn btn--accent" href={companyCta.href} slot="actions" data-hero-cta>
      {companyCta.label} 
    </a>

    <p class="hero-cta-note" slot="actions">
      Public demos and private beta are on the way.
    </p>
  </Hero>

  <section class="reach-band" aria-label="Where the engine runs">
    <div class="wrap">
      <Reach />
    </div>
  </section>

  <Layers />

  <PanelDeck
    id="device"
    eyebrow="Device"
    title="The record runs on the machine that made it."
    lede="A board of a few dozen grams, a chip that costs a couple of dollars, and no database under the engine. The records live in a partition of the flash the part already has."
    panels={[
      {
        kicker: 'The part',
        metrics: [
          { value: '$2', unit: 'MCU' },
          { value: '45', unit: 'g' },
        ],
        title: 'A two-dollar chip on a 45-gram airframe',
        body: 'The module costs a couple of dollars on the bill of materials, and the board weighs 45 g without its battery. It carries 8 MB of flash and half a megabyte of RAM, with no operating system, no database, and no file system between the engine and the flash.',
        image: {
          src: '/esp32s3-board.jpg',
          alt: 'A small flight-controller board with an ESP32-S3 module, its battery, and a USB bridge.',
          width: 1440,
          height: 739,
        },
      },
      {
        kicker: 'The footprint',
        metrics: [{ value: '1,648', unit: 'B' }],
        title: 'The engine holds under two kilobytes while it runs',
        body: 'That is the peak working memory measured on the part, with the records on the flash and the read path included. A boot does no storage work to find them: the address is computed from the fields, so there is no index to rebuild.',
        note: 'The first start prepares the storage; later starts hold the same figure.',
      },
      {
        kicker: 'The comparison',
        metrics: [{ value: '100', unit: 'KB' }],
        title: 'What a database needs for the same question',
        body: 'A minimum SQLite build needs an operating system and about 100 KB of heap for its B-tree, and it rebuilds on boot: it replays its write-ahead log, while LittleFS walks its directory and NVS reads its page index into RAM. The engine recomputes an address instead, in 1,648 bytes, with nothing running under it.',
        note: 'The engine figure is measured on the board; the database figure is its published minimum.',
      },
      {
        kicker: 'The other side',
        title: 'The small part is the proof, not the ceiling',
        body: 'One segment in memory, an answer read from the address, and nothing to build as the log grows. The same engine runs from firmware to a data centre.',
      },
    ]}
    labels={['Part', 'Footprint', 'Compare', 'Beyond']}
  />

  <PanelDeck
    id="delta"
    eyebrow="Operations"
    title="One space for the fleet."
    lede="Delta is the cockpit of a campaign: the machines, the people, and the record of a run, read together. The first case is a fire on an island, because it shows the whole platform at once."
    panels={[
      {
        kicker: 'The run',
        title: 'A fire on an island, answered by the fleet already there',
        body: 'A campaign opens on the island: survey and thermal drones map the perimeter, a relay holds the link over the strait, crawlers and boats take the shore, and each intent is claimed by a different machine under the same wind and keep-out bounds. The operator reads the same record and changes the intent while the run is moving.',
        note: 'Every campaign has this shape: a situation, a briefing, the objectives, the constraints, and the record.',
        image: {
          src: '/delta_devscr.jpg',
          alt: 'Rescue Wing: Island Fire. The intents and records on the left, the cell view of survey, thermal, photo and relay drones with crawlers, boats and rovers in the middle, the island and its shoreline on the right, and the timeline below.',
          width: 1842,
          height: 1047,
        },
      },
      {
        kicker: 'The cell',
        title: 'A factory cell runs on one intent',
        body: 'Servos, conveyors, cameras, maintenance robots, and the people who run them, read in the same cell view. An intent is written once, and every agent under the cell answers from it.',
        image: {
          src: '/delta_scr_factory.jpeg',
          alt: 'The cockpit on a factory cell: the intents and records on the left, the feed and the cell view in the middle with servos, conveyors and maintenance robots, and the timeline along the bottom.',
          width: 1766,
          height: 920,
        },
      },
      {
        kicker: 'The span',
        metrics: [{ value: '35,786', unit: 'km' }],
        title: 'Land, air, and orbit in one view',
        body: 'A rescue run reaches from a geostationary satellite at 35,786 km to a drone over the site, with the helicopters, the escorts, and the hospital on the same map. Each element is read where it is, and the run keeps one record across all of them.',
        image: {
          src: '/delta_scr_satelite.jpeg',
          alt: 'A rescue campaign on the map and in the cell view: satellites at 550, 1,200 and 35,786 km, rescue and medevac aircraft, escorts, the hospital, and the operators on one space.',
          width: 1265,
          height: 686,
        },
      },
      {
        kicker: 'The seat',
        title: 'The operator stands inside the run',
        body: `On the island, the operator does not read a dashboard about the fire. The cockpit is the run's own coordinate space: the drones, their record, and the wind and keep-out bounds around them, with the intent changed from the same place the record is read.`,
      },
      {
        kicker: 'The campaign',
        title: 'A run another team can replay',
        body: 'A finished run becomes a package that can be handed on and compared against another. The next campaign starts from it.',
      },
    ]}
    labels={['Run', 'Cell', 'Span', 'Seat', 'Campaign']}
    footnote="Pre-release development builds on simulated demo data."
  />

  <PanelDeck
    id="partners"
    eyebrow="Fit"
    title="Where the engine is the right answer."
    lede="Three conditions hold: the question combines several axes, it has to be answered where the record was made, and the memory is the one the part carries."
    panels={[
      {
        kicker: 'The condition',
        title: 'Answered on the machine, inside the memory it has',
        point: 'The link is down, the question is multi-axis, and no database fits in the part.',
        body: 'A record that stays on the machine answers from its own history. Nothing is built to answer it, and nothing has to be shipped out first.',
      },
      {
        kicker: 'Everyday',
        title: 'The same shape on things people already own',
        point: 'A bike computer that keeps a season of rides. An espresso machine that remembers every shot.',
        body: 'Which climb cost the battery, or what changed since Monday, answered on the device itself. No phone, no account, and no round trip.',
      },
      {
        kicker: 'Critical systems',
        title: 'Where the answer has to survive the audit',
        point: 'Ten to thirty years in service, and the organization that shipped it answers for what it did.',
        body: 'Defense programs, medical device makers, vehicle programs, and energy operators. The machine outlives the deployment, and the record has to outlive the machine.',
        note: 'The EU AI Act requires logging over the life of a high-risk system. The Cyber Resilience Act\'s reporting duty has applied since 11 September 2026, and its main obligations, including the software bill of materials, apply from 11 December 2027.'
      },
      {
        kicker: 'Where it does not apply',
        title: 'When a database is the right answer',
        point: 'If the record may leave the device, a database already does this.',
        body: 'A system that already runs a database, or one whose record may live on a server, does not need the engine. The boundary is part of the specification.',
      },
    ]}
    labels={['Condition', 'Everyday', 'Critical', 'Not a fit']}
  />

  <CaseDeck />

  <Section
    id="contact"
    label="Contact"
    title="Building a system that has to answer for itself?"
    lede="Write to us. We work with design partners now."
    band
  >
    <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
  </Section>
</Base>

<style>
  /* The note is a footnote to the call: who can ask for a demo now, and when the
     rest can. */
  .hero-cta-note {
    flex-basis: 100%;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-3);
    text-wrap: pretty;
  }

  .reach-band {
    /* The globe starts behind the end of the promise: the copy is read against it,
       and the two are one scene rather than two stacked blocks. */
    margin-top: clamp(-200px, -17vh, -110px);
    position: relative;
    z-index: 1;
    padding-block: 4px clamp(40px, 6vh, 80px);
    /* The scene opens wider than the window and settles into it. The part that hangs
       past the edge is never on screen, and clipping it sideways keeps a phone from
       scrolling the whole page to reach it. The vertical bleed is the point, so only
       the horizontal axis is clipped. */
    overflow-x: clip;
  }

  /* The sphere is the scene, so it may use the window rather than the reading column,
     and it holds the right edge while the copy holds the left. */
  .reach-band .wrap {
    max-width: none;
    padding-inline: 0;
  }

  /* A phone has no column to give the globe, so the figure sits below the promise. */
  @media (max-width: 720px) {
    .reach-band {
      margin-top: -120px;
    }
  }

  /* The deck has no gap under it, and the link that closes the turn needs one. */
  .hl-close {
    padding-block: clamp(20px, 3vh, 32px) clamp(40px, 6vh, 80px);
  }

</style>
