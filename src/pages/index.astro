---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import Product from '../components/Product.astro';
import Proof from '../components/Proof.astro';
import WhyNow from '../components/WhyNow.astro';
import Competition from '../components/Competition.astro';
import Company from '../components/Company.astro';
import Contact from '../components/Contact.astro';
import { site } from '../config';
---

<Base title={`${site.name}: ${site.tagline}`} description={site.description}>
  <Hero />
  <Metrics />
  <Product />
  <Proof />
  <WhyNow />
  <Competition />
  <Company />
  <Contact />
</Base>
