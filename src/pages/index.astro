---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Layers from '../components/Layers.astro';
import Reach from '../components/Reach.astro';
import Section from '../components/Section.astro';
import Deck from '../components/Deck.astro';
import { companyCta, productMenu, site, type NavItem } from '../config';

// The homepage owns its sections and its strip. The order, labels, and anchors below
// drive both the page and the header, so they cannot drift.

const homeSections = [
  { key: 'stack', label: 'Stack', id: 'products' },
  { key: 'operations', label: 'Operations', id: 'delta' },
  { key: 'accountability', label: 'Accountability', id: 'accountability' },
  { key: 'engine', label: 'Engine', id: 'engine' },
  { key: 'cases', label: 'Cases', id: 'cases' },
  { key: 'fit', label: 'Fit', id: 'partners' },
  { key: 'contact', label: 'Contact', id: 'contact' },
] as const;

const companyNav: readonly NavItem[] = homeSections.map(({ key, label, id }) => ({
  label,
  href: `#${id}`,
  ...(key === 'stack' ? { items: productMenu } : {}),
}));

const operationsPanels = [
  {
    kicker: 'The run',
    title: 'A fire on an island, met by the fleet already there',
    body: 'Survey and thermal drones map the perimeter, a relay holds the link over the strait, and crawlers and boats take the shore. One intent carries every machine, and the operator changes it while the run moves.',
    image: {
      src: '/delta_devscr.jpg',
      alt: 'Rescue Wing: Island Fire. The intents and records on the left, the cell view of survey, thermal, photo and relay drones with crawlers, boats and rovers in the middle, the island and its shoreline on the right, and the timeline below.',
      width: 1842,
      height: 1047,
    },
  },
  {
    kicker: 'The cell',
    title: 'A workforce runs on one intent',
    body: 'Servos, conveyors, cameras, maintenance robots, software agents, and the people who run them, in one cell view. An intent is written once, and the cell runs on it.',
    image: {
      src: '/delta_scr_factory.jpeg',
      alt: 'The cockpit on a factory cell: the intents and records on the left, the feed and the cell view in the middle with servos, conveyors and maintenance robots, and the timeline along the bottom.',
      width: 1766,
      height: 920,
    },
  },
  {
    kicker: 'The span',
    metrics: [{ value: '35,786', unit: 'km' }],
    title: 'Land, air, and orbit in one view',
    body: 'A rescue run reaches from a satellite at 35,786 km to a drone over the site, with the helicopters, the escorts, and the hospital on the same map.',
    image: {
      src: '/delta_scr_satelite.jpeg',
      alt: 'A rescue campaign on the map and in the cell view: satellites at 550, 1,200 and 35,786 km, rescue and medevac aircraft, escorts, the hospital, and the operators on one space.',
      width: 1265,
      height: 686,
    },
  },
  {
    kicker: 'The seat',
    title: 'The operator stands inside the run',
    body: `On the island, the operator stands in the run: the drones, their record, and the bounds around them, with the intent changed from where the record is read.`,
  },
  {
    kicker: 'The chain',
    title: 'The ask and the act stay one chain',
    body: 'A request is stated, claimed, performed, and written as a result, with the link back to the request. One chain across agents, people, machines, and outside systems.',
  },
  {
    kicker: 'The terms',
    title: 'The rules are written before the work starts',
    body: 'A smart contract or a governance rule sets which model may act, at what cost, and on whose authority. The record is checked against it.',
  },
  {
    kicker: 'The campaign',
    title: 'A run another team can replay',
    body: 'A finished run becomes a package that can be handed on and compared against another. The next campaign starts from it.',
  },
];

const accountabilityPanels = [
  {
    kicker: 'The intent',
    title: 'The intent is the boundary',
    body: 'A person states the work and the constraints once. The gate that binds an agent to them sits above the machines, not inside them. A call an agent originates is denied by default.',
  },
  {
    kicker: 'The chain',
    title: 'The act and the record are one chain',
    body: 'What was asked, who claimed it, what was done, and what it produced stay one chain. Nothing is joined from separate logs after the fact.',
  },
  {
    kicker: 'The replay',
    title: 'The run replays from the record',
    body: 'Every act carries an address anyone can recompute. The run replays from the record itself, on any target, years later.',
  },
];

const enginePanels = [
  {
    kicker: 'The Validation',
    metrics: [
      { value: '$2', unit: 'MCU' },
      { value: '45', unit: 'g' },
      { value: '1,648', unit: 'B' },
    ],
    title: 'A two-dollar chip on a 45-gram airframe',
    body: 'A $2 module with 8 MB of flash and 512 KB of RAM. The engine executes multi-axis queries and maintains its record within a 1,648-byte footprint.',
    note: 'The initial boot prepares the volume; all subsequent boots operate within this peak.',
    image: {
      src: '/esp32s3-board.jpg',
      alt: 'A small flight-controller board with an ESP32-S3 module, its battery, and a USB bridge.',
      width: 1440,
      height: 739,
    },
  },
  {
    kicker: 'The hard end',
    title: '64 KB of SRAM, and no operating system',
    body: 'On the RISC-V reference part, 256 KB of flash and 64 KB of SRAM, the engine and its storage take 32,812 B of static SRAM and 123,782 B of flash. Its heap peaks at 2,163 B, and no resident index grows with the record count.',
  },
  {
    kicker: 'The comparison',
    title: 'What the same question costs elsewhere',
    body: 'A general database needs an operating system and 100 KB or more of heap. An embedded key-value store keeps one axis and a RAM index. The engine resolves across axes with no resident index and no operating system.',
  },
  {
    kicker: 'Alongside the database',
    title: 'Keep the database. Send it fewer questions',
    body: 'A multi-axis question costs an index per axis. The engine resolves it from the record. Your database keeps transactions.',
  },
];

const fitPanels = [
  {
    kicker: 'Everyday',
    title: 'The same shape on things people already run',
    point: 'A service that keeps a year of runs. A bike computer that keeps a season of rides.',
    body: 'Which deploy cost the latency, or what changed since Monday, settled in the process itself. No account and no round trip.',
  },
  {
    kicker: 'Critical systems',
    title: 'Where the record has to survive the audit',
    point: 'Ten to thirty years in service, and the organization that shipped it is accountable for what it did.',
    body: 'Defense programs, medical device makers, vehicle programs, and energy operators. The machine outlives the deployment, and the record has to outlive the machine.',
    note: 'Medical and automotive: the EU AI Act requires logging over the life of a high-risk system. Industrial and energy: the CRA reporting duty has applied since 11 September 2026, with main obligations from 11 December 2027. Defense answers to its own regime.',
  },
  {
    kicker: 'The boundary',
    title: 'The line sits above the engine',
    point: 'The engine holds the record. Everything above the line is yours.',
    body: 'A record made where the work runs is proved from its own history. Your database, your cloud, and your services stay above it, and the format does not change.',
  },
];

const caseSlides = [
  {
    meta: 'Pump',
    stamp: '03:14',
    title: 'The dose was held.',
    rows: [
      { label: 'The question', text: 'How did the dose and the response move together over the last 24 hours, and was the alarm justified?' },
      { label: 'What the record must hold', text: 'Three weeks of readings on the pump itself, the earlier occlusion they match, and the entry that held the next dose.', rule: true },
    ],
  },
  {
    meta: 'Robot',
    stamp: '14:22',
    title: 'The line stopped.',
    rows: [
      { label: 'The question', text: 'Which decision led to the failure, and who authorized it?' },
      { label: 'What the record must hold', text: 'The ask, who took it, what was produced, and who approved it.', rule: true },
    ],
  },
  {
    meta: 'Drone',
    stamp: '09:41',
    title: 'The link dropped.',
    rows: [
      { label: 'The question', text: 'What did the sensors see before it, and was the operator warned?' },
      { label: 'What the record must hold', text: 'The readings on the airframe, ordered by time, with the last acknowledged command.', rule: true },
    ],
  },
  {
    meta: 'Vehicle',
    stamp: '21:07',
    title: 'The system intervened.',
    rows: [
      { label: 'The question', text: 'Which sensor and which model agreed before the intervention, and which did not?' },
      { label: 'What the record must hold', text: "Both readings, the model's output, and the rule that allowed the action.", rule: true },
    ],
  },
  {
    meta: 'Workflow',
    stamp: '08:12',
    title: 'The hand-off failed.',
    rows: [
      { label: 'The question', text: 'Which agent claimed the work, which tool did it call, and what did it hand on?' },
      { label: 'What the record must hold', text: 'The intent, the claim, the tool call, and the record the next agent received.', rule: true },
    ],
  },
  {
    meta: 'Software agent',
    stamp: '11:48',
    title: 'The agent responded.',
    rows: [
      { label: 'The question', text: 'Which model responded, at what cost, and on whose authority?' },
      { label: 'What the record must hold', text: 'The model, the price, and the authority, in one record beside the result.', rule: true },
    ],
  },
];

const assertNever = (value: never): never => {
  throw new Error(`Unhandled home section: ${JSON.stringify(value)}`);
};

---

<Base
  title={`${site.name}: ${site.tagline}`}
  description={site.description}
  nav={companyNav}
  cta={companyCta}
>
    <Hero
      eyebrow=""
      title="Replayable Agentic Computing"
      subline="Every autonomous act, accountable."
      lede="AI agent books shipment. Drone turns back. Insulin pump holds dose. Robot stops line. Later, someone asks why. System answers from record: what was asked, what it did, and what limited it."
      body="We turn intent into verified work, bind the act and the record together, and let the operator ask and prove the decision from the inside. One open format, from a two-dollar chip or a typical applications to a hyperscale data center, and your infrastructure stays as it is."
      fieldReveal="scroll"
      depth
    >
    <a class="btn btn--accent" href={companyCta.href} slot="actions" data-hero-cta>
      {companyCta.label}
    </a>
  </Hero>

  <section class="reach-band" aria-label="Where the engine runs">
    <div class="wrap">
      <Reach
        caption={{
          lead: 'One space and format, from chip to orbit.',
          body: 'Each agent, service, or machine keeps its own record. A record from one is read at the same coordinate by another, with no translator between them. The record is the trail from the past to this moment, and the longer it runs, the smaller the space of what happens next. Connect through your own infrastructure, or through our mission control.',
        }}
      />
    </div>
  </section>

  {homeSections.map((section) => {
    switch (section.key) {
      case 'stack':
        return <Layers id={section.id} eyebrow={section.label} />;
      case 'operations':
        return (
          <Deck
            id={section.id}
            eyebrow={section.label}
            title="One space for the work."
            lede="Delta is the cockpit, Kletos is the operating system for the agent workflow, and Krisis is the terms the work stays inside."
            slides={operationsPanels}
            labels={['Run', 'Cell', 'Span', 'Seat', 'Chain', 'Terms', 'Campaign']}
            footnote="The campaign data in these views is simulated. Delta is planned to be open source."
          />
        );
      case 'accountability':
        return (
          <Deck
            id={section.id}
            eyebrow={section.label}
            title="Inside the intent, on the record."
            lede="Accountable execution for an autonomous system: the intent bounds the work, the act stays on the record, and the run replays."
            slides={accountabilityPanels}
            labels={['Intent', 'Chain', 'Replay']}
          />
        );
      case 'engine':
        return (
          <Deck
            id={section.id}
            eyebrow={section.label}
            title="One engine, from a data center to the smallest part."
            lede="The range runs from a server to the smallest part a product ships. The engine has validated at this absolute limit."
            slides={enginePanels}
            labels={['Validation', 'Hard end', 'Compare', 'Alongside']}
          />
        );
      case 'cases':
        return (
          <Deck
            id={section.id}
            eyebrow={section.label}
            title="One record, every agent."
            lede="A pump, a robot, a drone, a vehicle, a workflow, a software agent. The same record holds what was asked, what was done, and what bounded it."
            slides={caseSlides}
          />
        );
      case 'fit':
        return (
          <Deck
            id={section.id}
            eyebrow={section.label}
            title="Where the record stands on its own."
            lede="The question combines several axes. It has to be settled where the record was made, inside the memory the system has."
            slides={fitPanels}
            labels={['Everyday', 'Critical', 'Boundary']}
          />
        );
      case 'contact':
        return (
          <Section
            id={section.id}
            label={section.label}
            title="Building a system that has to answer for itself?"
            lede="Write to us. Bring the system that has to answer for what it did."
            band
          >
            <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
          </Section>
        );
      default:
        return assertNever(section);
    }
  })}
</Base>

<style>
  /* The note is a footnote to the call: who can ask for a preview now, and when the
     rest can. */
  .hero-cta-note {
    flex-basis: 100%;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-3);
    text-wrap: pretty;
  }

  .reach-band {
    /* The globe starts behind the end of the promise: the copy is read against it,
       and the two are one scene rather than two stacked blocks. */
    margin-top: clamp(-200px, -17vh, -110px);
    position: relative;
    z-index: 1;
    padding-block: 4px clamp(40px, 6vh, 80px);
    /* The scene opens wider than the window and settles into it. The part that hangs
       past the edge is never on screen, and clipping it sideways keeps a phone from
       scrolling the whole page to reach it. The vertical bleed is the point, so only
       the horizontal axis is clipped. */
    overflow-x: clip;
  }

  /* The sphere is the scene, so it may use the window rather than the reading column,
     and it holds the right edge while the copy holds the left. */
  .reach-band .wrap {
    max-width: none;
    padding-inline: 0;
  }

  /* A phone has no column to give the globe, so the figure sits below the promise. */
  @media (max-width: 720px) {
    .reach-band {
      margin-top: -120px;
    }
  }

  /* The deck has no gap under it, and the link that closes the turn needs one. */
  .hl-close {
    padding-block: clamp(20px, 3vh, 32px) clamp(40px, 6vh, 80px);
  }

</style>
