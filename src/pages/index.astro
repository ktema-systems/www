---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CaseDeck from '../components/CaseDeck.astro';
import ProofDeck from '../components/ProofDeck.astro';
import DeltaDeck from '../components/DeltaDeck.astro';
import ProductHighlight from '../components/ProductHighlight.astro';
import ProductLink from '../components/ProductLink.astro';
import Layers from '../components/Layers.astro';
import Reach from '../components/Reach.astro';
import Section from '../components/Section.astro';
import { companyCta, companyNav, creedLine, site } from '../config';

// The company's landing page: the promise, the situations the product is built for,
// one turn for each of the six products, and the stack they make together. The
// detail lives on the product pages and in the pitch.
---

<Base
  title={`${site.name}: ${site.tagline}`}
  description={site.description}
  nav={companyNav}
  cta={companyCta}
>
  <Hero
    eyebrow={creedLine}
    title="Replayable Agentic Computing"
    subline="One space. One protocol. From chip to orbit."
    lede="An insulin pump holds a dose. A drone turns back. A robot stops a line. Later, someone asks why, and the machine answers: what it was asked, what it did, and what limited it. That account sits on the device itself, at the moment it happened."
    body="We make that answer the default. A spatiotemporal record on the machine, and a portable mission control the operator rewinds and proves. No cloud. No database. The record stays where it was made, from field sensors to space systems, from homes to defense programs."
    fieldReveal="scroll"
    depth
  />

  <section class="reach-band" aria-label="Where the engine runs">
    <div class="wrap">
      <Reach />
    </div>
  </section>

  <CaseDeck />

  <ProofDeck
    eyebrow="Ktema · the black box"
    title="What it costs to remember everything."
    lede="Microseconds on the host, bytes on the part. The volume grows and the record does not."
  />
  <div class="wrap hl-close">
    <ProductLink href="/ktema" label="Ktema" />
  </div>

  <ProductHighlight
    id="kletos"
    name="Kletos"
    meta="the autopilot"
    title="One unit of work, four steps, one record"
    lede="Work is stated, claimed, performed, and deposited as a fact, with a derivation that ties it to the intent that proposed it."
    rows={[
      {
        k: 'Stated',
        v: 'The work is stated, and the intent that proposes it is written with it.',
      },
      { k: 'Claimed', v: 'An agent, a machine, or a person takes it, and the claim is written.' },
      { k: 'Performed', v: 'The work is done where the machine that took it runs.' },
      {
        k: 'Deposited',
        v: 'The result is written as a fact, with a derivation that ties it to the intent.',
      },
    ]}
    href="/kletos"
  />

  <ProductHighlight
    id="krisis"
    name="Krisis"
    meta="the authority"
    title="The rules the work runs inside"
    lede="It sets what each action may do, chooses which model answers and at what cost, and keeps the work inside the rules a deployment declared."
    rows={[
      { k: 'The action', v: 'What each action may do, and what it may not.' },
      { k: 'The model', v: 'Which model answers a request.' },
      { k: 'The cost', v: 'What that answer costs.' },
      { k: 'The terms', v: 'On what terms it is given.' },
    ]}
    href="/krisis"
  />

  <DeltaDeck eyebrow="Delta · the cockpit" title="Intent enters a moving run" />
  <div class="wrap hl-close">
    <ProductLink href="/delta" label="Delta" />
  </div>

  <ProductHighlight
    id="telos"
    name="Telos"
    meta="the transport"
    title="A step to another place is an address"
    lede="Work is addressed by coordinate and reached by teleport, so an agent moves between work locations without walking a tree or scanning a path."
    points={[
      'Live execution states move between agents, people, and spaces.',
      "It carries the operator's view to the machine, so the platform is a position inside the system rather than a window onto it.",
    ]}
    href="/telos"
  />

  <ProductHighlight
    id="kleis"
    name="Kleis"
    meta="the seal"
    title="It decides who enters"
    lede="The key a holder presents, the seal that makes a copy of the files worth nothing, and the proof that the holder was there."
    rows={[
      { k: 'Who enters', v: 'Kleis, from the key the holder presents.' },
      { k: 'What may be done', v: 'Krisis, from the rules the deployment declared.' },
    ]}
    href="/kleis"
  />

  <Layers />

  <Section
    id="partners"
    label="Partners"
    title="Built for physical AI autonomous systems"
    lede="We work with the teams that build them and stand behind them after they ship."
  >
    <div class="biz">
      <div>
        <p class="biz__k">Who builds with it</p>
        <p>Defense programs, medical device makers, vehicle programs, and energy operators. They build the machine and carry the liability for what it does in the real world.</p>
      </div>
      <div>
        <p class="biz__k">Why now</p>
        <p>
          The EU AI Act and the Cyber Resilience Act require automatic logging over the life of a
          high-risk system. A machine that carries its own record meets that requirement as it
          ships.
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="contact"
    label="Contact"
    title="Building a system that has to answer for itself?"
    lede="Write to us. We are choosing the first design partners now."
    band
  >
    <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
  </Section>
</Base>

<style>
  .reach-band {
    /* The globe starts behind the end of the promise: the copy is read against it,
       and the two are one scene rather than two stacked blocks. */
    margin-top: clamp(-200px, -17vh, -110px);
    position: relative;
    z-index: 1;
    padding-block: 4px clamp(40px, 6vh, 80px);
  }

  /* The sphere is the scene, so it may use the window rather than the reading column,
     and it holds the right edge while the copy holds the left. */
  .reach-band .wrap {
    max-width: none;
    padding-inline: 0;
  }

  /* A phone has no column to give the globe, so the figure sits below the promise. */
  @media (max-width: 720px) {
    .reach-band {
      margin-top: -40px;
    }
  }

  /* The deck has no gap under it, and the link that closes the turn needs one. */
  .hl-close {
    padding-block: clamp(20px, 3vh, 32px) clamp(40px, 6vh, 80px);
  }

  .biz {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .biz > div {
    background: var(--bg);
    padding: 22px 24px;
  }

  .biz p {
    margin: 0;
  }

  .biz p + p {
    margin-top: 8px;
    color: var(--fg-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .biz__k {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  @media (max-width: 820px) {
    .biz {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
