---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Layers from '../components/Layers.astro';
import Reach from '../components/Reach.astro';
import Section from '../components/Section.astro';
import Deck from '../components/Deck.astro';
import { demoCta, papers, productMenu, site, type NavItem } from '../config';

// The homepage owns its sections and its strip. The order, labels, and anchors below
// drive both the page and the header, so they cannot drift.

const homeSections = [
  { key: 'stack', label: 'Stack', id: 'products' },
  { key: 'cases', label: 'Incidents', id: 'cases' },
  { key: 'accountability', label: 'What changes', id: 'accountability' },
  { key: 'engine', label: 'Proof', id: 'engine' },
  { key: 'operations', label: 'Operations', id: 'delta' },
  { key: 'open', label: 'Open', id: 'open' },
  { key: 'fit', label: 'Fit', id: 'partners' },
  { key: 'contact', label: 'Contact', id: 'contact' },
] as const;

const companyNav: readonly NavItem[] = homeSections.map(({ key, label, id }) => ({
  label,
  href: `#${id}`,
  ...(key === 'stack' ? { items: productMenu } : {}),
}));

const operationsPanels = [
  {
    kicker: 'The run',
    title: 'A fire on an island, met by the fleet already there',
    body: 'Survey and thermal drones map the perimeter, a relay holds the link over the strait, and crawlers and boats take the shore. One intent carries every machine, and the operator changes it while the run moves.',
    image: {
      src: '/delta_devscr.jpg',
      alt: 'Rescue Wing: Island Fire. The intents and records on the left, the cell view of survey, thermal, photo and relay drones with crawlers, boats and rovers in the middle, the island and its shoreline on the right, and the timeline below.',
      width: 1842,
      height: 1047,
    },
  },
  {
    kicker: 'The cell',
    title: 'A workforce runs on one intent',
    body: 'Servos, conveyors, cameras, maintenance robots, software agents, and the people who run them, in one cell view. An intent is written once, and the cell runs on it.',
    image: {
      src: '/delta_scr_factory.jpeg',
      alt: 'The cockpit on a factory cell: the intents and records on the left, the feed and the cell view in the middle with servos, conveyors and maintenance robots, and the timeline along the bottom.',
      width: 1766,
      height: 920,
    },
  },
  {
    kicker: 'The span',
    metrics: [{ value: '35,786', unit: 'km' }],
    title: 'Land, air, and orbit in one view',
    body: 'A rescue run reaches from a satellite at 35,786 km to a drone over the site, with the helicopters, the escorts, and the hospital on the same map.',
    image: {
      src: '/delta_scr_satelite.jpeg',
      alt: 'A rescue campaign on the map and in the cell view: satellites at 550, 1,200 and 35,786 km, rescue and medevac aircraft, escorts, the hospital, and the operators on one space.',
      width: 1265,
      height: 686,
    },
  },
  {
    kicker: 'The seat',
    title: 'The operator stands inside the run',
    body: `On the island, the operator stands in the run: the drones, their record, and the bounds around them, with the intent changed from where the record is read.`,
  },
  {
    kicker: 'The chain',
    title: 'The ask and the act stay one chain',
    body: 'A request is stated, claimed, performed, and written as a result, with the link back to the request. One chain across agents, people, machines, and outside systems.',
  },
  {
    kicker: 'The terms',
    title: 'The rules are written before the work starts',
    body: 'A smart contract or a governance rule sets which model may act, at what cost, and on whose authority. The record is checked against it.',
  },
  {
    kicker: 'The campaign',
    title: 'A run another team can replay',
    body: 'A finished run becomes a package that can be handed on and compared against another. The next campaign starts from it.',
  },
];

const accountabilityPanels = [
  {
    kicker: 'The limit',
    title: 'The limit is written before the work starts',
    body: 'A person states the work and its bounds once. A call outside them is refused by the system while it runs, instead of by a review afterwards.',
  },
  {
    kicker: 'The chain',
    title: 'The ask and the act are one record',
    body: 'What was asked, who claimed it, what was done, and what came back stay together. Nothing is joined from separate logs when the question arrives.',
  },
  {
    kicker: 'The replay',
    title: 'The run can be re-entered years later',
    body: 'Every act carries an address anyone can recompute, so the run replays on another target from the record alone.',
  },
];

const enginePanels = [
  {
    kicker: 'The part',
    metrics: [
      { value: '8', unit: 'MB' },
      { value: '512', unit: 'KB' },
      { value: '1,648', unit: 'B' },
    ],
    title: 'The engine on an 8 MB microcontroller',
    body: 'An ESP32-S3 module with 8 MB of flash and 512 KB of RAM. The engine answers multi-axis questions and keeps its record within 1,648 bytes, so a product that ships this part can answer for itself.',
    note: 'The initial boot prepares the volume; all subsequent boots operate within this peak.',
    image: {
      src: '/esp32s3-board.jpg',
      alt: 'An ESP32-S3-WROOM-1 module on the flight-controller board that carries it.',
      width: 700,
      height: 350,
    },
  },
  {
    kicker: 'The hard end',
    title: '64 KB of SRAM, and no operating system',
    body: 'On the RISC-V reference part, with 256 KB of flash and 64 KB of SRAM, the engine and its storage take 32,812 B of static SRAM and 123,782 B of flash, and its heap peaks at 2,163 B. A database needs an operating system and a heap; this answers without either.',
  },
  {
    kicker: 'The comparison',
    title: 'What the same question costs elsewhere',
    body: 'A general database needs an operating system and 100 KB or more of heap. An embedded key-value store keeps one axis and a RAM index. The engine answers across axes with no resident index, so the memory a product reserves does not grow with its history.',
  },
  {
    kicker: 'Alongside the database',
    title: 'Keep the database. Send it fewer questions.',
    body: 'A multi-axis question costs an index per axis. The engine answers it from the record, and the database keeps transactions.',
  },
];

const fitPanels = [
  {
    kicker: 'Everyday',
    title: 'The same shape on things people already run',
    point: 'A service that keeps a year of runs. A bike computer that keeps a season of rides.',
    body: 'Which deploy cost the latency, or what changed since Monday, settled in the process itself. No account and no round trip.',
  },
  {
    kicker: 'Critical systems',
    title: 'Where the record has to survive the audit',
    point: 'Ten to thirty years in service, and the organization that shipped it is accountable for what it did.',
    body: 'Defense programs, medical device makers, vehicle programs, and energy operators. The machine outlives the deployment, and the record has to outlive the machine.',
    note: 'Medical and automotive: the EU AI Act requires logging over the life of a high-risk system. Industrial and energy: the CRA reporting duty has applied since 11 September 2026, with main obligations from 11 December 2027. Defense answers to its own regime.',
  },
  {
    kicker: 'The boundary',
    title: 'The line sits above the engine',
    point: 'The engine holds the record. Everything above the line is yours.',
    body: 'A record made where the work runs is proved from its own history. Your database, your cloud, and your services stay above it, and the format does not change.',
  },
];

const caseSlides = [
  {
    meta: 'Pump',
    stamp: '03:14',
    title: 'The dose was held.',
    rows: [
      { label: 'What happened', text: 'A dose was held. Weeks later, someone has to say why.' },
      { label: 'Today', text: 'Three logs in three places: the readings, the alarm, the model decision.' },
      { label: 'The record', text: 'The readings, the earlier occlusion they match, and the entry that held the dose, in one record on the pump.', rule: true },
    ],
  },
  {
    meta: 'Robot',
    stamp: '14:22',
    title: 'The line stopped.',
    rows: [
      { label: 'What happened', text: 'A line stopped, and the shift wants to know which decision did it.' },
      { label: 'Today', text: 'The cell log, the robot trace, and the approval, joined by hand.' },
      { label: 'The record', text: 'The ask, who took it, what was produced, and who approved it, in one chain.', rule: true },
    ],
  },
  {
    meta: 'Drone',
    stamp: '09:41',
    title: 'The link dropped.',
    rows: [
      { label: 'What happened', text: 'A link dropped, and someone asks what the aircraft saw before it.' },
      { label: 'Today', text: 'The flight log ends where the radio ended.' },
      { label: 'The record', text: 'The readings ordered by time, with the last acknowledged command, kept on the aircraft.', rule: true },
    ],
  },
  {
    meta: 'Vehicle',
    stamp: '21:07',
    title: 'The system intervened.',
    rows: [
      { label: 'What happened', text: 'The system braked on its own, and the question is which sensors agreed.' },
      { label: 'Today', text: 'Two vendor logs and one model server, with no shared clock.' },
      { label: 'The record', text: 'Both readings, the model output, and the rule that allowed the action.', rule: true },
    ],
  },
  {
    meta: 'Workflow',
    stamp: '08:12',
    title: 'The hand-off failed.',
    rows: [
      { label: 'What happened', text: 'Work moved between agents, and stopped moving.' },
      { label: 'Today', text: 'Each agent kept its own log, and nothing ties the hand-off.' },
      { label: 'The record', text: 'The intent, the claim, the tool call, and the record the next agent received.', rule: true },
    ],
  },
  {
    meta: 'Software agent',
    stamp: '11:48',
    title: 'The agent responded.',
    rows: [
      { label: 'What happened', text: 'An agent answered a customer, and the answer cost money.' },
      { label: 'Today', text: 'The platform billing, the model log, and no record of who allowed it.' },
      { label: 'The record', text: 'The model, the price, and the authority, in one record beside the result.', rule: true },
    ],
  },
];

const assertNever = (value: never): never => {
  throw new Error(`Unhandled home section: ${JSON.stringify(value)}`);
};

---

<Base
  title={`${site.name}: ${site.tagline}`}
  description={site.description}
  nav={companyNav}
  cta={demoCta}
>
    <Hero
      eyebrow=""
      title="Replayable Agentic Computing"
      subline="Every autonomous act, accountable."
      lede="AI agent books shipment. Drone turns back. Insulin pump holds dose. Robot stops line. Later, someone asks why. System answers from record: what was asked, what it did, and what limited it."
      body="The answer is usually assembled afterwards, from an agent log, a device trace, and rows in a database that were never written to agree. We keep the ask, the act, and the limit in one record at the machine that made it, so the answer is already there when the question arrives."
      fieldReveal="scroll"
      depth
    >
    <a class="btn btn--accent" href={demoCta.href} slot="actions" data-hero-cta>
      {demoCta.label}
    </a>
  </Hero>

  <section class="reach-band" aria-label="Where the engine runs">
    <div class="wrap">
      <Reach
        caption={{
          lead: 'The same record, from a part to orbit.',
          body: 'An agent, a service, or a machine keeps its own record, and another reads it at the same address with no translator between them. One format, so a fleet, a cell, and a product line answer the same way. Connect through your own infrastructure, or through our mission control.',
        }}
      />
    </div>
  </section>

  {homeSections.map((section) => {
    switch (section.key) {
      case 'stack':
        return <Layers id={section.id} eyebrow={section.label} />;
      case 'open':
        return (
          <Section
            id={section.id}
            label={section.label}
            title="A published format, and the engineering that runs it."
            lede="The format and the research are published through the SSCCS Initiative, which the work shares an origin with. A record is evidence only if someone other than its author can check it, so the format has to be public. The engines, the kernels, and the layers above them are separate engineering, and a deployment licenses them."
          >
            <dl class="spec open">
              <dt>The format</dt>
              <dd>
                Published under Apache 2.0, so a second implementation can recompute an address from the fields and
                check a record it did not write.
              </dd>
              <dt>The research</dt>
              <dd>
                Four preprints on the format and the addressing, from February to September 2026.
                <ul class="papers">
                  {papers.map((paper) => (
                    <li>
                      <span class="papers__when">{paper.when}</span>
                      <a href={paper.href}>{paper.title}</a>
                    </li>
                  ))}
                </ul>
              </dd>
              <dt>The initiative</dt>
              <dd>
                The <a href="https://ssccs.org">SSCCS Initiative</a> publishes the format and carries it as the neutral
                source for the compliance frameworks. It is a non-profit and open source foundation.
              </dd>
              <dt>The engineering</dt>
              <dd>
                The engines, the device kernels, and the layers above them are built here, outside the published
                material, and a deployment licenses them.
              </dd>
            </dl>
          </Section>
        );
      case 'operations':
        return (
          <Deck
            id={section.id}
            eyebrow={section.label}
            title="The run, seen from where it happens."
            lede="Delta is the cockpit: the machines, their records, the bounds around them, and the timeline, in one space."
            slides={operationsPanels}
            labels={['Run', 'Cell', 'Span', 'Seat', 'Chain', 'Terms', 'Campaign']}
            footnote="The campaign data in these views is simulated. Delta is planned to be open source."
          />
        );
      case 'accountability':
        return (
          <Deck
            id={section.id}
            eyebrow={section.label}
            title="The answer stops being reconstruction."
            lede="Three things change: the limit is written first, the ask stays with the act, and the run can be re-entered."
            slides={accountabilityPanels}
            labels={['Limit', 'Chain', 'Replay']}
          />
        );
      case 'engine':
        return (
          <Deck
            id={section.id}
            eyebrow={section.label}
            title="The same build answers in a data center and on a 256 KB part."
            lede="The measurements that bound it, from a part with no operating system to the comparison with a database."
            slides={enginePanels}
            labels={['Part', 'Hard end', 'Compare', 'Alongside']}
          />
        );
      case 'cases':
        return (
          <Deck
            id={section.id}
            eyebrow={section.label}
            title="Everything is asked afterwards."
            lede="An incident is settled by what was kept. Six of them, and what the answer takes."
            slides={caseSlides}
          />
        );
      case 'fit':
        return (
          <Deck
            id={section.id}
            eyebrow={section.label}
            title="Where this pays for itself."
            lede="The question spans several axes, and the answer has to exist where the record was made."
            slides={fitPanels}
            labels={['Everyday', 'Critical', 'Boundary']}
          />
        );
      case 'contact':
        return (
          <Section
            id={section.id}
            label={section.label}
            title="Building a system that has to answer for itself?"
            lede="Write to us. Bring the system that has to answer for what it did."
            band
          >
            <p><a class="btn btn--accent" href={`mailto:${site.contact}`}>Write to us</a></p>
          </Section>
        );
      default:
        return assertNever(section);
    }
  })}
</Base>

<style>
  /* The note is a footnote to the call: who can ask for a preview now, and when the
     rest can. */
  .hero-cta-note {
    flex-basis: 100%;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-3);
    text-wrap: pretty;
  }

  .reach-band {
    /* The globe starts behind the end of the promise: the copy is read against it,
       and the two are one scene rather than two stacked blocks. */
    margin-top: clamp(-200px, -17vh, -110px);
    position: relative;
    z-index: 1;
    padding-block: 4px clamp(40px, 6vh, 80px);
    /* The scene opens wider than the window and settles into it. The part that hangs
       past the edge is never on screen, and clipping it sideways keeps a phone from
       scrolling the whole page to reach it. The vertical bleed is the point, so only
       the horizontal axis is clipped. */
    overflow-x: clip;
  }

  /* The sphere is the scene, so it may use the window rather than the reading column,
     and it holds the right edge while the copy holds the left. */
  .reach-band .wrap {
    max-width: none;
    padding-inline: 0;
  }

  /* A phone has no column to give the globe, so the figure sits below the promise. */
  @media (max-width: 720px) {
    .reach-band {
      margin-top: -120px;
    }
  }

  /* The deck has no gap under it, and the link that closes the turn needs one. */
  .hl-close {
    padding-block: clamp(20px, 3vh, 32px) clamp(40px, 6vh, 80px);
  }

  /* The open block reads as a licence sheet: what anyone may use, what is published,
     and what is licensed. The links are the evidence, so they carry the accent. */
  .open a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .open a:hover,
  .open a:focus-visible {
    border-bottom-color: var(--accent);
  }

  .papers {
    display: grid;
    gap: 7px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .papers li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 13.5px;
    line-height: 1.5;
  }

  .papers__when {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

</style>
