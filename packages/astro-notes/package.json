{
  "name": "@ktema-systems/astro-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Read a directory of Markdown notes whose attributes sit in a YAML header under one namespace.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "keywords": [
    "markdown",
    "frontmatter",
    "yaml",
    "notes"
  ],
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "scripts": {
    "test": "node --test index.test.mjs"
  }
}
