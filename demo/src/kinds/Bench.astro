---
// The measurement page: one workload measured three ways. What is compared is the shape each
// engine gives the same record, because that is what a buyer chooses between.
//
// The charts are drawn from the data. The document under them is Markdown, and it carries no figure of its own: every
// number arrives from `data/bench.ts` through the values below, so a re-run cannot leave the prose quoting an old one.
import Chart from '../components/Chart.astro';
import Markdown from '../components/Markdown.astro';
import { engines, indexMemory, ceiling, source, reads, boxes, type Row } from '../data/bench';
import type { Artifact } from '../data/artifacts';

interface Props {
  artifact: Artifact;
}

const { artifact } = Astro.props;

const label = (n: number) => (n >= 1_000_000 ? `${n / 1_000_000}M` : n >= 1000 ? `${n / 1000}k` : String(n));
const mib = (bytes: number) => bytes / (1024 * 1024);
const kb = (bytes: number) => bytes / 1024;
const size = (bytes: number) =>
  bytes >= 1024 ** 3
    ? `${(bytes / 1024 ** 3).toFixed(1)} GB`
    : bytes >= 1024 ** 2
      ? `${(bytes / 1024 ** 2).toFixed(1)} MB`
      : `${(bytes / 1024).toFixed(0)} kB`;
const span = (us: number) => (us >= 1000 ? `${(us / 1000).toFixed(1)} ms` : `${us.toFixed(0)} µs`);
const rate = (row: (typeof boxes.rows)[number]) => Math.round(row.answers / (row.us / 1_000_000));
const kilo = (value: number) =>
  value >= 1_000_000 ? `${(value / 1_000_000).toFixed(1)} million` : `${Math.round(value / 1000)} thousand`;
const gigabytes = (bytes: number, us: number) => bytes / (us / 1_000_000) / 1024 ** 3;

const seriesOf = (pick: (row: Row) => number) =>
  engines.map((engine) => ({
    name: engine.name,
    color: engine.color,
    points: engine.rows.map((row) => ({ label: label(row.records), value: pick(row) })),
  }));

const at = (id: string, records: number) =>
  engines.find((engine) => engine.id === id)!.rows.find((row) => row.records === records)!;

const ktema100k = at('ktema', 100_000);
const log100k = at('log', 100_000);
const sqlite100k = at('sqlite', 100_000);
const ktema1m = at('ktema', 1_000_000);
const log1m = at('log', 1_000_000);
const sqlite1m = at('sqlite', 1_000_000);
const ktemaRows = engines[0]!.rows;
const sqliteRows = engines[2]!.rows;
const logMap1m = indexMemory.log[indexMemory.log.length - 1]!.bytes;
const sqliteCache = indexMemory.sqlite[indexMemory.sqlite.length - 1]!.bytes;

// How many times the volume the engine reads to answer a tenth of it, which is what its time follows.
const tenthMultiple = (ktema100k.range_bytes ?? 0) / ktema100k.volume_bytes;

const values: Record<string, string> = {
  bytes_ktema: String(ktema1m.bytes_per_record),
  bytes_log: String(log1m.bytes_per_record),
  bytes_sqlite: String(sqlite1m.bytes_per_record),
  index_ktema: `${kb(indexMemory.engine_bytes).toFixed(0)} kB, optional; not built in this run`,
  index_log: `${mib(logMap1m).toFixed(0)} MB, one entry per record`,
  index_sqlite: `${mib(sqliteCache).toFixed(1)} MB, page cache`,
  append_ktema: `${ktema100k.write_us.toFixed(1)} µs`,
  append_log: `${log100k.write_us.toFixed(1)} µs`,
  append_sqlite: `${sqlite100k.write_us.toFixed(1)} µs`,
  open_ktema: `${(ktema100k.open_us / 1000).toFixed(2)} ms`,
  open_log: `${(log100k.open_us / 1000).toFixed(2)} ms`,
  open_sqlite: `${(sqlite100k.open_us / 1000).toFixed(2)} ms`,
  point_ktema: `${ktema100k.point_read_us.toFixed(2)} µs, reading ${kb(ktema100k.point_read_bytes ?? 0).toFixed(0)} kB`,
  point_log: `${log100k.point_read_us.toFixed(2)} µs`,
  point_sqlite: `${sqlite100k.point_read_us.toFixed(2)} µs, reading ${kb(sqlite100k.point_read_bytes ?? 0).toFixed(0)} kB`,
  tenth_ktema: `${(ktema100k.range_us / 1000).toFixed(0)} ms, reading ${tenthMultiple.toFixed(1)} times the volume`,
  tenth_log: `${(log100k.range_us / 1000).toFixed(2)} ms`,
  tenth_sqlite: `${(sqlite100k.range_us / 1000).toFixed(2)} ms, reading ${mib(sqlite100k.range_bytes ?? 0).toFixed(1)} MB`,
  ceiling_records: ceiling.records.toLocaleString('en-US'),
  volume_multiple: tenthMultiple.toFixed(1),
};
---

<p class="bench__lede">
  One record, three stores, on one machine. The record is three 60-byte addresses, an origin, a media type and a
  payload of about 55 bytes, which is what the engine's own bench writes. Each chart below measures the same content,
  so the differences are the formats.
</p>

<div class="bench__grid">
  <Chart
    title="Memory to answer by address"
    wide={true}
    caption={`The index each engine has to hold. The bare log builds one map entry per record, and at five million records that map is ${mib(indexMemory.log_at_five_million).toFixed(0)} MB. The engine's line is its optional structural index, a fixed array of about ${kb(indexMemory.engine_bytes).toFixed(0)} kB that this benchmark does not build: the run opens without record maps, so it answers a box query by walking the log. A database keeps its index in a file, so the memory it holds is the page cache that file is read through, which follows the records until it reaches about ${mib(sqliteCache).toFixed(0)} MB, the size the cache was configured with.`}
    unit="MB"
    scale="log"
    decimals={2}
    series={[
      {
        name: 'Ktema, optional index',
        color: 'var(--accent)',
        points: indexMemory.log.map((point) => ({
          label: label(point.records),
          value: kb(indexMemory.engine_bytes) / 1024,
        })),
      },
      {
        name: 'Append log',
        color: 'var(--fg-2)',
        points: indexMemory.log.map((point) => ({ label: label(point.records), value: mib(point.bytes) })),
      },
      {
        name: 'SQLite',
        color: 'rgb(122, 121, 119)',
        points: indexMemory.sqlite.map((point) => ({ label: label(point.records), value: mib(point.bytes) })),
      },
    ]}
  />
  <Chart
    title="Volume size"
    caption="Linear for all three, as a log is. At a million records the engine's volume is 472 MB, the append log's 245 MB and the database's 279 MB."
    unit="MB"
    scale="log"
    decimals={1}
    series={seriesOf((row) => mib(row.volume_bytes))}
  />
  <Chart
    title="Write one record"
    caption="Appending one record once the volume is built."
    unit="µs"
    scale="log"
    decimals={2}
    series={seriesOf((row) => row.write_us)}
  />
  <Chart
    title="Open"
    caption="Making the volume answerable. The log rebuilds its address map here; the engine reads its segment trailers."
    unit="µs"
    scale="log"
    decimals={1}
    series={seriesOf((row) => row.open_us)}
  />
  <Chart
    title="One record by address"
    caption="One record fetched by its own address. The log holds the whole address map in memory, so its lookup is constant; the engine builds no map, because the path that runs without an operating system has nowhere to keep one, so it finds the record by probing the segments of the log. That read grows from 3.1 kB at a thousand records to 20 kB at a million, and the line follows the bytes. The flat line in the memory chart is the same choice from the other side: no map is held, so the read is paid on the medium."
    unit="µs"
    scale="log"
    decimals={2}
    series={seriesOf((row) => row.point_read_us)}
  />
  <Chart
    title="A tenth of the records by address"
    caption="A contiguous tenth of the addresses, enumerated rather than counted: about 100 records at a thousand and about 100,000 at a million. The engine's path carries no index, so it walks the log."
    unit="µs"
    scale="log"
    decimals={0}
    series={seriesOf((row) => row.range_us)}
  />
  <Chart
    title="Bytes read from the medium to answer"
    caption="The bytes each store asked the medium for to answer one call. The engine's channel counts its reads; the database's pager counts the pages it fetched, at its 4 kB page, on a connection opened for the read, because a cache that already holds the page fetches nothing. A point read costs the engine 3.1 kB at a thousand records and the database 12 kB; at a million they are 20 kB and 24 kB. A tenth of the range is where the tree shows: the database reads 27.9 MB and the engine 1.5 GB, because the engine's path has no index and walks the log. The append log maps its file, so its reads are page faults no counter here sees: its open walks the whole file, and a point read afterwards touches a page already there."
    unit="MB"
    scale="log"
    decimals={2}
    series={[
      {
        name: 'Ktema, point read',
        color: 'var(--accent)',
        points: ktemaRows.map((row) => ({ label: label(row.records), value: mib(row.point_read_bytes ?? 0) })),
      },
      {
        name: 'Ktema, a tenth',
        color: 'var(--fg-2)',
        points: ktemaRows.map((row) => ({ label: label(row.records), value: mib(row.range_bytes ?? 0) })),
      },
      {
        name: 'SQLite, point read',
        color: 'rgb(122, 121, 119)',
        points: sqliteRows.map((row) => ({ label: label(row.records), value: mib(row.point_read_bytes ?? 0) })),
      },
      {
        name: 'SQLite, a tenth',
        color: 'var(--fg-3)',
        points: sqliteRows.map((row) => ({ label: label(row.records), value: mib(row.range_bytes ?? 0) })),
      },
    ]}
  />
</div>

<section class="bench__fit">
  <Markdown source={artifact.body ?? ''} values={values} />
</section>

<section class="bench__fit">
  <h2>A box on any axis</h2>
  <p>
    A multi-dimensional query fixes ranges on some axes and asks for the records inside. One box over a tenth of one
    axis, at a million records, through each store's own query path:
  </p>
  <table>
    <thead>
      <tr><th>Shape</th><th>Answers</th><th>Time</th><th>Bytes read</th><th>Index</th></tr>
    </thead>
    <tbody>
      {boxes.rows.map((row) => (
        <tr>
          <td>{row.store}</td>
          <td>{row.answers.toLocaleString('en-US')}</td>
          <td>{span(row.us)}</td>
          <td>{size(row.bytes)}</td>
          <td>{row.index_bytes === 0 ? 'none' : size(row.index_bytes)}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p>
    The engine answers both shapes from the same pass, in the same bytes, because the address is computed and nothing
    is stored to prune with. The database's inner-axis row is the shape its key order does not carry: {(
      boxes.rows[3].bytes / boxes.rows[2].bytes
    ).toFixed(1)} times the reads of the key range and {(
      boxes.rows[3].us / boxes.rows[2].us
    ).toFixed(1)} times the time. An index makes that shape cheap again, and the index is {size(boxes.rows[4].index_bytes)} on a {size(sqlite1m.volume_bytes)} volume, held for one shape and
    maintained by every append.
  </p>
  <p>
    The engine's flat cost is its whole namespace, walked once per query: {size(boxes.rows[0].bytes)} at a million
    records. The merge sets it. A listing compares each key once per segment, and a segment answers with an entry
    rather than with the bytes of the key, so a volume of eight segments reads eight entries for every key it lists,
    and the box pays that whether it answers a tenth of the volume or all of it. A listing begins at a prefix, and a
    box is a set of ranges rather than a prefix, so the walk begins at the namespace's first key. A start-of-range
    seek in the channel is what would make a box read its own window.
  </p>
  <Chart
    title="Answers a second"
    caption={`Answers a second, which is what a box returns rather than what it costs. The database's rate follows whether its key order carries the shape: ${kilo(rate(boxes.rows[2]))} for the ordered shape, ${kilo(rate(boxes.rows[3]))} for an inner axis, and ${kilo(rate(boxes.rows[4]))} once an index exists for that axis. The engine's rate is ${kilo(rate(boxes.rows[0]))} for the ordered shape and ${kilo(rate(boxes.rows[1]))} for an inner axis, because no axis is cheaper than another when the address is computed. The bytes behind those rates are on the chart above: ${gigabytes(boxes.rows[0].bytes, boxes.rows[0].us).toFixed(1)} GB/s through the engine's read path against ${gigabytes(boxes.rows[2].bytes, boxes.rows[2].us).toFixed(1)} GB/s through the database's, work the database does when its cache is cold and serves from memory otherwise.`}
    unit="answers/s"
    scale="linear"
    decimals={0}
    kind="bar"
    series={[
      {
        name: 'Ktema',
        color: 'var(--accent)',
        points: [
          { label: 'Axis in order', value: rate(boxes.rows[0]) },
          { label: 'Inner axis', value: rate(boxes.rows[1]) },
        ],
      },
      {
        name: 'SQLite',
        color: 'rgb(122, 121, 119)',
        points: [
          { label: 'Axis in order', value: rate(boxes.rows[2]) },
          { label: 'Inner axis', value: rate(boxes.rows[3]) },
        ],
      },
    ]}
  />
  <p>
    A rate is output and bytes are its cost, so the two charts answer different questions and neither is the verdict.
    What the rate shows is that the database's follows the shape and the engine's does not: the ordered shape is
    where a stored order pays, and an axis it does not carry is where it falls to a scan. What the bytes show is what
    that output costs, and the database pays it once because it keeps the page.
  </p>
  <p>
    A volume stops at 4 GiB, which at {ktema1m.bytes_per_record} bytes a record is {ceiling.records.toLocaleString('en-US')}{' '}
    records. An analysis dataset at the size a particle-physics ntuple reaches is about a hundred times that, so the
    unit here is the volume: a dataset that size is many volumes addressed together. This page measures one.
  </p>
</section>

<section class="bench__fit">
  <h2>What a read costs the medium</h2>
  <Chart
    title="Reads a question costs the medium"
    caption="The same record, read at 64 records and at 512. Neither count moves, which is the contract's claim: a point read asks the medium for the same four regions at any volume, and the listing reads no record. The bytes those regions cover follow the volume, which is the chart above."
    unit="reads"
    kind="bar"
    decimals={0}
    series={[
      {
        name: `${reads.rows[0].records} records`,
        color: 'var(--fg-3)',
        points: [
          { label: 'Framing', value: reads.rows[0].framing },
          { label: 'Fact', value: reads.rows[0].fact },
          { label: 'Listing', value: reads.rows[0].listing },
        ],
      },
      {
        name: `${reads.rows[1].records} records`,
        color: 'var(--accent)',
        points: [
          { label: 'Framing', value: reads.rows[1].framing },
          { label: 'Fact', value: reads.rows[1].fact },
          { label: 'Listing', value: reads.rows[1].listing },
        ],
      },
    ]}
  />
  <p>
    The engine counts the reads it asks the medium for, which is the unit its own read contract uses. The count stays
    at one framing read and three fact reads at any volume, and a prefix read does not read a record. The bytes behind
    those reads do grow, which is the line in the chart above: the count is fixed and what each read costs is not. The
    same record is read at {reads.rows[0].records} and at {reads.rows[1].records} records.
  </p>
  <table>
    <thead>
      <tr><th>Records</th><th>Framing read</th><th>Fact read</th><th>Listing</th></tr>
    </thead>
    <tbody>
      {reads.rows.map((row) => (
        <tr>
          <td>{row.records}</td>
          <td>{row.framing} read</td>
          <td>{row.fact} reads</td>
          <td>{row.listing} byte reads</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p>
    An eightfold volume changes neither count. The listing issues no byte read at all, which is the contract's "does not
    read a record"; the directory walk itself is not a call this counter sees, so the zero is a statement about records
    and not a claim that a listing is free. Nor is either count a statement about bytes: the same four reads cover 3.1 kB
    at a thousand records and 20 kB at a million.
  </p>
</section>

<p class="bench__source">
  {source.engine} and {source.peers} · {source.host} · {source.recorded} · median of {source.samples} samples ·
  SQLite {source.sqlite}. The append log here is a fixed-width frame per record plus an address map, which is what an
  integrator writes without a database. A single volume stops at 4 GiB because the format's offsets are 32 bits.
</p>
