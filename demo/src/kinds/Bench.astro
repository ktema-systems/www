---
// The measurement page: one chart per number the benchmark run records. The numbers are committed data, not measured
// on every build, so the page is a reading of a run rather than a benchmark of its own.
import Chart from '../components/Chart.astro';
import { volumes, source } from '../data/bench';

const label = (n: number) => (n >= 1000 ? `${n / 1000}k` : String(n));
const mib = (bytes: number) => bytes / (1024 * 1024);
const millis = (microseconds: number) => microseconds / 1000;
const answers = volumes.map((v) => v.query_answers.toLocaleString('en-US')).join(', ');
---

<p class="bench__lede">
  The engine measured on one host at 1,000, 10,000 and 100,000 records. Each volume is built once; every number is the
  median of {source.samples} samples. These are the format's own costs, not a comparison against a database; the note
  below says which workload each is the right tool for.
</p>

<div class="bench__grid">
  <Chart
    title="Bytes written per record"
    caption="The format's per-record write cost is flat across two orders of magnitude."
    unit="bytes"
    kind="bar"
    decimals={0}
    series={[
      { name: 'per record', points: volumes.map((v) => ({ label: label(v.records), value: v.write_medium_bytes })) },
    ]}
  />
  <Chart
    title="Volume size"
    caption="The log grows linearly with the records, as a log does."
    unit="MB"
    decimals={1}
    series={[
      { name: 'volume', points: volumes.map((v) => ({ label: label(v.records), value: mib(v.volume_bytes) })) },
    ]}
  />
  <Chart
    title="Open"
    caption="The engine over the log as it stands. The growth is hydration, not an index rebuild."
    unit="µs"
    decimals={1}
    series={[{ name: 'open', points: volumes.map((v) => ({ label: label(v.records), value: v.open_us })) }]}
  />
  <Chart
    title="Point read"
    caption="One framing read, which is what a replay pays per record."
    unit="µs"
    decimals={2}
    series={[
      {
        name: 'point read',
        points: volumes.map((v) => ({ label: label(v.records), value: v.point_read_us })),
      },
    ]}
  />
  <Chart
    title="Box query"
    caption={`A box over a tenth of an axis, answering ${answers} records. This is the scan path; the structural index is not enabled in this build.`}
    unit="ms"
    scale="log"
    decimals={2}
    series={[
      { name: 'query', points: volumes.map((v) => ({ label: label(v.records), value: millis(v.query_us) })) },
    ]}
  />
</div>

<section class="bench__fit">
  <h2>Where this engine fits</h2>
  <p>
    Ktema is a record engine for an append-only, addressable history, not a general-purpose database. The format's
    per-record write cost is flat, and the structural index is constant in record count. Mount and hydration are
    linear: opening a volume walks the log and the host build keeps the record maps it hydrates. The total memory is
    therefore not constant, and this page does not claim it is. What stays constant is the index, not the engine's
    whole working set.
  </p>
  <table>
    <thead>
      <tr><th></th><th>Ktema</th><th>A relational database</th></tr>
    </thead>
    <tbody>
      <tr>
        <td>Purpose</td>
        <td>An addressable history of what happened</td>
        <td>Rows a program queries and changes</td>
      </tr>
      <tr>
        <td>Write</td>
        <td>Flat per record: 482 to 484 bytes</td>
        <td>Row plus index maintenance</td>
      </tr>
      <tr>
        <td>Index</td>
        <td>Constant in record count, linear in distinct axis values</td>
        <td>Grows with rows</td>
      </tr>
      <tr>
        <td>Mount</td>
        <td>Linear in the log, because the record maps hydrate</td>
        <td>Fast, because the index is already on disk</td>
      </tr>
      <tr>
        <td>Host</td>
        <td>A service, or no OS at all on the device tier</td>
        <td>An OS and a filesystem</td>
      </tr>
      <tr>
        <td>Query</td>
        <td>Addressed reads and bounded boxes</td>
        <td>SQL, joins, ad-hoc predicates</td>
      </tr>
      <tr>
        <td>Right tool when</td>
        <td>The history is the product and the host is constrained</td>
        <td>The data is mutable and the questions are open</td>
      </tr>
    </tbody>
  </table>
</section>

<p class="bench__source">
  {source.command} · commit {source.commit} · {source.recorded} · median of {source.samples} samples. The host's seconds
  and the medium's bytes answer different questions; each chart carries one unit.
</p>
