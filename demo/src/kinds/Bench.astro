---
// The measurement page: one workload measured three ways. What is compared is the shape each
// engine gives the same record, because that is what a buyer chooses between.
//
// The charts are drawn from the data. The document under them is Markdown, and it carries no figure of its own: every
// number arrives from `data/bench.ts` through the values below, so a re-run cannot leave the prose quoting an old one.
import Chart from '../components/Chart.astro';
import Section from '../components/Section.astro';
import { engines, indexMemory, source, reads, boxes, runs, values, type Row } from '../data/bench';
import type { Artifact } from '../data/artifacts';

interface Props {
  artifact: Artifact;
}

const { artifact } = Astro.props;

const label = (n: number) => (n >= 1_000_000 ? `${n / 1_000_000}M` : n >= 1000 ? `${n / 1000}k` : String(n));
const mib = (bytes: number) => bytes / (1024 * 1024);
const kb = (bytes: number) => bytes / 1024;
const size = (bytes: number) =>
  bytes >= 1024 ** 3
    ? `${(bytes / 1024 ** 3).toFixed(1)} GB`
    : bytes >= 1024 ** 2
      ? `${(bytes / 1024 ** 2).toFixed(1)} MB`
      : `${(bytes / 1024).toFixed(0)} kB`;
const span = (us: number) => (us >= 1000 ? `${(us / 1000).toFixed(1)} ms` : `${us.toFixed(0)} µs`);
const opening = (us: number) => (us < 1000 ? `${us.toFixed(2)} µs` : `${(us / 1000).toFixed(2)} ms`);
const rate = (row: (typeof boxes.rows)[number]) => Math.round(row.answers / (row.us / 1_000_000));
const kilo = (value: number) =>
  value >= 1_000_000 ? `${(value / 1_000_000).toFixed(1)} million` : `${Math.round(value / 1000)} thousand`;

const seriesOf = (pick: (row: Row) => number) =>
  engines.map((engine) => ({
    name: engine.name,
    color: engine.color,
    points: engine.rows.map((row) => ({ label: label(row.records), value: pick(row) })),
  }));

const at = (id: string, records: number) =>
  engines.find((engine) => engine.id === id)!.rows.find((row) => row.records === records)!;

const ktema100k = at('ktema', 100_000);
const log100k = at('log', 100_000);
const sqlite100k = at('sqlite', 100_000);
const ktema1k = at('ktema', 1_000);
const sqlite1k = at('sqlite', 1_000);
const ktema1m = at('ktema', 1_000_000);
const log1m = at('log', 1_000_000);
const sqlite1m = at('sqlite', 1_000_000);
const ktemaRows = engines[0]!.rows;
const sqliteRows = engines[2]!.rows;
const logMap1m = indexMemory.log[indexMemory.log.length - 1]!.bytes;
const sqliteCache = indexMemory.sqlite[indexMemory.sqlite.length - 1]!.bytes;

// The bytes a point read asked the medium for, at the two rungs the prose compares. The measure is the run's own, so a
// re-run cannot leave the sentence quoting a number the chart no longer draws.
const asked = (row: Row) => `${kb(row.point_read_bytes ?? 0).toFixed(1)} kB`;
const askedRange = (row: Row) => size(row.range_bytes ?? 0);

// Where a run's own figures stand in Corpus Space. The app draws the records a project holds, so a link is the app's
// figures reading at the project that holds the measurements, and the record it opens is the run's own key.
const appUrl = (import.meta.env.PUBLIC_CENTER_URL ?? 'https://corpus.ktema.systems/').replace(/\/?$/, '/');
const figuresOf = (subject: string) =>
  new URL(`figures?project=corpus-bench&pick=${encodeURIComponent(subject)}`, appUrl).href;
---

<p class="bench__lede">
  One record, three stores, one machine. The record is three 60-byte addresses, an origin, a media type and a payload of
  about 55 bytes, so the differences below are the formats.
</p>

<div class="bench__grid">
  <Chart
    title="Memory to answer by address"
    wide={true}
    caption={`The index each engine must hold. The bare log builds a map entry per record, ${mib(indexMemory.log_at_five_million).toFixed(0)} MB at five million. The engine's optional structural index is a fixed array of about ${kb(indexMemory.engine_bytes).toFixed(0)} kB, not built in this run. A database keeps its index in a file, so its memory is the page cache that file is read through, about ${mib(sqliteCache).toFixed(0)} MB.`}
    unit="MB"
    scale="log"
    decimals={2}
    series={[
      {
        name: 'Ktema, optional index',
        color: 'var(--accent)',
        points: indexMemory.log.map((point) => ({
          label: label(point.records),
          value: kb(indexMemory.engine_bytes) / 1024,
        })),
      },
      {
        name: 'Append log',
        color: 'var(--fg-2)',
        points: indexMemory.log.map((point) => ({ label: label(point.records), value: mib(point.bytes) })),
      },
      {
        name: 'SQLite',
        color: 'rgb(122, 121, 119)',
        points: indexMemory.sqlite.map((point) => ({ label: label(point.records), value: mib(point.bytes) })),
      },
    ]}
  />
  <Chart
    title="Open"
    caption="Making the volume answerable. The log rebuilds its address map here; the engine reads the trailer a stop wrote."
    unit="µs"
    scale="log"
    decimals={1}
    series={seriesOf((row) => row.open_us)}
  />
  <Chart
    title="One record by address"
    caption={`One record by its own address. The log keeps the whole address map in memory, so its lookup is constant. The engine holds no map, so it probes the segments, and that read grows from ${asked(ktema1k)} at a thousand records to ${asked(ktema1m)} at a million.`}
    unit="µs"
    scale="log"
    decimals={2}
    series={seriesOf((row) => row.point_read_us)}
  />
  <Chart
    title="A tenth of the records by address"
    caption="A contiguous tenth of the addresses, enumerated rather than counted: about 100 records at a thousand and about 100,000 at a million. The engine's path carries no index, so it walks the log."
    unit="µs"
    scale="log"
    decimals={0}
    series={seriesOf((row) => row.range_us)}
  />
  <Chart
    title="Bytes read from the medium to answer"
    caption={`The bytes each store asked the medium for. The engine counts its reads; the database counts the pages its pager fetched at 4 kB, on a connection opened for the read. A point read is ${asked(ktema1k)} for the engine and ${asked(sqlite1k)} for the database at a thousand records, ${asked(ktema1m)} and ${asked(sqlite1m)} at a million; a tenth of the range is ${askedRange(ktema1m)} against ${askedRange(sqlite1m)}. The append log maps its file and issues no read call.`}
    unit="MB"
    scale="log"
    decimals={2}
    series={[
      {
        name: 'Ktema, point read',
        color: 'var(--accent)',
        points: ktemaRows.map((row) => ({ label: label(row.records), value: mib(row.point_read_bytes ?? 0) })),
      },
      {
        name: 'Ktema, a tenth',
        color: 'var(--fg-2)',
        points: ktemaRows.map((row) => ({ label: label(row.records), value: mib(row.range_bytes ?? 0) })),
      },
      {
        name: 'SQLite, point read',
        color: 'rgb(122, 121, 119)',
        points: sqliteRows.map((row) => ({ label: label(row.records), value: mib(row.point_read_bytes ?? 0) })),
      },
      {
        name: 'SQLite, a tenth',
        color: 'var(--fg-3)',
        points: sqliteRows.map((row) => ({ label: label(row.records), value: mib(row.range_bytes ?? 0) })),
      },
    ]}
  />
</div>

<section class="bench__fit">
  <Section source={artifact.body ?? ''} name="What the three are" values={values} />
  <Section source={artifact.body ?? ''} name="Reading the times" values={values} />
  <Section source={artifact.body ?? ''} name="The path this page does not measure" values={values} />
</section>

<section class="bench__fit">
  <Section source={artifact.body ?? ''} name="A box on any axis" values={values} />
  <table>
    <thead>
      <tr><th>Shape</th><th>Answers</th><th>Time</th><th>Bytes read</th><th>Index</th></tr>
    </thead>
    <tbody>
      {boxes.rows.map((row) => (
        <tr>
          <td>{row.store}</td>
          <td>{row.answers.toLocaleString('en-US')}</td>
          <td>{span(row.us)}</td>
          <td>{size(row.bytes)}</td>
          <td>{row.index_bytes === 0 ? 'none' : size(row.index_bytes)}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <Chart
    title="What the rate costs to hold"
    caption={`Answers a second across, bytes of index held up. The engine sits on the floor at either axis: ${kilo(rate(boxes.rows[0]))} and ${kilo(rate(boxes.rows[1]))} answers a second at zero state. The database answers the ordered shape at ${kilo(rate(boxes.rows[2]))} from the table it already stores; the shape that table does not carry costs ${size(boxes.rows[3].bytes)} of reads and ${span(boxes.rows[3].us)} as a scan, or ${size(boxes.rows[4].index_bytes)} of index to answer in ${span(boxes.rows[4].us)}.`}
    unit="answers/s across, MB held up"
    kind="scatter"
    scale="linear"
    decimals={0}
    series={[
      {
        name: 'Ktema',
        color: 'var(--accent)',
        points: [
          { label: 'Ktema, either axis', x: rate(boxes.rows[0]), value: 0, align: 'end', dx: 10, dy: -10 },
          { label: '', x: rate(boxes.rows[1]), value: 0 },
        ],
      },
      {
        name: 'SQLite',
        color: 'rgb(122, 121, 119)',
        points: [
          { label: 'SQLite, key order', x: rate(boxes.rows[2]), value: 0, align: 'end', dx: 10, dy: -10 },
          { label: 'SQLite, a scan', x: rate(boxes.rows[3]), value: 0, dy: -10 },
          {
            label: 'SQLite, an index',
            x: rate(boxes.rows[4]),
            value: boxes.rows[4].index_bytes / 1024 ** 2,
            dy: -10,
          },
        ],
      },
    ]}
  />
  <Section source={artifact.body ?? ''} name="What a box costs to hold" values={values} />
</section>

<section class="bench__fit">
  <Section source={artifact.body ?? ''} name="What a read costs the medium" values={values} />
  <Chart
    title="Reads a question costs the medium"
    caption={`One record read at ${reads.rows[0].records.toLocaleString('en-US')} records and at ${reads.rows[1].records.toLocaleString('en-US')}. Neither count moves: a point read asks the medium for the same four regions at any volume, and the listing reads no record. The bytes behind them follow the volume.`}
    unit="reads"
    kind="bar"
    decimals={0}
    series={[
      {
        name: `${reads.rows[0].records} records`,
        color: 'var(--fg-3)',
        points: [
          { label: 'Framing', value: reads.rows[0].framing },
          { label: 'Fact', value: reads.rows[0].fact },
          { label: 'Listing', value: reads.rows[0].listing },
        ],
      },
      {
        name: `${reads.rows[1].records} records`,
        color: 'var(--accent)',
        points: [
          { label: 'Framing', value: reads.rows[1].framing },
          { label: 'Fact', value: reads.rows[1].fact },
          { label: 'Listing', value: reads.rows[1].listing },
        ],
      },
    ]}
  />
  <table>
    <thead>
      <tr><th>Records</th><th>Framing read</th><th>Fact read</th><th>Listing</th></tr>
    </thead>
    <tbody>
      {reads.rows.map((row) => (
        <tr>
          <td>{row.records}</td>
          <td>{row.framing} read</td>
          <td>{row.fact} reads</td>
          <td>{row.listing} byte reads</td>
        </tr>
      ))}
    </tbody>
  </table>
  <Section source={artifact.body ?? ''} name="The read contract" values={values} />
</section>

<section class="bench__fit">
  <h2>The runs behind the numbers</h2>
  <p>
    Every figure above is one of three records. Each opens the run's own numbers in Corpus Space, drawn from the same
    fields and the same rungs.
  </p>
  <table>
    <thead>
      <tr><th>Run</th><th>Revision</th><th>Fills</th><th></th></tr>
    </thead>
    <tbody>
      {
        runs.map((run) => (
          <tr>
            <td>{run.heading}</td>
            <td>{run.revision}</td>
            <td>{run.created.slice(0, 10)}</td>
            <td>
              <a class="bench__figures-link" href={figuresOf(run.subject)} target="_blank" rel="noreferrer">
                The figures
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<p class="bench__source">
  {source.engine} · {source.peers} · {source.host} · {source.recorded} · median of {source.samples} samples ·
  SQLite {source.sqlite}. The append log is a fixed-width frame per record plus an address map, which is what an
  integrator writes without a database. The engine's rows are the corpus record <code>{source.key}</code>.
</p>
