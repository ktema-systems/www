---
// The recorded proofs. Each is a terminal run kept where it can be replayed, so the page lays them out as one gallery:
// a still of the run, what it proves, and the way to play it. The tile is the center's own, which is what lets a
// recording stand beside an application without a second visual language.
import type { Artifact } from '../data/artifacts';

interface Props {
  artifact: Artifact;
}

const { artifact } = Astro.props;
const proofs = artifact.recordings ?? [];
---

<p class="terminal__lede">{artifact.summary}</p>

<ul class="proofs">
  {
    proofs.map((proof) => (
      <li>
        <a class="tile tile--opens tile--proof" href={proof.href} style={`--wash: url('${proof.poster}')`}>
          <span class="tile__wash" aria-hidden="true" />
          <span class="tile__screen">
            <img src={proof.poster} alt={proof.posterAlt} loading="lazy" decoding="async" />
          </span>
          <span class="tile__body">
            <span class="tile__title">{proof.label}</span>
            <span class="tile__summary">{proof.detail}</span>
            <span class="tile__cta">
              Play the recording <span class="tile__arrow" aria-hidden="true">
                &#8594;
              </span>
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
