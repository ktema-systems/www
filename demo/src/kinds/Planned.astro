---
// A demonstration that is specified and not yet recorded.
//
// The page is the brief, and the brief is the document: purpose, procedure, preconditions, deliverable, and the check
// that produces the evidence. The claim sits in the page header, where it sits on a recorded demonstration too, so the
// two kinds of page are read and compared on the same terms.
import type { Surface } from '../data/surfaces';
import Markdown from '../components/Markdown.astro';

interface Props {
  surface: Surface;
}

const { surface } = Astro.props;
---

<article class="brief">
  <Markdown source={surface.body} />
</article>

<style>
  .brief {
    max-width: 74ch;
  }

  /* The document's own headings are the brief's sections, so the rules that separate them are applied to what the
     Markdown renderer hands back. */
  .brief :global(h2) {
    margin: 36px 0 14px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .brief :global(h2:first-child) {
    margin-top: 8px;
    padding-top: 0;
    border-top: none;
  }

  .brief :global(p) {
    margin: 0;
    color: var(--fg-2);
    font-size: 16.5px;
    line-height: 1.65;
  }

  .brief :global(ol),
  .brief :global(ul) {
    margin: 0;
    padding-left: 22px;
    color: var(--fg-2);
    font-size: 16.5px;
    line-height: 1.65;
  }

  .brief :global(li + li) {
    margin-top: 8px;
  }
</style>
