---
// A measurement drawn as a chart. One unit per chart, axes and gridlines in the page's hairlines, and no decoration
// that does not carry a number: a benchmark figure is read, not admired.
interface Datum {
  label: string;
  value: number;
}
interface Series {
  name: string;
  points: Datum[];
  color?: string;
}
interface Props {
  title: string;
  caption?: string;
  unit: string;
  kind?: 'line' | 'bar';
  scale?: 'linear' | 'log';
  decimals?: number;
  series: Series[];
  height?: number;
}

const {
  title,
  caption,
  unit,
  kind = 'line',
  scale = 'linear',
  decimals = 1,
  series,
  height = 240,
} = Astro.props;

const W = 720;
const H = height;
const m = { top: 22, right: 18, bottom: 40, left: 78 };
const plotW = W - m.left - m.right;
const plotH = H - m.top - m.bottom;

const values = series.flatMap((s) => s.points.map((p) => p.value));
const max = Math.max(...values);
const minPositive = Math.min(...values.filter((v) => v > 0));

function niceMax(v: number) {
  const exp = Math.floor(Math.log10(v));
  const base = 10 ** exp;
  const n = v / base;
  const step = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
  return step * base;
}

const yMax = scale === 'log' ? 10 ** Math.ceil(Math.log10(max)) : niceMax(max);
const yMin = scale === 'log' ? 10 ** Math.floor(Math.log10(minPositive)) : 0;

function yAt(v: number) {
  if (v <= 0) return m.top + plotH;
  if (scale === 'log') {
    const lo = Math.log10(yMin);
    const hi = Math.log10(yMax);
    return m.top + plotH - ((Math.log10(v) - lo) / (hi - lo)) * plotH;
  }
  return m.top + plotH - (v / yMax) * plotH;
}

const ticks =
  scale === 'log'
    ? Array.from({ length: Math.round(Math.log10(yMax) - Math.log10(yMin)) + 1 }, (_, i) => yMin * 10 ** i)
    : Array.from({ length: 5 }, (_, i) => (yMax * i) / 4);

function fmtTick(v: number) {
  if (scale === 'log') {
    return v >= 1 ? String(Math.round(v)) : v.toFixed(2).replace(/0+$/, '').replace(/\.$/, '');
  }
  const abs = Math.abs(v);
  if (abs >= 1000) return v.toLocaleString('en-US', { maximumFractionDigits: 0 });
  if (abs >= 10) return v.toFixed(0);
  return v.toFixed(decimals);
}

const count = series[0]?.points.length ?? 1;
const slot = plotW / count;
const xAt = (i: number) => m.left + slot * (i + 0.5);

const colors = ['var(--accent)', 'var(--fg-2)', 'var(--accent-2)'];
const colorOf = (s: Series, i: number) => s.color ?? colors[i % colors.length];
---

<figure class="chart">
  <figcaption class="chart__head">
    <span class="chart__title">{title}</span>
    {caption && <span class="chart__caption">{caption}</span>}
    {
      series.length > 1 && (
        <ul class="chart__legend">
          {series.map((s, i) => (
            <li class="chart__legend-item">
              <span class="chart__swatch" style={`background:${colorOf(s, i)}`} />
              {s.name}
            </li>
          ))}
        </ul>
      )
    }
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title}. ${caption ?? ''}`}>
    <text class="chart__unit" x={m.left} y={12}>{unit}</text>

    {
      ticks.map((tick) => (
        <>
          <line class="chart__grid" x1={m.left} x2={W - m.right} y1={yAt(tick)} y2={yAt(tick)} />
          <text
            class="chart__tick"
            x={m.left - 10}
            y={yAt(tick)}
            text-anchor="end"
            dominant-baseline="middle"
          >
            {fmtTick(tick)}
          </text>
        </>
      ))
    }

    {series[0]?.points.map((point, i) => (
      <text class="chart__x" x={xAt(i)} y={m.top + plotH + 20} text-anchor="middle">
        {point.label}
      </text>
    ))}

    <line class="chart__axis" x1={m.left} x2={m.left} y1={m.top} y2={m.top + plotH} />
    <line class="chart__axis" x1={m.left} x2={W - m.right} y1={m.top + plotH} y2={m.top + plotH} />

    {
      kind === 'bar' &&
        series.map((s, si) =>
          s.points.map((point, i) => {
            const group = slot * 0.62;
            const bar = group / series.length;
            const x = xAt(i) - group / 2 + si * bar;
            return (
              <rect
                class="chart__bar"
                x={x}
                y={yAt(point.value)}
                width={Math.max(2, bar - 3)}
                height={m.top + plotH - yAt(point.value)}
                fill={colorOf(s, si)}
              />
            );
          })
        )
    }

    {
      kind === 'line' &&
        series.map((s, si) => (
          <>
            <polyline
              class="chart__line"
              points={s.points.map((point, i) => `${xAt(i)},${yAt(point.value)}`).join(' ')}
              stroke={colorOf(s, si)}
            />
            {s.points.map((point, i) => (
              <circle
                class="chart__dot"
                cx={xAt(i)}
                cy={yAt(point.value)}
                r="3"
                fill={colorOf(s, si)}
              />
            ))}
          </>
        ))
    }
  </svg>
</figure>
