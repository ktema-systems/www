---
// One entry of the center read as a row: the same tile, laid on its side for a list.
//
// The thumbnail is the same still a tile carries, or the same bay when there is none, so the two views describe an
// entry the same way and cannot disagree about it. What the entry is rides on the thumbnail in both, because that is
// where the grid and the list both look first.
import { platformOf, type Platform } from '../data/taxonomy';
import { CATEGORY_TAGS, type Category } from '../data/kinds';

interface Props {
  href: string;
  title: string;
  /** What the page is, which is the first tag a reader reads. */
  category?: Category;
  products?: string[];
  platforms?: Platform[];
  summary: string;
  poster?: string;
  posterAlt?: string;
}

const { href, title, category, products = [], platforms = [], summary, poster, posterAlt } = Astro.props;
---

<li class="row" data-category={category}>
  <a class="row__link" href={href}>
    <span class="row__thumb">
      {
        poster ? (
          <img src={poster} alt={posterAlt ?? ''} loading="lazy" decoding="async" />
        ) : (
          <span class="row__bay" aria-hidden="true" />
        )
      }
      {
        category && (
          <span class:list={['tile__kind', `tile__kind--${category}`]} title={CATEGORY_TAGS[category].title}>
            {CATEGORY_TAGS[category].label}
          </span>
        )
      }
    </span>
    <span class="row__body">
      <span class="row__head">
        <span class="row__title">{title}</span>
        <span class="tags">
          {platforms.map((name) => <span class="platform-tag">{platformOf(name).label}</span>)}
          {products.map((name) => <span class="product-tag">{name}</span>)}
        </span>
      </span>
      <span class="row__summary">{summary}</span>
    </span>
  </a>
</li>
