---
// The Corpus Center: every record the corpus holds, by key.
//
// A row here is the record's own claim and its key, exported from ktema's volume by
// `corpus/assembly/export.sh`. The page states no number of its own, so it cannot say something the corpus
// does not carry, and every row is traceable to the run behind it.
import corpus from '../data/corpus.json';
import Shell from '../layouts/Shell.astro';

interface Record {
  key: string;
  activity: string;
  subject: string;
  platform: string;
  revision: string;
  created: string;
  class: string;
  claim: string;
  object?: { path: string };
}

const records = [...(corpus.records as Record[])].reverse();

// The order a reader cares about: what was shown, then what was measured, then what waits.
const order = ['demo', 'bench', 'trial', 'verify'];
const present = order.filter((activity) => records.some((one) => one.activity === activity));
const rest = [...new Set(records.map((one) => one.activity))].filter((one) => !present.includes(one));
const groups = [...present, ...rest].map((activity) => ({
  activity,
  rows: records.filter((one) => one.activity === activity),
}));
---

<Shell
  title="Corpus"
  description="Every record the corpus holds: what a run established, at which revision, on which surface."
  crumbs={[{ label: 'Demo Center', href: '/' }, { label: 'Corpus' }]}
>
  <section class="hero">
    <h1>Corpus</h1>
    <p class="lede">
      What a run established, at the revision it ran on, on the surface it ran over. A row is a record: its
      sentence comes from the producer, and its key is where the bytes live. Nothing on this page is typed by
      hand, and a record that is missing is work that has not run.
    </p>
  </section>

  {
    groups.map((group) => (
      <section class="bench__fit">
        <h2>{group.activity}</h2>
        <table>
          <thead>
            <tr>
              <th>subject</th>
              <th>platform</th>
              <th>revision</th>
              <th>created</th>
              <th>class</th>
              <th>claim</th>
            </tr>
          </thead>
          <tbody>
            {group.rows.map((row) => (
              <tr>
                <td><code>{row.subject}</code></td>
                <td>{row.platform}</td>
                <td><code>{row.revision}</code></td>
                <td>{row.created.slice(0, 10)}</td>
                <td>{row.class}</td>
                <td>{row.claim}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="bench__source">
          Keys: {group.rows.map((row) => <code>{row.key}</code>)}.
        </p>
      </section>
    ))
  }
</Shell>
