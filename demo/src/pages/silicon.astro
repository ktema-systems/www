---
// The decoder as a finished layout, for a reader who has not seen a GDS before.
//
// The pictures are the flow's final GDS rather than an illustration: the renderer keeps the metal layers
// and leaves the device layers out. The page states what the layout is, what it was checked against, and
// where the source lives.
import Shell from '../layouts/Shell.astro';

const contact = 'mailto:demo@ktema.systems';
const source = 'https://github.com/ssccsorg/syntagma/blob/main/hw/visuals/render_gds.py';

// The six metal layers, bottom to top, each drawn from the same window of the same GDS.
const stackLayers = [
  { file: 'layer-67', name: 'li1' },
  { file: 'layer-68', name: 'met1' },
  { file: 'layer-69', name: 'met2' },
  { file: 'layer-70', name: 'met3' },
  { file: 'layer-71', name: 'met4' },
  { file: 'layer-72', name: 'met5' },
];
---

<Shell
  title="On silicon"
  description="The decoder the engine's coordinate model describes, carried to a finished SkyWater 130 nm layout."
  crumbs={[{ label: 'Corpus Hub', href: '/' }, { label: 'On silicon' }]}
>
  <section class="hero">
    <h1>The same decoder, in gates.</h1>
    <p class="lede">
      A 16-bit code point enters, three axis labels leave, in one registered stage. The same decode the engine runs in
      software exists here as a finished SkyWater 130 nm layout: standard cells placed and routed by the OpenROAD flow,
      drawn from the metal layers of its final GDS.
    </p>
  </section>

  <figure class="run__figure figure--lead">
    <img
      src="/proofs/silicon.png"
      width="2317"
      height="2400"
      alt="The full die of the decoder layout: a grid of magenta and white power straps over dense teal and gold routing."
      decoding="async"
    />
    <figcaption>
      The die at its full frame: <code>li1</code> and <code>met1</code> through <code>met5</code>. The wide straps carry
      power; the dense field between them is the logic and its wiring.
    </figcaption>
  </figure>

  <section class="section">
    <h2>What it is</h2>
    <dl class="facts">
      <dt>The unit</dt>
      <dd>
        A 16-bit code point enters and three axis labels leave, in one registered stage. The decode is combinational and
        the outputs are registered on the clock, so the latency is a number a design can plan around.
      </dd>
      <dt>The target</dt>
      <dd>
        SkyWater 130 nm high-density standard cells, placed and routed by the OpenROAD flow, with the clock constrained
        to 12 MHz.
      </dd>
      <dt>The check</dt>
      <dd>
        The RTL is verified against the software reference over every code point, the gate netlist is simulated against
        the same anchors, and the RTL and the gate netlist are proven equivalent.
      </dd>
    </dl>
  </section>

  <figure class="run__figure">
    <img
      src="/proofs/silicon-detail.png"
      width="1800"
      height="1800"
      alt="A close view of the die centre: standard cell rows crossed by teal signal wiring, gold longer routes, and magenta and white power straps."
      loading="lazy"
      decoding="async"
    />
    <figcaption>
      The centre of the die, close. <code>met1</code> and <code>met2</code> carry the local wiring, <code>met3</code>
      the longer runs, and <code>met4</code> and <code>met5</code> the power.
    </figcaption>
  </figure>

  <figure class="run__figure">
    <img
      src="/proofs/silicon-routing.png"
      width="2317"
      height="2400"
      alt="The same window with the power straps removed, leaving only signal routing in blue, teal and gold."
      loading="lazy"
      decoding="async"
    />
    <figcaption>
      The same window with the power straps withheld, so the signal routing stands on its own: the local wires, the
      longer runs, and the cells underneath them.
    </figcaption>
  </figure>

  <section class="section">
    <h2>In three dimensions</h2>
    <p class="section__lede">
      The six metal layers separated and stacked, <code>li1</code> at the bottom and <code>met5</code> at the top. Each
      plate is the same window of the same GDS. The spacing between them is even so the stack can be read, and is not
      to scale.
    </p>
    <div class="stack3d" data-stack3d>
      <div class="stack3d__stage" data-stack-stage>
        {
          stackLayers.map((layer, index) => (
            <img
              src={`/proofs/stack/${layer.file}.png`}
              alt=""
              width="1000"
              height="1000"
              loading="lazy"
              decoding="async"
              style={`--i:${index}`}
            />
          ))
        }
      </div>
    </div>
    <p class="note">Drag to turn the stack. <span class="stack3d__key">Bottom to top: {stackLayers.map((l) => l.name).join(', ')}.</span></p>
  </section>

  <section class="section">
    <h2>Where it comes from</h2>
    <p class="section__lede">
      The RTL, the flow configuration, and the renderer live in the hardware tree of the syntagma repository. The images
      are drawn from the flow's final GDS: the metal layers only, cropped to the placed cells, so they follow the design
      as the flow redraws it. The <a href={source}>renderer</a> carries no knowledge of the design.
    </p>
    <p class="call">
      <a class="btn" href="/trial/">The build to evaluate</a>
      <a class="btn" href="/claims/">What the stack establishes</a>
    </p>
    <p class="note">
      This is a test chip, not a product die. For a part built to your own workload, <a href={contact}>write to us</a>.
    </p>
  </section>
</Shell>

<style>
  .figure--lead {
    margin-block-start: 2.5rem;
  }

  .section {
    margin-block: 3rem;
  }

  .section h2 {
    margin-block-end: 1rem;
  }

  .section__lede {
    color: var(--fg-3);
    max-inline-size: 68ch;
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(9rem, max-content) 1fr;
    gap: 0.6rem 1.5rem;
    margin: 1.25rem 0 0;
    max-inline-size: 74ch;
  }

  .facts dt {
    color: var(--fg);
    font-size: 0.95em;
  }

  .facts dd {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.92em;
  }

  .call {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0.75rem;
  }

  .note {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.88em;
    max-inline-size: 68ch;
  }

  /* The stack is turned as one object: the six plates keep their own depth and the stage rotates around a
     shared centre, so a drag moves the whole stack rather than one plate against another. */
  .stack3d {
    display: grid;
    place-items: center;
    margin-block-start: 2rem;
    padding-block: 2%;
    perspective: 1600px;
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    /* A turned plate projects wider than the box it is drawn in, so the container clips the overflow rather than
       letting the page scroll sideways. */
    overflow: clip;
  }

  .stack3d:active {
    cursor: grabbing;
  }

  .stack3d__stage {
    position: relative;
    width: min(100%, 620px);
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 62deg)) rotateZ(var(--rz, -32deg));
  }

  .stack3d__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: translateZ(calc(var(--i) * 30px));
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.45));
    pointer-events: none;
  }

  .stack3d__key {
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .stack3d__stage {
      width: 78%;
    }
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .facts dd {
      margin-block-end: 0.75rem;
    }
  }
</style>

<script>
  // The stack turns on its own until a reader takes it, and a drag then sets the two angles directly. The stage keeps
  // the transform in custom properties so the plates' own depth stays in the sheet.
  const stack = document.querySelector<HTMLElement>('[data-stack3d]');
  const stage = stack?.querySelector<HTMLElement>('[data-stack-stage]');
  if (stack && stage) {
    let rx = 62;
    let rz = -32;
    let spin = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let frame = 0;

    const draw = () => {
      stage.style.setProperty('--rx', `${rx}deg`);
      stage.style.setProperty('--rz', `${rz}deg`);
    };

    const tick = () => {
      if (!spin) return;
      rz = (rz + 0.18) % 360;
      draw();
      frame = requestAnimationFrame(tick);
    };

    stack.addEventListener('pointerdown', (event) => {
      spin = false;
      cancelAnimationFrame(frame);
      stack.setPointerCapture(event.pointerId);
      let x = event.clientX;
      let y = event.clientY;
      const move = (next: PointerEvent) => {
        rz += (next.clientX - x) * 0.45;
        rx = Math.min(86, Math.max(16, rx - (next.clientY - y) * 0.35));
        x = next.clientX;
        y = next.clientY;
        draw();
      };
      const up = (next: PointerEvent) => {
        stack.releasePointerCapture(next.pointerId);
        stack.removeEventListener('pointermove', move);
        stack.removeEventListener('pointerup', up);
        stack.removeEventListener('pointercancel', up);
      };
      stack.addEventListener('pointermove', move);
      stack.addEventListener('pointerup', up);
      stack.addEventListener('pointercancel', up);
    });

    draw();
    if (spin) frame = requestAnimationFrame(tick);
  }
</script>
