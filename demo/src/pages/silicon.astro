---
// The decoder as a finished layout.
//
// The 3D stack carries the page; the stills sit under it as the same window at three levels of detail.
import Shell from '../layouts/Shell.astro';

const contact = 'mailto:demo@ktema.systems';
const source = 'https://github.com/ssccsorg/syntagma/blob/main/hw/visuals/render_gds.py';

// The six metal layers, bottom to top, each drawn from the same window of the same GDS.
const stackLayers = [
  { file: 'layer-67', name: 'li1' },
  { file: 'layer-68', name: 'met1' },
  { file: 'layer-69', name: 'met2' },
  { file: 'layer-70', name: 'met3' },
  { file: 'layer-71', name: 'met4' },
  { file: 'layer-72', name: 'met5' },
];

// The stills in the order they read: the whole die, its centre, and the same window without the power.
const stills = [
  {
    src: '/proofs/silicon.png',
    width: 2317,
    height: 2400,
    alt: 'The full die: magenta and white power straps over dense teal and gold routing.',
    caption: 'The die at its full frame, li1 through met5.',
  },
  {
    src: '/proofs/silicon-detail.png',
    width: 1800,
    height: 1800,
    alt: 'A close view of the die centre: standard cell rows crossed by teal wiring, gold longer routes, and magenta and white power straps.',
    caption: 'The centre, close: met1 and met2 on the local wiring, met3 on the longer runs.',
  },
  {
    src: '/proofs/silicon-routing.png',
    width: 2317,
    height: 2400,
    alt: 'The same window without the power straps, leaving only signal routing in blue, teal and gold.',
    caption: 'The same window without the power straps, so the signal routing stands alone.',
  },
];
---

<Shell
  title="On silicon"
  description="The decoder the engine's coordinate model describes, carried to a finished SkyWater 130 nm layout."
  crumbs={[{ label: 'Corpus Hub', href: '/' }, { label: 'On silicon' }]}
>
  <section class="hero">
    <div class="hero__copy">
      <h1>The same decoder, in gates.</h1>
      <p class="lede">
        A 16-bit code point enters, three axis labels leave, in one registered stage. The same decode the engine runs in
        software, built as a finished SkyWater 130 nm layout: standard cells placed and routed by the OpenROAD flow.
      </p>
    </div>
    <div class="hero__stack">
      <div class="stack3d" data-stack3d>
        <div class="stack3d__stage" data-stack-stage>
          {
            stackLayers.map((layer, index) => (
              <img
                src={`/proofs/stack/${layer.file}.png`}
                alt=""
                width="1000"
                height="1000"
                decoding="async"
                style={`--i:${index - (stackLayers.length - 1) / 2}`}
              />
            ))
          }
        </div>
      </div>
      <p class="stack3d__key">li1 at the bottom, met5 at the top. Drag to turn.</p>
    </div>
  </section>

  <section class="section">
    <h2>What it is</h2>
    <dl class="facts">
      <dt>The unit</dt>
      <dd>
        A 16-bit code point enters and three axis labels leave, in one registered stage. The decode is combinational and
        the outputs are registered on the clock, so the latency is a number a design can plan around.
      </dd>
      <dt>The target</dt>
      <dd>
        SkyWater 130 nm high-density standard cells, placed and routed by the OpenROAD flow, with the clock constrained
        to 12 MHz.
      </dd>
      <dt>The check</dt>
      <dd>
        The RTL is verified against the software reference over every code point, the gate netlist is simulated against
        the same anchors, and the RTL and the gate netlist are proven equivalent.
      </dd>
    </dl>
  </section>

  <ul class="gallery">
    {
      stills.map((still) => (
        <li>
          <figure>
            <img src={still.src} width={still.width} height={still.height} alt={still.alt} loading="lazy" decoding="async" />
            <figcaption>{still.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  <section class="section">
    <h2>Where it comes from</h2>
    <p class="section__lede">
      The RTL, the flow configuration, and the renderer live in the hardware tree of the syntagma repository. The images
      are drawn from the flow's final GDS: the metal layers only, cropped to the placed cells. The{' '}
      <a href={source}>renderer</a> is the only step between the two.
    </p>
    <p class="call">
      <a class="btn" href="/trial/">The build to evaluate</a>
      <a class="btn" href="/claims/">What the stack establishes</a>
    </p>
    <p class="note">
      This is a test chip, not a product die. For a part built to your own workload, <a href={contact}>write to us</a>.
    </p>
  </section>
</Shell>

<style>
  /* The stack is the page's picture, so the hero is two columns on a wide screen and one column below the point
     where a turned plate stops reading. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    max-width: none;
  }

  .hero__copy {
    min-width: 0;
  }

  .hero__stack {
    min-width: 0;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }

  /* The stack is turned as one object: the six plates keep their own depth and the stage rotates around a
     shared centre, so a drag moves the whole stack rather than one plate against another. */
  .stack3d {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    perspective: 1800px;
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    /* A turned plate projects wider than the box it is drawn in, so the container clips the overflow rather than
       letting the page scroll sideways. Perspective magnifies the near edge, which reaches a few pixels below the box. */
    overflow: clip;
    padding-block-end: 2%;
  }

  .stack3d:active {
    cursor: grabbing;
  }

  .stack3d__stage {
    position: relative;
    /* A plate projects about 1.29 times its width at this tilt, so it is drawn at a bit over two thirds of the box to
       keep every corner inside it. */
    width: 71%;
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 62deg)) rotateZ(var(--rz, -32deg));
  }

  .stack3d__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: translateZ(calc(var(--i) * 30px));
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.45));
    pointer-events: none;
  }

  .stack3d__key {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.82em;
  }

  .section {
    margin-block: 3rem;
  }

  .section h2 {
    margin-block-end: 1rem;
  }

  .section__lede {
    color: var(--fg-3);
    max-inline-size: 68ch;
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(9rem, max-content) 1fr;
    gap: 0.6rem 1.5rem;
    margin: 1.25rem 0 0;
    max-inline-size: 74ch;
  }

  .facts dt {
    color: var(--fg);
    font-size: 0.95em;
  }

  .facts dd {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.92em;
  }

  /* Three stills in one row: the die, the centre, and the same window without the power. They read across, so the
     row is a sequence rather than three separate pictures. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem;
    margin: 3rem 0;
    padding: 0;
    list-style: none;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: #11161c;
  }

  .gallery figcaption {
    margin-block-start: 0.6rem;
    color: var(--fg-3);
    font-size: 0.85em;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .call {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0.75rem;
  }

  .note {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.88em;
    max-inline-size: 68ch;
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .stack3d__stage {
      width: 76%;
    }
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .facts dd {
      margin-block-end: 0.75rem;
    }
  }
</style>

<script>
  // The stack turns on its own until a reader takes it, and a drag then sets the two angles directly. The stage keeps
  // the transform in custom properties so the plates' own depth stays in the sheet.
  const stack = document.querySelector<HTMLElement>('[data-stack3d]');
  const stage = stack?.querySelector<HTMLElement>('[data-stack-stage]');
  if (stack && stage) {
    let rx = 62;
    let rz = -32;
    let spin = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let frame = 0;

    const draw = () => {
      stage.style.setProperty('--rx', `${rx}deg`);
      stage.style.setProperty('--rz', `${rz}deg`);
    };

    const tick = () => {
      if (!spin) return;
      rz = (rz + 0.18) % 360;
      draw();
      frame = requestAnimationFrame(tick);
    };

    stack.addEventListener('pointerdown', (event) => {
      spin = false;
      cancelAnimationFrame(frame);
      stack.setPointerCapture(event.pointerId);
      let x = event.clientX;
      let y = event.clientY;
      const move = (next: PointerEvent) => {
        rz += (next.clientX - x) * 0.45;
        rx = Math.min(86, Math.max(16, rx - (next.clientY - y) * 0.35));
        x = next.clientX;
        y = next.clientY;
        draw();
      };
      const up = (next: PointerEvent) => {
        stack.releasePointerCapture(next.pointerId);
        stack.removeEventListener('pointermove', move);
        stack.removeEventListener('pointerup', up);
        stack.removeEventListener('pointercancel', up);
      };
      stack.addEventListener('pointermove', move);
      stack.addEventListener('pointerup', up);
      stack.addEventListener('pointercancel', up);
    });

    draw();
    if (spin) frame = requestAnimationFrame(tick);
  }
</script>
