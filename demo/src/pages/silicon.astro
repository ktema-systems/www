---
// The decoder as a finished layout.
//
// The stack opens on the die from above and tilts under a drag; the stills under it cover what the stack does not.
import Shell from '../layouts/Shell.astro';

const contact = 'mailto:demo@ktema.systems';

// The six metal layers, bottom to top, each drawn from the whole die.
const stackLayers = [
  { file: 'layer-67', name: 'li1' },
  { file: 'layer-68', name: 'met1' },
  { file: 'layer-69', name: 'met2' },
  { file: 'layer-70', name: 'met3' },
  { file: 'layer-71', name: 'met4' },
  { file: 'layer-72', name: 'met5' },
];

const stills = [
  {
    src: '/proofs/silicon-detail.png',
    width: 1800,
    height: 1800,
    alt: 'A close view of the die centre: standard cell rows crossed by teal wiring, gold longer routes, and magenta and white power straps.',
    caption: 'The centre, close: met1 and met2 on the local wiring, met3 on the longer runs.',
  },
  {
    src: '/proofs/silicon-routing.png',
    width: 1600,
    height: 1600,
    alt: 'The whole die without the power straps, leaving only signal routing in blue, teal and gold.',
    caption: 'The whole die without the power straps, so the signal routing stands alone.',
  },
];
---

<Shell
  title="Physical layout"
  description="The coordinate decoder block of the engine, carried through synthesis and place-and-route to a finished SkyWater 130 nm GDS layout."
  crumbs={[{ label: 'Corpus Hub', href: '/' }, { label: 'Physical layout' }]}
>
  <section class="hero">
    <h1>The same decoder, in gates.</h1>
    <p class="lede">
      A 16-bit code point enters, three axis labels leave, in one registered stage. This is that decoder as a finished
      GDS layout: SkyWater 130 nm standard cells, placed and routed by the OpenROAD flow. It is a layout and not a
      fabricated part; no wafer has been made.
    </p>
  </section>

  <figure class="showcase">
    <div class="stack3d" data-stack3d>
      <div class="stack3d__stage" data-stack-stage>
        {
          stackLayers.map((layer, index) => (
            <img
              src={`/proofs/stack/${layer.file}.png`}
              alt=""
              width="1200"
              height="1200"
              decoding="async"
              style={`--i:${index - (stackLayers.length - 1) / 2}`}
            />
          ))
        }
      </div>
    </div>
    <figcaption class="showcase__key">
      The die from above, <code>li1</code> at the bottom and <code>met5</code> at the top. Drag to tilt.
    </figcaption>
  </figure>

  <section class="section">
    <h2>What it is</h2>
    <div class="spec">
      <dl class="facts">
      <dt>The block</dt>
      <dd>
        One decoder, not the engine: the primitive a coordinate resolves through to become its axes. Storage, recovery,
        and scaling live elsewhere in the engine and are not part of this block.
      </dd>
      <dt>The unit</dt>
      <dd>
        A 16-bit code point enters and three axis labels leave, in one registered stage. The decode is combinational and
        the outputs are registered on the clock, so the latency is fixed and a design can plan around it.
      </dd>
      <dt>The target</dt>
      <dd>
        SkyWater 130 nm high-density standard cells, placed and routed by the OpenROAD flow, with the clock constrained
        to the 12 MHz the block was built for.
      </dd>
      <dt>The size</dt>
      <dd>
        588 two-input cells in the gate estimate, 201 LUT4 and 41 carry cells on an iCE40 FPGA, and 388 standard cells
        covering 2,826 µm² in SkyWater 130 nm. The standard-cell figure has no registers, since the decode is
        combinational.
      </dd>
      <dt>The area</dt>
      <dd>
        The block that went through place and route, the decoder with its output registers and the validity flag, covers
        4,430 µm² at 34% of the core: 410 logic and register cells in 1,920 placed instances, the rest fill and tap.
      </dd>
      <dt>The timing</dt>
      <dd>
        Worst setup slack +72.77 ns and total negative slack 0.00 at the 12 MHz constraint, from the placed and routed
        netlist with extracted parasitics.
      </dd>
      <dt>The power</dt>
      <dd>
        57.8 µW at the tool's default switching activity, 36.6 µW at one code point per clock, about 3.0 pJ per decode.
      </dd>
      <dt>The check</dt>
      <dd>
        The RTL is verified against the software reference over all 65,536 code points, the gate netlist is simulated
        against the same anchors, and the RTL and the gate netlist are proven equivalent.
      </dd>
    </dl>
      <p class="spec-note">
        These come from one synthesis and one placed run of one revision; a different cell library or clock constraint
        moves them.
      </p>
    </div>
  </section>

  <ul class="gallery">
    {
      stills.map((still) => (
        <li>
          <figure>
            <img src={still.src} width={still.width} height={still.height} alt={still.alt} loading="lazy" decoding="async" />
            <figcaption>{still.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  <section class="section">
    <h2>How it was made</h2>
    <p class="section__lede">
      The RTL is synthesized to SkyWater 130 nm standard cells, then placed and routed by the OpenROAD flow. These images
      are drawn from that flow's final GDS, keeping the metal layers and cropping to the placed cells. The decoder is
      published as open hardware; the engine built on it is the product.
    </p>
    <div class="close">
      <p class="call">
        <a class="btn" href="/trial/">The build to evaluate</a>
        <a class="btn" href="/claims/">What the stack establishes</a>
      </p>
      <p class="footnote">
        This is a test block, not a product die. For a part built to your own workload, <a href={contact}>write to us</a>.
      </p>
    </div>
  </section>
</Shell>

<style>
  /* The stack is the page's picture and stands in the body at its own size rather than beside the copy. It opens
     flat on the die and tilts under a drag, so the first view is the whole square. */
  .showcase {
    display: grid;
    justify-items: center;
    margin: 2.5rem 0 0;
  }

  .stack3d {
    display: grid;
    place-items: center;
    width: min(100%, 640px);
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    /* A turned plate reaches past its box, so the container clips as a last resort; the script scales the stack to
       fit, and this only catches a frame before that runs. */
    overflow: clip;
  }

  .stack3d:active {
    cursor: grabbing;
  }

  /* No perspective: the plates stay parallel, which keeps the layers aligned when the stack is seen from above.
     The script sets --s so a tilted silhouette stays inside the square. */
  .stack3d__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(var(--s, 1));
  }

  .stack3d__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: translateZ(calc(var(--i) * 26px));
    pointer-events: none;
  }

  .showcase__key {
    margin-block-start: 0.9rem;
    color: var(--fg-3);
    font-size: 0.85em;
  }

  .section {
    margin-block: 3rem;
  }

  .section h2 {
    margin-block-end: 1rem;
  }

  .section__lede {
    color: var(--fg-3);
    max-inline-size: 68ch;
  }

  /* A block owns the space between its parts, so no margin of a neighbouring rule can take it away. */
  .spec {
    display: grid;
    gap: 1.75rem;
    margin-block-start: 1.25rem;
    max-inline-size: 74ch;
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(9rem, max-content) 1fr;
    gap: 0.6rem 1.5rem;
    margin: 0;
  }

  .facts dt {
    color: var(--fg);
    font-size: 0.95em;
  }

  .facts dd {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.92em;
  }

  /* The caveat stands off the table with a rule of its own, rather than reading as one more row. */
  .spec-note {
    margin: 0;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--line);
    color: var(--fg-3);
    font-size: 0.88em;
    line-height: 1.6;
  }

  /* Two stills in one row: a close crop and the same die without the power. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
    margin: 3rem 0;
    padding: 0;
    list-style: none;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: #11161c;
  }

  .gallery figcaption {
    margin-block-start: 0.6rem;
    color: var(--fg-3);
    font-size: 0.85em;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* The call and the line under it are one group: the gap belongs to the group, not to whichever element
     happens to come first. */
  .close {
    display: grid;
    gap: 0.9rem;
    margin-block-start: 1.75rem;
  }

  .call {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }

  .footnote {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.88em;
    max-inline-size: 68ch;
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .facts dd {
      margin-block-end: 0.75rem;
    }
  }
</style>

<script>
  // The stack opens on the die from above. A drag sets the two angles: vertical travel tilts it away from the top
  // view, horizontal travel turns it about the upright axis. A square does not fit its own silhouette once turned, so
  // the stack is scaled just enough to keep every corner inside the box.
  const stack = document.querySelector<HTMLElement>('[data-stack3d]');
  const stage = stack?.querySelector<HTMLElement>('[data-stack-stage]');
  if (stack && stage) {
    const plates = stage.querySelectorAll('img').length;
    const depth = 26 * (plates - 1);
    let rx = 0;
    let ry = 0;

    const fit = () => {
      const side = stage.offsetWidth;
      const box = stack.clientWidth;
      const a = (rx * Math.PI) / 180;
      const b = (ry * Math.PI) / 180;
      const ca = Math.cos(a);
      const sa = Math.sin(a);
      const cb = Math.cos(b);
      const sb = Math.sin(b);
      let halfW = 0;
      let halfH = 0;
      for (const cx of [-0.5, 0.5]) {
        for (const cy of [-0.5, 0.5]) {
          for (const cz of [-0.5, 0.5]) {
            const x = cx * side;
            const z = cz * depth;
            const turnedX = x * cb + z * sb;
            const turnedZ = -x * sb + z * cb;
            halfW = Math.max(halfW, Math.abs(turnedX));
            halfH = Math.max(halfH, Math.abs(cy * side * ca - turnedZ * sa));
          }
        }
      }
      const scale = Math.min(1, box / 2 / halfW, box / 2 / halfH);
      stage.style.setProperty('--s', scale.toFixed(3));
    };

    const draw = () => {
      stage.style.setProperty('--rx', `${rx}deg`);
      stage.style.setProperty('--ry', `${ry}deg`);
      fit();
    };

    stack.addEventListener('pointerdown', (event) => {
      stack.setPointerCapture(event.pointerId);
      let x = event.clientX;
      let y = event.clientY;
      const move = (next: PointerEvent) => {
        ry = Math.min(70, Math.max(-70, ry + (next.clientX - x) * 0.4));
        rx = Math.min(80, Math.max(-70, rx + (next.clientY - y) * 0.35));
        x = next.clientX;
        y = next.clientY;
        draw();
      };
      const up = (next: PointerEvent) => {
        stack.releasePointerCapture(next.pointerId);
        stack.removeEventListener('pointermove', move);
        stack.removeEventListener('pointerup', up);
        stack.removeEventListener('pointercancel', up);
      };
      stack.addEventListener('pointermove', move);
      stack.addEventListener('pointerup', up);
      stack.addEventListener('pointercancel', up);
    });

    draw();
    window.addEventListener('resize', fit);
  }
</script>
