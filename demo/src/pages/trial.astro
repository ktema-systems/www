---
// The page a partner reads before asking for the trial build.
//
// It answers one question: what is ready, and who to ask for it. The build travels on request,
// so the page states it and sends the reader to the call rather than to a file. The recordings
// and the measurement logs stay as rows: they are the evidence a trial is judged by, and they
// are published.
import { getDeliveries, byKind, type Delivery } from '../data/deliveries';
import Shell from '../layouts/Shell.astro';

const all = getDeliveries();
const recordings = byKind(all, 'demo');
const measurements = byKind(all, 'bench');
const contact = 'mailto:demo@ktema.systems';

const size = (bytes: number) => {
  if (bytes >= 1 << 20) return `${(bytes / (1 << 20)).toFixed(1)} MB`;
  if (bytes >= 1 << 10) return `${(bytes / (1 << 10)).toFixed(1)} KB`;
  return `${bytes} B`;
};

const digest = (delivery: Delivery) => delivery.sha256.replace(/^sha256:/, '');
---

<Shell
  title="Trial build"
  description="The build a partner evaluates: what is ready, what it holds, and how to ask for it."
  crumbs={[{ label: 'Corpus Hub', href: '/' }, { label: 'Trial build' }]}
>
  <section class="hero">
    <h1>Trial build</h1>
    <p class="lede">
      One engine, built for a part with no operating system and for Linux machines: the same build a firmware team
      links and a host runs. It comes with the specification it implements, and it answers no network and needs no
      account. Ask for it and we send the archive that matches your hardware.
    </p>
  </section>

  <section class="section">
    <h2>What is ready</h2>
    <dl class="ready">
      <dt>The build</dt>
      <dd>
        A C header, a static library, and a worked example for each machine class; a shared object and a Python
        binding where the class has an operating system; a daemon for each Linux class.
      </dd>
      <dt>The specification</dt>
      <dd>
        Four documents: the format, the medium, the index, and the coordinate read. They are enough to build a
        conforming implementation and to check a record you did not write.
      </dd>
      <dt>The evidence</dt>
      <dd>The recordings below, and the logs the measurements wrote. Each is published with its digest.</dd>
      <dt>The check</dt>
      <dd>
        A digest for every file in the archive, a signature over that list, and the fingerprint of the key that
        made it.
      </dd>
    </dl>
    <p class="call">
      <a class="btn btn--accent" href={contact}>Write to us</a>
    </p>
    <p class="note">
      The archive travels with its digest, and the fingerprint is sent the same way, so what arrives can be
      checked against what was signed.
    </p>
  </section>

  <section class="section">
    <h2>Recordings</h2>
    <p class="section__lede">The cut video of a demonstration, with the terminal session and the apparatus in one frame.</p>
    {
      recordings.length === 0 ? (
        <p class="empty">Nothing of this kind is published yet.</p>
      ) : (
        <ul class="files">
          {recordings.map((delivery) => (
            <li class="file">
              <a class="file__name" href={delivery.url}>
                {delivery.name}
              </a>
              <div class="file__meta">
                <span>{size(delivery.bytes)}</span>
                <span class="file__unsigned">digest only</span>
              </div>
              <code class="file__digest">{digest(delivery)}</code>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="section">
    <h2>Measurements</h2>
    <p class="section__lede">The raw log a measurement wrote: what the medium cost per record, in the run that produced it.</p>
    {
      measurements.length === 0 ? (
        <p class="empty">Nothing of this kind is published yet.</p>
      ) : (
        <ul class="files">
          {measurements.map((delivery) => (
            <li class="file">
              <a class="file__name" href={delivery.url}>
                {delivery.name}
              </a>
              <div class="file__meta">
                <span>{size(delivery.bytes)}</span>
                <span class="file__unsigned">digest only</span>
              </div>
              <code class="file__digest">{digest(delivery)}</code>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Shell>

<style>
  .section {
    margin-block-start: 3rem;
  }

  .section h2 {
    margin-block-end: 0.25rem;
  }

  .section__lede {
    margin-block: 0 1.5rem;
    color: var(--fg-3);
    max-inline-size: 60ch;
  }

  .empty {
    color: var(--fg-3);
  }

  /* What a partner is deciding about, read as a list rather than a paragraph: the four things
     that arrive are the answer, and each is one line. */
  .ready {
    display: grid;
    grid-template-columns: minmax(10rem, max-content) 1fr;
    gap: 0.6rem 1.5rem;
    margin: 1.5rem 0 2rem;
    max-inline-size: 74ch;
  }

  .ready dt {
    font-size: 0.95em;
    color: var(--fg);
  }

  .ready dd {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.92em;
  }

  .call {
    margin: 0 0 0.75rem;
  }

  .note {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.88em;
    max-inline-size: 60ch;
  }

  @media (max-width: 640px) {
    .ready {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .ready dd {
      margin-block-end: 0.75rem;
    }
  }

  /* A file is a row on the page's own ground, ruled like every other list here. A card would
     make three entries look like three islands. */
  .files {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .file {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 0.4rem;
  }

  .file__name {
    font-family: var(--mono);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  .file__meta {
    display: flex;
    gap: 1rem;
    font-size: 0.85em;
    color: var(--fg-3);
  }

  .file__unsigned {
    color: var(--fg-3);
  }

  .file__digest {
    font-family: var(--mono);
    font-size: 0.75em;
    color: var(--fg-3);
    overflow-wrap: anywhere;
  }
</style>
