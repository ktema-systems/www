---
// What the stack establishes: one line per thing it sets out to do, with the entry under each.
//
// It reads from the same data the grid does, so a line cannot name evidence the hub does not carry, and an artifact
// cannot be left off the register. The platforms table below is the vocabulary the lines rest on: what each environment
// can establish, and so what a run on it can show. A line whose entry is still a plan stands beside one whose entry is
// a recorded run: this is where what is done and what is planned are read together.
import { placeLines } from '../data/claims';
import { getArtifacts, getSurfaces } from '../data/source';
import { PLATFORMS, platformOf, type Platform } from '../data/taxonomy';
import Shell from '../layouts/Shell.astro';

const lines = placeLines(await getArtifacts(), await getSurfaces());

const coverage = (Object.keys(PLATFORMS) as Platform[]).map((name) => ({
  name,
  label: PLATFORMS[name].label,
  proves: PLATFORMS[name].proves,
}));
---

<Shell
  title="What it establishes"
  description="What Kletos sets out to establish, and the recorded runs or stated plans under each."
  crumbs={[{ label: 'Corpus Hub', href: '/' }, { label: 'What it establishes' }]}
>
  <section class="hero">
    <h1>What it establishes</h1>
    <p class="lede">
      Each line is one thing the stack sets out to establish, with the entry under it that does so. An entry with a
      still is a recorded run; one with the mark is a page that states the work before it is recorded, so both what is
      done and what is planned stand here together.
    </p>
  </section>

  <ol class="map">
    {
      lines.map((line) => (
        <li class="map__line">
          <div class="map__part">
            <h2 class="map__title">{line.title}</h2>
            <p class="map__states">{line.states}</p>
          </div>
          <ul class="map__evidence">
            {line.evidence.map((item) => (
              <li>
                <a class="map__item" href={`/${item.id}`}>
                  <span class="map__thumb">
                    {item.poster ? (
                      <img src={item.poster} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <span class="map__bay" aria-hidden="true" />
                    )}
                  </span>
                  <span class="map__name">{item.title}</span>
                  <span class="tags">
                    {item.platforms.map((name) => (
                      <span class="platform-tag">{platformOf(name).label}</span>
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  <section class="claims-section">
    <header class="section-head">
      <h2>The platforms</h2>
      <p class="section-head__note">
        What each platform can establish, and so what a demonstration on it can show.
      </p>
    </header>

    <ul class="coverage">
      {
        coverage.map((surface) => (
          <li class="coverage__row">
            <span class="coverage__label">{surface.label}</span>
            <span class="coverage__proves">{surface.proves}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Shell>
