---
// The claim register: the sentences the program is built to hold, and the evidence under each.
//
// It reads from the same data the grid does, so a claim cannot name evidence the center does not carry, and an artifact
// cannot be left off the register. The platforms table below is the vocabulary the claims rest on: what each environment
// can establish, and therefore what evidence on it may claim.
import { placeLines } from '../data/claims';
import { getArtifacts, getSurfaces } from '../data/source';
import { PLATFORMS, platformOf, type Platform } from '../data/taxonomy';
import Shell from '../layouts/Shell.astro';

const lines = placeLines(await getArtifacts(), await getSurfaces());

const coverage = (Object.keys(PLATFORMS) as Platform[]).map((name) => ({
  name,
  label: PLATFORMS[name].label,
  proves: PLATFORMS[name].proves,
}));
---

<Shell
  title="Claims"
  description="The claims Ktema Systems holds, and the evidence that establishes each one."
  crumbs={[{ label: 'Corpus Center', href: '/' }, { label: 'Claims' }]}
>
  <section class="hero">
    <h1>Claims</h1>
    <p class="lede">
      The sentences the program is built to hold, and the evidence under each. An entry with a still is a recorded run;
      one with the mark is a page that states the work before it is recorded.
    </p>
  </section>

  <ol class="map">
    {
      lines.map((line) => (
        <li class="map__line">
          <div class="map__part">
            <h2 class="map__title">{line.title}</h2>
            <p class="map__states">{line.states}</p>
          </div>
          <ul class="map__evidence">
            {line.evidence.map((item) => (
              <li>
                <a class="map__item" href={`/${item.id}`}>
                  <span class="map__thumb">
                    {item.poster ? (
                      <img src={item.poster} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <span class="map__bay" aria-hidden="true" />
                    )}
                  </span>
                  <span class="map__name">{item.title}</span>
                  <span class="tags">
                    {item.platforms.map((name) => (
                      <span class="platform-tag">{platformOf(name).label}</span>
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  <section class="claims-section">
    <header class="section-head">
      <h2>The platforms</h2>
      <p class="section-head__note">
        What each platform can establish, and therefore what a demonstration on it may claim.
      </p>
    </header>

    <ul class="coverage">
      {
        coverage.map((surface) => (
          <li class="coverage__row">
            <span class="coverage__label">{surface.label}</span>
            <span class="coverage__proves">{surface.proves}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Shell>
