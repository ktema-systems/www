---
// The files a reader fetches rather than reads.
//
// The hub's other pages draw what a run measured. This one names what a run produced: the bundle a firmware team
// links, the cut video of a demonstration, the raw medium log a measurement wrote. Each states where to fetch it
// from and the digest to check it against, so a reader who downloaded one can establish that what arrived is what
// was published.
//
// A bundle carries a signature inside itself and the page says so. Anything else is a video or a log: its digest
// establishes that the file is the one stated, which is what a video needs and all it can be given without a key.
import { getDeliveries, byKind, type Delivery, type DeliveryKind } from '../data/deliveries';
import Shell from '../layouts/Shell.astro';

const all = getDeliveries();

// One section per kind, in the order a reader needs them. A kind with nothing under it is drawn with a line saying
// so, because an empty section a reader cannot see is indistinguishable from a page that forgot one.
const sections: { kind: DeliveryKind; title: string; lede: string }[] = [
  {
    kind: 'bundle',
    title: 'Bundles',
    lede: 'The engine as a firmware team links it: built for a part with no operating system and for Linux machines, with a worked example and the specification it implements. A trial or a proof of concept starts from this file.',
  },
  {
    kind: 'demo',
    title: 'Recordings',
    lede: 'The cut video of a demonstration, with the terminal session and the apparatus in one frame.',
  },
  {
    kind: 'bench',
    title: 'Measurements',
    lede: 'The raw log a measurement wrote: what the medium cost per record, in the run that produced it.',
  },
];

const size = (bytes: number) => {
  if (bytes >= 1 << 20) return `${(bytes / (1 << 20)).toFixed(1)} MB`;
  if (bytes >= 1 << 10) return `${(bytes / (1 << 10)).toFixed(1)} KB`;
  return `${bytes} B`;
};

const digest = (delivery: Delivery) => delivery.sha256.replace(/^sha256:/, '');
---

<Shell
  title="Artifacts"
  description="The files the hub publishes: bundles, recordings, and measurement logs, each with the digest to check it against."
  crumbs={[{ label: 'Corpus Hub', href: '/' }, { label: 'Artifacts' }]}
>
  <section class="hero">
    <h1>Artifacts</h1>
    <p class="lede">
      Everything this hub publishes as a file: the trial build, the recordings of what ran, and the logs the
      measurements wrote. Each entry states where to fetch it and the SHA-256 to check it against. The trial build is
      also signed, so the key's fingerprint can be compared with the one that reached you out of band.
    </p>
  </section>

  {
    sections.map((section) => {
      const rows = byKind(all, section.kind);
      return (
        <section class="section" id={section.kind === 'bundle' ? 'bundles' : undefined}>
          <h2>{section.title}</h2>
          <p class="section__lede">{section.lede}</p>
          {
            section.kind === 'bundle' && (
              <div class="inventory">
                <h3>What you receive</h3>
                <dl>
                  <dt>The specification</dt>
                  <dd>
                    Four documents: the format, the medium, the index, and the coordinate read. They are enough to build
                    a conforming implementation and to check a record you did not write.
                  </dd>
                  <dt>The C surface</dt>
                  <dd>
                    A header, a static library, a worked example, and the terms, for each machine class. Where the class
                    has an operating system, a shared object and a Python binding come with it, using nothing outside
                    the standard library.
                  </dd>
                  <dt>The daemon</dt>
                  <dd>
                    The engine answering on a unix socket, for Linux machines. One binary for each architecture, since a
                    build for one does not run on the other.
                  </dd>
                  <dt>The bill of materials</dt>
                  <dd>Each class's dependencies in CycloneDX, stating what is linked into an image.</dd>
                  <dt>The trial record</dt>
                  <dd>What the build was held to, and what each test printed.</dd>
                  <dt>The manifest</dt>
                  <dd>The version, the ABI, the format, and the machine classes this build covers.</dd>
                  <dt>The signature</dt>
                  <dd>
                    A digest for every file, a signature over that list, and the fingerprint of the key that made it.
                  </dd>
                </dl>
                <p>
                  Everything in it runs where you put it: no account, no network call, and no service of ours in the
                  path.
                </p>
              </div>
            )
          }
          {rows.length === 0 ? (
            <p class="empty">Nothing of this kind is published yet.</p>
          ) : (
            <ul class="files">
              {rows.map((delivery) => (
                <li class="file">
                  <a class="file__name" href={delivery.url}>
                    {delivery.name}
                  </a>
                  <div class="file__meta">
                    <span>{size(delivery.bytes)}</span>
                    {delivery.signature ? (
                      <span class="file__signed">signed, {delivery.signature}</span>
                    ) : (
                      <span class="file__unsigned">digest only</span>
                    )}
                  </div>
                  <code class="file__digest">{digest(delivery)}</code>
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    })
  }
</Shell>

<style>
  .section {
    margin-block-start: 3rem;
  }

  .section h2 {
    margin-block-end: 0.25rem;
  }

  .section__lede {
    margin-block: 0 1.5rem;
    color: var(--fg-3);
    max-inline-size: 60ch;
  }

  .empty {
    color: var(--fg-3);
  }

  /* What a bundle holds, read as a list rather than a paragraph: a reader deciding
     whether to ask for one reads the inventory, not the sentence about it. */
  .inventory {
    margin-block-end: 2rem;
    max-inline-size: 74ch;
  }

  .inventory h3 {
    margin-block: 0 0.75rem;
    font-size: 1rem;
    color: var(--fg-2);
    font-weight: 600;
  }

  .inventory dl {
    display: grid;
    grid-template-columns: minmax(10rem, max-content) 1fr;
    gap: 0.5rem 1.5rem;
    margin: 0 0 1rem;
  }

  .inventory dt {
    font-size: 0.95em;
    color: var(--fg);
  }

  .inventory dd {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.9em;
  }

  .inventory p {
    margin: 0;
    color: var(--fg-3);
    font-size: 0.9em;
  }

  @media (max-width: 640px) {
    .inventory dl {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .inventory dd {
      margin-block-end: 0.75rem;
    }
  }

  /* A file is a row on the page's own ground, ruled like every other list here.
     A card would make three entries look like three islands. */
  .files {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .file {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 0.4rem;
  }

  .file__name {
    font-family: var(--mono);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  .file__meta {
    display: flex;
    gap: 1rem;
    font-size: 0.85em;
    color: var(--fg-3);
  }

  .file__signed {
    color: var(--accent);
  }

  .file__unsigned {
    color: var(--fg-3);
  }

  .file__digest {
    font-family: var(--mono);
    font-size: 0.75em;
    color: var(--fg-3);
    overflow-wrap: anywhere;
  }
</style>
