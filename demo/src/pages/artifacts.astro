---
// The files a reader fetches rather than reads.
//
// The hub's other pages draw what a run measured. This one names what a run produced: the bundle a firmware team
// links, the cut video of a demonstration, the raw medium log a measurement wrote. Each states where to fetch it
// from and the digest to check it against, so a reader who downloaded one can establish that what arrived is what
// was published.
//
// A bundle carries a signature inside itself and the page says so. Anything else is a video or a log: its digest
// establishes that the file is the one stated, which is what a video needs and all it can be given without a key.
import { getDeliveries, byKind, type Delivery, type DeliveryKind } from '../data/deliveries';
import Shell from '../layouts/Shell.astro';

const all = getDeliveries();

// One section per kind, in the order a reader needs them. A kind with nothing under it is drawn with a line saying
// so, because an empty section a reader cannot see is indistinguishable from a page that forgot one.
const sections: { kind: DeliveryKind; title: string; lede: string }[] = [
  {
    kind: 'bundle',
    title: 'Bundles',
    lede: 'The engine as a firmware team links it: a header and a static library per machine class, a shared object and a binding where there is an operating system, and a daemon for each Linux class. A bundle is the file a trial or a proof of concept starts from.',
  },
  {
    kind: 'demo',
    title: 'Recordings',
    lede: 'The cut video of a demonstration, with the terminal session and the apparatus in one frame.',
  },
  {
    kind: 'bench',
    title: 'Measurements',
    lede: 'The raw log a measurement wrote: what the medium cost per record, in the run that produced it.',
  },
];

const size = (bytes: number) => {
  if (bytes >= 1 << 20) return `${(bytes / (1 << 20)).toFixed(1)} MB`;
  if (bytes >= 1 << 10) return `${(bytes / (1 << 10)).toFixed(1)} KB`;
  return `${bytes} B`;
};

const digest = (delivery: Delivery) => delivery.sha256.replace(/^sha256:/, '');
---

<Shell
  title="Artifacts"
  description="The files the hub publishes: bundles, recordings, and measurement logs, each with the digest to check it against."
  crumbs={[{ label: 'Corpus Hub', href: '/' }, { label: 'Artifacts' }]}
>
  <section class="hero">
    <h1>Artifacts</h1>
    <p class="lede">
      What this hub publishes as files: the bundle a firmware team links, the recordings of what ran, and the logs the
      measurements wrote. Each line states where to fetch one and the SHA-256 to check it against. A bundle carries an
      Ed25519 signature inside itself, and the fingerprint of the key is stated in its <code>SIGNING-KEY</code>; the
      other files carry a digest, which establishes the file is the one stated.
    </p>
  </section>

  {
    sections.map((section) => {
      const rows = byKind(all, section.kind);
      return (
        <section class="section">
          <h2>{section.title}</h2>
          <p class="section__lede">{section.lede}</p>
          {
            section.kind === 'bundle' && (
              <div class="inventory">
                <h3>What the archive holds</h3>
                <dl>
                  <dt>spec/</dt>
                  <dd>
                    Four documents: the format, the medium contract, the index contract, and the
                    coordinate read contract. A reader holding these can build a conforming
                    implementation, and nothing here needs this hub or our software to check it.
                  </dd>
                  <dt>targets/&lt;class&gt;/</dt>
                  <dd>
                    The C surface for one machine class: <code>ktema.h</code>, the static library,
                    <code>example.c</code>, the terms, and <code>LINKING</code>, which states the two
                    hooks the integrator supplies. A class with an operating system also carries a
                    shared object and a Python binding that reaches nothing outside the standard
                    library. The same directory travels beside it as a tarball.
                  </dd>
                  <dt>lib/&lt;class&gt;/ktema-daemon</dt>
                  <dd>
                    The engine over a unix socket, for a host with an operating system. One binary
                    per host class, because a binary built for the other architecture does not run.
                  </dd>
                  <dt>sbom/&lt;class&gt;.json</dt>
                  <dd>
                    A CycloneDX bill of materials per built class, naming the dependency closure
                    that class links, which is what a firmware image contains rather than what the
                    lock file could reach.
                  </dd>
                  <dt>trial/</dt>
                  <dd>
                    The page the trial wrote, the receipts it belongs to, and the rule the bundle is
                    named and kept under.
                  </dd>
                  <dt>RELEASE</dt>
                  <dd>
                    The version, the ABI, the format, the revision, the classes this build got, and
                    the classes it did not get. This file is the authority for the last two: a class
                    the assembling machine could not build is named as absent rather than dropped.
                  </dd>
                  <dt>SHA256SUMS and its signature</dt>
                  <dd>
                    The digest of every file above, the signature over that list, the public key that
                    verifies it, and the fingerprint of that key. The three checks are stated in
                    <code>START-HERE.md</code>, which opens the archive.
                  </dd>
                </dl>
                <p>
                  The archive carries no engine source and no build system. What it carries is the
                  specification and a build of it, which is what an evaluation needs and what a
                  receipt can be checked against without trusting the machine that produced it.
                </p>
              </div>
            )
          }
          {rows.length === 0 ? (
            <p class="empty">Nothing of this kind is published yet.</p>
          ) : (
            <ul class="files">
              {rows.map((delivery) => (
                <li class="file">
                  <a class="file__name" href={delivery.url}>
                    {delivery.name}
                  </a>
                  <div class="file__meta">
                    <span>{size(delivery.bytes)}</span>
                    {delivery.signature ? (
                      <span class="file__signed">signed, {delivery.signature}</span>
                    ) : (
                      <span class="file__unsigned">digest only</span>
                    )}
                  </div>
                  <code class="file__digest">{digest(delivery)}</code>
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    })
  }
</Shell>

<style>
  .section {
    margin-block-start: 3rem;
  }

  .section h2 {
    margin-block-end: 0.25rem;
  }

  .section__lede {
    margin-block: 0 1.5rem;
    color: var(--muted, #666);
    max-inline-size: 60ch;
  }

  .empty {
    color: var(--muted, #666);
  }

  /* What a bundle holds, read as a list rather than a paragraph: a reader deciding
     whether to ask for one reads the inventory, not the sentence about it. */
  .inventory {
    margin-block-end: 2rem;
    max-inline-size: 74ch;
  }

  .inventory h3 {
    margin-block: 0 0.75rem;
    font-size: 1rem;
  }

  .inventory dl {
    display: grid;
    grid-template-columns: minmax(11rem, max-content) 1fr;
    gap: 0.5rem 1.5rem;
    margin: 0 0 1rem;
  }

  .inventory dt {
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }

  .inventory dd {
    margin: 0;
    color: var(--muted, #666);
    font-size: 0.9em;
  }

  .inventory p {
    margin: 0;
    color: var(--muted, #666);
    font-size: 0.9em;
  }

  @media (max-width: 640px) {
    .inventory dl {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .inventory dd {
      margin-block-end: 0.75rem;
    }
  }

  .files {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1px;
    background: var(--rule, #e5e5e5);
  }

  .file {
    background: var(--surface, #fff);
    padding: 1rem;
    display: grid;
    gap: 0.4rem;
  }

  .file__name {
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  .file__meta {
    display: flex;
    gap: 1rem;
    font-size: 0.85em;
    color: var(--muted, #666);
  }

  .file__signed {
    color: var(--accent, #2c6e49);
  }

  .file__digest {
    font-size: 0.75em;
    color: var(--muted, #666);
    overflow-wrap: anywhere;
  }
</style>
