---
import { artifacts, planned } from '../data/artifacts';
import Shell from '../layouts/Shell.astro';
import Tile from '../components/Tile.astro';

// The first artifact is the page's figure and takes two columns of the grid; everything else fills in around it. One
// demonstration is a still and a way in, and the surfaces that are not built yet stand beside it, which is what the
// center is until there are enough of either to be a catalogue.
const [lead, ...rest] = artifacts;

// A deployed application is opened at its own address. It owns the viewport, its own header and its own back button, so a
// frame around it is a second header and a second scrollbar; the center sends the reader there instead of drawing it.
const hrefOf = (artifact: (typeof artifacts)[number]) =>
  artifact.kind === 'live' ? artifact.source : `/${artifact.id}`;
---

<Shell title="Demo Center">
  <section class="hero">
    <h1>Explore the stack.</h1>
    <p class="lede">
      A unified space for demos across the stack: interactive applications, the engine's own runs, and hardware on the
      bench.
    </p>
  </section>

  <ul class="bento">
    {
      lead && (
        <li>
          <Tile
            href={hrefOf(lead)}
            title={lead.title}
            summary={lead.summary}
            poster={lead.poster}
            posterAlt={lead.posterAlt}
            cta="Open the demonstration"
            eager
          />
        </li>
      )
    }

    {
      rest.map((artifact) => (
        <li>
          <Tile
            href={hrefOf(artifact)}
            title={artifact.title}
            summary={artifact.summary}
            poster={artifact.poster}
            posterAlt={artifact.posterAlt}
            cta="Open"
          />
        </li>
      ))
    }

    {
      planned.map((surface) => (
        <li>
          <Tile title={surface.title} summary={surface.summary} badge="coming soon" />
        </li>
      ))
    }
  </ul>
</Shell>
