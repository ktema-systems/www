---
import { getArtifacts, getSurfaces } from '../data/source';
import Shell from '../layouts/Shell.astro';
import Tile from '../components/Tile.astro';
import Row from '../components/Row.astro';

// The hub's board, which is what the front page's own call opens. `PUBLIC_CENTER_URL` is where a build points when the
// application moves, and the shell names the same address in its bar.
const viewUrl = (import.meta.env.PUBLIC_CENTER_URL ?? 'https://corpus.ktema.systems/').replace(/\/?$/, '/');

// Two lists, each drawn twice. The surfaces that are recorded stand in the first; the demonstrations that are
// specified and not yet recorded stand under them in their own section. Every entry is drawn as a tile and as a row,
// and the switch in the bar picks which of the two is shown, so the views cannot disagree about what the center
// carries. A tile with a still is a recorded run; a tile with the mark is a page that states the work.
const recorded = (await getArtifacts()).map((artifact) => ({
  id: artifact.id,
  title: artifact.title,
  category: artifact.category,
  products: artifact.products,
  platforms: artifact.platforms,
  summary: artifact.summary,
  poster: artifact.poster,
  posterAlt: artifact.posterAlt,
}));

const further = (await getSurfaces()).map((surface) => ({
  id: surface.id,
  title: surface.title,
  category: surface.category,
  products: surface.products,
  platforms: surface.platforms,
  summary: surface.summary,
  poster: undefined as string | undefined,
  posterAlt: undefined as string | undefined,
}));
---

<Shell title="Corpus Hub">
  <Fragment slot="bar">
    <div class="views__bar">
      <button type="button" data-view-set="grid" aria-pressed="true" aria-label="Tiles">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
          <rect x="2.5" y="2.5" width="4.5" height="4.5" />
          <rect x="9" y="2.5" width="4.5" height="4.5" />
          <rect x="2.5" y="9" width="4.5" height="4.5" />
          <rect x="9" y="9" width="4.5" height="4.5" />
        </svg>
      </button>
      <button type="button" data-view-set="list" aria-pressed="false" aria-label="Rows">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M2.5 4h11M2.5 8h11M2.5 12h11" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </Fragment>

  <section class="hero">
    <h1>The stack, surface by surface.</h1>
    <p class="lede">
      Records from Ktema Systems: the demonstrations that show the stack running, and the measurements that say what a run
      cost.
    </p>
    <p class="hero__actions">
      <a class="btn" href={viewUrl} target="_blank" rel="noreferrer" data-hero-cta>
        Open Corpus Space
      </a>
    </p>
  </section>

  <div class="views" data-views data-view="grid">
    <ul class="bento">
      {
        recorded.map((entry, index) => (
          <li>
            <Tile
              href={`/${entry.id}`}
              title={entry.title}
              category={entry.category}
              products={entry.products}
              platforms={entry.platforms}
              summary={entry.summary}
              poster={entry.poster}
              posterAlt={entry.posterAlt}
              eager={index === 0}
            />
          </li>
        ))
      }
    </ul>

    <ul class="rows">
      {
        recorded.map((entry) => (
          <Row
            href={`/${entry.id}`}
            title={entry.title}
            category={entry.category}
            products={entry.products}
            platforms={entry.platforms}
            summary={entry.summary}
            poster={entry.poster}
            posterAlt={entry.posterAlt}
          />
        ))
      }
    </ul>

    <section class="further" hidden={!further.length}>
      <header class="section-head">
        <h2>Further demonstrations</h2>
        <p class="section-head__note">
          Stated and not yet recorded. Each one names its purpose, procedure, preconditions, deliverable and
          verification, so what it will establish is on the page before a run exists.{' '}
          <a href="/claims">What the program establishes</a>.
        </p>
      </header>

      {further.length ? (
        <ul class="bento">
          {further.map((entry) => (
            <li>
              <Tile
                href={`/${entry.id}`}
                title={entry.title}
                products={entry.products}
                platforms={entry.platforms}
                summary={entry.summary}
              />
            </li>
          ))}
        </ul>
      ) : null}

      {further.length ? (
        <ul class="rows">
          {further.map((entry) => (
            <Row
              href={`/${entry.id}`}
              title={entry.title}
              category={entry.category}
              products={entry.products}
              platforms={entry.platforms}
              summary={entry.summary}
            />
          ))}
        </ul>
      ) : null}
    </section>
  </div>
</Shell>

<script>
  const root = document.querySelector<HTMLElement>('[data-views]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-view-set]');
  if (root) {
    const select = (view: string) => {
      root.dataset.view = view;
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.viewSet === view));
      }
    };
    for (const button of buttons) {
      button.addEventListener('click', () => select(button.dataset.viewSet ?? 'grid'));
    }
  }
</script>
