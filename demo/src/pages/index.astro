---
import { artifacts, planned } from '../data/artifacts';
import Shell from '../layouts/Shell.astro';

// The first artifact is the page's figure and takes two columns of the grid; everything else fills in around it. One
// demonstration is a still and a way in, and the surfaces that are not built yet stand beside it, which is what the
// center is until there are enough of either to be a catalogue.
const [lead, ...rest] = artifacts;
---

<Shell title="Demo Center">
  <section class="hero">
    <p class="eyebrow">Demo center</p>
    <h1>Every system, running.</h1>
    <p class="lede">
      Delta is the first surface here: the cockpit for a working fleet, with ten scenes from a factory cell to a rescue
      over an island. Boards, recordings and hardware runs follow in the same place.
    </p>
  </section>

  <ul class="bento">
    {
      lead && (
        <li>
          <a class="tile tile--opens" href={`/${lead.id}`} style={`--wash: url('${lead.poster}')`}>
            <span class="tile__wash" aria-hidden="true" />
            {lead.poster && (
              <span class="tile__screen">
                <img
                  src={lead.poster}
                  alt={lead.posterAlt ?? ''}
                  width="1842"
                  height="1047"
                  loading="eager"
                  decoding="async"
                />
              </span>
            )}
            <span class="tile__body">
              <span class="badges">
                {lead.kind === 'live' && <span class="badge badge--live">live</span>}
                {lead.status && <span class="badge">{lead.status}</span>}
                {lead.data && <span class="badge">{lead.data}</span>}
              </span>
              <span class="tile__title">{lead.title}</span>
              <span class="tile__summary">{lead.summary}</span>
              <span class="tile__cta">
                Open the demonstration <span class="tile__arrow" aria-hidden="true">
                  &#8594;
                </span>
              </span>
            </span>
          </a>
        </li>
      )
    }

    {
      rest.map((artifact) => (
        <li>
          <a class="tile tile--opens" href={`/${artifact.id}`}>
            <span class="tile__body">
              <span class="badges">
                {artifact.kind === 'live' && <span class="badge badge--live">live</span>}
                {artifact.status && <span class="badge">{artifact.status}</span>}
                {artifact.data && <span class="badge">{artifact.data}</span>}
              </span>
              <span class="tile__title">{artifact.title}</span>
              <span class="tile__summary">{artifact.summary}</span>
              <span class="tile__cta">
                Open <span class="tile__arrow" aria-hidden="true">
                  &#8594;
                </span>
              </span>
            </span>
          </a>
        </li>
      ))
    }

    {
      planned.map((surface) => (
        <li>
          <div class="tile tile--planned">
            <span class="tile__screen tile__screen--empty" aria-hidden="true" />
            <div class="tile__body">
              <span class="badges">
                <span class="badge badge--planned">in build</span>
              </span>
              <span class="tile__title">{surface.title}</span>
              <span class="tile__summary">{surface.summary}</span>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Shell>
