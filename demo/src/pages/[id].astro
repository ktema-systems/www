---
// One page per artifact the center draws itself.
//
// A deployed application is not one of them. It owns the viewport, its own header and its own back button, so the center
// sends a reader to its address instead of framing it; a frame around an application is a second header and a second
// scrollbar, which is what this page stopped being.
import { artifacts, type Artifact } from '../data/artifacts';
import Shell from '../layouts/Shell.astro';
import Video from '../kinds/Video.astro';
import Document from '../kinds/Document.astro';
import Runs from '../kinds/Runs.astro';
import Bench from '../kinds/Bench.astro';
import Device from '../kinds/Device.astro';

export function getStaticPaths() {
  return artifacts
    .filter((artifact) => artifact.kind !== 'live')
    .map((artifact) => ({ params: { id: artifact.id }, props: { artifact } }));
}

const { artifact } = Astro.props as { artifact: Artifact };

const BODIES = { video: Video, document: Document, runs: Runs, bench: Bench, device: Device };
const Body = BODIES[artifact.kind as keyof typeof BODIES];

// A kind with no body here would render nothing at all, so the build stops instead of publishing an empty page.
if (!Body) throw new Error(`the center draws no page for a ${artifact.kind} artifact`);
---

<Shell
  title={artifact.title}
  description={artifact.summary}
  crumbs={[{ label: 'Demo Center', href: '/' }, { label: artifact.title }]}
>
  <header class="page__head">
    <h1 class="artifact__title">{artifact.title}</h1>
    <span class="tags">
      {artifact.products.map((name) => (
        <span class="product-tag">{name}</span>
      ))}
    </span>
  </header>
  <Body artifact={artifact} />
</Shell>
