---
// One page per entry the center draws: an artifact a reader can open, or a surface that does not exist yet and has a
// plan. They share a route because they share a header and a reader: a planned entry becomes an artifact at the same
// address once it is built, so nothing the center published has to move.
//
// A deployed application gets a page here too, and the page does not frame it: the application owns the viewport, its
// own header and its own back button, so the page carries the still, what the screen is, and one link out to its
// address. A frame around an application would be a second header and a second scrollbar.
import { type Artifact } from '../data/artifacts';
import { getArtifacts, getNotes, getSurfaces } from '../data/source';
import { type Surface } from '../data/surfaces';
import { noteFor } from '../data/posts';
import { PLATFORMS } from '../data/taxonomy';
import Shell from '../layouts/Shell.astro';
import Live from '../kinds/Live.astro';
import Video from '../kinds/Video.astro';
import Document from '../kinds/Document.astro';
import Runs from '../kinds/Runs.astro';
import Bench from '../kinds/Bench.astro';
import Device from '../kinds/Device.astro';
import Package from '../kinds/Package.astro';
import Planned from '../kinds/Planned.astro';

type Entry =
  | { kind: 'artifact'; artifact: Artifact }
  | { kind: 'planned'; surface: Surface };

export async function getStaticPaths() {
  const [artifacts, surfaces] = await Promise.all([getArtifacts(), getSurfaces()]);
  const seen = new Set<string>();
  const paths = [
    ...artifacts.map((artifact) => ({
      params: { id: artifact.id },
      props: { entry: { kind: 'artifact', artifact } as Entry },
    })),
    ...surfaces.map((surface) => ({
      params: { id: surface.id },
      props: { entry: { kind: 'planned', surface } as Entry },
    })),
  ];
  // One address is one thing. A planned entry that keeps an artifact's address would replace a page that already
  // exists, so the build stops instead of one of them winning silently.
  for (const path of paths) {
    if (seen.has(path.params.id)) throw new Error(`two entries share the address /${path.params.id}`);
    seen.add(path.params.id);
  }
  return paths;
}

const { entry } = Astro.props as { entry: Entry };

const brief = entry.kind === 'planned' ? entry.surface : undefined;
const artifact = entry.kind === 'artifact' ? entry.artifact : undefined;

const title = brief ? brief.title : artifact!.title;
const claim = brief ? brief.claim : artifact!.claim;
const products = brief ? brief.products : artifact!.products;
const platforms = brief ? brief.platforms : artifact!.platforms;
const summary = brief ? brief.summary : artifact!.summary;
const note = artifact ? noteFor(await getNotes(), `/${artifact!.id}`) : undefined;

const BODIES = { live: Live, video: Video, document: Document, runs: Runs, bench: Bench, device: Device, package: Package };
const ArtifactBody = artifact ? BODIES[artifact.kind as keyof typeof BODIES] : null;

// A kind with no body here would render nothing at all, so the build stops instead of publishing an empty page.
if (artifact && !ArtifactBody) throw new Error(`the center draws no page for a ${artifact.kind} artifact`);
---

<Shell
  title={title}
  description={summary}
  crumbs={[{ label: 'Demo Center', href: '/' }, { label: title }]}
>
  <header class="page__head">
    <h1 class="artifact__title">{title}</h1>
    {
      (artifact?.status || artifact?.data) && (
        <span class="badges">
          {artifact.status && <span class="badge">{artifact.status}</span>}
          {artifact.data && <span class="badge">{artifact.data}</span>}
        </span>
      )
    }
    <span class="tags">
      {platforms.map((name) => (
        <span class="platform-tag">{PLATFORMS[name].label}</span>
      ))}
      {products.map((name) => (
        <span class="product-tag">{name}</span>
      ))}
    </span>
    <p class="artifact__claim">{claim}</p>
  </header>
  {brief && <Planned surface={brief} />}
  {artifact && ArtifactBody && <ArtifactBody artifact={artifact} />}
  {
    note && (
      <p class="note__demo">
        <a href={`/notes/${note.id}`}>The note on this run</a>
      </p>
    )
  }
</Shell>
