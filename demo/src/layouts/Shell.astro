---
// The center's own chrome: who is showing this, where a reader is, and how to leave.
//
// It stands above the artifact and never inside it. The center draws this bar and the page below it; nothing else takes
// the viewport, because an application is opened at its own address rather than framed here.
import '../styles.css';
import type { Artifact } from '../data/artifacts';

interface Props {
  title: string;
  artifact?: Artifact;
}

const { title, artifact } = Astro.props;

// The bar hides its section name on a narrow screen, and which name that is depends on the page: a home page repeats the
// eyebrow under it, and an artifact page would lose where the reader is. So the page says which of the two it is.
const page = artifact ? 'artifact' : 'home';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{artifact ? `${artifact.title} | Ktema Systems Demo Center` : 'Ktema Systems Demo Center'}</title>
    <meta name="description" content={artifact?.summary ?? 'The surfaces Ktema Systems builds, in one place.'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class={page}>
    <header class="bar">
      <div class="bar__inner">
        <a class="bar__brand" href="/">
          <span class="bar__mark" aria-hidden="true"></span>
          <span class="bar__name">Ktema Systems</span>
        </a>
        <span class="bar__sep" aria-hidden="true"></span>
        <span class="bar__title">{artifact ? artifact.title : 'Demo Center'}</span>
        {artifact?.status ? <span class="tag">{artifact.status}</span> : null}
        <span class="bar__spacer"></span>
        <a class="bar__back" href="https://ktema.systems/">Home</a>
      </div>
    </header>
    <main class="main">
      <slot />
    </main>
  </body>
</html>
