---
// The center's own chrome: who is showing this, where a reader is, and how to leave.
//
// It stands above the artifact and never inside it. The center draws this bar and the page below it; nothing else takes
// the viewport, because an application is opened at its own address rather than framed here.
import '../styles.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  /** What the page is, where it is one this chrome draws a way into the app for. */
  kind?: string;
  crumbs?: Crumb[];
}

const { title, description, crumbs = [{ label: 'Corpus Hub' }] } = Astro.props;
// The Corpus app is deployed on its own, so the bar names its address rather than assuming the hub's.
const base = (import.meta.env.PUBLIC_CENTER_URL ?? 'https://corpus.ktema.systems/').replace(/\/?$/, '/');
// A page that is a figure set has a picture of it in Corpus Space, and the app's address is what a link there is built
// from. It is stated once here so no page has to know where the app is served.
const viewUrl = base;

// The front page carries the same call in its hero, so the bar's copy stays closed until that one has passed under it.
// The observer is the page's own: a page with no hero call has nothing to wait for, and `data-hero-cta` is absent.
const waitsForHero = Astro.url.pathname === '/' || Astro.url.pathname === '';

const pageTitle = title === 'Corpus Hub' ? 'Ktema Systems Corpus Hub' : `${title} | Ktema Systems Corpus Hub`;
const pageDescription = description ?? 'The demonstrations and the measurements Ktema Systems records, in one place.';

// `site` is set in the center's astro.config.mjs, so its own address is known at build time.
const origin = Astro.site!;
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL('/og.png', origin);
// Every page also ships as markdown at its own address, so an agent can take the text
// without the page around it.
const markdown = new URL(`${Astro.url.pathname}index.md`, origin);

// The company the center demonstrates for. The bar links to it and the structured data
// names it, so it is written once.
const company = 'https://ktema.systems/';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', company).href,
      name: 'Ktema Systems',
      url: company,
      logo: new URL('/favicon.svg', company).href,
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', origin).href,
      name: 'Ktema Systems Corpus Hub',
      url: origin.href,
      inLanguage: 'en',
      publisher: { '@id': new URL('/#organization', company).href },
    },
  ],
};

// A bench item opens its figures in the app, which draws the run's own numbers beside the ones this page states. The
// address is the app's, at the project that holds the measurements; the label is the field set the page is.
const figuresUrl = new URL('figures?project=corpus-bench', base).href;
const isBench = Astro.props.kind === 'bench';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdown} />
    <link rel="describedby" href={new URL('/llms.txt', origin)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#131210" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ktema Systems Corpus Hub" />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Ktema Systems Corpus Hub: the cockpit and an FPGA board on one page." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="bar">
      <div class="bar__inner">
        <a class="bar__brand" href={company}>
          <span class="bar__mark" aria-hidden="true"></span>
          <span class="bar__name">Ktema Systems</span>
        </a>
        {
          crumbs.map((crumb, index) => (
            <>
              <span class="bar__sep" aria-hidden="true" />
              {crumb.href ? (
                <a class:list={['bar__crumb', index === 0 && 'bar__crumb--root']} href={crumb.href}>
                  {crumb.label}
                </a>
              ) : (
                <span class="bar__title bar__title--current">{crumb.label}</span>
              )}
            </>
          ))
        }
        <span class="bar__spacer"></span>
        
        <slot name="bar" />
        {
          /* The hub's own call, which the hero carries the same of on the front page. The bar's copy takes no width
             until the hero's has passed under it, so the two are one button that moves. */
        }
        <span class="bar__main">
          <a
            class="bar__action bar__action--main"
            href={viewUrl}
            target="_blank"
            rel="noreferrer"
            title="Corpus Space: the corpus, read in Delta"
          >
            Open Corpus Space
          </a>
        </span>
        {
          /* A measurement has a second picture of itself: the app draws each run's figures, and a reader who has read the
             page is one press from the numbers drawn live. */
          isBench && (
            <a
              class="bar__action bar__action--figures"
              href={figuresUrl}
              target="_blank"
              rel="noreferrer"
              title="The measurements as Corpus Space draws them, from this corpus's own runs"
            >
              Figures in Corpus Space
            </a>
          )
        }
        <a class="bar__action" href="mailto:demo@ktema.systems">Request a demo</a>
      </div>
    </header>
    <main class="main" data-app={viewUrl}>
      <slot />
    </main>
    {
      waitsForHero && (
        <script>
          // The bar's call is a box the row can close, and it stays closed while the hero's call is on screen: the
          // width is measured once the fonts are in, because the button's own width is what the box opens to.
          const bar = document.querySelector<HTMLElement>('.bar__inner');
          const slot = bar?.querySelector<HTMLElement>('.bar__main');
          const button = slot?.querySelector<HTMLElement>('.bar__action--main');
          const hero = document.querySelector('[data-hero-cta]');
          if (bar && slot && button && hero) {
            const measure = () => {
              slot.style.maxWidth = 'none';
              const width = Math.ceil(button.getBoundingClientRect().width);
              slot.style.maxWidth = '';
              if (width > 0) bar.style.setProperty('--cta-w', `${width + 8}px`);
            };
            measure();
            void document.fonts?.ready.then(measure);
            window.addEventListener('resize', measure);

            const barHeight = Math.ceil(bar.getBoundingClientRect().height);
            new IntersectionObserver(
              ([entry]) => bar.classList.toggle('is-cta-past', !entry.isIntersecting),
              { rootMargin: `-${barHeight}px 0px 0px 0px` },
            ).observe(hero);
          }
        </script>
      )
    }
  </body>
</html>
