---
// The center's own chrome: who is showing this, where a reader is, and how to leave.
//
// It stands above the artifact and never inside it. The center draws this bar and the page below it; nothing else takes
// the viewport, because an application is opened at its own address rather than framed here.
import '../styles.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  crumbs?: Crumb[];
}

const { title, description, crumbs = [{ label: 'Demo Center' }] } = Astro.props;

// The last crumb is where the reader is; every earlier one is a way back.
const isSubpage = crumbs.length > 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Demo Center' ? 'Ktema Systems Demo Center' : `${title} | Ktema Systems Demo Center`}</title>
    <meta name="description" content={description ?? 'The surfaces Ktema Systems builds, in one place.'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="bar">
      <div class="bar__inner">
        <a class="bar__brand" href="https://ktema.systems/">
          <span class="bar__mark" aria-hidden="true"></span>
          <span class="bar__name">Ktema Systems</span>
        </a>
        {
          crumbs.map((crumb, index) => (
            <>
              <span class="bar__sep" aria-hidden="true" />
              {crumb.href ? (
                <a class:list={['bar__crumb', index === 0 && 'bar__crumb--root']} href={crumb.href}>
                  {crumb.label}
                </a>
              ) : (
                <span class:list={['bar__title', isSubpage && 'bar__title--current']}>{crumb.label}</span>
              )}
            </>
          ))
        }
        <span class="bar__spacer"></span>
        <a class="bar__cta" href="mailto:demo@ktema.systems">Enquiry Demo</a>
      </div>
    </header>
    <main class="main">
      <slot />
    </main>
  </body>
</html>
