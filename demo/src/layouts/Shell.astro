---
// The center's own chrome: who is showing this, where a reader is, and how to leave.
//
// It stands above the artifact and never inside it. The center draws this bar and the page below it; nothing else takes
// the viewport, because an application is opened at its own address rather than framed here.
import '../styles.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  crumbs?: Crumb[];
}

const { title, description, crumbs = [{ label: 'Corpus Hub' }] } = Astro.props;
// The viewer is deployed on its own, so the bar names its address rather than assuming the hub's.
const viewerUrl = (import.meta.env.PUBLIC_CENTER_URL ?? 'https://delta.ktema.systems/').replace(/\/?$/, '/');

const pageTitle = title === 'Corpus Hub' ? 'Ktema Systems Corpus Hub' : `${title} | Ktema Systems Corpus Hub`;
const pageDescription = description ?? 'The surfaces Ktema Systems builds, in one place.';

// `site` is set in the center's astro.config.mjs, so its own address is known at build time.
const origin = Astro.site!;
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL('/og.png', origin);
// Every page also ships as markdown at its own address, so an agent can take the text
// without the page around it.
const markdown = new URL(`${Astro.url.pathname}index.md`, origin);

// The company the center demonstrates for. The bar links to it and the structured data
// names it, so it is written once.
const company = 'https://ktema.systems/';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', company).href,
      name: 'Ktema Systems',
      url: company,
      logo: new URL('/favicon.svg', company).href,
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', origin).href,
      name: 'Ktema Systems Corpus Hub',
      url: origin.href,
      inLanguage: 'en',
      publisher: { '@id': new URL('/#organization', company).href },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdown} />
    <link rel="describedby" href={new URL('/llms.txt', origin)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#131210" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ktema Systems Corpus Hub" />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Ktema Systems Corpus Hub: the cockpit and an FPGA board on one page." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="bar">
      <div class="bar__inner">
        <a class="bar__brand" href={company}>
          <span class="bar__mark" aria-hidden="true"></span>
          <span class="bar__name">Ktema Systems</span>
        </a>
        {
          crumbs.map((crumb, index) => (
            <>
              <span class="bar__sep" aria-hidden="true" />
              {crumb.href ? (
                <a class:list={['bar__crumb', index === 0 && 'bar__crumb--root']} href={crumb.href}>
                  {crumb.label}
                </a>
              ) : (
                <span class="bar__title bar__title--current">{crumb.label}</span>
              )}
            </>
          ))
        }
        <span class="bar__spacer"></span>
        <a
          class="bar__delta"
          href={viewerUrl}
          target="_blank"
          rel="noreferrer"
          title="open the corpus viewer: this corpus, as a board of its measurements and demonstrations"
        >
          Open Corpus Viewer
        </a>
        <slot name="bar" />
        <a class="bar__cta" href="mailto:demo@ktema.systems">Request a demo</a>
      </div>
    </header>
    <main class="main">
      <slot />
    </main>
  </body>
</html>
