# Dependencies
node_modules/

# Build output
dist/
# The demonstration center builds beside the site and publishes to its own project.
demo-dist/

# Generated types, from `astro sync`
.*
.*/
# Environment files. The negation keeps a future `.env.example` tracked, so the
# shape of the configuration stays documented.
!.env.example
!.gitignore
# The workflows are source. Without this the two rules above hide them, and a new one is added with `-f` or not at all.
!.github/
!.github/**

# Logs
*.log

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Local Wrangler state, written by `wrangler pages deploy`
.wrangler/
