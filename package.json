{
  "name": "ktema-www",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:demo": "astro dev --root demo",
    "prebuild:demo": "node tools/demo.mjs check",
    "build:demo": "astro build --root demo",
    "preview:demo": "astro preview --root demo",
    "demo": "node tools/demo.mjs run",
    "demo:deploy": "node tools/demo.mjs deploy",
    "astro": "astro",
    "test:packages": "node --test packages/*/index.test.mjs",
    "corpus:sync": "node tools/demo.mjs corpus",
    "corpus:take": "node tools/demo.mjs take",
    "corpus:flow": "node tools/demo.mjs flow",
    "corpus:check": "node tools/demo.mjs check",
    "corpus:show": "node tools/demo.mjs show"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12",
    "gsap": "^3.15.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}
