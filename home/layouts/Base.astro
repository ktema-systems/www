---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, type NavItem, type NavLink } from '../config';

interface Props {
  title: string;
  description: string;
  // The page's own strip and call to action. A page that passes neither gets the
  // site's fallback strip, which is what the header defaults to.
  nav?: readonly NavItem[];
  cta?: NavItem;
  // The products panel's entries. It is separate from the nav because a product
  // page carries the panel without an entry that opens it.
  products?: readonly NavLink[];
  // Passed to the masthead: the product being read, and whether the products panel
  // is unfolded on arrival.
  current?: string;
  openProducts?: boolean;
  // A page that is reachable by its url and listed nowhere: no navigation entry points at
  // it, and this keeps a crawler from adding one.
  noindex?: boolean;
}

const {
  title,
  description,
  nav,
  cta,
  noindex = false,
  products,
  current,
  openProducts,
} = Astro.props;

// `site` is set in astro.config.mjs, so the origin is known at build time and every
// absolute address below is derived from it rather than written twice.
const origin = Astro.site!;
// The not-found page is served at no address of its own, so it claims none. Astro
// hands it a trailing slash like any other route.
const isNotFound = /^\/404\/?$/.test(Astro.url.pathname);
const canonical = isNotFound ? undefined : new URL(Astro.url.pathname, origin);
const ogImage = new URL('/og.png', origin);

// The company is one entity across the site, so it is described once and every page
// points at that description. `WebSite` is what a search engine reads for the name it
// prints above a result.
const organisationId = new URL('/#organization', origin).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organisationId,
      name: site.name,
      url: origin.href,
      logo: new URL('/favicon.svg', origin).href,
      description: site.description,
      sameAs: [site.github, site.docs],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', origin).href,
      name: site.name,
      url: origin.href,
      inLanguage: 'en',
      publisher: { '@id': organisationId },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#131210" />
    <script is:inline>
      // The masthead's settle state has to be right in the first frame, or a
      // reload part way down the page would draw the brand at the wrong size and
      // then correct it. The stylesheet turns this offset into the progress value
      // the brand and the bar's chrome are drawn from, and takes the chrome off
      // entirely at zero.
      const root = document.documentElement;
      const offset = window.scrollY || 0;
      root.style.setProperty('--masthead-scroll', String(offset));
      root.classList.toggle('is-at-top', offset <= 0);
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header
      items={nav}
      cta={cta}
      products={products}
      current={current}
      openProducts={openProducts}
    />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
